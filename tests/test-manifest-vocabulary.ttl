@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The terms the query fixtures' manifests add to W3C's mf: and qt: test-manifest vocabularies. No pod uses them.

ctm:lensQueryPath a owl:ObjectProperty ;
    rdfs:label "lens query path"@en ;
    rdfs:comment "The query file of the lens a query test builds its pod under."@en .

ctm:boundRecord a owl:ObjectProperty ;
    rdfs:label "bound record"@en ;
    rdfs:comment "A record a matcher query test binds ?record to, as a matcher run binds it to each record it compares; the test's rows are those of every such binding."@en .
