@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "current-revision-is-the-latest-observation" ;
  rdfs:comment "One record with two revisions, neither revising the other and neither carrying a source change time, whose times are written in different offsets: the later observation has the smaller clock time. The later is derived from two documents of two hospitals." ;
  mf:entries (
    <#the-current-revision>
    <#its-revisions>
  ) .

<#the-current-revision> a mf:QueryEvaluationTest ;
  mf:name "the-current-revision" ;
  rdfs:comment "The current revision is the one observed last, compared as times and not as text, and its version is the record's current version." ;
  mf:action [ qt:query <the-current-revision.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-current-revision.srj> .

<#its-revisions> a mf:QueryEvaluationTest ;
  mf:name "its-revisions" ;
  rdfs:comment "Each revision is a row with its two clocks, the current one marked, and a revision derived from two documents is a row for each, beside its own hospital and, where the document says it, the instant its source answered as of." ;
  mf:action [ qt:query <../../../queries/questions/record/Its%20revisions,%20in%20the%20order%20they%20arrived.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <its-revisions.srj> .
