@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-table-revised-elsewhere-keeps-the-matcher-judgment" ;
  rdfs:comment "A product ingredient table whose version 2 revises version 1 and changes only the row of a code no record holds, and the matcher's judgment joining a brand allergy and its ingredient's by version 1's rows, asserted under a rule list version whose same mapped code row runs same-active-ingredient.rq." ;
  mf:entries (
    <#matcher-judgments-that-count>
    <#whether-it-counts>
  ) .

<#matcher-judgments-that-count> a mf:QueryEvaluationTest ;
  mf:name "matcher-judgments-that-count" ;
  rdfs:comment "The matcher judgment counts and has not lapsed though version 2 is current: version 2's rows join its members as version 1's did." ;
  mf:action [ qt:query <matcher-judgments-that-count.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <matcher-judgments-that-count.srj> .

<#whether-it-counts> a mf:QueryEvaluationTest ;
  mf:name "whether-it-counts" ;
  rdfs:comment "The matcher judgment's one row says it counts, and none says it was made under a version since replaced: the current version joins its members." ;
  mf:action [ qt:query <../../../queries/questions/judgment/Whether%20it%20counts.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <whether-it-counts.srj> .
