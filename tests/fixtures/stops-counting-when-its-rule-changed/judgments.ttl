@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cascade:CascadeMatcher a prov:SoftwareAgent ; rdfs:label "Cascade matcher" .

:changedRule a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameMappedCode ;
    prov:hadMember :m1 , :m2 ; prov:wasDerivedFrom :m1Version , :m2Version ;
    cascade:matcherRule cascade:SameMappedCodeRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:changedRuleUnderRules1 a cascade:MatcherJudgmentAssertion ; cascade:assertedJudgment :changedRule ;
    cascade:assertedUnderRuleListVersion :rules1 .

:assertedAgain a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameMappedCode ;
    prov:hadMember :n1 , :n2 ; prov:wasDerivedFrom :n1Version , :n2Version ;
    cascade:matcherRule cascade:SameMappedCodeRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:assertedAgainUnderRules1 a cascade:MatcherJudgmentAssertion ; cascade:assertedJudgment :assertedAgain ;
    cascade:assertedUnderRuleListVersion :rules1 .

:assertedAgainUnderRules2 a cascade:MatcherJudgmentAssertion ; cascade:assertedJudgment :assertedAgain ;
    cascade:assertedUnderRuleListVersion :rules2 .
