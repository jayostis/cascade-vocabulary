@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "an-entry-given-for-a-condition-states-no-name" ;
  rdfs:comment "An active asthma; an active medicine that names it as its reason and states a name; and a completed procedure that names it as its reason and states no name." ;
  mf:entries (
    <#my-active-conditions>
    <#my-condition-history>
  ) .

<#my-active-conditions> a mf:QueryEvaluationTest ;
  mf:name "my-active-conditions" ;
  rdfs:comment "The asthma lists the procedure's entry IRI alone first, then the medicine's entry IRI and its name." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20conditions.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-conditions.srj> .

<#my-condition-history> a mf:QueryEvaluationTest ;
  mf:name "my-condition-history" ;
  rdfs:comment "The asthma lists the procedure's entry IRI alone first, then the medicine's entry IRI and its name." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20condition%20history.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-condition-history.srj> .
