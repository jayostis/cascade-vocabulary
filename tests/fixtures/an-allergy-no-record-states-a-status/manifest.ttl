@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "an-allergy-no-record-states-a-status" ;
  rdfs:comment "Four allergies from one summary: shellfish stating a reaction and severity and no status, dust stating neither and no status, latex inactive and pollen resolved." ;
  mf:entries (
    <#my-active-allergies>
  ) .

<#my-active-allergies> a mf:QueryEvaluationTest ;
  mf:name "my-active-allergies" ;
  rdfs:comment "Dust and shellfish are listed with the status not stated, the shellfish with its reaction and the dust with none; latex and pollen are not." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20allergies.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-allergies.srj> .
