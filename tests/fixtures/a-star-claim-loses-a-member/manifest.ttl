@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-star-claim-loses-a-member" ;
  rdfs:comment "A product ingredient table whose version 2 revises version 1 and drops the row of one of two brands, and the matcher's claim joining both brand allergies and their ingredient's by version 1's rows, asserted under a rule list version whose same mapped code row runs same-active-ingredient.rq." ;
  mf:entries (
    <#claims-that-count>
  ) .

<#claims-that-count> a mf:QueryEvaluationTest ;
  mf:name "claims-that-count" ;
  rdfs:comment "The claim no longer counts, and has lapsed: version 2 joins two of its members, but no member to each other one." ;
  mf:action [ qt:query <claims-that-count.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <claims-that-count.srj> .
