@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-model-proposed-retraction-reads-as-a-persons" ;
  rdfs:comment "A person's Different, and its retraction proposed by a model and said yes to by the person: the retraction names the person in cascade:PatientRole and the model in cascade:ModelProposerRole." ;
  mf:entries (
    <#who-judged-what>
    <#what-everything-is-called>
  ) .

<#who-judged-what> a mf:QueryEvaluationTest ;
  mf:name "who-judged-what" ;
  rdfs:comment "The retraction's role is the person's alone, in one row: the model's association is not its maker's, so it adds no row." ;
  mf:action [ qt:query <../../../queries/questions/judgment/Who%20judged%20what.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <who-judged-what.srj> .

<#what-everything-is-called> a mf:QueryEvaluationTest ;
  mf:name "what-everything-is-called" ;
  rdfs:comment "The retraction is named for the patient who said yes to it, as a retraction the patient made is." ;
  mf:action [ qt:query <../../../queries/questions/pod/What%20everything%20is%20called.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-everything-is-called.srj> .
