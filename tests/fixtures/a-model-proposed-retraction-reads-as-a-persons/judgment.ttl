@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .
:model a prov:SoftwareAgent .

:judgment a cascade:Judgment ; cascade:verdict cascade:Different ; prov:hadMember :record , :other ;
    prov:wasAttributedTo :person ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-01-02T09:00:00Z"^^xsd:dateTime .

:retraction a prov:Activity ; prov:invalidated :judgment ;
    prov:wasAssociatedWith :person ;
    prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ,
                              [ prov:agent :model ; prov:hadRole cascade:ModelProposerRole ] ;
    prov:startedAtTime "2026-01-03T09:00:00Z"^^xsd:dateTime .

:kept a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :record , :another ;
    prov:wasAttributedTo :person ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-01-01T09:00:00Z"^^xsd:dateTime .
