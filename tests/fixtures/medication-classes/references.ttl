@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:ingredients a cascade:ReferenceSeries ; rdfs:label "Product ingredients" ; cascade:tableKind cascade:ProductIngredients .
:ingredients-1 prov:specializationOf :ingredients ; pav:version "1" .

:classes a cascade:ReferenceSeries ; rdfs:label "Drug classes" ; cascade:tableKind cascade:DrugClasses .
:classes-1 prov:specializationOf :classes ; pav:version "1" .

:more-classes a cascade:ReferenceSeries ; rdfs:label "More drug classes" ; cascade:tableKind cascade:DrugClasses .
:more-classes-1 prov:specializationOf :more-classes ; pav:version "1" .
