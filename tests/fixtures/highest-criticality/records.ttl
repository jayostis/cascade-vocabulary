    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:unable a health:AllergyRecord .
:unableVersion prov:specializationOf :unable ; rec:patient :subject ; health:allergen "Peanut" ; clinical:criticality "unable-to-assess" .
:unableRevision a rec:Revision ; rec:revisionOf :unable ; rec:version :unableVersion ;
