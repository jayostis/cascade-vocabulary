@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:high a cascade:AllergyOrIntolerance .
:highVersion prov:specializationOf :high ; cascade:patient :subject ; cascade:allergen "Peanut" ; cascade:allergyCriticality "high" .
:highRevision a cascade:Revision ; cascade:revisionOf :high ; cascade:version :highVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:low a cascade:AllergyOrIntolerance .
:lowVersion prov:specializationOf :low ; cascade:patient :subject ; cascade:allergen "Peanut" ; cascade:allergyCriticality "low" .
:lowRevision a cascade:Revision ; cascade:revisionOf :low ; cascade:version :lowVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:unable a cascade:AllergyOrIntolerance .
:unableVersion prov:specializationOf :unable ; cascade:patient :subject ; cascade:allergen "Peanut" ; cascade:allergyCriticality "unable-to-assess" .
:unableRevision a cascade:Revision ; cascade:revisionOf :unable ; cascade:version :unableVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
