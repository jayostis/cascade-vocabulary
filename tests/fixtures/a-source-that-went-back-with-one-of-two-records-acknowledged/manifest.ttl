@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-source-that-went-back-with-one-of-two-records-acknowledged" ;
  rdfs:comment "Two conditions pulled twice from one source, each changed and stamped later by the second pull. One finding names the two revisions holding the older states and the two it contradicts. The person acknowledged the finding for gout alone, naming gout and the two documents." ;
  mf:entries (
    <#what-needs-review>
  ) .

<#what-needs-review> a mf:QueryEvaluationTest ;
  mf:name "what-needs-review" ;
  rdfs:comment "The finding is one line saying one record is at a state older than the source reported on 10 January, expanding to eczema alone: gout, which the acknowledgement named, is neither counted nor listed." ;
  mf:action [ qt:query <../../../queries/questions/record/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-needs-review.srj> .
