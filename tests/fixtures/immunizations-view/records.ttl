@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:fluOld a cascade:Vaccination .
:fluOldVersion prov:specializationOf :fluOld ; cascade:patient :subject ; cascade:vaccineName "Influenza" ; cascade:workflowStatus "completed" ;
    cascade:vaccinationOccurrenceTime "2025-10-01"^^xsd:date .
:fluOldRevision a cascade:Revision ; cascade:revisionOf :fluOld ; cascade:version :fluOldVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:fluNew a cascade:Vaccination .
:fluNewVersion prov:specializationOf :fluNew ; cascade:patient :subject ; cascade:vaccineName "Influenza, quadrivalent" ;
    cascade:vaccineCode <https://ns.cascadeprotocol.org/codes/cvx/150> .
:fluNewRevision a cascade:Revision ; cascade:revisionOf :fluNew ; cascade:version :fluNewVersion ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-02-01T00:00:00Z"^^xsd:dateTime .

:tdap a cascade:Vaccination .
:tdapVersion prov:specializationOf :tdap ; cascade:patient :subject ; cascade:vaccineName "Tdap" ; cascade:vaccineCode <https://ns.cascadeprotocol.org/codes/cvx/115> ; cascade:workflowStatus "not-done" ;
    cascade:vaccinationOccurrenceTime "2015-01-01"^^xsd:date .
:tdapRevision a cascade:Revision ; cascade:revisionOf :tdap ; cascade:version :tdapVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:hepB a cascade:Vaccination .
:hepBVersion prov:specializationOf :hepB ; cascade:patient :subject ; cascade:vaccineName "Hepatitis B, in 2015" ; cascade:workflowStatus "completed" ;
    cascade:vaccinationOccurrenceTime "2015"^^xsd:gYear .
:hepBRevision a cascade:Revision ; cascade:revisionOf :hepB ; cascade:version :hepBVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:covid a cascade:Vaccination .
:covidVersion prov:specializationOf :covid ; cascade:patient :subject ; cascade:vaccineName "COVID-19, at two" ; cascade:workflowStatus "completed" ;
    cascade:vaccinationOccurrenceTime "2025-11-03T14:00:00"^^xsd:dateTime ;
    cascade:paddedDateTime <urn:x:covidVersion#padded-vaccinationOccurrenceTime> .
<urn:x:covidVersion#padded-vaccinationOccurrenceTime> cascade:paddedDateTimeProperty cascade:vaccinationOccurrenceTime ; cascade:writtenDate "2025110314" .
:covidRevision a cascade:Revision ; cascade:revisionOf :covid ; cascade:version :covidVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .
