@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "immunizations-view" ;
  rdfs:comment "An immunization entry of two members, the later naming it and stating no status and no date; and one not done; and one given in a year it names alone." ;
  mf:entries (
    <#the-immunizations-view>
    <#my-immunizations>
  ) .

<#the-immunizations-view> a mf:QueryEvaluationTest ;
  mf:name "the-immunizations-view" ;
  rdfs:comment "Each entry takes the vaccine and code of its lead, the status of the member chosen for status, and the date of the member chosen for the date." ;
  mf:action [ qt:query <the-immunizations-view.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-immunizations-view.srj> .

<#my-immunizations> a mf:QueryEvaluationTest ;
  mf:name "my-immunizations" ;
  rdfs:comment "Every entry, newest first by the date as written, so the year 2015 follows 1 January 2015, with its code as CVX's IRI and how many records it joins." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20immunizations.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-immunizations.srj> .
