PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

SELECT ?holds ?property ?written ?named
WHERE {
  GRAPH <https://pod.example/clinical/immunizations.ttl> {
    ?holder cascade:paddedDateTime ?node .
    ?node cascade:paddedDateTimeProperty ?property ; cascade:writtenDate ?written .
    BIND (IF(EXISTS { ?holder cascade:mergedFrom [] }, "entry", "member's values") AS ?holds)
    BIND (STR(?node) = CONCAT(STR(?holder), "-padded-vaccinationOccurrenceTime") AS ?named)
  }
}
