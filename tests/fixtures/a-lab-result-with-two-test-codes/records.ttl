@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:glucose a cascade:LaboratoryTestResult .
:glucoseVersion prov:specializationOf :glucose ; cascade:patient :subject ; cascade:testName "Glucose" ;
    cascade:testCode <http://loinc.org/rdf/2345-7> , <http://loinc.org/rdf/2339-0> ;
    cascade:resultValueKind cascade:TextResultValue ; cascade:resultValueText "95" ; cascade:resultUnitText "mg/dL" ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-04-10T08:00:00Z"^^xsd:dateTime .
:glucoseRevision a cascade:Revision ; cascade:revisionOf :glucose ; cascade:version :glucoseVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:sodium a cascade:LaboratoryTestResult .
:sodiumVersion prov:specializationOf :sodium ; cascade:patient :subject ; cascade:testName "Sodium" ;
    cascade:testCode <http://loinc.org/rdf/2951-2> ;
    cascade:resultValueKind cascade:TextResultValue ; cascade:resultValueText "140" ; cascade:resultUnitText "mmol/L" ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-04-09T08:00:00Z"^^xsd:dateTime .
:sodiumRevision a cascade:Revision ; cascade:revisionOf :sodium ; cascade:version :sodiumVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .
