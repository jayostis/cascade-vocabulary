@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-lab-result-with-two-test-codes" ;
  rdfs:comment "A glucose its source coded twice, as glucose in serum or plasma and as glucose in blood, and a sodium the day before, coded once." ;
  mf:entries (
    <#my-lab-results>
  ) .

<#my-lab-results> a mf:QueryEvaluationTest ;
  mf:name "my-lab-results" ;
  rdfs:comment "An entry with two test codes is two rows, one for each code, alike but for it; the sodium follows, a day older." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20lab%20results.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-lab-results.srj> .
