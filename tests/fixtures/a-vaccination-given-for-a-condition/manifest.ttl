@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-vaccination-given-for-a-condition" ;
  rdfs:comment "An active asthma and a completed vaccination whose version names the asthma's record as its reason." ;
  mf:entries (
    <#my-active-conditions>
  ) .

<#my-active-conditions> a mf:QueryEvaluationTest ;
  mf:name "my-active-conditions" ;
  rdfs:comment "The asthma lists the vaccination's entry with the vaccine's name." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20conditions.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-conditions.srj> .
