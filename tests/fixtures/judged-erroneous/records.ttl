@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:judged a cascade:AllergyOrIntolerance .
:judgedVersion prov:specializationOf :judged ; cascade:patient :subject .
:judgedRevision a cascade:Revision ; cascade:revisionOf :judged ; cascade:version :judgedVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:stillShown a cascade:AllergyOrIntolerance .
:stillShownVersion prov:specializationOf :stillShown ; cascade:patient :subject .
:stillShownRevision a cascade:Revision ; cascade:revisionOf :stillShown ; cascade:version :stillShownVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .
