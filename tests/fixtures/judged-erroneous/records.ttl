@prefix : <urn:x:> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a rec:Subject .

:judged a health:AllergyRecord .
:judgedVersion prov:specializationOf :judged ; rec:patient :subject .
:judgedRevision a rec:Revision ; rec:revisionOf :judged ; rec:version :judgedVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:stillShown a health:AllergyRecord .
:stillShownVersion prov:specializationOf :stillShown ; rec:patient :subject .
:stillShownRevision a rec:Revision ; rec:revisionOf :stillShown ; rec:version :stillShownVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
