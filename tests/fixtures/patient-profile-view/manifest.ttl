@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "patient-profile-view" ;
  rdfs:comment "Two patient profiles counting About judgments tie to the subject, each arriving by an import of its own." ;
  mf:entries (
    <#one-entry-for-the-person>
    <#whose-it-is-counted-as-with-no-record>
    <#where-it-came-from>
    <#no-entry-seen-more-than-once>
  ) .

<#one-entry-for-the-person> a mf:QueryEvaluationTest ;
  mf:name "one-entry-for-the-person" ;
  rdfs:comment "One patient profile entry, named from the subject, joins both profiles." ;
  mf:action [ qt:query <one-entry-for-the-person.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <one-entry-for-the-person.srj> .

<#whose-it-is-counted-as-with-no-record> a mf:QueryEvaluationTest ;
  mf:name "whose-it-is-counted-as-with-no-record" ;
  rdfs:comment "Each row is a hospital whose records name a profile; with no version naming either profile, there is none." ;
  mf:action [ qt:query <../../../queries/questions/profile/Whose%20it%20is%20counted%20as.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <whose-it-is-counted-as-with-no-record.srj> .

<#where-it-came-from> a mf:QueryEvaluationTest ;
  mf:name "where-it-came-from" ;
  rdfs:comment "Each member of the patient entry, a profile, with when its current revision arrived and the import that brought it." ;
  mf:action [ qt:query <../../../queries/questions/entry/Where%20it%20came%20from.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <where-it-came-from.srj> .

<#no-entry-seen-more-than-once> a mf:QueryEvaluationTest ;
  mf:name "no-entry-seen-more-than-once" ;
  rdfs:comment "The patient entry joins two profiles from two places, but a profile is no record, so no entry holds more than one record." ;
  mf:action [ qt:query <../../../queries/questions/pod/What%20was%20seen%20more%20than%20once.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <no-entry-seen-more-than-once.srj> .
