@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:aboutNorth a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :northProfile ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:wasAttributedTo :person ; prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
:aboutSouth a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :southProfile ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:wasAttributedTo :person ; prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:northRevision a cascade:Revision ; cascade:revisionOf :northProfile ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    cascade:version :northV ; prov:wasGeneratedBy :northImport .
:northImport rdfs:label "North import" .
:southRevision a cascade:Revision ; cascade:revisionOf :southProfile ; prov:generatedAtTime "2026-01-02T00:00:00Z"^^xsd:dateTime ;
    cascade:version :southV ; prov:wasGeneratedBy :southImport .
:southImport rdfs:label "South import" .
