@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "my-reports-notes-and-documents" ;
  rdfs:comment "A final progress note sent twice, from a summary a clinic wrote and an exchange keeps and from a hospital's visit record, which the person judged one; a preliminary plan of care note the person entered, typed in LOINC and in a clinic's own system; a blood count report from the summary, coded in LOINC and in the lab's own system, naming a low hemoglobin with its reference range and an MCV flagged high and abnormal; a glucose tolerance report naming three glucose results, two of them flagged high; and a vitamin B12 report sent only as a PDF, with the time it was issued and no other date." ;
  mf:entries (
    <#my-reports-notes-and-documents>
  ) .

<#my-reports-notes-and-documents> a mf:QueryEvaluationTest ;
  mf:name "my-reports-notes-and-documents" ;
  rdfs:comment "One row for each entry, its text once, newest first, the B12 report placed by the time it was issued: every code it states, the IRI or the code in its system; the PDF as the attachment the pod does not read; each result with its test, value, unit, range and its own flags, so the two high glucoses are told from the one that is not; and each record of the note with its own document, retrieval time and the hospitals that wrote and keep it." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20reports,%20notes%20and%20documents.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-reports-notes-and-documents.srj> .
