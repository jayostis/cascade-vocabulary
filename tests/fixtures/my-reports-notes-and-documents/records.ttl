:progressRevision a cascade:Revision ; cascade:revisionOf :progress ; cascade:version :progressVersion ; prov:wasDerivedFrom :summary ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

