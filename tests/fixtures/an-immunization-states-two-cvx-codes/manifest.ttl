@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "an-immunization-states-two-cvx-codes" ;
  rdfs:comment "A vaccination whose source coded it twice, as CVX 140 and CVX 150, and a vaccination that names no vaccine, given the same day." ;
  mf:entries (
    <#my-immunizations>
  ) .

<#my-immunizations> a mf:QueryEvaluationTest ;
  mf:name "my-immunizations" ;
  rdfs:comment "An entry with two codes is two rows, one for each, alike but for the code; the entry that names no vaccine is listed before the one that does, given the same day." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20immunizations.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-immunizations.srj> .
