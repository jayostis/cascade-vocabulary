@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:person a prov:Person .

:about a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :claimed ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
:aboutRetracted a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :retracted ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
:retraction a cascade:Judgment ; npx:retracts :aboutRetracted ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
