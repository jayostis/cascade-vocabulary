@prefix : <urn:x:> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a rec:Subject .

:person a prov:Person .

:about a jdg:Judgment ; jdg:verdict jdg:About ; prov:hadMember :claimed ; jdg:subject :subject ;
    jdg:basis jdg:OwnerStatement ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
:aboutRetracted a jdg:Judgment ; jdg:verdict jdg:About ; prov:hadMember :retracted ; jdg:subject :subject ;
    jdg:basis jdg:OwnerStatement ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
:retraction a jdg:Judgment ; npx:retracts :aboutRetracted ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
