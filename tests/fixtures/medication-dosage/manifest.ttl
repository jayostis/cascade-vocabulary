@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "medication-dosage" ;
  rdfs:comment "A medication entry joining a list entry and a later prescription that each state a dosage; one whose later prescription states none beside a list entry that does, which the entry shows; and one that states none." ;
  mf:entries (
    <#the-dosage-the-view-shows>
    <#my-active-medications>
    <#my-medication-history>
  ) .

<#the-dosage-the-view-shows> a mf:QueryEvaluationTest ;
  mf:name "the-dosage-the-view-shows" ;
  rdfs:comment "An entry takes the dosage of its lead, else that of the member that states one, none when none does, and keeps each member's own dosage beside the member; an entry no member gives a dosage has none." ;
  mf:action [ qt:query <the-dosage-the-view-shows.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-dosage-the-view-shows.srj> .

<#my-active-medications> a mf:QueryEvaluationTest ;
  mf:name "my-active-medications" ;
  rdfs:comment "Each active entry gives the dosages its members state, each with the member that states it; none for the entry no member gives a dosage." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20medications.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-medications.srj> .

<#my-medication-history> a mf:QueryEvaluationTest ;
  mf:name "my-medication-history" ;
  rdfs:comment "Every entry gives the dosages its members state, each with the member that states it." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20medication%20history.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-medication-history.srj> .
