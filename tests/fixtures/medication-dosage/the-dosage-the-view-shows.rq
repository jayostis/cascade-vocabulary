PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

SELECT DISTINCT ?medication ?dosageInstructionText ?member ?memberDosage
WHERE { GRAPH <https://pod.example/clinical/medications.ttl> {
  ?entry cascade:entryMember [] ; cascade:drugName ?medication .
  OPTIONAL { ?entry cascade:dosageInstructionText ?dosageInstructionText }
  OPTIONAL { ?entry cascade:memberCurrentValues ?values . ?values cascade:valuesOfMember ?member ; cascade:dosageInstructionText ?memberDosage } } }
