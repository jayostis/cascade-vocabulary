@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-version-no-longer-reaches" ;
  rdfs:comment "A rule list whose version 2 revises version 1 and changes the same code query, four of the matcher's same code claims asserted under version 1, one of them asserted again under version 2, and version 2's finding of the claims it no longer reaches, naming a claim of two records and one of three." ;
  mf:entries (
    <#the-findings-pairs-for-review>
  ) .

<#the-findings-pairs-for-review> a mf:QueryEvaluationTest ;
  mf:name "the-findings-pairs-for-review" ;
  rdfs:comment "The finding is one line, its pairs: each pair of a claim it names, now in two entries, with that claim; the claim of three records gives three pairs. A lapsed claim the finding names is not listed again alone, the claim asserted again under version 2 joins its pair and is not listed, and a lapsed claim no finding names is listed alone." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20needs%20review.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-findings-pairs-for-review.srj> .
