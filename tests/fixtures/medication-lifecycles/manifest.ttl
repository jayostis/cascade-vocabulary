@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "medication-lifecycles" ;
  rdfs:comment "One medication for each way a status reaches an entry: each FHIR R4 code the table needs, no status at all, the HL7 v3 ActStatus codes aborted and suspended as C-CDA writes them, a synonym, a fragment that a more conservative one outranks, text nothing matches, and the R4 code entered-in-error and the ActStatus code nullified." ;
  mf:entries (
    <#each-record-and-its-entry-classed>
    <#my-active-medications>
    <#my-medication-history>
  ) .

<#each-record-and-its-entry-classed> a mf:QueryEvaluationTest ;
  mf:name "each-record-and-its-entry-classed" ;
  rdfs:comment "Each record is classed by its own current version's status, and its entry, of which it is the one member, has the same class." ;
  mf:action [ qt:query <each-record-and-its-entry-classed.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <each-record-and-its-entry-classed.srj> .

<#my-active-medications> a mf:QueryEvaluationTest ;
  mf:name "my-active-medications" ;
  rdfs:comment "Only the active entry: not one on hold, not taken, completed, stopped, cancelled, a draft, one without a status, a C-CDA aborted or suspended one, a discontinued one or one no longer taken." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20medications.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-medications.srj> .

<#my-medication-history> a mf:QueryEvaluationTest ;
  mf:name "my-medication-history" ;
  rdfs:comment "Every entry with its status's lifecycle class: active; stopped for not taken, completed, stopped, cancelled, aborted, discontinued and no longer taken; paused for on hold and suspended; entered in error for entered-in-error and nullified; unknown for a draft, no status and text nothing matches." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20medication%20history.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-medication-history.srj> .
