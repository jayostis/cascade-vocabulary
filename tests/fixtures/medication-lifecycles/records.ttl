@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a rec:Subject .

:active a clinical:Medication .
:activeVersion prov:specializationOf :active ; rec:patient :subject ; clinical:drugName "status: active" ; clinical:clinicalIntent "prescribed" ;
    clinical:status "active" .
:activeRevision a rec:Revision ; rec:revisionOf :active ; rec:version :activeVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

