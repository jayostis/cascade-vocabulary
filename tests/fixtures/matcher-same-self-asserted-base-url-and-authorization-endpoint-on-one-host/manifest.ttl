<> a mf:Manifest ;
  rdfs:label "matcher-same-self-asserted-base-url-and-authorization-endpoint-on-one-host" ;
  rdfs:comment "Six servers, each reporting one self-asserted base URL and one authorization endpoint: three on one host, at two paths and at another port, connected with one client id; one at another host; one on the first host connected with another client id; and one with no version." ;
  mf:entries (
    <#same-self-asserted-base-url-and-authorization-endpoint-on-one-host>
  ) .

