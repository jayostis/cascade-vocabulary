@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "value-set-members" ;
  rdfs:comment "Two hand-written versions of one value set expansions series, of VSAC's Diabetes value set (2.16.840.1.113883.3.464.1003.103.12.1001): the first lists diabetes mellitus type 2 (SNOMED CT 44054006) and type 2 diabetes mellitus without complications (ICD-10-CM E11.9); the second, revising it, also lists its descendant diabetes mellitus type 2 without retinopathy (SNOMED CT 1481000119100), and counts one member left out for having no code IRI. Conditions coded 1481000119100, E11.9 and essential hypertension (ICD-10-CM I10)." ;
  mf:entries (
    <#conditions-in-the-value-set>
  ) .

<#conditions-in-the-value-set> a mf:QueryEvaluationTest ;
  mf:name "conditions-in-the-value-set" ;
  rdfs:comment "Each condition whose code the value set, found by its canonical URL, lists, with each version that lists it and its expansion version. E11.9 is in both versions, one row each; 1481000119100 is in the second only, so the two versions answer apart; hypertension is in neither, and 44054006, which no condition holds, gives no row." ;
  mf:action [ qt:query <conditions-in-the-value-set.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <conditions-in-the-value-set.srj> .
