@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "medication-dose-history" ;
  rdfs:comment "A medication entry of two prescriptions, a 25 mg one written in September and a 50 mg one written in October, whose IRIs sort the other way; and an entry of a list entry stating no written date beside a prescription that states one." ;
  mf:entries (
    <#my-active-medications>
    <#my-medication-history>
  ) .

<#my-active-medications> a mf:QueryEvaluationTest ;
  mf:name "my-active-medications" ;
  rdfs:comment "Each active entry gives the dosage text of every member that states one, each with the day its prescription was written where it states one, in order of that day, the member stating none last." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20medications.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-medications.srj> .

<#my-medication-history> a mf:QueryEvaluationTest ;
  mf:name "my-medication-history" ;
  rdfs:comment "Each entry gives the dosage text of every member that states one, each with the day its prescription was written where it states one, in order of that day, the member stating none last." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20medication%20history.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-medication-history.srj> .
