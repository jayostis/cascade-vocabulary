@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:sameSertraline a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :fiftyMg, :twentyFiveMg ;
    prov:wasAttributedTo :person ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-10-21T00:00:00Z"^^xsd:dateTime .

:sameLisinopril a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :aListed, :bPrescribed ;
    prov:wasAttributedTo :person ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-10-21T00:00:00Z"^^xsd:dateTime .
