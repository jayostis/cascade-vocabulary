@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:mmrFromDownload a cascade:Vaccination .
:mmrFromDownloadVersion prov:specializationOf :mmrFromDownload ; cascade:patient :subject ;
    cascade:vaccineName "Measles, mumps and rubella" ; cascade:vaccineCode <https://ns.cascadeprotocol.org/codes/cvx/03> ;
    cascade:vaccinationOccurrenceTime "2025-03-10"^^xsd:date .
:mmrFromDownloadRevision a cascade:Revision ; cascade:revisionOf :mmrFromDownload ; cascade:version :mmrFromDownloadVersion ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-02-01T00:00:00Z"^^xsd:dateTime .
