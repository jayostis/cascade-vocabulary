@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-second-source-joins-an-immunization" ;
  rdfs:comment "One MMR shot from a portal, and the same shot from a download whose record's IRI sorts first, joined by a matcher judgment. Each source is its own file, the judgment another, so the pod can be built with and without each original." ;
  mf:entries () .
