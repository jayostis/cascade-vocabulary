@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:mmrFromPortal a cascade:Vaccination .
:mmrFromPortalVersion prov:specializationOf :mmrFromPortal ; cascade:patient :subject ; cascade:vaccineName "MMR" ;
    cascade:vaccineCode <https://ns.cascadeprotocol.org/codes/cvx/03> ; cascade:vaccinationOccurrenceTime "2025-03-10"^^xsd:date .
:mmrFromPortalRevision a cascade:Revision ; cascade:revisionOf :mmrFromPortal ; cascade:version :mmrFromPortalVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .
