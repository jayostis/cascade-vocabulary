@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:aboutNorth a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :north ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:wasAttributedTo :person ; prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
:aboutSouth a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :south ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:wasAttributedTo :person ; prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
:aboutSilent a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :silent ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:wasAttributedTo :person ; prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
