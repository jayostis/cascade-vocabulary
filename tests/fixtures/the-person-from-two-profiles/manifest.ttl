@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "the-person-from-two-profiles" ;
  rdfs:comment "Three profiles the person claimed by About: a hospital's, born 1968-11-04, female and not dead; a clinic's, born in November 1968, of unknown gender and dead on 2026-01-15; and one the person entered that says none of these. A fourth, from the clinic's summary, no About claims." ;
  mf:entries (
    <#the-person-this-pod-is-about>
  ) .

<#the-person-this-pod-is-about> a mf:QueryEvaluationTest ;
  mf:name "the-person-this-pod-is-about" ;
  rdfs:comment "The subject, with each claimed profile's date of birth, gender, whether they have died and when, after the profile that says it, neither source chosen over the other and nothing for the profile that says nothing; and each claimed profile with its document, when that was retrieved and the hospital that wrote it, the entered one with none. Nothing from the profile no About claims." ;
  mf:action [ qt:query <../../../queries/questions/pod/The%20person%20this%20pod%20is%20about.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-person-this-pod-is-about.srj> .
