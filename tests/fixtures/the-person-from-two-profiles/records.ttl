    cascade:administrativeGender "unknown" ; cascade:deceased true ; cascade:dateOfDeath "2026-01-15"^^xsd:date .
:southRevision a cascade:Revision ; cascade:revisionOf :south ; cascade:version :southVersion ; prov:wasDerivedFrom :southSummary ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-02-01T00:00:00Z"^^xsd:dateTime .

:silent a cascade:PatientProfile .
