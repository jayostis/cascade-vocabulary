:subject a cascade:Subject .

:northSummary a prov:Entity ; pav:retrievedOn "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAttribution [ prov:agent [ rdfs:label "North Hospital" ] ; prov:hadRole cascade:AuthorRole ] .
:southSummary a prov:Entity ; pav:retrievedOn "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAttribution [ prov:agent [ rdfs:label "South Clinic" ] ; prov:hadRole cascade:AuthorRole ] .

:north a cascade:PatientProfile .
:northVersion prov:specializationOf :north ; foaf:name "Priya Natarajan" ; cascade:dateOfBirth "1968-11-04"^^xsd:date ;
    cascade:administrativeGender "female" ; cascade:deceased false .
:northRevision a cascade:Revision ; cascade:revisionOf :north ; cascade:version :northVersion ; prov:wasDerivedFrom :northSummary ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:south a cascade:PatientProfile .
