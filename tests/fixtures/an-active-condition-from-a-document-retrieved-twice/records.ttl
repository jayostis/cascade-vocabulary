@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:download a prov:Activity ; rdfs:label "Download" ;
    prov:startedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:summary a prov:Entity ;
    pav:retrievedOn "2026-01-01T00:00:00Z"^^xsd:dateTime , "2026-02-01T00:00:00Z"^^xsd:dateTime .

:asthma a cascade:ProblemOrDiagnosis .
:asthmaVersion prov:specializationOf :asthma ; cascade:patient :subject ; cascade:conditionName "Asthma" ;
    cascade:clinicalStatus "active" .
:asthmaRevision a cascade:Revision ; cascade:revisionOf :asthma ; cascade:version :asthmaVersion ;
    prov:wasDerivedFrom :summary ; prov:wasGeneratedBy :download ;
    prov:generatedAtTime "2026-02-01T00:00:05Z"^^xsd:dateTime ; cascade:observedAsOf "2026-02-01T00:00:05Z"^^xsd:dateTime .
