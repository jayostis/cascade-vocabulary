@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "exposure-of-a-copy-first-recorded-later" ;
  rdfs:comment "One medication entry joining the generic, taken since 2022, and the brand a second hospital first recorded in 2025 and that arrived later, both still taken." ;
  mf:entries (
    <#each-copys-exposure>
  ) .

<#each-copys-exposure> a mf:QueryEvaluationTest ;
  mf:name "each-copys-exposure" ;
  rdfs:comment "Each copy's exposure starts on its own start of use, so the copy that arrived later does not shorten the earlier one's, and both are ongoing." ;
  mf:action [ qt:query <each-copys-exposure.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <each-copys-exposure.srj> .
