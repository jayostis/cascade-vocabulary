@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "exposure-of-a-stopped-copy-in-an-active-entry" ;
  rdfs:comment "One medication entry joining a copy completed with no end date and an active copy that arrived later, from which the entry takes its status." ;
  mf:entries (
    <#each-copys-lifecycle-and-exposure>
  ) .

<#each-copys-lifecycle-and-exposure> a mf:QueryEvaluationTest ;
  mf:name "each-copys-lifecycle-and-exposure" ;
  rdfs:comment "The entry is active, but the completed copy is classed by its own status, stopped, so it has its start and neither an end nor an ongoing exposure; the active copy's exposure is ongoing." ;
  mf:action [ qt:query <each-copys-lifecycle-and-exposure.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <each-copys-lifecycle-and-exposure.srj> .
