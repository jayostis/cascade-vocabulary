@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "matcher-same-business-identifier-and-test-code-within-one-organization" ;
  rdfs:comment "Potassiums carrying one business identifier of one system: from a FHIR summary and a C-CDA summary whose custodian is the hospital, one at another time; from a summary whose custodian is the organization a merger gave the hospital, which the person judged the same as it; from an exchange's summary that names the hospital as an author; from a clinic's summary; and from a pull, whose document names no organization. A sodium carrying that identifier from the hospital's summary, a potassium carrying its value under another system, two glucoses sharing an identifier with no system from the hospital's two summaries, and a potassium whose current version dropped the identifier its first version carried. Every record but the one after the merger is a record of the run." ;
  mf:entries (
    <#same-business-identifier-and-test-code-within-one-organization>
  ) .

<#same-business-identifier-and-test-code-within-one-organization> a mf:QueryEvaluationTest ;
  mf:name "same-business-identifier-and-test-code-within-one-organization" ;
  rdfs:comment "The four potassiums of the hospital match one another, whatever their times: the hospital's two, the one after the merger, the organizations being judged one, and the exchange's, which names the hospital as author. Not matched: the clinic's, the pulled one, the sodium, which has another code, the potassium under another system, the two glucoses, whose identifier names no system, and the potassium that no longer carries the identifier." ;
  mf:action [ qt:query <../../../queries/matcher/same-business-identifier-and-test-code-within-one-organization.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ;
              cascade:boundRecord <urn:x:authoredByTheHospital> ,
                                  <urn:x:elsewhere> ,
                                  <urn:x:fromCcda> ,
                                  <urn:x:fromFhir> ,
                                  <urn:x:identifierDropped> ,
                                  <urn:x:noSystemFirst> ,
                                  <urn:x:noSystemSecond> ,
                                  <urn:x:otherCode> ,
                                  <urn:x:otherSystem> ,
                                  <urn:x:pulled> ] ;
  mf:result <same-business-identifier-and-test-code-within-one-organization.srj> .
