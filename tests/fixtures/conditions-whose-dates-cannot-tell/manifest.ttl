@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "conditions-whose-dates-cannot-tell" ;
  rdfs:comment "Pairs of conditions of one code in two entries: one with no onset, one resolved with no abatement, both under ICD-10-CM and SNOMED CT; two episodes with both periods known and apart; a pair a person judged different; a pair the matcher joined by code and period." ;
  mf:entries (
    <#listed-for-review>
    <#export-counts-the-period-rule>
  ) .

<#listed-for-review> a mf:QueryEvaluationTest ;
  mf:name "listed-for-review" ;
  rdfs:comment "Each pair whose dates cannot tell is listed once, from the entry of its smaller record; the pair apart, the pair judged different and the pair already joined are not." ;
  mf:action [ qt:query <../../../queries/v1-draft/questions/entry/What%20needs%20review.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <listed-for-review.srj> .

<#export-counts-the-period-rule> a mf:QueryEvaluationTest ;
  mf:name "export-counts-the-period-rule" ;
  rdfs:comment "Under export the matcher's same code and period counts, as same code and same code and date do." ;
  mf:action [ qt:query <export-counts-the-period-rule.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/export.rq> ] ;
  mf:result <export-counts-the-period-rule.srj> .
