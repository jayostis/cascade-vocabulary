@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "procedures-view" ;
  rdfs:comment "A procedure entry of two members, the later naming it, stating no status and no date and its SNOMED CT code; and one not done." ;
  mf:entries (
    <#the-procedures-view>
    <#my-procedures>
  ) .

<#the-procedures-view> a mf:QueryEvaluationTest ;
  mf:name "the-procedures-view" ;
  rdfs:comment "Each entry takes the name and code of its lead, the status of the member chosen for status, and the date of the member chosen for the date." ;
  mf:action [ qt:query <the-procedures-view.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-procedures-view.srj> .

<#my-procedures> a mf:QueryEvaluationTest ;
  mf:name "my-procedures" ;
  rdfs:comment "Every entry, newest first, with its code as SNOMED CT's IRI and how many records it joins." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20procedures.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-procedures.srj> .
