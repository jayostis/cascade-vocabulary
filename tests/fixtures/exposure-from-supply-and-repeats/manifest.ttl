@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "exposure-from-supply-and-repeats" ;
  rdfs:comment "Prescriptions each alone in its entry, stating the day they were written and a supply in days, weeks or months, with three repeats, one, none or none stated; one written only to the month, one also stating its end of use, and one whose supply is a bound." ;
  mf:entries (
    <#each-copys-exposure>
  ) .

<#each-copys-exposure> a mf:QueryEvaluationTest ;
  mf:name "each-copys-exposure" ;
  rdfs:comment "With no end of use, a prescription's exposure ends its supply times one plus its repeats, less a day, after its start, in whole days, as CumulativeMedicationDuration's request period does, and is then not ongoing; a start given to the month counts the supply from the month's first day; an end of use stated wins; a supply that is a bound is not read." ;
  mf:action [ qt:query <each-copys-exposure.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <each-copys-exposure.srj> .
