@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "matcher-same-product-code" ;
  rdfs:comment "A version of a drug products table listing SCDs and SBDs, and a version of a product ingredient table and a pod file that hold term type rows too; medications of one product and of a product with an ingredient, the four pairs of one strength, one salt, one brand or one ingredient that were no Same, two of a product and an NDC, three of two products one of which carries both, the same three whose products two smaller drug products series list apart, and two each of a code only the pod file lists and only the other kind's version lists, and two of one product, one of them also carrying a code that only an older version of the drug products series lists." ;
  mf:entries (
    <#same-product-code>
    <#same-product-code-in-current-tables>
    <#same-product-code-in-current-tables-and-overlapping-exposure-periods>
  ) .

<#same-product-code> a mf:QueryEvaluationTest ;
  mf:name "same-product-code" ;
  rdfs:comment "Two records sharing a code the drug products version lists match with that version, either way round, whatever else either carries. None of the four counterexamples matches, nor a pair that shares an NDC, nor a record that carries two products with either of the records that share one with it, whether one version lists both or two series list one each, nor records of a code only a pod file or another kind's version lists." ;
  mf:action [ qt:query <../../../queries/matcher/same-product-code.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ;
              ctm:boundRecord <urn:x:brandFive> ,
                                  <urn:x:brandTen> ,
                                  <urn:x:bridgeA> ,
                                  <urn:x:bridgeB> ,
                                  <urn:x:bridgeC> ,
                                  <urn:x:combination> ,
                                  <urn:x:droppedA> ,
                                  <urn:x:droppedB> ,
                                  <urn:x:fillA> ,
                                  <urn:x:fillB> ,
                                  <urn:x:ingredientA> ,
                                  <urn:x:ingredientB> ,
                                  <urn:x:otherKindA> ,
                                  <urn:x:otherKindB> ,
                                  <urn:x:partialA> ,
                                  <urn:x:partialB> ,
                                  <urn:x:partialC> ,
                                  <urn:x:productB> ,
                                  <urn:x:single> ,
                                  <urn:x:strayA> ,
                                  <urn:x:strayB> ,
                                  <urn:x:strengthA> ,
                                  <urn:x:strengthB> ] ;
  mf:result <same-product-code.srj> .

<#same-product-code-in-current-tables> a mf:QueryEvaluationTest ;
  mf:name "same-product-code-in-current-tables" ;
  rdfs:comment "As same-product-code, with codes counted over the current version of each series alone: a code only the drug products version no longer current lists is not counted, so the record that carries it beside a product another record shares joins that record, which same-product-code leaves out." ;
  mf:action [ qt:query <../../../queries/matcher/same-product-code-in-current-tables.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ;
              ctm:boundRecord <urn:x:brandFive> ,
                                  <urn:x:brandTen> ,
                                  <urn:x:bridgeA> ,
                                  <urn:x:bridgeB> ,
                                  <urn:x:bridgeC> ,
                                  <urn:x:combination> ,
                                  <urn:x:droppedA> ,
                                  <urn:x:droppedB> ,
                                  <urn:x:fillA> ,
                                  <urn:x:fillB> ,
                                  <urn:x:ingredientA> ,
                                  <urn:x:ingredientB> ,
                                  <urn:x:otherKindA> ,
                                  <urn:x:otherKindB> ,
                                  <urn:x:partialA> ,
                                  <urn:x:partialB> ,
                                  <urn:x:partialC> ,
                                  <urn:x:productB> ,
                                  <urn:x:single> ,
                                  <urn:x:strayA> ,
                                  <urn:x:strayB> ,
                                  <urn:x:strengthA> ,
                                  <urn:x:strengthB> ] ;
  mf:result <same-product-code-in-current-tables.srj> .

<#same-product-code-in-current-tables-and-overlapping-exposure-periods> a mf:QueryEvaluationTest ;
  mf:name "same-product-code-in-current-tables-and-overlapping-exposure-periods" ;
  rdfs:comment "As same-product-code-in-current-tables, every record exposed from one day: the period test leaves the drug test's rows as they are." ;
  mf:action [ qt:query <../../../queries/matcher/same-product-code-in-current-tables-and-overlapping-exposure-periods.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ;
              ctm:boundRecord <urn:x:brandFive> ,
                                  <urn:x:brandTen> ,
                                  <urn:x:bridgeA> ,
                                  <urn:x:bridgeB> ,
                                  <urn:x:bridgeC> ,
                                  <urn:x:combination> ,
                                  <urn:x:droppedA> ,
                                  <urn:x:droppedB> ,
                                  <urn:x:fillA> ,
                                  <urn:x:fillB> ,
                                  <urn:x:ingredientA> ,
                                  <urn:x:ingredientB> ,
                                  <urn:x:otherKindA> ,
                                  <urn:x:otherKindB> ,
                                  <urn:x:partialA> ,
                                  <urn:x:partialB> ,
                                  <urn:x:partialC> ,
                                  <urn:x:productB> ,
                                  <urn:x:single> ,
                                  <urn:x:strayA> ,
                                  <urn:x:strayB> ,
                                  <urn:x:strengthA> ,
                                  <urn:x:strengthB> ] ;
  mf:result <same-product-code-in-current-tables.srj> .
