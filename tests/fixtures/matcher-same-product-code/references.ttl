@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:products a cascade:ReferenceSeries ; rdfs:label "Drug products" ; cascade:tableKind cascade:DrugProducts .
:products-0 prov:specializationOf :products ; pav:version "0" .
:products-1 prov:specializationOf :products ; pav:version "1" ; prov:wasRevisionOf :products-0 .

:ingredients a cascade:ReferenceSeries ; rdfs:label "Product ingredients" ; cascade:tableKind cascade:ProductIngredients .
:ingredients-1 prov:specializationOf :ingredients ; pav:version "1" .

:partial-p a cascade:ReferenceSeries ; rdfs:label "Drug products, a smaller list" ; cascade:tableKind cascade:DrugProducts .
:partial-p-1 prov:specializationOf :partial-p ; pav:version "1" .

:partial-q a cascade:ReferenceSeries ; rdfs:label "Drug products, another smaller list" ; cascade:tableKind cascade:DrugProducts .
:partial-q-1 prov:specializationOf :partial-q ; pav:version "1" .
