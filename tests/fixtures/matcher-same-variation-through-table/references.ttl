@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:lynch a cascade:ReferenceSeries ; rdfs:label "ClinVar Lynch classifications" ; cascade:tableKind cascade:VariantClassifications .
:lynch-1 prov:specializationOf :lynch ; pav:version "1" ; cascade:coversGene "MLH1" .

:other a cascade:ReferenceSeries ; rdfs:label "Another variant classifications series" ; cascade:tableKind cascade:VariantClassifications .
:other-1 prov:specializationOf :other ; pav:version "1" ; cascade:coversGene "MLH1" .

:names a cascade:ReferenceSeries ; rdfs:label "Variation names" ; cascade:tableKind cascade:CodeNames .
:names-1 prov:specializationOf :names ; pav:version "1" .
