@prefix : <urn:x:> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

:lynch a rec:ReferenceSeries ; rdfs:label "ClinVar Lynch classifications" ; rec:tableKind rec:VariantClassifications .
:lynch-1 prov:specializationOf :lynch ; pav:version "1" ; rec:coversGene "MLH1" .

:other a rec:ReferenceSeries ; rdfs:label "Another variant classifications series" ; rec:tableKind rec:VariantClassifications .
:other-1 prov:specializationOf :other ; pav:version "1" ; rec:coversGene "MLH1" .

:names a rec:ReferenceSeries ; rdfs:label "Variation names" ; rec:tableKind rec:CodeNames .
:names-1 prov:specializationOf :names ; pav:version "1" .
