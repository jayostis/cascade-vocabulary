@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "matcher-same-variation-through-table" ;
  rdfs:comment "Two versions of a variant classifications table, both holding rows 90011 and 90012, and a names version and a pod file that hold expression rows too. Variants of one row by expression on two transcripts, three of them with the second series holding only one transcript; an ID and an expression of the same row; an ID on no row beside its expression on a row; two IDs with an expression of the other's row; a shared ID; an expression on two rows; an expression on no row; an ID that is only another column's value; and an expression only a names version and a pod file hold; and two records of one expression that an older version of the first series holds on a second row." ;
  mf:entries (
    <#same-variation-through-table>
    <#same-variation-through-current-tables>
  ) .

<#same-variation-through-table> a mf:QueryEvaluationTest ;
  mf:name "same-variation-through-table" ;
  rdfs:comment "Two records match with each version that holds the row both find, either way round: through the expression on both transcripts of 90011, through an ID and an expression of 90012 in both series, and through an expression and an ID of 90013. None matches by an ID that is on no row, by two different IDs, by a shared ID, by an expression on two rows, by no row, or by rows of another kind or a pod file." ;
  mf:action [ qt:query <../../../queries/matcher/same-variation-through-table.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ;
              ctm:boundRecord <urn:x:oldRow1> ,
                                  <urn:x:oldRow2> ,
                                  <urn:x:q1> ,
                                  <urn:x:q2> ,
                                  <urn:x:r1> ,
                                  <urn:x:r2> ,
                                  <urn:x:s1> ,
                                  <urn:x:s2> ,
                                  <urn:x:t1> ,
                                  <urn:x:t2> ,
                                  <urn:x:u1> ,
                                  <urn:x:u2> ,
                                  <urn:x:v2> ,
                                  <urn:x:v3> ,
                                  <urn:x:w2> ,
                                  <urn:x:x1> ,
                                  <urn:x:y> ,
                                  <urn:x:z1> ,
                                  <urn:x:z2> ] ;
  mf:result <same-variation-through-table.srj> .

<#same-variation-through-current-tables> a mf:QueryEvaluationTest ;
  mf:name "same-variation-through-current-tables" ;
  rdfs:comment "As same-variation-through-table, with rows counted over the current version of each series alone: two records whose expression the version no longer current holds on a second row join through the current version's one row, which same-variation-through-table leaves out." ;
  mf:action [ qt:query <../../../queries/matcher/same-variation-through-current-tables.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ;
              ctm:boundRecord <urn:x:oldRow1> ,
                                  <urn:x:oldRow2> ,
                                  <urn:x:q1> ,
                                  <urn:x:q2> ,
                                  <urn:x:r1> ,
                                  <urn:x:r2> ,
                                  <urn:x:s1> ,
                                  <urn:x:s2> ,
                                  <urn:x:t1> ,
                                  <urn:x:t2> ,
                                  <urn:x:u1> ,
                                  <urn:x:u2> ,
                                  <urn:x:v2> ,
                                  <urn:x:v3> ,
                                  <urn:x:w2> ,
                                  <urn:x:x1> ,
                                  <urn:x:y> ,
                                  <urn:x:z1> ,
                                  <urn:x:z2> ] ;
  mf:result <same-variation-through-current-tables.srj> .
