@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a rec:Subject .

:profile a cascade:PatientProfile .

:fromDocument a health:AllergyRecord .
:fromDocumentVersion prov:specializationOf :fromDocument ; rec:patient :profile ; health:allergen "Peanut" ;
    clinical:status "active" .
:fromDocumentRevision a rec:Revision ; rec:revisionOf :fromDocument ; rec:version :fromDocumentVersion ;
    prov:wasDerivedFrom :document ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
:document pav:retrievedFrom <https://north.example/fhir/AllergyIntolerance/peanut> ;
    pav:retrievedOn "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAttribution [ prov:hadRole rec:author ; prov:agent [ rdfs:label "Northgate" ] ] .

:entered a health:AllergyRecord .
:enteredVersion prov:specializationOf :entered ; rec:patient :subject ; health:allergen "Peanut" ;
    clinical:status "active" .
:enteredRevision a rec:Revision ; rec:revisionOf :entered ; rec:version :enteredVersion ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:table a rec:ReferenceSeries ; rdfs:label "Rules" .
:table-1 prov:specializationOf :table ; pav:version "1" .
