@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "befores-through-another-record-form-no-cycle" ;
  rdfs:comment "A condition stamped active in January and resolved in February, the person's Before placing the February revision first, and two Befores between its revisions and the revision of a condition it is the same as, that lead from the January revision back to the February one." ;
  mf:entries (
    <#the-current-revision>
  ) .

<#the-current-revision> a mf:QueryEvaluationTest ;
  mf:name "the-current-revision" ;
  rdfs:comment "A cycle is looked for among one record's revisions alone, so the Before removes the February revision and the January state is current; the other condition is at its one revision." ;
  mf:action [ qt:query <the-current-revision.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-current-revision.srj> .
