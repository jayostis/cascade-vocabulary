@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:conversions a cascade:ReferenceSeries ; rdfs:label "Code conversions" ; cascade:tableKind cascade:CodeConversions .
:conversions-1 prov:specializationOf :conversions ; pav:version "1" .

:ingredients a cascade:ReferenceSeries ; rdfs:label "Product ingredients" ; cascade:tableKind cascade:ProductIngredients .
:ingredients-1 prov:specializationOf :ingredients ; pav:version "1" .
