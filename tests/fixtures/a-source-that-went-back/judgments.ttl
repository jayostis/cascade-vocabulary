@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .
:eczemaRolledBack a cascade:Judgment ; cascade:verdict cascade:Before ; prov:hadMember :eczemaSecond , :eczemaFirst ;
    cascade:earlierMember :eczemaSecond ; prov:wasAttributedTo :person ;
    prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-02T00:00:00Z"^^xsd:dateTime .
:secondPullAcknowledged a cascade:Judgment ; cascade:verdict cascade:Acknowledged ; prov:hadMember :wentBackOnTheSecondPull ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-01-11T00:00:00Z"^^xsd:dateTime .
