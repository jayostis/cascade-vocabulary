    prov:qualifiedAttribution [ prov:hadRole cascade:AuthorRole ; prov:agent [ rdfs:label "Northgate" ] ] .

:gout a cascade:ProblemOrDiagnosis .
:goutActive prov:specializationOf :gout ; cascade:patient :subject ; cascade:conditionName "Gout" ; cascade:clinicalStatus "active" .
:goutResolved prov:specializationOf :gout ; cascade:patient :subject ; cascade:conditionName "Gout" ; cascade:clinicalStatus "resolved" .
:goutFirst a cascade:Revision ; cascade:revisionOf :gout ; cascade:version :goutActive ; pav:lastUpdateOn "2025-12-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasDerivedFrom :pulledFirst ; prov:wasGeneratedBy :firstPull ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .
:goutSecond a cascade:Revision ; cascade:revisionOf :gout ; cascade:version :goutResolved ; prov:wasRevisionOf :goutFirst ;
    pav:lastUpdateOn "2026-01-05T00:00:00Z"^^xsd:dateTime ; prov:wasDerivedFrom :pulledSecond ; prov:wasGeneratedBy :secondPull ;
    prov:generatedAtTime "2026-01-10T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-10T00:00:00Z"^^xsd:dateTime .

