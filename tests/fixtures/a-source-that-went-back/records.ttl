:asthmaInactive prov:specializationOf :asthma ; cascade:patient :subject ; cascade:conditionName "Asthma" ; cascade:clinicalStatus "inactive" .
:asthmaRecurring prov:specializationOf :asthma ; cascade:patient :subject ; cascade:conditionName "Asthma" ; cascade:clinicalStatus "recurrence" .
