:subject a cascade:Subject .
:pulledFirst pav:retrievedOn "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAttribution [ prov:hadRole cascade:AuthorRole ; prov:agent [ rdfs:label "Northgate" ] ] .
:pulledSecond pav:retrievedOn "2026-01-10T00:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAttribution [ prov:hadRole cascade:AuthorRole ; prov:agent [ rdfs:label "Northgate" ] ] .
