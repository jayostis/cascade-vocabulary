    prov:generatedAtTime "2026-01-10T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-10T00:00:00Z"^^xsd:dateTime .
:asthmaRestored a cascade:Revision ; cascade:revisionOf :asthma ; cascade:version :asthmaRecurring ; prov:wasRevisionOf :asthmaSecond ;
    pav:lastUpdateOn "2026-01-03T00:00:00Z"^^xsd:dateTime ; prov:wasDerivedFrom :pulledAfterTheRestore ; prov:wasGeneratedBy :restoredPull ;
