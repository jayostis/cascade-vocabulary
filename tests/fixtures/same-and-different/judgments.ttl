@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:sameA a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :a1, :a2 ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:sameB a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :b1, :b2 ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:differentB a cascade:Judgment ; cascade:verdict cascade:Different ; prov:hadMember :b1, :b2 ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-02T00:00:00Z"^^xsd:dateTime .

:sameC a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :c1, :c2 ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:retraction a prov:Activity ; prov:invalidated :sameC ;
    prov:wasAssociatedWith :person ; prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:startedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
