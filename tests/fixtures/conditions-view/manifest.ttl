@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "conditions-view" ;
  rdfs:comment "An active condition entry of two members, the later naming it, stating two SNOMED CT codes and two ICD-10-CM codes, each as its code IRI, and stating no status and no onset; and a resolved condition." ;
  mf:entries (
    <#the-conditions-view>
    <#my-active-conditions>
  ) .

<#the-conditions-view> a mf:QueryEvaluationTest ;
  mf:name "the-conditions-view" ;
  rdfs:comment "Each entry takes the name and code of its lead, the status and abatement of the member chosen for status, and the onset of the member chosen for the date." ;
  mf:action [ qt:query <the-conditions-view.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-conditions-view.srj> .

<#my-active-conditions> a mf:QueryEvaluationTest ;
  mf:name "my-active-conditions" ;
  rdfs:comment "Only the active entry, one row, with the first of its codes in code point order, its onset and how many records it joins." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20conditions.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-conditions.srj> .
