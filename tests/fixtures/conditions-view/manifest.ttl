@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "conditions-view" ;
  rdfs:comment "An active condition entry of two members, the later naming it, stating its SNOMED CT code as an IRI and its ICD-10-CM code as a literal, and stating no status and no onset; and a resolved condition." ;
  mf:entries (
    <#the-conditions-view>
    <#my-active-conditions>
    <#what-it-shows>
  ) .

<#the-conditions-view> a mf:QueryEvaluationTest ;
  mf:name "the-conditions-view" ;
  rdfs:comment "Each entry takes the name and code of its latest member, the status and abatement of the member chosen for status, and the onset of the member chosen for the date." ;
  mf:action [ qt:query <the-conditions-view.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-conditions-view.srj> .

<#my-active-conditions> a mf:QueryEvaluationTest ;
  mf:name "my-active-conditions" ;
  rdfs:comment "Only the active entry, one row, with the first of its SNOMED CT and of its ICD-10-CM codes, its onset and how many records it joins." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20conditions.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-conditions.srj> .

<#what-it-shows> a mf:QueryEvaluationTest ;
  mf:name "what-it-shows" ;
  rdfs:comment "Each statement of each condition entry in its view, with the member it was taken from: the onset from the member the derivations chose for the date, which the view names by no term of its own." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20it%20shows.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-it-shows.srj> .
