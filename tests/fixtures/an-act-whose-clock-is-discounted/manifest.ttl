@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "an-act-whose-clock-is-discounted" ;
  rdfs:comment "Two writers that never received each other's pulls pulled gout, which the source stamps with no change time, one on 10 January and one on a clock that said 2 January; the second also pulled asthma stamped 5 January, after its own time, and filed a finding that its clock was at least 3 days behind. The person discounted the second pull's clock." ;
  mf:entries (
    <#the-current-revisions>
    <#what-needs-review>
  ) .

<#the-current-revisions> a mf:QueryEvaluationTest ;
  mf:name "the-current-revisions" ;
  rdfs:comment "The discounted revision of gout stands beside the other pull's, observed later, and the least IRI picks it." ;
  mf:action [ qt:query <the-current-revisions.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-current-revisions.srj> .

<#what-needs-review> a mf:QueryEvaluationTest ;
  mf:name "what-needs-review" ;
  rdfs:comment "Gout's pick is listed with no basis, and the clock finding, answered by the discount, is not." ;
  mf:action [ qt:query <../../../queries/questions/record/What%20needs%20review.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-needs-review.srj> .
