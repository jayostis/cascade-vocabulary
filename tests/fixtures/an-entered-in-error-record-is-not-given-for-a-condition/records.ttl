@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:asthma a cascade:ProblemOrDiagnosis .
:asthmaVersion prov:specializationOf :asthma ; cascade:patient :subject ; cascade:conditionName "Asthma" ; cascade:clinicalStatus "active" .
:asthmaRevision a cascade:Revision ; cascade:revisionOf :asthma ; cascade:version :asthmaVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:albuterol a cascade:PrescribedOrReportedMedication .
:albuterolVersion prov:specializationOf :albuterol ; cascade:patient :subject ; cascade:drugName "Albuterol inhaler" ;
    cascade:prescribedOrReported "prescribed" ; cascade:workflowStatus "active" ; cascade:reasonCondition :asthma .
:albuterolRevision a cascade:Revision ; cascade:revisionOf :albuterol ; cascade:version :albuterolVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:montelukast a cascade:PrescribedOrReportedMedication .
:montelukastVersion prov:specializationOf :montelukast ; cascade:patient :subject ; cascade:drugName "Montelukast" ;
    cascade:prescribedOrReported "prescribed" ; cascade:workflowStatus "entered-in-error" ; cascade:reasonCondition :asthma .
:montelukastRevision a cascade:Revision ; cascade:revisionOf :montelukast ; cascade:version :montelukastVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:spirometry a cascade:MedicalProcedure .
:spirometryVersion prov:specializationOf :spirometry ; cascade:patient :subject ; cascade:procedureName "Spirometry" ;
    cascade:workflowStatus "entered-in-error" ; cascade:reasonCondition :asthma .
:spirometryRevision a cascade:Revision ; cascade:revisionOf :spirometry ; cascade:version :spirometryVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:flu a cascade:Vaccination .
:fluVersion prov:specializationOf :flu ; cascade:patient :subject ; cascade:vaccineName "Influenza" ;
    cascade:workflowStatus "entered-in-error" ; cascade:reasonCondition :asthma .
:fluRevision a cascade:Revision ; cascade:revisionOf :flu ; cascade:version :fluVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .
