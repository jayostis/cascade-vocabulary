@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .
:firstRestoreAcknowledged a cascade:Judgment ; cascade:verdict cascade:Acknowledged ;
    cascade:answersWarningOfKind cascade:SourceReportedOlderStates ; prov:hadMember :psoriasis , :pulledSecond , :pulledFirst ;
    prov:wasAttributedTo :person ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-01-11T00:00:00Z"^^xsd:dateTime .
