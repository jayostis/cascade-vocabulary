@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "server-same-custodians-judged-one-organization" ;
  rdfs:comment "A person's Same over a server at its old and its new address, and an allergy a3 pulled from each: from a hospital at the old, and at the new under the organization record a merger gave it, which the person judged the same as the first." ;
  mf:entries (
    <#same-records>
  ) .

<#same-records> a mf:QueryEvaluationTest ;
  mf:name "same-records" ;
  rdfs:comment "The two custodians are one organization, so the two a3 are one record, both ways." ;
  mf:action [ qt:query <same-records.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <same-records.srj> .
