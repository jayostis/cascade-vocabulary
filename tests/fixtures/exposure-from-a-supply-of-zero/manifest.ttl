@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "exposure-from-a-supply-of-zero" ;
  rdfs:comment "Two active prescriptions each alone in its entry, stating the day they were written and a supply of zero, one in months and one in years." ;
  mf:entries (
    <#each-copys-exposure>
  ) .

<#each-copys-exposure> a mf:QueryEvaluationTest ;
  mf:name "each-copys-exposure" ;
  rdfs:comment "A supply of zero months or zero years is zero days, so the exposure ends on its start and is not ongoing, as a supply under a day does." ;
  mf:action [ qt:query <each-copys-exposure.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <each-copys-exposure.srj> .
