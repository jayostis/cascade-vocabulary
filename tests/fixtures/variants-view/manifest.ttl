@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "variants-view" ;
  rdfs:comment "A variant entry of two members, a panel report on transcript 3 with no ID and an exome report on transcript 4 with an ID; a variant in another gene with one expression and one ID; and a variant in a third gene with no code." ;
  mf:entries (
    <#the-variants-view>
    <#my-genetic-variants>
  ) .

<#the-variants-view> a mf:QueryEvaluationTest ;
  mf:name "the-variants-view" ;
  rdfs:comment "Each entry takes every member's gene symbol, HGVS expressions and ClinVar IDs, so the joined entry shows both transcripts and the ID, and the status of the member chosen for status." ;
  mf:action [ qt:query <the-variants-view.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-variants-view.srj> .

<#my-genetic-variants> a mf:QueryEvaluationTest ;
  mf:name "my-genetic-variants" ;
  rdfs:comment "One row for each entry and each code it states, the expression or the ID with its gene, and one row without a code for the entry that states none." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20genetic%20variants.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-genetic-variants.srj> .
