@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-retracted-statement-is-not-another-statement-of-an-entry" ;
  rdfs:comment "Three allergies of the subject, a person's Same over the first two, and a person's Same over the last two that the person retracted, so one entry holds the first two and the third is in its own." ;
  mf:entries (
    <#where-each-record-a-statement-names-is-now>
  ) .

<#where-each-record-a-statement-names-is-now> a mf:QueryEvaluationTest ;
  mf:name "where-each-record-a-statement-names-is-now" ;
  rdfs:comment "The retracted Same is listed with Counts false and outcome split, since its records are in two entries; the Same in force lists no other statement and merges with none, because the retracted one counts for nothing; the retracted one lists the Same in force as another statement of its entry." ;
  mf:action [ qt:query <../../../queries/questions/record/Where%20each%20record%20a%20statement%20names%20is%20now.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <where-each-record-a-statement-names-is-now.srj> .
