@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "two-acknowledgements-of-one-pair-each" ;
  rdfs:comment "A rule list whose version 2 revises version 1 and changes the same code query, a matcher's same code matcher judgment of x1 and x3 asserted under version 1 alone, version 2's finding naming it, and a person's two Acknowledged of that kind, one naming x1 and x2 and the other x3 and x4." ;
  mf:entries (
    <#what-needs-review>
  ) .

<#what-needs-review> a mf:QueryEvaluationTest ;
  mf:name "what-needs-review" ;
  rdfs:comment "The finding's pair, x1 and x3, is listed: each acknowledgement answers a warning about its own two records, and x1 and x3 are one record from each." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-needs-review.srj> .
