@prefix : <urn:x:> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .
:matcher a prov:SoftwareAgent ; rdfs:label "Matcher" .

# a: a Same that used version 1 of its table alone
:sameA a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :a1 , :a2 ;
    prov:used :table1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

# b: a Same that used version 1 of the rules and no table
:sameB a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :b1 , :b2 ;
    prov:used :rules1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

# c: filed again under version 2 of the table, beside the Same that used version 1
:sameCOld a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :c1 , :c2 ;
    prov:used :table1 , :rules4 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:sameCNew a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :c1 , :c2 ;
    prov:used :table2 , :rules4 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

# d: a lapsed pair a person's Same joins
:sameD a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :d1 , :d2 ;
    prov:used :table1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:personSameD a jdg:Judgment ; jdg:verdict jdg:Same ; prov:hadMember :d1 , :d2 ; prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

# e: a lapsed pair a person's Different separates
:sameE a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :e1 , :e2 ;
    prov:used :table1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:personDifferentE a jdg:Judgment ; jdg:verdict jdg:Different ; prov:hadMember :e1 , :e2 ; prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

# f: a lapsed Same a person retracted
:sameF a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :f1 , :f2 ;
    prov:used :table1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:retractF a jdg:Judgment ; npx:retracts :sameF ; prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

# g: a Same of three records that used version 1, two of which a Same that used version 2 joins
:sameGOld a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :g1 , :g2 , :g3 ;
    prov:used :table1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:sameGNew a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :g1 , :g2 ;
    prov:used :table2 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

# h: a Same of a series with one version only
:sameH a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :h1 , :h2 ;
    prov:used :solo1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

# i: two Sames of one pair, each lapsed (the rules differ, the table is the same)
:sameIRules1 a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :i1 , :i2 ;
    prov:used :table1 , :rules1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:sameIRules4 a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :i1 , :i2 ;
    prov:used :table1 , :rules4 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

# j: a person's Same superseded the machine's, and was retracted
:sameJ a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :j1 , :j2 ;
    prov:used :table1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:personSameJ a jdg:Judgment ; jdg:verdict jdg:Same ; prov:hadMember :j1 , :j2 ; npx:supersedes :sameJ ; prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:retractPersonSameJ a jdg:Judgment ; npx:retracts :personSameJ ; prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .


# k: a lapsed Same a person's Different supersedes, the Different not retracted
:sameK a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameMappedCode ; prov:hadMember :k1 , :k2 ;
    prov:used :table1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:personDifferentK a jdg:Judgment ; jdg:verdict jdg:Different ; prov:hadMember :k1 , :k2 ; npx:supersedes :sameK ; prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
