@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "joins-that-lapsed" ;
  rdfs:comment "A table series with versions 1 and 2, a rule list series with versions 1 and 4 (each revising version 1), a series with one version, a matcher and a person, and the pairs of allergies the matcher's Sames join: lapsed, filed again, judged by a person, or of a series still current." ;
  mf:entries (
    <#which-have-lapsed>
    <#lapsed-joins-for-review>
  ) .

<#which-have-lapsed> a mf:QueryEvaluationTest ;
  mf:name "which-have-lapsed" ;
  rdfs:comment "Under everyday, a matcher's Same lapses when a version it used has a newer current one and nothing counts, retracts or supersedes it: not one filed again, one a person retracted, nor one of a series with one version." ;
  mf:action [ qt:query <which-have-lapsed.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <which-have-lapsed.srj> .

<#lapsed-joins-for-review> a mf:QueryEvaluationTest ;
  mf:name "lapsed-joins-for-review" ;
  rdfs:comment "Each pair of a lapsed Same's records that is now in two entries and not judged different is listed once, with the lapsed Same that has the smallest IRI: none for a pair filed again, joined by a person's Same, separated by a person's Different, or retracted." ;
  mf:action [ qt:query <../../../queries/v1-draft/questions/entry/What%20needs%20review.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <lapsed-joins-for-review.srj> .
