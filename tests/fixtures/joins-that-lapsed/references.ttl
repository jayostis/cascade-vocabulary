@prefix : <urn:x:> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

:table a rec:ReferenceSeries ; rdfs:label "Crosswalk" .
:table1 prov:specializationOf :table ; pav:version "1" .
:table2 prov:specializationOf :table ; pav:version "2" ; prov:wasRevisionOf :table1 .

:rules a rec:ReferenceSeries ; rdfs:label "Rules" .
:rules1 prov:specializationOf :rules ; pav:version "1" .
:rules4 prov:specializationOf :rules ; pav:version "4" ; prov:wasRevisionOf :rules1 .

:solo a rec:ReferenceSeries ; rdfs:label "Kit table" .
:solo1 prov:specializationOf :solo ; pav:version "1" .
