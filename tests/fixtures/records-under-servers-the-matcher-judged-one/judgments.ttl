@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cascade:CascadeMatcher a prov:SoftwareAgent ; rdfs:label "Cascade matcher" .

:serversSame a cascade:Judgment ; cascade:verdict cascade:Same ;
    cascade:justification cascade:SameSelfAssertedBaseUrlAndAuthorizationEndpointOnOneHost ;
    prov:hadMember <urn:uuid:302e31f3-700b-8db9-b523-9bde7ea71b66>, <urn:uuid:28797f22-3db7-830d-8cb0-0910a25446ea> ;
    prov:used :oldServerVersion , :newServerVersion ;
    cascade:matcherRule cascade:SameSelfAssertedBaseUrlAndAuthorizationEndpointOnOneHostRule ;
    prov:wasAttributedTo cascade:CascadeMatcher .

:serversSameUnderRules1 a cascade:ClaimAssertion ; cascade:assertedClaim :serversSame ;
    cascade:assertedUnderRuleListVersion :rules1 .

:rules a cascade:ReferenceSeries ; rdfs:label "Rules" .
:rules1 prov:specializationOf :rules ; pav:version "1" .
:rules1ServersRule cascade:rowOfRuleListVersion :rules1 ;
    cascade:matcherRule cascade:SameSelfAssertedBaseUrlAndAuthorizationEndpointOnOneHostRule ;
    cascade:queryHash :serversQuery .
