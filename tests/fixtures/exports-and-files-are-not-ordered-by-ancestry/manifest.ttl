@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "exports-and-files-are-not-ordered-by-ancestry" ;
  rdfs:comment "Two conditions whose source stamps no change time, each imported twice, the second import's snapshot descending from the first's: two Apple Health exports, the one imported later answering as of an older day; and a live pull, then a C-CDA file imported on a clock that ran behind." ;
  mf:entries (
    <#the-current-revisions>
    <#what-needs-review>
  ) .

<#the-current-revisions> a mf:QueryEvaluationTest ;
  mf:name "the-current-revisions" ;
  rdfs:comment "Ancestry orders only live pulls, so the older export imported later never un-corrects the newer one, and the C-CDA file never outranks the pull observed later: the clocks pick both." ;
  mf:action [ qt:query <the-current-revisions.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-current-revisions.srj> .

<#what-needs-review> a mf:QueryEvaluationTest ;
  mf:name "what-needs-review" ;
  rdfs:comment "Both picks are listed, observed later." ;
  mf:action [ qt:query <../../../queries/questions/record/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-needs-review.srj> .
