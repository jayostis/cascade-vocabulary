@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "variant-classifications-agreement" ;
  rdfs:comment "A version of a variant classifications table with a pathogenic and likely pathogenic row found by two transcripts, a benign row found by ID, a conflicting row, a conflicting data row, a risk factor row, a row with no classification, and two pathogenic rows one expression and one ID can each find. A variant of two reports on two transcripts, one of them not an ACMG answer; a variant with a benign and a likely benign report; one variant for each other row; one whose codes find two rows; and one found on no row." ;
  mf:entries (
    <#agreement>
  ) .

<#agreement> a mf:QueryEvaluationTest ;
  mf:name "agreement" ;
  rdfs:comment "A report agrees when its ACMG value is among the row's, and differs when the row holds one of the five and not the report's. A conflicting or conflicting-data row gives labs disagree whatever the report says, a row with no ACMG value gives as ClinVar writes it, and a report with no ACMG value, a variant whose codes find two rows and a variant found on no row give no verdict." ;
  mf:action [ qt:query <../../../queries/v1-draft/tables/agreement.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <agreement.srj> .
