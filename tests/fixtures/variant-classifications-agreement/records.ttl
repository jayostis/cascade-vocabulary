:subject a cascade:Subject .

# Martin's variant: two reports of one variant, on two transcripts, one of them with the ID.
:panel a cascade:GeneticVariantFinding .
:panelVersion prov:specializationOf :panel ; cascade:patient :subject ; cascade:geneSymbol "MLH1" ; cascade:hgvsCodingDnaExpression "NM_000249.3:c.2042C>T" .
:panelRevision a cascade:Revision ; cascade:revisionOf :panel ; cascade:version :panelVersion ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
:exome a cascade:GeneticVariantFinding .
:exomeVersion prov:specializationOf :exome ; cascade:patient :subject ; cascade:geneSymbol "MLH1" ; cascade:hgvsCodingDnaExpression "NM_000249.4:c.2042C>T" ;
    cascade:clinvarVariationId "90011" .
:exomeRevision a cascade:Revision ; cascade:revisionOf :exome ; cascade:version :exomeVersion ; prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

