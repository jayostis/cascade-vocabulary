@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "exposure-started-from-a-dosage-bounds-or-validity-period" ;
  rdfs:comment "Prescriptions each alone in its entry and stating no use: one with one dosage bounded after the day it was written, one with two dosages each bounded, one stating only its dispensing window, and one whose one dosage is bounded past its supply." ;
  mf:entries (
    <#each-copys-exposure>
  ) .

<#each-copys-exposure> a mf:QueryEvaluationTest ;
  mf:name "each-copys-exposure" ;
  rdfs:comment "As CumulativeMedicationDuration's request period, a prescription's exposure starts at its one dosage's bounds, else the day it was written, else its dispensing window's start, and ends at its supply's end, else at its one dosage's bounds' end; the bounds of a version with several dosages are not read, and a dispensing window's end is never an end." ;
  mf:action [ qt:query <each-copys-exposure.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <each-copys-exposure.srj> .
