:subject a cascade:Subject .

:lab a cascade:Organization .
:labVersion prov:specializationOf :lab ; foaf:name "Harbour Lab" .
:labRevision a cascade:Revision ; cascade:revisionOf :lab ; cascade:version :labVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:hemoglobin a cascade:LaboratoryTestResult .
:hemoglobinVersion prov:specializationOf :hemoglobin ; cascade:patient :subject ; cascade:testName "Hemoglobin" ;
    cascade:resultValueKind cascade:TextResultValue ; cascade:resultValue "13.9" ; cascade:resultUnit "g/dL" .
:hemoglobinRevision a cascade:Revision ; cascade:revisionOf :hemoglobin ; cascade:version :hemoglobinVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:leukocytes a cascade:LaboratoryTestResult .
:leukocytesVersion prov:specializationOf :leukocytes ; cascade:patient :subject ; cascade:testName "Leukocytes" ;
    cascade:resultValueKind cascade:TextResultValue ; cascade:resultValue "6.1" ; cascade:resultUnit "10*3/uL" .
:leukocytesRevision a cascade:Revision ; cascade:revisionOf :leukocytes ; cascade:version :leukocytesVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:cbc a cascade:DiagnosticReport .
:cbcVersion prov:specializationOf :cbc ; cascade:patient :subject ; cascade:reportName "CBC panel - Blood by Automated count" ;
    cascade:reportCode <http://loinc.org/rdf/58410-2> ; cascade:reportCategory "LAB"^^<http://terminology.hl7.org/CodeSystem/v2-0074> ;
    cascade:reportEffectiveTime "2025-04-02T08:30:00Z"^^xsd:dateTime ; cascade:reportConclusion "Normal blood count." ;
    cascade:narrativeText "Hemoglobin 13.9 g/dL\nLeukocytes 6.1 10*3/uL" ; cascade:workflowStatus "final" ;
    obo:RO_0002351 :hemoglobin , :leukocytes , :notHeld ; prov:wasAttributedTo :lab .
:cbcRevision a cascade:Revision ; cascade:revisionOf :cbc ; cascade:version :cbcVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:cobalamin a cascade:DiagnosticReport .
