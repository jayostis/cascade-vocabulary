@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-download-without-an-address-is-named-by-its-author" ;
  rdfs:comment "Three allergies from downloads that state no address to retrieve them from: two name the same author and custodian and arrived on different days, one names nobody." ;
  mf:entries (
    <#the-record-version-and-revision-labels>
  ) .

<#the-record-version-and-revision-labels> a mf:QueryEvaluationTest ;
  mf:name "the-record-version-and-revision-labels" ;
  rdfs:comment "A record, version and revision whose download names an author but no address are named by the author, and the record, which gives no day of its own, by the day its revision arrived; one whose download names nobody is of an unknown source." ;
  mf:action [ qt:query <the-record-version-and-revision-labels.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-record-version-and-revision-labels.srj> .
