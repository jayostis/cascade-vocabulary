@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "date-from-the-latest-that-states-one" ;
  rdfs:comment "A condition entry whose latest member states no date." ;
  mf:entries (
    <#where-the-entry-takes-its-date-from>
    <#what-it-shows>
  ) .

<#where-the-entry-takes-its-date-from> a mf:QueryEvaluationTest ;
  mf:name "where-the-entry-takes-its-date-from" ;
  rdfs:comment "The entry takes its date from the latest member that states one." ;
  mf:action [ qt:query <where-the-entry-takes-its-date-from.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <where-the-entry-takes-its-date-from.srj> .

<#what-it-shows> a mf:QueryEvaluationTest ;
  mf:name "what-it-shows" ;
  rdfs:comment "The entry shows the onset of the member chosen for its date, which the view names by no term of its own, and the name both members state, the lead's first." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20it%20shows.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-it-shows.srj> .
