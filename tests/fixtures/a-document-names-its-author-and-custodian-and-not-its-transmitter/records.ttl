@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:download a prov:Activity ; rdfs:label "Download" ;
    prov:startedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:summary a prov:Entity ; pav:retrievedOn "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo _:clinic , _:exchange ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent _:exchange ; prov:hadRole cascade:CustodianRole ] ,
                                                    [ prov:agent _:apple ; prov:hadRole cascade:TransmitterRole ] ] ,
                        [ prov:qualifiedAssociation [ prov:agent _:clinic ; prov:hadRole cascade:AuthorRole ] ] .
_:clinic rdfs:label "Fernhill Clinic" .
_:exchange rdfs:label "Bay Area Health Exchange" .
_:apple rdfs:label "Apple Health" .

:asthma a cascade:ProblemOrDiagnosis .
:asthmaVersion prov:specializationOf :asthma ; cascade:patient :subject ; cascade:conditionName "Asthma" .
:asthmaRevision a cascade:Revision ; cascade:revisionOf :asthma ; cascade:version :asthmaVersion ;
    prov:wasDerivedFrom :summary ; prov:wasGeneratedBy :download ;
    prov:generatedAtTime "2026-01-01T00:00:05Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:05Z"^^xsd:dateTime .
