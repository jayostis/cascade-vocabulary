@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

cascade:CascadeMatcher a prov:SoftwareAgent ; rdfs:label "Cascade matcher" .

:personSame a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :record , :other ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:superseded a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :record , :other ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:superseding a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :record , :other ; dct:replaces :superseded ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:retracted a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :record , :other ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:retraction a prov:Activity ; prov:invalidated :retracted ;
    prov:wasAssociatedWith :person ; prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:startedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:machineCode a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameCode ; prov:hadMember :record , :other ;
    prov:used :recordVersion , :otherVersion ; cascade:matcherRule cascade:SameCodeRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:machineMapped a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameMappedCode ; prov:hadMember :record , :other ;
    prov:used :recordVersion , :otherVersion ; cascade:matcherRule cascade:SameMappedCodeRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:machineOld a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameCode ; prov:hadMember :record , :other ;
    prov:used :recordVersion , :otherVersion ; cascade:matcherRule cascade:SameCodeRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:machineCodeUnderrules2 a cascade:ClaimAssertion ; cascade:assertedClaim :machineCode ;
    cascade:assertedUnderRuleListVersion :rules-2 .

:machineMappedUnderrules2 a cascade:ClaimAssertion ; cascade:assertedClaim :machineMapped ;
    cascade:assertedUnderRuleListVersion :rules-2 .

:machineOldUnderrules1 a cascade:ClaimAssertion ; cascade:assertedClaim :machineOld ;
    cascade:assertedUnderRuleListVersion :rules-1 .
