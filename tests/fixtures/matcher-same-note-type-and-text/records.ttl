:clinic a cascade:Organization .
:hospital a cascade:Organization .

:hospitalSummary a prov:Entity ;
    prov:qualifiedAttribution [ prov:hadRole cascade:CustodianRole ; prov:agent :hospital ] .
:clinicSummary a prov:Entity ;
    prov:qualifiedAttribution [ prov:hadRole cascade:CustodianRole ; prov:agent :clinic ] .
:clinicUnstructured a prov:Entity ;
    prov:qualifiedAttribution [ prov:hadRole cascade:CustodianRole ; prov:agent :clinic ] .
:pull a prov:Entity ; cascade:serverBaseUrl "https://fhir.hospital.example/r4" .

:hospitalCourse a cascade:ClinicalNoteOrDocument .
<urn:x:hospitalCourseVersion> prov:specializationOf :hospitalCourse ;
    cascade:noteOrDocumentType <http://loinc.org/rdf/8648-8> ;
    cascade:narrativeText "Admitted on October 2, 2026 with dizziness and a sodium of 123 mmol/L. Hydrochlorothiazide was stopped and fluids restricted; the sodium rose to 134 mmol/L by discharge.\nDischarged home on October 5, 2026 to follow up with her primary care provider within one week." ;
    cascade:noteOrDocumentDate "2026-10-05T12:00:00-05:00"^^xsd:dateTime .
:hospitalCourseRevision a cascade:Revision ; cascade:revisionOf :hospitalCourse ; cascade:version <urn:x:hospitalCourseVersion> ;
    prov:wasDerivedFrom :hospitalSummary ;
    prov:generatedAtTime "2026-11-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-10-05T12:00:00-05:00"^^xsd:dateTime .

