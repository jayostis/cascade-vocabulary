PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

SELECT ?holds ?property ?written ?named
WHERE {
  GRAPH <https://pod.example/clinical/allergies.ttl> {
    ?holder cascade:paddedDateTime ?node .
    ?node cascade:paddedDateTimeProperty ?property ; cascade:timeAsWritten ?written .
    BIND (IF(EXISTS { ?holder cascade:entryMember [] }, "entry", "member's values") AS ?holds)
    BIND (STR(?node) = CONCAT(STR(?holder), "-padded-onsetDate") AS ?named)
  }
}
