@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:northImport a prov:Activity ; rdfs:label "Northgate download" ;
    prov:startedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
:session a prov:Activity ; rdfs:label "Entry session" ; prov:startedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:peanutFromDocument a cascade:AllergyOrIntolerance .
:peanutFromDocumentVersion prov:specializationOf :peanutFromDocument ; cascade:patient :subject ; cascade:allergen "Peanut" ;
    cascade:clinicalStatus "active" ; cascade:allergyCriticality "high" .
:peanutFromDocumentRevision a cascade:Revision ; cascade:revisionOf :peanutFromDocument ;
    cascade:version :peanutFromDocumentVersion ; prov:wasDerivedFrom :peanutDocument ; prov:wasGeneratedBy :northImport ;
    prov:generatedAtTime "2026-01-01T00:00:05Z"^^xsd:dateTime .

:peanutEntered a cascade:AllergyOrIntolerance .
:peanutEnteredVersion prov:specializationOf :peanutEntered ; cascade:patient :subject ; cascade:allergen "Peanut allergy" ;
    cascade:allergenCode <http://snomed.info/id/91935009> .
:peanutEnteredRevision a cascade:Revision ; cascade:revisionOf :peanutEntered ; cascade:version :peanutEnteredVersion ;
    prov:wasGeneratedBy :session ; prov:generatedAtTime "2026-02-01T00:00:05Z"^^xsd:dateTime .

:latex a cascade:AllergyOrIntolerance .
:latexVersion prov:specializationOf :latex ; cascade:patient :subject ; cascade:allergen "Latex" ;
    cascade:clinicalStatus "inactive" .
:latexRevision a cascade:Revision ; cascade:revisionOf :latex ; cascade:version :latexVersion ;
    prov:wasDerivedFrom :latexDocument ; prov:wasGeneratedBy :northImport ;
    prov:generatedAtTime "2026-01-01T00:00:05Z"^^xsd:dateTime .
