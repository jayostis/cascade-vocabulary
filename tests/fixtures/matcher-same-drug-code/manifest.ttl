@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "matcher-same-drug-code" ;
  rdfs:comment "A version of a product ingredient table mapping a product to its ingredient and the ingredient to itself, and a version of a brand generics table mapping a code of another medication; medications of the product, of the product and its ingredient, of the ingredient alone, of one NDC and of another; two records of a code only a version of another kind and a pod file map." ;
  mf:entries (
    <#same-drug-code>
  ) .

<#same-drug-code> a mf:QueryEvaluationTest ;
  mf:name "same-drug-code" ;
  rdfs:comment "Records of the product join, and any record that also carries it, and the two fills of one NDC join, each with the product ingredient table's version only; records sharing only the ingredient, one product and one NDC, two NDCs, or a code only another kind's version or a pod file maps, do not." ;
  mf:action [ qt:query <../../../queries/v1-draft/matcher/same-drug-code.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <same-drug-code.srj> .
