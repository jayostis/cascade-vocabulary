@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "superseded-by-a-retracted-judgment" ;
  rdfs:comment "A machine's SameCode made with the current reference version, a person's Same superseding it, and a retraction of the person's Same." ;
  mf:entries (
    <#whether-it-counts-everyday>
    <#whether-it-counts-for-export>
  ) .

<#whether-it-counts-everyday> a mf:QueryEvaluationTest ;
  mf:name "whether-it-counts-everyday" ;
  rdfs:comment "Under everyday, a retracted judgment supersedes nothing: the machine's Same it superseded counts again, though the supersession is still shown." ;
  mf:action [ qt:query <../../../queries/v1-draft/questions/judgment/Whether%20it%20counts.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <whether-it-counts.srj> .

<#whether-it-counts-for-export> a mf:QueryEvaluationTest ;
  mf:name "whether-it-counts-for-export" ;
  rdfs:comment "Under export too, a retracted judgment supersedes nothing." ;
  mf:action [ qt:query <../../../queries/v1-draft/questions/judgment/Whether%20it%20counts.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/export.rq> ] ;
  mf:result <whether-it-counts.srj> .
