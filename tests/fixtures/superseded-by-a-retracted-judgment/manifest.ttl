@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "superseded-by-a-retracted-judgment" ;
  rdfs:comment "A person's Same, superseded by a later Same of the person's, and a retraction of that later Same." ;
  mf:entries (
    <#whether-it-counts-everyday>
    <#whether-it-counts-for-export>
  ) .

<#whether-it-counts-everyday> a mf:QueryEvaluationTest ;
  mf:name "whether-it-counts-everyday" ;
  rdfs:comment "Under everyday, a retracted judgment supersedes nothing: the judgment it superseded counts again, though the supersession is still shown." ;
  mf:action [ qt:query <../../../queries/questions/judgment/Whether%20it%20counts.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <whether-it-counts.srj> .

<#whether-it-counts-for-export> a mf:QueryEvaluationTest ;
  mf:name "whether-it-counts-for-export" ;
  rdfs:comment "Under export too, a retracted judgment supersedes nothing." ;
  mf:action [ qt:query <../../../queries/questions/judgment/Whether%20it%20counts.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/export.rq> ] ;
  mf:result <whether-it-counts.srj> .
