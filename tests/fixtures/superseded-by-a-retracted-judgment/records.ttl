@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:record a cascade:AllergyOrIntolerance .
:recordVersion prov:specializationOf :record ; cascade:patient :subject ; cascade:allergen "Peanut" .
:recordRevision a cascade:Revision ; cascade:revisionOf :record ; cascade:version :recordVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:other a cascade:AllergyOrIntolerance .
:otherVersion prov:specializationOf :other ; cascade:patient :subject ; cascade:allergen "Peanut oil" .
:otherRevision a cascade:Revision ; cascade:revisionOf :other ; cascade:version :otherVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:rules a cascade:ReferenceSeries ; rdfs:label "Rules" .
:rules-1 prov:specializationOf :rules ; pav:version "1" .
:rules-1SameCodeRule cascade:rowOfRuleListVersion :rules-1 ; cascade:matcherRule cascade:SameCodeRule ;
    cascade:queryHash :sameCodeQuery .
