@prefix : <urn:x:> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:matcher a prov:SoftwareAgent ; rdfs:label "Matcher" .

:machineSame a jdg:Judgment ; jdg:verdict jdg:Same ; jdg:justification jdg:SameCode ; prov:hadMember :record , :other ;
    prov:used :rules-1 ; prov:wasAttributedTo :matcher ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:superseding a jdg:Judgment ; jdg:verdict jdg:Same ; prov:hadMember :record , :other ; npx:supersedes :machineSame ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:retraction a jdg:Judgment ; npx:retracts :superseding ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
