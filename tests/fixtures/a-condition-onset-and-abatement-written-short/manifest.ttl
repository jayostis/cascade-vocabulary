@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-condition-onset-and-abatement-written-short" ;
  rdfs:comment "An active migraine whose onset its source wrote to the hour, 2020021409, and a resolved ankle sprain whose abatement it wrote to the hour, 2021032010, each held padded to the second with the node saying so." ;
  mf:entries (
    <#its-padded-times>
    <#my-active-conditions>
  ) .

<#its-padded-times> a mf:QueryEvaluationTest ;
  mf:name "its-padded-times" ;
  rdfs:comment "An onset or abatement its source wrote to the hour keeps, in the view, the node saying so and what was written, on the entry and on its member's values, each named after its holder, -padded- and the property." ;
  mf:action [ qt:query <its-padded-times.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <its-padded-times.srj> .

<#my-active-conditions> a mf:QueryEvaluationTest ;
  mf:name "my-active-conditions" ;
  rdfs:comment "The migraine alone is active, shown with its onset as the record holds it, padded, with no zone." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20conditions.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-conditions.srj> .
