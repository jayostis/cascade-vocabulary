@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .
cascade:CascadeMatcher a prov:SoftwareAgent ; rdfs:label "Cascade matcher" .

:sameXAfterTheRename a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameCode ; prov:hadMember :x1 , :x2 ;
    prov:wasDerivedFrom :x1Version , :x2Version ; cascade:matcherRule cascade:SameCodeRule ; prov:wasAttributedTo cascade:CascadeMatcher .
:sameXAfterTheRenameUnderRules1 a cascade:MatcherJudgmentAssertion ; cascade:assertedJudgment :sameXAfterTheRename ; cascade:assertedUnderRuleListVersion :rules1 .

:findingAfterTheRename a cascade:FindingForReview ; oa:hasBody cascade:MatcherJudgmentsNoLongerReached ; oa:motivatedBy oa:classifying ; cascade:noLongerReachedUnderRuleListVersion :rules2 ;
    oa:hasTarget :sameXAfterTheRename .

:acknowledgement a cascade:Judgment ; cascade:verdict cascade:Acknowledged ;
    cascade:answersWarningOfKind cascade:MatcherJudgmentsNoLongerReached ; prov:hadMember :x1 , :x2 ; prov:wasAttributedTo :person ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ; prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
