PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX oa: <http://www.w3.org/ns/oa#>

SELECT ?finding ?judgment ?acknowledged ?judgmentCounts ?joined
WHERE {
  ?finding a cascade:FindingForReview ; oa:hasTarget ?judgment .
  BIND (EXISTS { ?acknowledgement cascade:countsUnderLens true ; cascade:verdict cascade:Acknowledged ; <http://www.w3.org/ns/prov#hadMember> ?finding } AS ?acknowledged)
  BIND (EXISTS { ?judgment cascade:countsUnderLens true } AS ?judgmentCounts)
  BIND (EXISTS { ?judgment <http://www.w3.org/ns/prov#hadMember> ?record , ?other . ?record cascade:currentlySame ?other } AS ?joined)
}
