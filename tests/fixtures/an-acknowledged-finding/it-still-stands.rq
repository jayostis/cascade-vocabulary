PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?finding ?judgment ?acknowledged ?judgmentCounts ?joined
WHERE {
  ?finding a cascade:FindingForReview ; oa:hasBody ?kind ; oa:hasTarget ?judgment .
  BIND (EXISTS { ?acknowledgement cascade:countsUnderLens true ; cascade:verdict cascade:Acknowledged ;
                                  cascade:answersWarningOfKind ?kind ; prov:hadMember ?record , ?other .
                 ?judgment prov:hadMember ?record , ?other .
                 FILTER (?record != ?other) } AS ?acknowledged)
  BIND (EXISTS { ?judgment cascade:countsUnderLens true } AS ?judgmentCounts)
  BIND (EXISTS { ?judgment prov:hadMember ?record , ?other . ?record cascade:currentlySame ?other } AS ?joined)
}
