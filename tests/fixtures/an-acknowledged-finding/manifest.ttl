@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "an-acknowledged-finding" ;
  rdfs:comment "A rule list whose version 2 revises version 1 and changes the same code query, a matcher's same code claim asserted under version 1 alone, version 2's finding naming it, and a person's Acknowledged whose member is the finding." ;
  mf:entries (
    <#off-the-review-page>
    <#it-still-stands>
  ) .

<#off-the-review-page> a mf:QueryEvaluationTest ;
  mf:name "off-the-review-page" ;
  rdfs:comment "The acknowledged finding's pair is not listed, by the finding nor alone, though its records are in two entries." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <off-the-review-page.srj> .

<#it-still-stands> a mf:QueryEvaluationTest ;
  mf:name "it-still-stands" ;
  rdfs:comment "The finding still names its claim, the acknowledgement counts, and nothing else changes: the claim does not count and its records are not joined." ;
  mf:action [ qt:query <it-still-stands.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <it-still-stands.srj> .
