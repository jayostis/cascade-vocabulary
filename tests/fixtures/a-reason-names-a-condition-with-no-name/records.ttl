@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:unnamed a cascade:ProblemOrDiagnosis .
:unnamedVersion prov:specializationOf :unnamed ; cascade:patient :subject ; cascade:clinicalStatus "active" .
:unnamedRevision a cascade:Revision ; cascade:revisionOf :unnamed ; cascade:version :unnamedVersion ;
