:encounters2022 a cascade:ClinicalNoteOrDocument .
<urn:x:encounters2022Version> prov:specializationOf :encounters2022 ;
    cascade:noteOrDocumentType <http://loinc.org/rdf/46240-8> ;
    cascade:narrativeText "Encounter\nDate\nDepartment\nProvider\nDiagnosis\nVisit summary\nOffice visit, follow-up\nNovember 15, 2022\nKestrel Harbor Internal Medicine\nSusan Park, MD\nHyperlipidemia\nLDL 93 on atorvastatin 20 mg. ALT 31, normal. Tolerating well. Continue. Annual visit in the new year.\nOffice visit, follow-up\nAugust 9, 2022\nKestrel Harbor Internal Medicine\nSusan Park, MD\nHyperlipidemia; prediabetes\nLDL 168 after six months of diet changes. Start atorvastatin 20 mg daily. Recheck lipids and liver tests in 3 months.\nOffice visit, annual physical\nJanuary 25, 2022\nKestrel Harbor Internal Medicine\nSusan Park, MD\nRoutine adult health examination; prediabetes; elevated LDL\nAnnual physical. LDL 148, A1c 6.0%. Discussed a statin; she prefers to work on diet for six months first. Repeat lipids in 6 months.\nOffice visit, annual physical\nJanuary 19, 2021\nKestrel Harbor Internal Medicine\nSusan Park, MD\nRoutine adult health examination; prediabetes\nAnnual physical. A1c 5.9%. LDL 137. Ten-year cardiovascular risk low; no statin. Continue lifestyle measures.\nOffice visit, annual physical\nJanuary 14, 2020\nKestrel Harbor Internal Medicine\nSusan Park, MD\nRoutine adult health examination; prediabetes\nAnnual physical. Fasting glucose 104 and hemoglobin A1c 5.8%: prediabetes. Diet and activity counselling. LDL 131. Tdap given. Screening mammogram ordered." ;
    cascade:noteOrDocumentDate "2022-11-28T19:33:07Z"^^xsd:dateTime .
:encounters2022Revision a cascade:Revision ; cascade:revisionOf :encounters2022 ; cascade:version <urn:x:encounters2022Version> ;
    prov:wasDerivedFrom :encounters2022Download ;
    prov:generatedAtTime "2026-11-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2022-11-28T19:33:07Z"^^xsd:dateTime .

:encounters2024 a cascade:ClinicalNoteOrDocument .
<urn:x:encounters2024Version> prov:specializationOf :encounters2024 ;
    cascade:noteOrDocumentType <http://loinc.org/rdf/46240-8> ;
    cascade:narrativeText "Encounter\nDate\nDepartment\nProvider\nDiagnosis\nVisit summary\nOffice visit, follow-up\nJanuary 23, 2024\nKestrel Harbor Internal Medicine\nSusan Park, MD\nEssential hypertension; prediabetes\nMuscle aches resolved off atorvastatin. Blood pressure at goal on lisinopril; potassium 4.4. A1c 6.3%. Discuss a different statin at the annual visit.\nOffice visit\nNovember 14, 2023\nKestrel Harbor Internal Medicine\nSusan Park, MD\nMyalgia, statin-related\nAching in the thighs and shoulders for about two months. CK 148, normal. Likely statin-related muscle symptoms: stop atorvastatin. Reassess in 4-6 weeks.\nOffice visit, annual physical\nJune 15, 2023\nKestrel Harbor Internal Medicine\nSusan Park, MD\nEssential hypertension; hyperlipidemia; prediabetes\nBlood pressure 152/96 today and 148/94 at the May nurse check; home readings similar: essential hypertension. Start lisinopril 10 mg daily; BMP in 3 weeks. Urine albumin/creatinine ratio 18 mg/g. LDL 99 on atorvastatin. A1c 6.1%.\nOffice visit, follow-up\nNovember 15, 2022\nKestrel Harbor Internal Medicine\nSusan Park, MD\nHyperlipidemia\nLDL 93 on atorvastatin 20 mg. ALT 31, normal. Tolerating well. Continue. Annual visit in the new year.\nOffice visit, follow-up\nAugust 9, 2022\nKestrel Harbor Internal Medicine\nSusan Park, MD\nHyperlipidemia; prediabetes\nLDL 168 after six months of diet changes. Start atorvastatin 20 mg daily. Recheck lipids and liver tests in 3 months.\nOffice visit, annual physical\nJanuary 25, 2022\nKestrel Harbor Internal Medicine\nSusan Park, MD\nRoutine adult health examination; prediabetes; elevated LDL\nAnnual physical. LDL 148, A1c 6.0%. Discussed a statin; she prefers to work on diet for six months first. Repeat lipids in 6 months.\nOffice visit, annual physical\nJanuary 19, 2021\nKestrel Harbor Internal Medicine\nSusan Park, MD\nRoutine adult health examination; prediabetes\nAnnual physical. A1c 5.9%. LDL 137. Ten-year cardiovascular risk low; no statin. Continue lifestyle measures.\nOffice visit, annual physical\nJanuary 14, 2020\nKestrel Harbor Internal Medicine\nSusan Park, MD\nRoutine adult health examination; prediabetes\nAnnual physical. Fasting glucose 104 and hemoglobin A1c 5.8%: prediabetes. Diet and activity counselling. LDL 131. Tdap given. Screening mammogram ordered." ;
    cascade:noteOrDocumentDate "2024-02-03T17:11:40Z"^^xsd:dateTime .
:encounters2024Revision a cascade:Revision ; cascade:revisionOf :encounters2024 ; cascade:version <urn:x:encounters2024Version> ;
    prov:wasDerivedFrom :encounters2024Download ;
    prov:generatedAtTime "2026-11-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2024-02-03T17:11:40Z"^^xsd:dateTime .

