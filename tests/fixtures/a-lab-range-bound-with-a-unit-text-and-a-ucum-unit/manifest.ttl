@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-lab-range-bound-with-a-unit-text-and-a-ucum-unit" ;
  rdfs:comment "A ferritin whose reference range runs from 30 to 400, each bound with the UCUM unit ng/mL and the text its source wrote for the unit, nanograms per millilitre." ;
  mf:entries (
    <#my-lab-results>
  ) .

<#my-lab-results> a mf:QueryEvaluationTest ;
  mf:name "my-lab-results" ;
  rdfs:comment "A bound is shown with the unit as its source wrote it rather than its UCUM code, so the range reads 30 nanograms per millilitre to 400 nanograms per millilitre." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20lab%20results.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-lab-results.srj> .
