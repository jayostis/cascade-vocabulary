    cascade:resultValueText "45" ; cascade:workflowStatus "final" ;
    cascade:resultClinicallyRelevantTime "2025-05-02T09:00:00Z"^^xsd:dateTime ;
    cascade:referenceRangeLow <urn:x:ferritinVersion#reference-low> ;
    cascade:referenceRangeHigh <urn:x:ferritinVersion#reference-high> .
<urn:x:ferritinVersion#reference-low> cascade:decimalValue "30"^^xsd:decimal ; cascade:writtenValue "30" ;
    cascade:ucumUnit "ng/mL" ; cascade:unitText "nanograms per millilitre" .
<urn:x:ferritinVersion#reference-high> cascade:decimalValue "400"^^xsd:decimal ; cascade:writtenValue "400" ;
    cascade:ucumUnit "ng/mL" ; cascade:unitText "nanograms per millilitre" .
:ferritinRevision a cascade:Revision ; cascade:revisionOf :ferritin ; cascade:version :ferritinVersion ;
