@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .
:earlierAcknowledged a cascade:Judgment ; cascade:verdict cascade:Acknowledged ; prov:hadMember :earlierClockBehind ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2025-12-29T00:00:00Z"^^xsd:dateTime .
