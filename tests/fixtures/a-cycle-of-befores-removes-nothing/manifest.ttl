@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-cycle-of-befores-removes-nothing" ;
  rdfs:comment "A condition stamped active in January and resolved in February, and two people's Befores ordering its two revisions both ways." ;
  mf:entries (
    <#the-current-revision>
    <#what-needs-review>
  ) .

<#the-current-revision> a mf:QueryEvaluationTest ;
  mf:name "the-current-revision" ;
  rdfs:comment "Befores that form a cycle remove nothing, so the clocks pick the February state." ;
  mf:action [ qt:query <the-current-revision.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-current-revision.srj> .

<#what-needs-review> a mf:QueryEvaluationTest ;
  mf:name "what-needs-review" ;
  rdfs:comment "The pair the Befores order both ways is listed once." ;
  mf:action [ qt:query <../../../queries/questions/record/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-needs-review.srj> .
