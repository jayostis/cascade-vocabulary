@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-report-conclusion-code" ;
  rdfs:comment "A cobalamin report whose conclusion, Low., its source also gave as a SNOMED CT code." ;
  mf:entries (
    <#its-conclusion-code>
  ) .

<#its-conclusion-code> a mf:QueryEvaluationTest ;
  mf:name "its-conclusion-code" ;
  rdfs:comment "A report's conclusion code is shown by the view on the entry and on its member's values." ;
  mf:action [ qt:query <its-conclusion-code.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <its-conclusion-code.srj> .
