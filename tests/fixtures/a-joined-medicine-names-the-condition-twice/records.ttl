@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:asthma a cascade:ProblemOrDiagnosis .
:asthmaVersion prov:specializationOf :asthma ; cascade:patient :subject ; cascade:conditionName "Asthma" ; cascade:clinicalStatus "active" .
:asthmaRevision a cascade:Revision ; cascade:revisionOf :asthma ; cascade:version :asthmaVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:prescribed a cascade:PrescribedOrReportedMedication .
:prescribedVersion prov:specializationOf :prescribed ; cascade:patient :subject ; cascade:drugName "Albuterol inhaler" ;
    cascade:prescribedOrReported "prescribed" ; cascade:workflowStatus "active" ; cascade:reasonCondition :asthma .
:prescribedRevision a cascade:Revision ; cascade:revisionOf :prescribed ; cascade:version :prescribedVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:reported a cascade:PrescribedOrReportedMedication .
:reportedVersion prov:specializationOf :reported ; cascade:patient :subject ; cascade:drugName "Albuterol inhaler" ;
    cascade:prescribedOrReported "reportedUse" ; cascade:workflowStatus "active" ; cascade:reasonCondition :asthma .
:reportedRevision a cascade:Revision ; cascade:revisionOf :reported ; cascade:version :reportedVersion ;
    prov:generatedAtTime "2026-01-02T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-02T00:00:00Z"^^xsd:dateTime .
