@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:sameOfThree a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :a3 , :a1 , :a2 ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:differentPair a cascade:Judgment ; cascade:verdict cascade:Different ; prov:hadMember :a1 , :a2 ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
