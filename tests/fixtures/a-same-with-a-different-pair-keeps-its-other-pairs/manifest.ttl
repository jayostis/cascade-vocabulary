@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-same-with-a-different-pair-keeps-its-other-pairs" ;
  rdfs:comment "A person's Same of three allergies whose least two the person also judged different." ;
  mf:entries (
    <#pairs>
    <#entries>
  ) .

<#pairs> a mf:QueryEvaluationTest ;
  mf:name "pairs" ;
  rdfs:comment "The Same holds a currently different pair, so it joins every other pair of its members, both ways, and not that pair: a3 with a1 and with a2." ;
  mf:action [ qt:query <pairs.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <pairs.srj> .

<#entries> a mf:QueryEvaluationTest ;
  mf:name "entries" ;
  rdfs:comment "The different pair is still one entry through the third member, named from a1." ;
  mf:action [ qt:query <entries.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <entries.srj> .
