@prefix : <urn:x:> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

:groups a rec:ReferenceSeries ; rdfs:label "Vaccine groups" ; rec:tableKind rec:VaccineGroups .
:groups-1 prov:specializationOf :groups ; pav:version "1" .

:names a rec:ReferenceSeries ; rdfs:label "Vaccine names" ; rec:tableKind rec:CodeNames .
:names-1 prov:specializationOf :names ; pav:version "1" .
