@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:pharmacy a cascade:Organization .
:pharmacyVersion prov:specializationOf :pharmacy ; foaf:name "Harbor Pharmacy" .
:pharmacyRevision a cascade:Revision ; cascade:revisionOf :pharmacy ; cascade:version :pharmacyVersion ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:fills a prov:Entity ; pav:retrievedOn "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    prov:wasAttributedTo :pharmacy ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :pharmacy ; prov:hadRole cascade:AuthorRole ] ] .

:filled a cascade:MedicationDispense .
:filledVersion prov:specializationOf :filled ; cascade:patient :subject ; cascade:drugName "metformin hydrochloride 500 MG Oral Tablet" ;
    cascade:workflowStatus "completed" ; cascade:dispensePreparedTime "2026-01-11"^^xsd:date .
:filledRevision a cascade:Revision ; cascade:revisionOf :filled ; cascade:version :filledVersion ; prov:wasDerivedFrom :fills ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-02-01T00:00:00Z"^^xsd:dateTime .

:filledCopy a cascade:MedicationDispense .
:filledCopyVersion prov:specializationOf :filledCopy ; cascade:patient :subject ; cascade:drugName "metformin 500 mg tablet" ;
    cascade:workflowStatus "completed" ; cascade:dispensePreparedTime "2026-01-11"^^xsd:date .
:filledCopyRevision a cascade:Revision ; cascade:revisionOf :filledCopy ; cascade:version :filledCopyVersion ; prov:wasDerivedFrom :fills ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-02-01T00:00:00Z"^^xsd:dateTime .
