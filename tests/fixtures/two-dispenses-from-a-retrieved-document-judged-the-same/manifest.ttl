@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "two-dispenses-from-a-retrieved-document-judged-the-same" ;
  rdfs:comment "Two completed dispenses of metformin from one record a pharmacy wrote, retrieved, which the person judged the same." ;
  mf:entries (
    <#the-medication-dispenses-view>
  ) .

<#the-medication-dispenses-view> a mf:QueryEvaluationTest ;
  mf:name "the-medication-dispenses-view" ;
  rdfs:comment "The two dispenses are one entry of two members." ;
  mf:action [ qt:query <the-medication-dispenses-view.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-medication-dispenses-view.srj> .
