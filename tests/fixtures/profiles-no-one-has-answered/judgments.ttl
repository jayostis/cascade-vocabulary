@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parent a prov:Person .

:aboutSettled a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :settled ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ;
    prov:wasAttributedTo :parent ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :parent ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
:notAboutDenied a cascade:Judgment ; cascade:verdict cascade:NotAbout ; prov:hadMember :denied ; cascade:subject :subject ;
    prov:wasAttributedTo :parent ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :parent ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
:aboutRetracted a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :unclaimedAgain ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ;
    prov:wasAttributedTo :parent ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :parent ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
:retraction a prov:Activity ; prov:invalidated :aboutRetracted ;
    prov:wasAssociatedWith :parent ; prov:qualifiedAssociation [ prov:agent :parent ; prov:hadRole cascade:PatientRole ] ;
    prov:startedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
