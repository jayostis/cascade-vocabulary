@prefix : <urn:x:> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a rec:Subject .

:allergy a health:AllergyRecord .
:allergyVersion prov:specializationOf :allergy ; rec:patient :subject ; health:allergen "Penicillin" .
:allergyRevision a rec:Revision ; rec:revisionOf :allergy ; rec:version :allergyVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:condition a health:ConditionRecord .
:conditionVersion prov:specializationOf :condition ; rec:patient :subject ; health:conditionName "Penicillin allergy" .
:conditionRevision a rec:Revision ; rec:revisionOf :condition ; rec:version :conditionVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
