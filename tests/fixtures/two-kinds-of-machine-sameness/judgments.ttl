@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cascade:CascadeMatcher a prov:SoftwareAgent ; rdfs:label "Cascade matcher" .

:byCode a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameCodeAndDate ; prov:hadMember :flu1 , :flu2 ;
    prov:used :flu1Version , :flu2Version ;
    cascade:matcherRule cascade:SameCodeAndDateRule ; prov:wasAttributedTo cascade:CascadeMatcher .
:byMappedCode a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameMappedCodeAndDate ;
    prov:hadMember :flu2 , :flu3 ; prov:used :flu2Version , :flu3Version ;
    cascade:matcherRule cascade:SameMappedCodeAndDateRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:byCodeUnderrules1 a cascade:ClaimAssertion ; cascade:assertedClaim :byCode ;
    cascade:assertedUnderRuleListVersion :rules1 .

:byMappedCodeUnderrules1 a cascade:ClaimAssertion ; cascade:assertedClaim :byMappedCode ;
    cascade:assertedUnderRuleListVersion :rules1 .

:rules a cascade:ReferenceSeries ; rdfs:label "Rules" .
:rules1 prov:specializationOf :rules ; pav:version "1" .
:rules1SameCodeAndDateRule cascade:rowOfRuleListVersion :rules1 ; cascade:matcherRule cascade:SameCodeAndDateRule ;
    cascade:queryHash :sameCodeAndDateQuery .
:rules1SameMappedCodeAndDateRule cascade:rowOfRuleListVersion :rules1 ; cascade:matcherRule cascade:SameMappedCodeAndDateRule ;
    cascade:queryHash :sameMappedCodeAndDateQuery .

:grown a cascade:Judgment ; cascade:verdict cascade:Same ;
    cascade:justification cascade:SameNoteTypeAndTextGrownWithinOneOrganization ; prov:hadMember :note1 , :note2 ;
    prov:used :note1Version , :note2Version ;
    cascade:matcherRule cascade:SameNoteTypeAndTextGrownWithinOneOrganizationRule ; prov:wasAttributedTo cascade:CascadeMatcher .
:sameText a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameNoteTypeAndText ;
    prov:hadMember :note2 , :note3 ; prov:used :note2Version , :note3Version ;
    cascade:matcherRule cascade:SameNoteTypeAndTextRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:grownUnderrules1 a cascade:ClaimAssertion ; cascade:assertedClaim :grown ;
    cascade:assertedUnderRuleListVersion :rules1 .

:sameTextUnderrules1 a cascade:ClaimAssertion ; cascade:assertedClaim :sameText ;
    cascade:assertedUnderRuleListVersion :rules1 .

:rules1SameNoteTypeAndTextGrownWithinOneOrganizationRule cascade:rowOfRuleListVersion :rules1 ;
    cascade:matcherRule cascade:SameNoteTypeAndTextGrownWithinOneOrganizationRule ; cascade:queryHash :grownQuery .
:rules1SameNoteTypeAndTextRule cascade:rowOfRuleListVersion :rules1 ; cascade:matcherRule cascade:SameNoteTypeAndTextRule ;
    cascade:queryHash :sameTextQuery .
