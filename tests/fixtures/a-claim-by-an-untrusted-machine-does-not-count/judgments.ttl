@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cascade:CascadeMatcher a prov:SoftwareAgent ; rdfs:label "Cascade matcher" .
:otherMatcher a prov:SoftwareAgent ; rdfs:label "Another app's matcher" .

:byCascade a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameCode ;
    prov:hadMember :c1 , :c2 ; prov:used :c1Version , :c2Version ;
    cascade:matcherRule cascade:SameCodeRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:byOther a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameCode ;
    prov:hadMember :c1 , :c2 ; prov:used :c1Version , :c2Version ;
    cascade:matcherRule cascade:SameCodeRule ; prov:wasAttributedTo :otherMatcher .

:byCascadeUnderRules1 a cascade:ClaimAssertion ; cascade:assertedClaim :byCascade ;
    cascade:assertedUnderRuleListVersion :rules1 .

:byOtherUnderRules1 a cascade:ClaimAssertion ; cascade:assertedClaim :byOther ;
    cascade:assertedUnderRuleListVersion :rules1 .
