@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "labels-entries-as-their-views-name-them" ;
  rdfs:comment "An allergy, and its view's graph holding its entry as a runtime's dataset does (view.trig): written <#4f2e> in the file, so resolved against the view's address in the graph." ;
  mf:entries (
    <#the-entries-labelled>
  ) .

<#the-entries-labelled> a mf:QueryEvaluationTest ;
  mf:name "the-entries-labelled" ;
  rdfs:comment "Each entry is labelled as the view's graph names it: the entry resolved against the view's address, and the placeholder the allergies view built here adds to that graph, since these fixtures build views without renaming their entries." ;
  mf:action [ qt:query <the-entries-labelled.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-entries-labelled.srj> .
