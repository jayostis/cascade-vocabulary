@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "labels-entries-as-their-views-name-them" ;
  rdfs:comment "A condition with an onset: its entry is a placeholder in the derived state and, in the conditions view's graph, resolved against the view's address." ;
  mf:entries (
    <#the-entries-labelled>
  ) .

<#the-entries-labelled> a mf:QueryEvaluationTest ;
  mf:name "the-entries-labelled" ;
  rdfs:comment "The entry the view names is labelled, with the date of the member its date is taken from; the placeholder, which no view holds, is not." ;
  mf:action [ qt:query <the-entries-labelled.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-entries-labelled.srj> .
