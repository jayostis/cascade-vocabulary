@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-not-about-for-another-subject-outranks-no-about" ;
  rdfs:comment "Over one profile, a parent's About for the subject, another parent's NotAbout for the subject, and the first parent's NotAbout after the About for another subject." ;
  mf:entries (
    <#what-needs-review>
  ) .

<#what-needs-review> a mf:QueryEvaluationTest ;
  mf:name "what-needs-review" ;
  rdfs:comment "The profile is held back, the first parent's About standing against the other's NotAbout: their later NotAbout is for another subject, so it outranks nothing." ;
  mf:action [ qt:query <../../../queries/questions/profile/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-needs-review.srj> .
