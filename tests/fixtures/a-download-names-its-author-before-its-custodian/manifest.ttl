@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-download-names-its-author-before-its-custodian" ;
  rdfs:comment "Two allergies from downloads that state no address: one names an author and a different custodian, one names only a custodian." ;
  mf:entries (
    <#the-record-version-revision-and-document-labels>
  ) .

<#the-record-version-revision-and-document-labels> a mf:QueryEvaluationTest ;
  mf:name "the-record-version-revision-and-document-labels" ;
  rdfs:comment "A download that names an author and a different custodian is named by its author, whichever sorts first; one that names only a custodian is named by it." ;
  mf:action [ qt:query <the-record-version-revision-and-document-labels.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-record-version-revision-and-document-labels.srj> .
