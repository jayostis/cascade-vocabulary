@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-lab-result-ruled-out-at-source-states-no-status" ;
  rdfs:comment "A troponin whose one record states no workflow status, only a verification status of refuted." ;
  mf:entries (
    <#my-lab-results>
  ) .

<#my-lab-results> a mf:QueryEvaluationTest ;
  mf:name "my-lab-results" ;
  rdfs:comment "The entry takes its status from the record that rules it out, which states no workflow status, so the troponin is shown with no status." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20lab%20results.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-lab-results.srj> .
