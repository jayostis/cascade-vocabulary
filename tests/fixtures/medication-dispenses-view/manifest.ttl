@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "medication-dispenses-view" ;
  rdfs:comment "A prescription, a completed dispense of it coded in RxNorm and NDC, handed over at a time its pharmacy wrote only to the day, and a dispense of another drug being prepared, which names no prescription." ;
  mf:entries (
    <#the-medication-dispenses-view>
  ) .

<#the-medication-dispenses-view> a mf:QueryEvaluationTest ;
  mf:name "the-medication-dispenses-view" ;
  rdfs:comment "Each entry takes the name, codes, times and the entry of the prescription it fills of its lead, and the status and its lifecycle class of the member chosen for status; the time written to the day keeps a padded node; a dispense naming no prescription names none." ;
  mf:action [ qt:query <the-medication-dispenses-view.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-medication-dispenses-view.srj> .
