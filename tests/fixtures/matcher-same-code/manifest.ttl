@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "matcher-same-code" ;
  rdfs:comment "Two allergies sharing an RxNorm allergen code; two procedures sharing a SNOMED CT code on different dates; an allergy and a condition sharing a code; and two allergies that shared a code only before one was revised." ;
  mf:entries (
    <#same-code>
  ) .

<#same-code> a mf:QueryEvaluationTest ;
  mf:name "same-code" ;
  rdfs:comment "Records of one kind whose current versions share a code match whatever their dates; records of two kinds, or sharing a code only through an earlier version, do not." ;
  mf:action [ qt:query <../../../queries/matcher/same-code.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ;
              cascade:boundRecord <urn:x:allergyB> ,
                                  <urn:x:allergyOfOneKind> ,
                                  <urn:x:conditionOfAnother> ,
                                  <urn:x:procedureB> ,
                                  <urn:x:revisedAway> ,
                                  <urn:x:stillThere> ] ;
  mf:result <same-code.srj> .
