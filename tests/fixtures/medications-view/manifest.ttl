@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "medications-view" ;
  rdfs:comment "A medication entry joining a prescription and, later, a list entry stating no status and no date; and a stopped medication with its end, a completed one without, and a stopped member followed by a newer active one, which takes no end." ;
  mf:entries (
    <#the-medications-view>
    <#my-active-medications>
    <#my-medication-history>
  ) .

<#the-medications-view> a mf:QueryEvaluationTest ;
  mf:name "the-medications-view" ;
  rdfs:comment "Each entry takes the name and code of its latest member, the status of the member chosen for status, the start of the member chosen for the date, and every intent a member states." ;
  mf:action [ qt:query <the-medications-view.rq> ;
              rec:lens <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-medications-view.srj> .

<#my-active-medications> a mf:QueryEvaluationTest ;
  mf:name "my-active-medications" ;
  rdfs:comment "Only the active entry, with its code, its start and how many records it joins." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20active%20medications.rq> ;
              rec:lens <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-active-medications.srj> .

<#my-medication-history> a mf:QueryEvaluationTest ;
  mf:name "my-medication-history" ;
  rdfs:comment "Every entry whatever its status; the end date on the stopped entry alone, none on the completed one that states no stop." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20medication%20history.rq> ;
              rec:lens <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-medication-history.srj> .
