@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:first a prov:Activity ; rdfs:label "First download" ; prov:startedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
:second a prov:Activity ; rdfs:label "Second download" ; prov:startedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:a a cascade:AllergyOrIntolerance .
:aV1 prov:specializationOf :a ; cascade:allergen "Peanut" .
:aV2 prov:specializationOf :a ; cascade:allergen "Peanuts" .
:aR1 a cascade:Revision ; cascade:revisionOf :a ; cascade:version :aV1 ; prov:wasGeneratedBy :first ;
    prov:generatedAtTime "2026-01-01T00:00:05Z"^^xsd:dateTime .
:aR2 a cascade:Revision ; cascade:revisionOf :a ; cascade:version :aV2 ; prov:wasRevisionOf :aR1 ; prov:wasGeneratedBy :second ;
    prov:generatedAtTime "2026-02-01T00:00:05Z"^^xsd:dateTime .

:b a cascade:AllergyOrIntolerance .
:bV1 prov:specializationOf :b ; cascade:allergen "Latex" .
:bR1 a cascade:Revision ; cascade:revisionOf :b ; cascade:version :bV1 ; prov:wasGeneratedBy :second ;
    prov:generatedAtTime "2026-02-01T00:00:05Z"^^xsd:dateTime .
