@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "variant-interpretations-view" ;
  rdfs:comment "One variant of two members, a panel's and an exome's; a second variant. A 2022 report of uncertain significance and a 2024 report of likely pathogenic on the first, a 2024 report whose answer is not one of the five ACMG values, a benign report on the second, and a report that names no variant." ;
  mf:entries (
    <#the-variant-interpretations-view>
    <#what-each-report-says-of-a-variant>
  ) .

<#the-variant-interpretations-view> a mf:QueryEvaluationTest ;
  mf:name "the-variant-interpretations-view" ;
  rdfs:comment "Each entry takes the classification and date of its latest member and the entry of the variant its member interprets, so the three reports of the first variant name one entry, and the report that names no variant names none." ;
  mf:action [ qt:query <the-variant-interpretations-view.rq> ;
              rec:lens <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-variant-interpretations-view.srj> .

<#what-each-report-says-of-a-variant> a mf:QueryEvaluationTest ;
  mf:name "what-each-report-says-of-a-variant" ;
  rdfs:comment "One row for each report that names a variant, newest first within a variant, without a classification for the answer that is none of the five, and none for the report that names no variant." ;
  mf:action [ qt:query <../../../queries/questions/pod/What%20each%20report%20says%20of%20a%20variant.rq> ;
              rec:lens <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-each-report-says-of-a-variant.srj> .
