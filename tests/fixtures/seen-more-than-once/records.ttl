@prefix : <urn:x:> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a rec:Subject .

:northImport a prov:Activity ; rdfs:label "Northgate download" ;
    prov:startedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
:northLaterImport a prov:Activity ; rdfs:label "Northgate later download" ;
    prov:startedAtTime "2026-01-03T00:00:00Z"^^xsd:dateTime .
:southImport a prov:Activity ; rdfs:label "Southview download" ;
    prov:startedAtTime "2026-01-02T00:00:00Z"^^xsd:dateTime .
:session a prov:Activity ; rdfs:label "Entry session" ; prov:startedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:penicillinNorth a health:AllergyRecord .
:penicillinNorthVersion prov:specializationOf :penicillinNorth ; rec:patient :subject ; health:allergen "Penicillin" .
:penicillinNorthRevision a rec:Revision ; rec:revisionOf :penicillinNorth ; rec:version :penicillinNorthVersion ;
    prov:wasDerivedFrom :penicillinNorthDocument ; prov:wasGeneratedBy :northImport ;
    prov:generatedAtTime "2026-01-01T00:00:05Z"^^xsd:dateTime .

:penicillinSouth a health:AllergyRecord .
:penicillinSouthVersion prov:specializationOf :penicillinSouth ; rec:patient :subject ; health:allergen "Penicillin" .
:penicillinSouthRevision a rec:Revision ; rec:revisionOf :penicillinSouth ; rec:version :penicillinSouthVersion ;
    prov:wasDerivedFrom :penicillinSouthDocument ; prov:wasGeneratedBy :southImport ;
    prov:generatedAtTime "2026-01-02T00:00:05Z"^^xsd:dateTime .

:penicillinEntered a health:AllergyRecord .
:penicillinEnteredVersion prov:specializationOf :penicillinEntered ; rec:patient :subject ;
    health:allergen "Penicillin" .
:penicillinEnteredRevision a rec:Revision ; rec:revisionOf :penicillinEntered ; rec:version :penicillinEnteredVersion ;
    prov:wasGeneratedBy :session ; prov:generatedAtTime "2026-02-01T00:00:05Z"^^xsd:dateTime .

:asthmaFirst a health:ConditionRecord .
:asthmaFirstVersion prov:specializationOf :asthmaFirst ; rec:patient :subject ; health:conditionName "Asthma" .
:asthmaFirstRevision a rec:Revision ; rec:revisionOf :asthmaFirst ; rec:version :asthmaFirstVersion ;
    prov:wasDerivedFrom :asthmaFirstDocument ; prov:wasGeneratedBy :northImport ;
    prov:generatedAtTime "2026-01-01T00:00:05Z"^^xsd:dateTime .

:asthmaSecond a health:ConditionRecord .
:asthmaSecondVersion prov:specializationOf :asthmaSecond ; rec:patient :subject ; health:conditionName "Asthma" .
:asthmaSecondRevision a rec:Revision ; rec:revisionOf :asthmaSecond ; rec:version :asthmaSecondVersion ;
    prov:wasDerivedFrom :asthmaSecondDocument ; prov:wasGeneratedBy :northLaterImport ;
    prov:generatedAtTime "2026-01-03T00:00:05Z"^^xsd:dateTime .

:latex a health:AllergyRecord .
:latexVersion prov:specializationOf :latex ; rec:patient :subject ; health:allergen "Latex" .
:latexRevision a rec:Revision ; rec:revisionOf :latex ; rec:version :latexVersion ;
    prov:wasDerivedFrom :latexDocument ; prov:wasGeneratedBy :northImport ;
    prov:generatedAtTime "2026-01-01T00:00:05Z"^^xsd:dateTime .
