@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:penicillinNorthDocument prov:wasAttributedTo :northgate ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:hadRole cascade:AuthorRole ; prov:agent :northgate ] ] .
:penicillinSouthDocument prov:wasAttributedTo _:southview ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:hadRole cascade:AuthorRole ; prov:agent _:southview ] ] .
_:southview rdfs:label "Southview" .
:asthmaFirstDocument prov:wasAttributedTo :northgate ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:hadRole cascade:AuthorRole ; prov:agent :northgate ] ] .
:asthmaSecondDocument prov:wasAttributedTo :northgate ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:hadRole cascade:AuthorRole ; prov:agent :northgate ] ] .
:latexDocument prov:wasAttributedTo :northgate ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:hadRole cascade:AuthorRole ; prov:agent :northgate ] ] .
:northgate rdfs:label "Northgate" .
