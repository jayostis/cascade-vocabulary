@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "left-out-at-source" ;
  rdfs:comment "The subject's records whose current versions their source marks entered in error and refuted, a report, a note or document, a note whose content is in error and a medication dispense among those in error, and one whose earlier version it marked entered in error." ;
  mf:entries (
    <#left-out-for-the-status-of-its-current-version>
  ) .

<#left-out-for-the-status-of-its-current-version> a mf:QueryEvaluationTest ;
  mf:name "left-out-for-the-status-of-its-current-version" ;
  rdfs:comment "A record whose current version is entered in error or refuted is left out for that reason, and one whose earlier version was is not." ;
  mf:action [ qt:query <left-out-for-the-status-of-its-current-version.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <left-out-for-the-status-of-its-current-version.srj> .
