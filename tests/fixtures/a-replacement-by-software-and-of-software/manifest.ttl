@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-replacement-by-software-and-of-software" ;
  rdfs:comment "Ana's Erroneous judgment, which a model replaces, and a model's Erroneous judgment, which Ana replaces." ;
  mf:entries (
    <#replaced-by-software-and-of-software>
  ) .

<#replaced-by-software-and-of-software> a mf:QueryEvaluationTest ;
  mf:name "replaced-by-software-and-of-software" ;
  rdfs:comment "The person's judgment the model replaced is listed, as one retracted by anyone but its maker is; the model's own judgment Ana replaced is not, its maker being no person." ;
  mf:action [ qt:query <../../../queries/questions/judgment/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <replaced-by-software-and-of-software.srj> .
