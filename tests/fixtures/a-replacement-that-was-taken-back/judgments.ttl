@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ana a prov:Person .
:ben a prov:Person .

:erroneousR a cascade:Judgment ; cascade:verdict cascade:Erroneous ; prov:hadMember :r ; prov:wasDerivedFrom :januaryDocument ;
    prov:wasAttributedTo :ana ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :ana ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:benReplacesR a cascade:Judgment ; cascade:verdict cascade:Different ; prov:hadMember :r , :s ; dct:replaces :erroneousR ;
    prov:wasAttributedTo :ben ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :ben ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .

:benRetractsHisReplacement a prov:Activity ; prov:invalidated :benReplacesR ;
    prov:wasAssociatedWith :ben ; prov:qualifiedAssociation [ prov:agent :ben ; prov:hadRole cascade:PatientRole ] ;
    prov:startedAtTime "2026-04-01T00:00:00Z"^^xsd:dateTime .

:erroneousS a cascade:Judgment ; cascade:verdict cascade:Erroneous ; prov:hadMember :s ; prov:wasDerivedFrom :januaryDocument ;
    prov:wasAttributedTo :ana ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :ana ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:benReplacesS a cascade:Judgment ; cascade:verdict cascade:Different ; prov:hadMember :r , :s ; dct:replaces :erroneousS ;
    prov:wasAttributedTo :ben ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :ben ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .

:anaReplacesBensReplacement a cascade:Judgment ; cascade:verdict cascade:Different ; prov:hadMember :r , :s ; dct:replaces :benReplacesS ;
    prov:wasAttributedTo :ana ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :ana ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-04-01T00:00:00Z"^^xsd:dateTime .
