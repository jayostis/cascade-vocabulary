@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-replacement-that-was-taken-back" ;
  rdfs:comment "Two of Ana's Erroneous judgments: Ben replaces each, then retracts his replacement of the first and Ana replaces his replacement of the second." ;
  mf:entries (
    <#a-taken-back-replacement-lists-nothing>
  ) .

<#a-taken-back-replacement-lists-nothing> a mf:QueryEvaluationTest ;
  mf:name "a-taken-back-replacement-lists-nothing" ;
  rdfs:comment "Ana's judgment whose replacement Ben retracted counts again and is not listed, nor is his retracted replacement; the one whose replacement was replaced still does not count, so it is listed with Ben's replaced replacement." ;
  mf:action [ qt:query <../../../queries/questions/judgment/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <a-taken-back-replacement-lists-nothing.srj> .
