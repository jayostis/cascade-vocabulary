@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:ingredients a cascade:ReferenceSeries ; rdfs:label "Ingredients" ; cascade:tableKind cascade:SubstanceIngredients .
:ingredients1 prov:specializationOf :ingredients ; pav:version "1" .
:ingredients2 prov:specializationOf :ingredients ; pav:version "2" ; prov:wasRevisionOf :ingredients1 .

:groups a cascade:ReferenceSeries ; rdfs:label "Groups" ; cascade:tableKind cascade:VaccineGroups .
:groups1 prov:specializationOf :groups ; pav:version "1" .

:rules a cascade:ReferenceSeries ; rdfs:label "Rules" .
:rules1 prov:specializationOf :rules ; pav:version "1" ;
    cascade:queryHash :sameCodeQuery , :sameMappedCodeAndDateQuery , :sameMappedCodeQuery .
