@prefix : <urn:x:> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

:ingredients a rec:ReferenceSeries ; rdfs:label "Ingredients" ; rec:tableKind rec:SubstanceIngredients .
:ingredients1 prov:specializationOf :ingredients ; pav:version "1" .
:ingredients2 prov:specializationOf :ingredients ; pav:version "2" ; prov:wasRevisionOf :ingredients1 .

:groups a rec:ReferenceSeries ; rdfs:label "Groups" ; rec:tableKind rec:VaccineGroups .
:groups1 prov:specializationOf :groups ; pav:version "1" .

:rules a rec:ReferenceSeries ; rdfs:label "Rules" .
:rules1 prov:specializationOf :rules ; pav:version "1" .
