@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "joined-by" ;
  rdfs:comment "A table series with versions 1 and 2, a table series of another kind with one version, a rule list series with one version, a matcher and four pairs of allergies the matcher's Sames join: by a table, by the rules alone, by a table that has a newer version since and by the newer one, and by two tables." ;
  mf:entries (
    <#joined-by>
  ) .

<#joined-by> a mf:QueryEvaluationTest ;
  mf:name "joined-by" ;
  rdfs:comment "Under everyday, the first pair's entry cites the vaccine groups version and neither the rules nor the records' versions; the pair joined by the rules alone cites nothing and has no row; the third pair's entry cites version 2 of its table, never the version 1 its lapsed Same used; the fourth cites both tables." ;
  mf:action [ qt:query <../../../queries/tables/joined-by.rq> ;
              rec:lens <../../../queries/lenses/everyday.rq> ] ;
  mf:result <joined-by.srj> .
