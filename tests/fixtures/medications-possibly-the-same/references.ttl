@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:rules a cascade:ReferenceSeries ; rdfs:label "Rules" .
:rules6 prov:specializationOf :rules ; pav:version "6" ;
    cascade:queryHash :sameMedicationCodeQueryBefore .
:rules7 prov:specializationOf :rules ; pav:version "7" ; prov:wasRevisionOf :rules6 ;
    cascade:queryHash :sameBrandGenericQuery , :sameMedicationCodeQuery , :sameProductCodeQuery .
