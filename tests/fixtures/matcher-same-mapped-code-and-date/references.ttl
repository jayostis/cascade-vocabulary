@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:groups a cascade:ReferenceSeries ; rdfs:label "Vaccine groups" ; cascade:tableKind cascade:VaccineGroups .
:groups-1 prov:specializationOf :groups ; pav:version "1" .

:names a cascade:ReferenceSeries ; rdfs:label "Vaccine names" ; cascade:tableKind cascade:CodeNames .
:names-1 prov:specializationOf :names ; pav:version "1" .
