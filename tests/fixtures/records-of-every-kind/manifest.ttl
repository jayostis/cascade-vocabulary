@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "records-of-every-kind" ;
  rdfs:comment "One record of each kind records.rq lists, a report and a note or document among them, each with one revision and a version stating its name, status and date, and a prescription stating when it was written and no start." ;
  mf:entries (
    <#what-each-record-is>
    <#the-name-and-date-of-each-version>
    <#what-each-version-says>
  ) .

<#what-each-record-is> a mf:QueryEvaluationTest ;
  mf:name "what-each-record-is" ;
  rdfs:comment "Each record becomes a cascade:Record of its kind, and only an allergy takes its status only from documents." ;
  mf:action [ qt:query <what-each-record-is.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-each-record-is.srj> .

<#the-name-and-date-of-each-version> a mf:QueryEvaluationTest ;
  mf:name "the-name-and-date-of-each-version" ;
  rdfs:comment "Each version gets cascade:displayName and cascade:displayDate from its kind's own properties; an allergy states no date, and a prescription with no start of use is dated by the day it was written." ;
  mf:action [ qt:query <the-name-and-date-of-each-version.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-name-and-date-of-each-version.srj> .

<#what-each-version-says> a mf:QueryEvaluationTest ;
  mf:name "what-each-version-says" ;
  rdfs:comment "One row per statement of each version as its file states it, and none of the name and date the derivations copy." ;
  mf:action [ qt:query <../../../queries/questions/record/What%20each%20version%20says.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-each-version-says.srj> .
