@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:sameColonoscopy a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :colonoscopy, :colonoscopyResent ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .

:sameTsh a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :tsh, :tshResent ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .

:sameLisinopril a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :listed, :prescribed ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
