PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

SELECT DISTINCT ?name ?text ?member ?memberText
WHERE { GRAPH ?view {
  ?entry cascade:mergedFrom [] ; cascade:leadMember [] .
  FILTER (?view IN (<https://pod.example/clinical/procedures.ttl>, <https://pod.example/clinical/lab-results.ttl>, <https://pod.example/clinical/medications.ttl>))
  OPTIONAL { ?entry cascade:procedureName ?procedure }
  OPTIONAL { ?entry cascade:testName ?test }
  OPTIONAL { ?entry cascade:drugName ?drug }
  BIND (COALESCE(?procedure, ?test, ?drug) AS ?name)
  OPTIONAL { ?entry cascade:narrativeText ?text }
  OPTIONAL { ?entry cascade:memberCurrentValues ?values . ?values cascade:valuesOfMember ?member ; cascade:narrativeText ?memberText } } }
