@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "joined-through-a-third-record" ;
  rdfs:comment "Three of the subject's conditions: A is the same as B, B as C, and A is different from C." ;
  mf:entries (
    <#one-entry-named-from-its-smallest-member>
    <#judged-different-still-joined>
  ) .

<#one-entry-named-from-its-smallest-member> a mf:QueryEvaluationTest ;
  mf:name "one-entry-named-from-its-smallest-member" ;
  rdfs:comment "A and C are joined through B though judged different, in one entry named from A." ;
  mf:action [ qt:query <one-entry-named-from-its-smallest-member.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <one-entry-named-from-its-smallest-member.srj> .

<#judged-different-still-joined> a mf:QueryEvaluationTest ;
  mf:name "judged-different-still-joined" ;
  rdfs:comment "The entry is listed for review, naming the pair judged different and the judgment." ;
  mf:action [ qt:query <../../../queries/v1-draft/questions/entry/What%20needs%20review.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <judged-different-still-joined.srj> .
