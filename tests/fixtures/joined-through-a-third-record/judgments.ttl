@prefix : <urn:x:> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:sameAB a jdg:Judgment ; jdg:verdict jdg:Same ; prov:hadMember :a, :b ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:sameBC a jdg:Judgment ; jdg:verdict jdg:Same ; prov:hadMember :b, :c ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:differentAC a jdg:Judgment ; jdg:verdict jdg:Different ; prov:hadMember :a, :c ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole jdg:patient ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
