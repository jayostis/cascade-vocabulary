:aRevision a cascade:Revision ; cascade:revisionOf :a ; cascade:version :aVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:b a cascade:ProblemOrDiagnosis .
