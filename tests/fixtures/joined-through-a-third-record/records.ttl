:bRevision a cascade:Revision ; cascade:revisionOf :b ; cascade:version :bVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:c a cascade:ProblemOrDiagnosis .
:cVersion prov:specializationOf :c ; cascade:patient :subject ; cascade:conditionName "Asthma" .
:cRevision a cascade:Revision ; cascade:revisionOf :c ; cascade:version :cVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
