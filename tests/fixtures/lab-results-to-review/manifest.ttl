@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "lab-results-to-review" ;
  rdfs:comment "Two glucoses the matcher joined by the same result on one day, one stamped with the day alone; a potassium of 4.1 mmol/L, one of 4.1 meq/L at that instant in another time zone with a finding of the two\'s different units, and one of 4.4 mmol/L at the first\'s instant with a finding of the two\'s different values; two leukocyte counts with a finding of their values that the person acknowledged; two glucoses in mg/dL and mmol/L with a finding of their units, that the person judged different; and two creatinines in mg/dL and umol/L with a finding of their units, that the person judged the same." ;
  mf:entries (
    <#listed-for-review>
  ) .

<#listed-for-review> a mf:QueryEvaluationTest ;
  mf:name "listed-for-review" ;
  rdfs:comment "The entry joined on one day is listed with its Same, and each finding of different values or units is listed with its two results, once. Not listed: the finding the person acknowledged, the finding of two results the person judged different, and the finding of two results the person judged the same." ;
  mf:action [ qt:query <../../../queries/questions/entry/What%20needs%20review.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <listed-for-review.srj> .
