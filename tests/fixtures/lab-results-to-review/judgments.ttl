@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .
cascade:CascadeMatcher a prov:SoftwareAgent ; rdfs:label "Cascade matcher" .

:onOneDay a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameResultOnOneDay ;
    prov:hadMember :dayOnly , :dayInstant ; prov:wasDerivedFrom <urn:x:dayOnlyVersion> , <urn:x:dayInstantVersion> ;
    cascade:matcherRule cascade:SameResultOnOneDayRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:onOneDayUnderrules11 a cascade:MatcherJudgmentAssertion ; cascade:assertedJudgment :onOneDay ;
    cascade:assertedUnderRuleListVersion :rules11 .

:notTheSame a cascade:Judgment ; cascade:verdict cascade:Different ; prov:hadMember :differentA , :differentB ;
    prov:wasAttributedTo :person ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:rules a cascade:ReferenceSeries ; rdfs:label "Rules" .
:rules11 prov:specializationOf :rules ; pav:version "11" .
:rules11SameResultOnOneDayRule cascade:rowOfRuleListVersion :rules11 ; cascade:matcherRule cascade:SameResultOnOneDayRule ;
    cascade:queryHash :sameResultOnOneDayQuery .

:differentValues a cascade:FindingForReview ; oa:hasBody cascade:DifferentResultValuesAtOneInstant ;
    oa:motivatedBy oa:classifying ; oa:hasTarget :unitsUpper , :valueOther ;
    prov:wasDerivedFrom <urn:x:unitsUpperVersion> , <urn:x:valueOtherVersion> .

:countsDiffer a cascade:FindingForReview ; oa:hasBody cascade:DifferentResultValuesAtOneInstant ;
    oa:motivatedBy oa:classifying ; oa:hasTarget :countPlain , :countAnnotated ;
    prov:wasDerivedFrom <urn:x:countPlainVersion> , <urn:x:countAnnotatedVersion> .

:seen a cascade:Judgment ; cascade:verdict cascade:Acknowledged ; prov:hadMember :countsDiffer ;
    prov:wasAttributedTo :person ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-02T00:00:00Z"^^xsd:dateTime .

:differentUnits a cascade:FindingForReview ; oa:hasBody cascade:DifferentResultUnitsAtOneInstant ;
    oa:motivatedBy oa:classifying ; oa:hasTarget :unitsUpper , :unitsOther ;
    prov:wasDerivedFrom <urn:x:unitsUpperVersion> , <urn:x:unitsOtherVersion> .

:unitsOfTheDifferent a cascade:FindingForReview ; oa:hasBody cascade:DifferentResultUnitsAtOneInstant ;
    oa:motivatedBy oa:classifying ; oa:hasTarget :differentA , :differentB ;
    prov:wasDerivedFrom <urn:x:differentAVersion> , <urn:x:differentBVersion> .

:unitsOfTheSame a cascade:FindingForReview ; oa:hasBody cascade:DifferentResultUnitsAtOneInstant ;
    oa:motivatedBy oa:classifying ; oa:hasTarget :sameA , :sameB ;
    prov:wasDerivedFrom <urn:x:sameAVersion> , <urn:x:sameBVersion> .

:theSame a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :sameA , :sameB ;
    prov:wasAttributedTo :person ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-03T00:00:00Z"^^xsd:dateTime .

:byIdentifier a cascade:Judgment ; cascade:verdict cascade:Same ;
    cascade:justification cascade:SameBusinessIdentifierAndTestCodeWithinOneOrganization ;
    prov:hadMember :identifiedFirst , :identifiedCorrected ;
    prov:wasDerivedFrom <urn:x:identifiedFirstVersion> , <urn:x:identifiedCorrectedVersion> ;
    cascade:matcherRule cascade:SameBusinessIdentifierAndTestCodeWithinOneOrganizationRule ;
    prov:wasAttributedTo cascade:CascadeMatcher .

:byIdentifierUnderrules11 a cascade:MatcherJudgmentAssertion ; cascade:assertedJudgment :byIdentifier ;
    cascade:assertedUnderRuleListVersion :rules11 .

:rules11SameBusinessIdentifierRule cascade:rowOfRuleListVersion :rules11 ;
    cascade:matcherRule cascade:SameBusinessIdentifierAndTestCodeWithinOneOrganizationRule ;
    cascade:queryHash :sameBusinessIdentifierQuery .

:byValue a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameResult ;
    prov:hadMember :identifiedCorrected , :sameAsCorrected ;
    prov:wasDerivedFrom <urn:x:identifiedCorrectedVersion> , <urn:x:sameAsCorrectedVersion> ;
    cascade:matcherRule cascade:SameResultRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:byValueUnderrules11 a cascade:MatcherJudgmentAssertion ; cascade:assertedJudgment :byValue ;
    cascade:assertedUnderRuleListVersion :rules11 .

:rules11SameResultRule cascade:rowOfRuleListVersion :rules11 ; cascade:matcherRule cascade:SameResultRule ;
    cascade:queryHash :sameResultQuery .

:correctedValue a cascade:FindingForReview ; oa:hasBody cascade:DifferentResultValuesAtOneInstant ;
    oa:motivatedBy oa:classifying ; oa:hasTarget :identifiedFirst , :identifiedCorrected ;
    prov:wasDerivedFrom <urn:x:identifiedFirstVersion> , <urn:x:identifiedCorrectedVersion> .

:byIdentifierUnmarked a cascade:Judgment ; cascade:verdict cascade:Same ;
    cascade:justification cascade:SameBusinessIdentifierAndTestCodeWithinOneOrganization ;
    prov:hadMember :unmarkedFirst , :unmarkedSecond ;
    prov:wasDerivedFrom <urn:x:unmarkedFirstVersion> , <urn:x:unmarkedSecondVersion> ;
    cascade:matcherRule cascade:SameBusinessIdentifierAndTestCodeWithinOneOrganizationRule ;
    prov:wasAttributedTo cascade:CascadeMatcher .

:byIdentifierUnmarkedUnderrules11 a cascade:MatcherJudgmentAssertion ; cascade:assertedJudgment :byIdentifierUnmarked ;
    cascade:assertedUnderRuleListVersion :rules11 .

:unmarkedValue a cascade:FindingForReview ; oa:hasBody cascade:DifferentResultValuesAtOneInstant ;
    oa:motivatedBy oa:classifying ; oa:hasTarget :unmarkedFirst , :unmarkedSecond ;
    prov:wasDerivedFrom <urn:x:unmarkedFirstVersion> , <urn:x:unmarkedSecondVersion> .
