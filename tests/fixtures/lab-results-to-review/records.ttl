@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:dayOnly a cascade:LaboratoryTestResult .
<urn:x:dayOnlyVersion> prov:specializationOf :dayOnly ; cascade:patient :subject ; cascade:testName "Glucose" ;
    cascade:testCode <http://loinc.org/rdf/2345-7> ; cascade:resultClinicallyRelevantTime "2025-03-27"^^xsd:date ;
    cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:dayOnlyVersion#value> .
<urn:x:dayOnlyVersion#value> cascade:decimalValue "95"^^xsd:decimal ; cascade:writtenValue "95" ; cascade:ucumUnit "mg/dL" .
:dayOnlyRevision a cascade:Revision ; cascade:revisionOf :dayOnly ; cascade:version <urn:x:dayOnlyVersion> ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:dayInstant a cascade:LaboratoryTestResult .
<urn:x:dayInstantVersion> prov:specializationOf :dayInstant ; cascade:patient :subject ; cascade:testName "Glucose, fasting" ;
    cascade:testCode <http://loinc.org/rdf/2345-7> ; cascade:resultClinicallyRelevantTime "2025-03-27T08:00:00Z"^^xsd:dateTime ;
    cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:dayInstantVersion#value> .
<urn:x:dayInstantVersion#value> cascade:decimalValue "95"^^xsd:decimal ; cascade:writtenValue "95" ; cascade:ucumUnit "mg/dL" .
:dayInstantRevision a cascade:Revision ; cascade:revisionOf :dayInstant ; cascade:version <urn:x:dayInstantVersion> ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:unitsUpper a cascade:LaboratoryTestResult .
<urn:x:unitsUpperVersion> prov:specializationOf :unitsUpper ; cascade:patient :subject ; cascade:testName "Potassium" ;
    cascade:testCode <http://loinc.org/rdf/2823-3> ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime ;
    cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:unitsUpperVersion#value> .
<urn:x:unitsUpperVersion#value> cascade:decimalValue "4.1"^^xsd:decimal ; cascade:writtenValue "4.1" ; cascade:ucumUnit "mmol/L" .
:unitsUpperRevision a cascade:Revision ; cascade:revisionOf :unitsUpper ; cascade:version <urn:x:unitsUpperVersion> ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

