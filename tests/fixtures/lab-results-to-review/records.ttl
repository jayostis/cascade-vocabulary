    cascade:testCode <http://loinc.org/rdf/2823-3> ; cascade:resultClinicallyRelevantTime "2025-03-27T07:00:00-05:00"^^xsd:dateTime ;
    cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:unitsLowerVersion#value> .
<urn:x:unitsLowerVersion#value> cascade:decimalValue "4.1"^^xsd:decimal ; cascade:writtenValue "4.1" ; cascade:ucumUnit "mmol/l" .
:unitsLowerRevision a cascade:Revision ; cascade:revisionOf :unitsLower ; cascade:version <urn:x:unitsLowerVersion> ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:countPlain a cascade:LaboratoryTestResult .
<urn:x:countPlainVersion> prov:specializationOf :countPlain ; cascade:patient :subject ; cascade:testName "WBC" ;
    cascade:testCode <http://loinc.org/rdf/6690-2> ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime ;
    cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:countPlainVersion#value> .
<urn:x:countPlainVersion#value> cascade:decimalValue "6.2"^^xsd:decimal ; cascade:writtenValue "6.2" ; cascade:ucumUnit "10*3/uL" .
:countPlainRevision a cascade:Revision ; cascade:revisionOf :countPlain ; cascade:version <urn:x:countPlainVersion> ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:countAnnotated a cascade:LaboratoryTestResult .
<urn:x:countAnnotatedVersion> prov:specializationOf :countAnnotated ; cascade:patient :subject ; cascade:testName "Leukocytes" ;
    cascade:testCode <http://loinc.org/rdf/6690-2> ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime ;
    cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:countAnnotatedVersion#value> .
<urn:x:countAnnotatedVersion#value> cascade:decimalValue "6.4"^^xsd:decimal ; cascade:writtenValue "6.4" ; cascade:ucumUnit "10*3{cells}/uL" .
:countAnnotatedRevision a cascade:Revision ; cascade:revisionOf :countAnnotated ; cascade:version <urn:x:countAnnotatedVersion> ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

