@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cascade:CascadeMatcher a prov:SoftwareAgent ; rdfs:label "Cascade matcher" .

:byCode a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameCode ;
    prov:hadMember :c1 , :c2 ; prov:used :c1Version , :c2Version ;
    cascade:matcherRule cascade:SameCodeRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:byCodeUnderRules1 a cascade:ClaimAssertion ; cascade:assertedClaim :byCode ;
    cascade:assertedUnderRuleListVersion :rules1 .

:byMappedCode a cascade:Judgment ; cascade:verdict cascade:Same ; cascade:justification cascade:SameMappedCode ;
    prov:hadMember :c1 , :c3 ; prov:used :c1Version , :c3Version ;
    cascade:matcherRule cascade:SameMappedCodeRule ; prov:wasAttributedTo cascade:CascadeMatcher .

:byMappedCodeUnderRules1 a cascade:ClaimAssertion ; cascade:assertedClaim :byMappedCode ;
    cascade:assertedUnderRuleListVersion :rules1 .

:byMappedCodeRetracted a prov:Activity ; prov:invalidated :byMappedCode ; prov:wasInfluencedBy :rules2 .
