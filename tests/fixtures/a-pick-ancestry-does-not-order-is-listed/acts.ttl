@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:firstPull a prov:Activity ; prov:startedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
:firstPullSnapshot a cascade:Snapshot ; prov:wasGeneratedBy :firstPull ;
    cascade:setHash "1111111111111111111111111111111111111111111111111111111111111111" ;
    cascade:fileAddedToSet "provenance/imports/fi/first-pull.ttl" .
:export a prov:Activity ; prov:startedAtTime "2026-01-05T00:00:00Z"^^xsd:dateTime .
:exportSnapshot a cascade:Snapshot ; prov:wasGeneratedBy :export ; cascade:firstParentSnapshot :firstPullSnapshot ;
    cascade:setHash "2222222222222222222222222222222222222222222222222222222222222222" ;
    cascade:fileAddedToSet "provenance/imports/ex/export.ttl" .
:skewedPull a prov:Activity ; prov:startedAtTime "2025-12-20T00:00:00Z"^^xsd:dateTime .
:skewedPullSnapshot a cascade:Snapshot ; prov:wasGeneratedBy :skewedPull ; cascade:firstParentSnapshot :exportSnapshot ;
    cascade:setHash "3333333333333333333333333333333333333333333333333333333333333333" ;
    cascade:fileAddedToSet "provenance/imports/sk/skewed-pull.ttl" .
:otherWritersPull a prov:Activity ; prov:startedAtTime "2026-01-03T00:00:00Z"^^xsd:dateTime .
:otherWritersPullSnapshot a cascade:Snapshot ; prov:wasGeneratedBy :otherWritersPull ;
    cascade:setHash "4444444444444444444444444444444444444444444444444444444444444444" ;
    cascade:fileAddedToSet "provenance/imports/ot/other-writers-pull.ttl" .
