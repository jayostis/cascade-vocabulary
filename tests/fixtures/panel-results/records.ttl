@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:potassium a cascade:LaboratoryTestResult .
:potassiumVersion prov:specializationOf :potassium ; cascade:patient :subject ; cascade:testName "Potassium" ;
    cascade:testCode <http://loinc.org/rdf/2823-3> ; cascade:resultValue "4.1" ; cascade:resultUnit "mmol/L" ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime .
:potassiumRevision a cascade:Revision ; cascade:revisionOf :potassium ; cascade:version :potassiumVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:sodium a cascade:LaboratoryTestResult .
:sodiumVersion prov:specializationOf :sodium ; cascade:patient :subject ; cascade:testName "Sodium" ;
    cascade:testCode <http://loinc.org/rdf/2951-2> ; cascade:resultValue "140" ; cascade:resultUnit "mmol/L" ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime .
:sodiumRevision a cascade:Revision ; cascade:revisionOf :sodium ; cascade:version :sodiumVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:systolic a cascade:LaboratoryTestResult .
:systolicVersion prov:specializationOf :systolic ; cascade:patient :subject ; cascade:testName "Systolic blood pressure" ;
    cascade:testCode <http://loinc.org/rdf/8480-6> ; cascade:resultValue "128" ; cascade:resultUnit "mm[Hg]" ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime .
:systolicRevision a cascade:Revision ; cascade:revisionOf :systolic ; cascade:version :systolicVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:myeloperoxidase a cascade:LaboratoryTestResult .
:myeloperoxidaseVersion prov:specializationOf :myeloperoxidase ; cascade:patient :subject ; cascade:testName "Myeloperoxidase Ab" ;
    cascade:testCode <http://loinc.org/rdf/6969-0> ; cascade:resultValue "2" ; cascade:resultUnit "[U]/mL" ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime .
:myeloperoxidaseRevision a cascade:Revision ; cascade:revisionOf :myeloperoxidase ; cascade:version :myeloperoxidaseVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:a1c a cascade:LaboratoryTestResult .
:a1cVersion prov:specializationOf :a1c ; cascade:patient :subject ; cascade:testName "Hemoglobin A1c" ;
    cascade:testCode <http://loinc.org/rdf/4548-4> ; cascade:resultValue "5.6" ; cascade:resultUnit "%" ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-03-27"^^xsd:date .
:a1cRevision a cascade:Revision ; cascade:revisionOf :a1c ; cascade:version :a1cVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .
