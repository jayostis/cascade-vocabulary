@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-replacement-by-someone-else" ;
  rdfs:comment "Two of Ana's Erroneous judgments: Ben replaces the first, Ana the second." ;
  mf:entries (
    <#replaced-by-someone-else>
  ) .

<#replaced-by-someone-else> a mf:QueryEvaluationTest ;
  mf:name "replaced-by-someone-else" ;
  rdfs:comment "The judgment Ben replaced is listed, being someone else's; the one Ana replaced herself is not." ;
  mf:action [ qt:query <../../../queries/questions/judgment/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <replaced-by-someone-else.srj> .
