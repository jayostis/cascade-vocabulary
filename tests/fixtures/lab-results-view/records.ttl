@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:drawn a cascade:LaboratoryTestResult .
:drawnVersion prov:specializationOf :drawn ; cascade:patient :subject ; cascade:testName "Potassium" ;
    cascade:testCode <http://loinc.org/rdf/2823-3> ; cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:drawnVersion#value> ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime .
<urn:x:drawnVersion#value> cascade:decimalValue "4.1"^^xsd:decimal ; cascade:writtenValue "4.10" ; cascade:ucumUnit "mmol/L" .
:drawnRevision a cascade:Revision ; cascade:revisionOf :drawn ; cascade:version :drawnVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:resent a cascade:LaboratoryTestResult .
:resentVersion prov:specializationOf :resent ; cascade:patient :subject ; cascade:testName "Serum potassium" ;
    cascade:testCode <http://loinc.org/rdf/2823-3> ; cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:resentVersion#value> .
<urn:x:resentVersion#value> cascade:decimalValue "4.1"^^xsd:decimal ; cascade:writtenValue "4.1" ; cascade:ucumUnit "mmol/L" ;
    cascade:unitText "mmol/l" .
:resentRevision a cascade:Revision ; cascade:revisionOf :resent ; cascade:version :resentVersion ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:glucose a cascade:LaboratoryTestResult .
:glucoseVersion prov:specializationOf :glucose ; cascade:patient :subject ; cascade:testName "Glucose" ;
    cascade:testCode <http://loinc.org/rdf/2345-7> ; cascade:resultValue "95" ; cascade:resultUnit "mg/dL" ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-04-10T08:00:00Z"^^xsd:dateTime .
:glucoseRevision a cascade:Revision ; cascade:revisionOf :glucose ; cascade:version :glucoseVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:a1c a cascade:LaboratoryTestResult .
:a1cVersion prov:specializationOf :a1c ; cascade:patient :subject ; cascade:testName "Hemoglobin A1c" ;
    cascade:testCode <http://loinc.org/rdf/4548-4> ; cascade:resultValueKind cascade:QuantityResultValue ; cascade:resultQuantity <urn:x:a1cVersion#value> ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-04-10"^^xsd:date .
<urn:x:a1cVersion#value> cascade:decimalValue "5.7"^^xsd:decimal ; cascade:writtenValue "5.7" ; cascade:quantityComparator "<" ;
    cascade:ucumUnit "%" .
:a1cRevision a cascade:Revision ; cascade:revisionOf :a1c ; cascade:version :a1cVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:titre a cascade:LaboratoryTestResult .
:titreVersion prov:specializationOf :titre ; cascade:patient :subject ; cascade:testName "ANA titre" ;
    cascade:testCode <http://loinc.org/rdf/5048-4> ; cascade:resultValueKind cascade:RatioResultValue ;
    cascade:resultRatioNumerator <urn:x:titreVersion#numerator> ; cascade:resultRatioDenominator <urn:x:titreVersion#denominator> ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-04-11T09:00:00Z"^^xsd:dateTime .
<urn:x:titreVersion#numerator> cascade:decimalValue "1"^^xsd:decimal ; cascade:writtenValue "1" .
<urn:x:titreVersion#denominator> cascade:decimalValue "64"^^xsd:decimal ; cascade:writtenValue "64" .
:titreRevision a cascade:Revision ; cascade:revisionOf :titre ; cascade:version :titreVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .

:urine a cascade:LaboratoryTestResult .
:urineVersion prov:specializationOf :urine ; cascade:patient :subject ; cascade:testName "WBC, urine sediment" ;
    cascade:testCode <http://loinc.org/rdf/5821-4> ; cascade:resultValueKind cascade:RangeResultValue ;
    cascade:resultRangeLow <urn:x:urineVersion#range-low> ; cascade:resultRangeHigh <urn:x:urineVersion#range-high> ;
    cascade:workflowStatus "final" ; cascade:resultClinicallyRelevantTime "2025-04-12T09:00:00Z"^^xsd:dateTime .
<urn:x:urineVersion#range-low> cascade:decimalValue "0"^^xsd:decimal ; cascade:writtenValue "0" ; cascade:ucumUnit "/[HPF]" .
<urn:x:urineVersion#range-high> cascade:decimalValue "5"^^xsd:decimal ; cascade:writtenValue "5" ; cascade:ucumUnit "/[HPF]" .
:urineRevision a cascade:Revision ; cascade:revisionOf :urine ; cascade:version :urineVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
