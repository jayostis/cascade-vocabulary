@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "lab-results-view" ;
  rdfs:comment "A potassium entry of two members, the later one stating another name and unit and no status or time; and a glucose." ;
  mf:entries (
    <#the-lab-results-view>
    <#my-lab-results>
  ) .

<#the-lab-results-view> a mf:QueryEvaluationTest ;
  mf:name "the-lab-results-view" ;
  rdfs:comment "Each entry takes the test, code, value and unit of its latest member, the status of the member chosen for status, and the time of the member chosen for the date." ;
  mf:action [ qt:query <the-lab-results-view.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <the-lab-results-view.srj> .

<#my-lab-results> a mf:QueryEvaluationTest ;
  mf:name "my-lab-results" ;
  rdfs:comment "Every entry, newest first, with how many records it joins." ;
  mf:action [ qt:query <../../../queries/v1-draft/questions/pod/My%20lab%20results.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <my-lab-results.srj> .
