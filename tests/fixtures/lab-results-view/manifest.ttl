@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "lab-results-view" ;
  rdfs:comment "A potassium entry of two members, the later one stating another name and unit and no status or time; a glucose at a time; and a hemoglobin A1c on that day, as a day." ;
  mf:entries (
    <#the-lab-results-view>
    <#my-lab-results>
  ) .

<#the-lab-results-view> a mf:QueryEvaluationTest ;
  mf:name "the-lab-results-view" ;
  rdfs:comment "Each entry takes the test, code, value, unit and time of its lead, so the potassium shows no time, and the status of the member chosen for status." ;
  mf:action [ qt:query <the-lab-results-view.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-lab-results-view.srj> .

<#my-lab-results> a mf:QueryEvaluationTest ;
  mf:name "my-lab-results" ;
  rdfs:comment "Every entry, newest first by day and then by time as written, so the glucose comes before the A1c of its day, with how many records it joins." ;
  mf:action [ qt:query <../../../queries/questions/pod/My%20lab%20results.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <my-lab-results.srj> .
