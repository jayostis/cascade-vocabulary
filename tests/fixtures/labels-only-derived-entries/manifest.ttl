@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "labels-only-derived-entries" ;
  rdfs:comment "An allergy, and a view file as a runtime writes it, naming the allergy's entry relative to its view." ;
  mf:entries (
    <#the-entries-labelled>
  ) .

<#the-entries-labelled> a mf:QueryEvaluationTest ;
  mf:name "the-entries-labelled" ;
  rdfs:comment "Only the derived entry is labelled: the runtime renames it when it writes the view, so a written entry is never labelled again." ;
  mf:action [ qt:query <the-entries-labelled.rq> ;
              cascade:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-entries-labelled.srj> .
