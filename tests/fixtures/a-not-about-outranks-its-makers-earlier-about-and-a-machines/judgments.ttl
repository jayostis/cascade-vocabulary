@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parent a prov:Person .
cascade:CascadeMatcher a prov:SoftwareAgent ; rdfs:label "Cascade matcher" .

:aboutFirst a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :changedMind ; cascade:subject :subject ;
    cascade:basis cascade:OwnerStatement ;
    prov:wasAttributedTo :parent ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :parent ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
:notAboutAfter a cascade:Judgment ; cascade:verdict cascade:NotAbout ; prov:hadMember :changedMind ; cascade:subject :subject ;
    prov:wasAttributedTo :parent ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :parent ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-02T00:00:00Z"^^xsd:dateTime .

:machineAbout a cascade:Judgment ; cascade:verdict cascade:About ; prov:hadMember :machineClaimed ; cascade:subject :subject ;
    cascade:basis cascade:SameDemographics ; cascade:matcherRule cascade:SameCodeRule ;
    prov:wasAttributedTo cascade:CascadeMatcher .
:machineAboutUnderRules1 a cascade:MatcherJudgmentAssertion ; cascade:assertedJudgment :machineAbout ;
    cascade:assertedUnderRuleListVersion :rules1 .
:rules a cascade:ReferenceSeries ; rdfs:label "Rules" .
:rules1 prov:specializationOf :rules ; pav:version "1" .
:rules1SameCodeRule cascade:rowOfRuleListVersion :rules1 ; cascade:matcherRule cascade:SameCodeRule ;
    cascade:queryHash :sameCodeQuery .
:notAboutTheMachines a cascade:Judgment ; cascade:verdict cascade:NotAbout ; prov:hadMember :machineClaimed ;
    cascade:subject :subject ;
    prov:wasAttributedTo :parent ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :parent ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-01-20T00:00:00Z"^^xsd:dateTime .

:notAboutANamelessProfile a cascade:Judgment ; cascade:verdict cascade:NotAbout ; prov:hadMember :namedByNoRecord ;
    cascade:subject :subject ;
    prov:wasAttributedTo :parent ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :parent ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-02-03T00:00:00Z"^^xsd:dateTime .
