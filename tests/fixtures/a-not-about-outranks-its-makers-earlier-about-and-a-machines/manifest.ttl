@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-not-about-outranks-its-makers-earlier-about-and-a-machines" ;
  rdfs:comment "A parent's About over a profile and their NotAbout after it; a Cascade matcher's counting About over another profile and the parent's NotAbout over it; and a NotAbout over a profile no record names." ;
  mf:entries (
    <#why-it-is-in-no-view>
    <#what-needs-review>
  ) .

<#why-it-is-in-no-view> a mf:QueryEvaluationTest ;
  mf:name "why-it-is-in-no-view" ;
  rdfs:comment "Each profile's record is left out because a counting NotAbout names its profile: the NotAbout outranks its maker's earlier About and the machine's About." ;
  mf:action [ qt:query <../../../queries/questions/record/Why%20it%20is%20in%20no%20view.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <why-it-is-in-no-view.srj> .

<#what-needs-review> a mf:QueryEvaluationTest ;
  mf:name "what-needs-review" ;
  rdfs:comment "No profile is listed: each is answered, and no About stands against its NotAbout, the parent's own being earlier and the machine's no person's." ;
  mf:action [ qt:query <../../../queries/questions/profile/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <what-needs-review.srj> .
