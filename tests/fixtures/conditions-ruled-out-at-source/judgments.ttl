@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:chestSame a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :chestFirst, :chestLater ;
    prov:wasAttributedTo :person ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .

:coughSame a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :coughFirst, :coughLater ;
    prov:wasAttributedTo :person ; prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
