    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .
:chestLater a cascade:ProblemOrDiagnosis .
:chestLaterVersion prov:specializationOf :chestLater ; cascade:patient :subject ; cascade:conditionName "Chest pain" ;
    cascade:clinicalStatus "resolved" ; cascade:verificationStatus "refuted" ; cascade:abatementDate "2026-01-20"^^xsd:date .
:chestLaterRevision a cascade:Revision ; cascade:revisionOf :chestLater ; cascade:version :chestLaterVersion ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-02-01T00:00:00Z"^^xsd:dateTime .

:coughFirst a cascade:ProblemOrDiagnosis .
