@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:subject a cascade:Subject .

:embolism a cascade:ProblemOrDiagnosis .
:embolismVersion prov:specializationOf :embolism ; cascade:patient :subject ; cascade:conditionName "Pulmonary embolism" ;
    cascade:snomedCode <http://snomed.info/id/59282003> ; cascade:clinicalStatus "resolved" ; cascade:verificationStatus "refuted" ;
    cascade:onsetDate "2025-07-08"^^xsd:date ; cascade:abatementDate "2025-07-08"^^xsd:date .
:embolismRevision a cascade:Revision ; cascade:revisionOf :embolism ; cascade:version :embolismVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:negated a cascade:ProblemOrDiagnosis .
:negatedVersion prov:specializationOf :negated ; cascade:patient :subject ; cascade:conditionName "No known problems" ;
    cascade:verificationStatus "refuted" .
:negatedRevision a cascade:Revision ; cascade:revisionOf :negated ; cascade:version :negatedVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:thrombosis a cascade:ProblemOrDiagnosis .
:thrombosisVersion prov:specializationOf :thrombosis ; cascade:patient :subject ; cascade:conditionName "Deep vein thrombosis" ;
    cascade:clinicalStatus "active" ; cascade:verificationStatus "refuted" .
:thrombosisRevision a cascade:Revision ; cascade:revisionOf :thrombosis ; cascade:version :thrombosisVersion ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .

:hypertension a cascade:ProblemOrDiagnosis .
