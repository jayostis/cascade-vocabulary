@prefix : <urn:x:> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:person a prov:Person .

:sameXY a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :x, :y ; prov:used :xFirst , :yFirst ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:samePQ a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :p, :q ; prov:used :pFirst , :qFirst ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:samePQAgain a cascade:Judgment ; cascade:verdict cascade:Same ; prov:hadMember :p, :q ; prov:used :pSecond , :qFirst ; dct:replaces :samePQ ;
    prov:wasAttributedTo :person ; prov:qualifiedAttribution [ prov:agent :person ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-04-01T00:00:00Z"^^xsd:dateTime .
