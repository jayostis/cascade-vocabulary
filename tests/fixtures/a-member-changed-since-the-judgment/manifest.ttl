@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-member-changed-since-the-judgment" ;
  rdfs:comment "Two of a person's Same judgments, each naming the January document its members were shown from; one member of the first has a second revision since, from a March document." ;
  mf:entries (
    <#a-member-changed>
  ) .

<#a-member-changed> a mf:QueryEvaluationTest ;
  mf:name "a-member-changed" ;
  rdfs:comment "The Same whose member's current revision came from a document it does not name is listed; the Same over records unchanged since is not." ;
  mf:action [ qt:query <../../../queries/questions/judgment/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <a-member-changed.srj> .
