@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "a-member-changed-since-the-judgment" ;
  rdfs:comment "Two Same judgments, each made from its members' first versions; one member of each has a second version since, and a later Same, made from it, supersedes the second judgment." ;
  mf:entries (
    <#a-member-changed>
  ) .

<#a-member-changed> a mf:QueryEvaluationTest ;
  mf:name "a-member-changed" ;
  rdfs:comment "The judgment made before a member changed is listed until a later one supersedes it." ;
  mf:action [ qt:query <../../../queries/v1-draft/questions/judgment/What%20needs%20review.rq> ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ] ;
  mf:result <a-member-changed.srj> .
