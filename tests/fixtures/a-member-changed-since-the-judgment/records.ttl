:xR1 a rec:Revision ; rec:revisionOf :x ; rec:version :xFirst ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime .
:xR2 a rec:Revision ; rec:revisionOf :x ; rec:version :xSecond ; prov:wasRevisionOf :xR1 ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
