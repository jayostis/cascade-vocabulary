@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-model-judgment-retracted-by-a-person" ;
  rdfs:comment "A model's Erroneous judgment of a record, retracted by the person." ;
  mf:entries (
    <#a-person-taking-back-a-models-judgment-is-not-listed>
  ) .

<#a-person-taking-back-a-models-judgment-is-not-listed> a mf:QueryEvaluationTest ;
  mf:name "a-person-taking-back-a-models-judgment-is-not-listed" ;
  rdfs:comment "The retraction is by someone other than the judgment's maker, but the maker is not a person, so nothing is listed." ;
  mf:action [ qt:query <../../../queries/questions/judgment/What%20needs%20review.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <a-person-taking-back-a-models-judgment-is-not-listed.srj> .
