@prefix ctm: <https://ns.cascadeprotocol.org/test-manifest#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt: <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<> a mf:Manifest ;
  rdfs:label "a-retraction-by-a-person-naming-no-role-is-named-a-person" ;
  rdfs:comment "A Same by a person who has no label, and its retraction associated with the same person and naming no qualified association, so no role; a second Same of the person's stays, so that something counts." ;
  mf:entries (
    <#the-retraction-labelled>
  ) .

<#the-retraction-labelled> a mf:QueryEvaluationTest ;
  mf:name "the-retraction-labelled" ;
  rdfs:comment "The retraction is named for a person, as one with a role other than the patient's is, and, with no start time, by the start of its own name." ;
  mf:action [ qt:query <the-retraction-labelled.rq> ;
              ctm:lensQueryPath <../../../queries/lenses/everyday.rq> ] ;
  mf:result <the-retraction-labelled.srj> .
