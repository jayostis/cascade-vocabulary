:r1 a cascade:Revision ; cascade:revisionOf :record ; cascade:version :v1 ; prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ; cascade:observedAsOf "2026-01-01T00:00:00Z"^^xsd:dateTime .
:r2 a cascade:Revision ; cascade:revisionOf :record ; cascade:version :v2 ; prov:wasRevisionOf :r1 ;
