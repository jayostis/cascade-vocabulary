@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:version prov:specializationOf :record ;
    cascade:resultValueKind cascade:TextResultValue ;
    cascade:resultQuantity :value .
:value cascade:decimalValue "4.1"^^xsd:decimal ; cascade:writtenValue "4.1" .
