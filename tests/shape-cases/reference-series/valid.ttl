@prefix : <#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:table a rec:ReferenceSeries ;
    rdfs:label "Ingredient map" .
:table-1 prov:specializationOf :table ;
    pav:version "1" .
:table-2 prov:specializationOf :table ;
    pav:version "2" ;
    prov:wasRevisionOf :table-1 .
