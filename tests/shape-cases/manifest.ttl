@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix health: <https://ns.cascadeprotocol.org/health/v1#> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .

<#record-allergy/valid> a sht:Validate ;
  mf:action [ sht:dataGraph <record-allergy/valid.ttl> ] ;
  mf:result [ a sh:ValidationReport ; sh:conforms true ] .

<#record-allergy/source-url-a-literal> a sht:Validate ;
  mf:action [ sht:dataGraph <record-allergy/source-url-a-literal.ttl> ] ;
  mf:result [ a sh:ValidationReport ; sh:conforms false ;
              sh:result [ sh:sourceShape rec:SourceUrlShape ; sh:resultPath rec:sourceUrl ] ] .

<#record-allergy/two-source-record-ids> a sht:Validate ;
  mf:action [ sht:dataGraph <record-allergy/two-source-record-ids.ttl> ] ;
  mf:result [ a sh:ValidationReport ; sh:conforms false ;
              sh:result [ sh:sourceShape health:AllergyRecordShape ; sh:resultPath health:sourceRecordId ] ] .

<#record-condition/valid> a sht:Validate ;
  mf:action [ sht:dataGraph <record-condition/valid.ttl> ] ;
