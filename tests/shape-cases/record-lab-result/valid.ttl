@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:record a cascade:LaboratoryTestResult ;
    cascade:sourceUrl <https://fhir.example/Observation/1> .

:version prov:specializationOf :record ;
    cascade:patient :patient ;
    cascade:testName "Potassium" ;
    cascade:testCode <http://loinc.org/rdf/2823-3> ;
    cascade:resultValue "4.1" ;
    cascade:resultUnit "mmol/L" ;
    cascade:workflowStatus "final" ;
    cascade:resultClinicallyRelevantTime "2025-03-27T12:00:00Z"^^xsd:dateTime .
