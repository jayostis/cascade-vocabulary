@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .

[] a cascade:AllergyOrIntolerance ;
    cascade:entryMember :one , :other ;
    cascade:allergenName "Latex" ;
    cascade:allergyCategory "latex" ;
    cascade:leadMember :other ;
    cascade:clinicalStatus "active" ;
    cascade:statusFrom :other .
