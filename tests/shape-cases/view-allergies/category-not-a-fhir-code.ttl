@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .

[] a cascade:AllergyOrIntolerance ;
    cascade:mergedFrom :one , :other ;
    cascade:allergen "Latex" ;
    cascade:allergyCategory "latex" ;
    cascade:latestMember :other ;
    cascade:clinicalStatus "active" ;
    cascade:statusFrom :other .
