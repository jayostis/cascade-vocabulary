@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:alex a prov:Person .
:matcher a prov:SoftwareAgent .

:matcherJudgment a cascade:Judgment ;
    cascade:verdict cascade:Same ;
    prov:hadMember :one , :other ;
    cascade:justification cascade:SameCode ;
    prov:wasDerivedFrom :oneVersion , :otherVersion ;
    cascade:matcherRule cascade:SameCodeRule ;
    prov:wasAttributedTo :matcher .

:judgment a cascade:Judgment ;
    cascade:verdict cascade:Same ;
    prov:hadMember :one , :other ;
    dct:replaces :matcherJudgment ;
    prov:wasAttributedTo :alex ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent :alex ; prov:hadRole cascade:PatientRole ] ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
