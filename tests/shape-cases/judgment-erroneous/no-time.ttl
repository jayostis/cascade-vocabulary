@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

:alex a prov:Person .

:judgment a cascade:Judgment ;
    cascade:verdict cascade:Erroneous ;
    prov:hadMember :record ;
    prov:wasAttributedTo :alex ;
    prov:qualifiedAttribution [ prov:agent :alex ; prov:hadRole cascade:PatientRole ] .
