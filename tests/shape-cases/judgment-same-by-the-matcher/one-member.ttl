@prefix : <#> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:matcher a prov:SoftwareAgent .

:judgment a jdg:Judgment ;
    jdg:verdict jdg:Same ;
    prov:hadMember :one ;
    jdg:justification jdg:SameCode ;
    prov:used :oneVersion , :otherVersion ;
    prov:wasAttributedTo :matcher ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .
