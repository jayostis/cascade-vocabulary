@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:alex a prov:Person .
:blair a prov:Person .
:model a prov:SoftwareAgent .

:retraction a prov:Activity ;
    prov:invalidated :judgment ;
    prov:wasAssociatedWith :alex ;
    prov:qualifiedAssociation [ prov:agent :blair ; prov:hadRole cascade:PatientRole ] ,
                              [ prov:agent :model ; prov:hadRole cascade:ModelProposerRole ] ;
    prov:startedAtTime "2026-03-01T09:10:00Z"^^xsd:dateTime .
