@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:alex a prov:Person .
:blair a prov:Person .

:session a prov:Activity , cascade:HandEntrySession ;
    prov:startedAtTime "2026-03-01T09:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAssociation [ prov:agent :alex ; prov:hadRole cascade:PatientRole ] ,
                              [ prov:agent :blair ; prov:hadRole cascade:ModelProposerRole ] .
