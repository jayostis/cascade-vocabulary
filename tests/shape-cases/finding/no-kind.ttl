@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:matcher a prov:SoftwareAgent .

:claim a cascade:Judgment ;
    cascade:verdict cascade:Same ;
    prov:hadMember :one , :other ;
    cascade:justification cascade:SameCode ;
    prov:used :oneVersion , :otherVersion ;
    cascade:matcherRule cascade:SameCodeRule ;
    prov:wasAttributedTo :matcher .

:finding a cascade:FindingForReview ;
    cascade:noLongerReachedUnderRuleListVersion :rules2 ;
    oa:hasTarget :claim .
