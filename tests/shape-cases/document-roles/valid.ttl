@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<ni:///sha-256;doc-valid> a prov:Entity ; pav:retrievedOn "2026-06-08T08:59:30Z"^^xsd:dateTime ;
    prov:wasAttributedTo _:clinic , _:exchange ;
    prov:wasGeneratedBy [ prov:qualifiedAssociation [ prov:agent _:clinic ; prov:hadRole cascade:AuthorRole ] ,
                                                    [ prov:agent _:exchange ; prov:hadRole cascade:CustodianRole ] ,
                                                    [ prov:agent _:app ; prov:hadRole cascade:TransmitterRole ] ] .
_:clinic rdfs:label "Fernhill Clinic" .
_:exchange rdfs:label "Bay Area Health Exchange" .
_:app rdfs:label "Apple Health" .
