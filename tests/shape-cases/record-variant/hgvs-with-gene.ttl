@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

:record a cascade:GeneticVariantFinding ;
    cascade:sourceUrl <https://fhir.example/Observation/9> .

:version prov:specializationOf :record ;
    cascade:patient :patient ;
    cascade:hgvsCodingDnaExpression "NM_000249.4(MLH1):c.2042C>T" .
