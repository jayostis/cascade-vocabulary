@prefix : <#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix genomics: <https://ns.cascadeprotocol.org/genomics/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

:record a genomics:Variant ;
    rec:sourceUrl <https://fhir.example/Observation/9> .

:version prov:specializationOf :record ;
    rec:patient :patient ;
    genomics:geneSymbol "MLH1" ;
    genomics:hgvsCDot "NM_000249.4:c.2042C>T" ;
    genomics:clinvarVariationId "90011" ;
    clinical:status "final" .
