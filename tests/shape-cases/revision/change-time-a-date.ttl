@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:revision a cascade:Revision ;
    cascade:revisionOf :record ;
    cascade:version :version ;
    prov:generatedAtTime "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    cascade:observedAsOf "2025-12-31T00:00:00Z"^^xsd:dateTime ;
    pav:lastUpdateOn "2025-12-30"^^xsd:date .
