@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:alex a prov:Person .
:model a prov:SoftwareAgent .

:modelJudgment a cascade:Judgment ;
    cascade:verdict cascade:Erroneous ;
    prov:hadMember :record ;
    prov:wasAttributedTo :model .

:retraction a prov:Activity ;
    prov:invalidated :modelJudgment ;
    prov:wasAssociatedWith :alex ;
    prov:qualifiedAssociation [ prov:agent :alex ; prov:hadRole cascade:PatientRole ] ;
    prov:startedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
