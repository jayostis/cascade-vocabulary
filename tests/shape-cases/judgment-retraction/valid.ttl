@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix npx: <http://purl.org/nanopub/x/> .

:alex a prov:Person .

:retracted a cascade:Judgment ;
    cascade:verdict cascade:Erroneous ;
    prov:hadMember :record ;
    prov:wasAttributedTo :alex ;
    prov:qualifiedAttribution [ prov:agent :alex ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-02-01T00:00:00Z"^^xsd:dateTime .

:retraction a cascade:Judgment ;
    npx:retracts :retracted ;
    prov:wasAttributedTo :alex ;
    prov:qualifiedAttribution [ prov:agent :alex ; prov:hadRole cascade:PatientRole ] ;
    prov:generatedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
