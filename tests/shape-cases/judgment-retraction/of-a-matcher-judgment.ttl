@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:alex a prov:Person .
:matcher a prov:SoftwareAgent .

:matcherJudgment a cascade:Judgment ;
    cascade:verdict cascade:Same ;
    prov:hadMember :one , :other ;
    cascade:justification cascade:SameCode ;
    prov:wasDerivedFrom :oneVersion , :otherVersion ;
    cascade:matcherRule cascade:SameCodeRule ;
    prov:wasAttributedTo :matcher .

:retraction a prov:Activity ;
    prov:invalidated :matcherJudgment ;
    prov:wasAssociatedWith :alex ;
    prov:qualifiedAssociation [ prov:agent :alex ; prov:hadRole cascade:PatientRole ] ;
    prov:startedAtTime "2026-03-01T00:00:00Z"^^xsd:dateTime .
