@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

:release a prov:Entity ;
    cascade:matcherRuleDeclaredWrong cascade:SameMappedCodeRule .

:assertion a cascade:MatcherJudgmentAssertion ;
    cascade:assertedJudgment :judgment ;
    cascade:assertedUnderRuleListVersion :rules1 .

:retraction a prov:Activity ;
    prov:invalidated :assertion ;
    prov:used :release .
