@prefix : <#> .
@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:record a cascade:PrescribedOrReportedMedication ;
    cascade:sourceUrl <https://fhir.example/MedicationRequest/1> .

:version prov:specializationOf :record ;
    cascade:patient :patient ;
    cascade:drugName "lisinopril 10 MG Oral Tablet" ;
    cascade:rxNormCode <https://ns.cascadeprotocol.org/codes/rxnorm/314076> ;
    cascade:workflowStatus "active" ;
    cascade:medicationUseStartDate "2023-06-15"^^xsd:date .
