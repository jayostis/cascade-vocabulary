@prefix h:        <urn:example:alex-rivera:handle:> .
@prefix rec:      <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix health:   <https://ns.cascadeprotocol.org/health/v1#> .
@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix cascade:  <https://ns.cascadeprotocol.org/core/v1#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

[] a health:ConditionRecord ;
  cascade:mergedFrom h:H1-CON-HTN , h:H2O-CON-HTN , h:H2F-CON-HTN ;
  health:conditionName "Essential hypertension" ;
  health:snomedCode <http://snomed.info/sct/38341003> ;
  rec:latestMember h:H2F-CON-HTN ;
  health:status "active" ;
  rec:statusFrom h:H2F-CON-HTN ;
  health:onsetDate "2021-04-02"^^xsd:date .

[] a health:ConditionRecord ;
  cascade:mergedFrom h:H1-CON-BRONCH ;
  health:conditionName "Acute bronchitis" ;
  health:snomedCode <http://snomed.info/sct/10509002> ;
  rec:latestMember h:H1-CON-BRONCH ;
  health:status "resolved" ;
  rec:statusFrom h:H1-CON-BRONCH ;
  clinical:abatementDate "2026-09-20"^^xsd:date ;
  health:onsetDate "2026-08-12"^^xsd:date .

[] a health:ConditionRecord ;
  cascade:mergedFrom h:H2O-CON-ASTHMA , h:H2F-CON-ASTHMA ;
  health:conditionName "Asthma" ;
  health:snomedCode <http://snomed.info/sct/195967001> ;
  rec:latestMember h:H2F-CON-ASTHMA ;
  health:status "active" ;
  rec:statusFrom h:H2F-CON-ASTHMA ;
  health:onsetDate "2008-09-01"^^xsd:date .

[] a health:ConditionRecord ;
  cascade:mergedFrom h:H1-CON-BACK ;
  health:conditionName "Low back pain" ;
  health:snomedCode <http://snomed.info/sct/279039007> ;
  rec:latestMember h:H1-CON-BACK ;
