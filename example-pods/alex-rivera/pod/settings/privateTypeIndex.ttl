@prefix solid:    <http://www.w3.org/ns/solid/terms#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix rec:      <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix health:   <https://ns.cascadeprotocol.org/health/v1#> .
@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix cascade:  <https://ns.cascadeprotocol.org/core/v1#> .

<> a solid:TypeIndex, solid:UnlistedDocument .

<#allergies> a solid:TypeRegistration ; solid:forClass health:AllergyRecord ;
    solid:instance </clinical/allergies.ttl> ; dct:title "Allergies" .
<#conditions> a solid:TypeRegistration ; solid:forClass health:ConditionRecord ;
    solid:instance </clinical/conditions.ttl> ; dct:title "Conditions" .
<#immunizations> a solid:TypeRegistration ; solid:forClass health:ImmunizationRecord ;
    solid:instance </clinical/immunizations.ttl> ; dct:title "Immunizations" .
<#procedures> a solid:TypeRegistration ; solid:forClass clinical:Procedure ;
    solid:instance </clinical/procedures.ttl> ; dct:title "Procedures" .
<#patient-profile> a solid:TypeRegistration ; solid:forClass cascade:PatientProfile ;
    solid:instance </clinical/patient-profile.ttl> ; dct:title "Patient profile" .
<#views> a solid:TypeRegistration ; solid:forClass rec:View ;
    solid:instanceContainer </clinical/> ; dct:title "Rebuildable views" .

<#allergy-records> a solid:TypeRegistration ; solid:forClass health:AllergyRecord ;
    solid:instanceContainer </records/allergies/> ; dct:title "Allergy records" .
<#condition-records> a solid:TypeRegistration ; solid:forClass health:ConditionRecord ;
    solid:instanceContainer </records/conditions/> ; dct:title "Condition records" .
<#immunization-records> a solid:TypeRegistration ; solid:forClass health:ImmunizationRecord ;
    solid:instanceContainer </records/immunizations/> ; dct:title "Immunization records" .
<#procedure-records> a solid:TypeRegistration ; solid:forClass clinical:Procedure ;
    solid:instanceContainer </records/procedures/> ; dct:title "Procedure records" .
