PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

SELECT ?performed ?procedure ?snomed ?status (COUNT(?record) AS ?records) ?label ?entry
WHERE {
  ?entry a clinical:Procedure ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry clinical:procedureDate ?performed }
  OPTIONAL { ?entry clinical:procedureName ?procedure }
  OPTIONAL { ?entry clinical:snomedCode ?snomed }
  OPTIONAL { ?entry clinical:status ?status }
  OPTIONAL { ?entry rdfs:label ?label }
}
GROUP BY ?entry ?performed ?procedure ?snomed ?status ?label
ORDER BY DESC(?performed) ?procedure
