PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

CONSTRUCT { ?thing rdfs:label ?label }
WHERE {
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      VALUES (?type ?kind) { (health:AllergyRecord "Allergy") (health:ConditionRecord "Condition")
                             (health:ImmunizationRecord "Immunization") (clinical:Procedure "Procedure") }
      ?thing a ?type ; pav:hasCurrentVersion ?v ; rec:currentRevision ?r .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?v health:allergen ?n1 }
      OPTIONAL { ?v health:conditionName ?n2 }
      OPTIONAL { ?v health:vaccineName ?n3 }
      OPTIONAL { ?v clinical:procedureName ?n4 }
      OPTIONAL { ?r prov:wasDerivedFrom ?doc }
      OPTIONAL { ?r prov:wasDerivedFrom/prov:qualifiedAttribution ?a .
                 ?a prov:hadRole rec:author ; prov:agent/rdfs:label ?author }
      BIND (CONCAT(?kind, " · ", COALESCE(?n1, ?n2, ?n3, ?n4, "no name"), " · ",
                   COALESCE(?author, IF(BOUND(?doc), "unknown source", "own entry"))) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      VALUES (?type ?kind) { (health:AllergyRecord "Allergy") (health:ConditionRecord "Condition")
                             (health:ImmunizationRecord "Immunization") (clinical:Procedure "Procedure") }
      ?thing prov:specializationOf ?record .
      ?record a ?type .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing health:allergen ?n1 }
      OPTIONAL { ?thing health:conditionName ?n2 }
      OPTIONAL { ?thing health:vaccineName ?n3 }
      OPTIONAL { ?thing clinical:procedureName ?n4 }
      OPTIONAL { ?thing clinical:status ?s1 }
      OPTIONAL { ?thing health:status ?s2 }
      OPTIONAL { ?thing clinical:verificationStatus ?s3 }
      OPTIONAL { ?thing clinical:criticality ?c }
      OPTIONAL { ?thing health:administrationDate ?d1 }
      OPTIONAL { ?thing clinical:procedureDate ?d2 }
      BIND (CONCAT(?kind, " version · ", COALESCE(?n1, ?n2, ?n3, ?n4, "no name"), " · ",
                   COALESCE(?s1, ?s2, ?s3, CONCAT("criticality ", ?c), STR(?d1), STR(?d2), "nothing stated")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a rec:Revision ; rec:version ?v ; prov:generatedAtTime ?t .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?v health:allergen ?n1 }
      OPTIONAL { ?v health:conditionName ?n2 }
      OPTIONAL { ?v health:vaccineName ?n3 }
      OPTIONAL { ?v clinical:procedureName ?n4 }
      BIND (CONCAT("Revision · ", COALESCE(?n1, ?n2, ?n3, ?n4, "no name"), " · received ",
                   SUBSTR(STR(?t), 1, 10)) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?revision a rec:Revision ; prov:wasDerivedFrom ?thing .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing prov:qualifiedAttribution ?a .
                 ?a prov:hadRole rec:author ; prov:agent/rdfs:label ?author }
      OPTIONAL { ?thing pav:retrievedFrom ?from }
      BIND (CONCAT("Document · ", COALESCE(?author, "unknown source"),
                   COALESCE(CONCAT(" · ", REPLACE(STR(?from), "^.*/([^/]+/[^/]+)$", "$1")), "")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a jdg:Judgment ; prov:generatedAtTime ?t ; prov:wasAttributedTo ?who .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing jdg:verdict ?verdict }
      OPTIONAL { ?who rdfs:label ?machine }
      OPTIONAL { ?thing prov:qualifiedAttribution/prov:hadRole ?role }
      BIND (CONCAT(COALESCE(REPLACE(STR(?verdict), "^.*#", ""), "Retraction"), " · ",
                   COALESCE(?machine, IF(?role = jdg:patient, "the patient", "a person")), " · ",
                   SUBSTR(STR(?t), 1, 10)) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing prov:specializationOf ?series ; pav:version ?version .
      ?series a rec:ReferenceSeries ; rdfs:label ?name .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      BIND (CONCAT(?name, " · ", ?version) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      VALUES (?type ?kind) { (health:AllergyRecord "Allergy entry") (health:ConditionRecord "Condition entry")
                             (health:ImmunizationRecord "Immunization entry") (clinical:Procedure "Procedure entry")
                             (cascade:PatientProfile "Patient entry") }
      ?thing a ?type ; cascade:mergedFrom [] .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing health:allergen ?n1 }
      OPTIONAL { ?thing health:conditionName ?n2 }
      OPTIONAL { ?thing health:vaccineName ?n3 }
      OPTIONAL { ?thing clinical:procedureName ?n4 }
      BIND (CONCAT(?kind, COALESCE(CONCAT(" · ", COALESCE(?n1, ?n2, ?n3, ?n4)), "")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?version rec:patient ?thing .
      FILTER NOT EXISTS { ?thing a rec:Subject }
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?revision rec:version ?version ; prov:wasDerivedFrom/prov:qualifiedAttribution ?a .
                 ?a prov:hadRole rec:author ; prov:agent/rdfs:label ?author }
      BIND (CONCAT("Patient profile · ", COALESCE(?author, "unknown source")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a rec:Subject .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      BIND ("The person this pod is about" AS ?l)
    }
    GROUP BY ?thing }
}
