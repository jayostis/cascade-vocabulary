PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

CONSTRUCT {
  ?entry a health:ConditionRecord ;
    health:conditionName ?name ;
    health:snomedCode ?snomed ;
    health:icd10Code ?icd10 ;
    health:status ?status ;
    clinical:abatementDate ?abatement ;
    health:onsetDate ?onset ;
    rec:latestMember ?latest ;
    rec:statusFrom ?statusFrom ;
    cascade:mergedFrom ?record .
}
WHERE {
  ?record a health:ConditionRecord ; rec:inEntry ?entry .
  ?entry rec:latestMember ?latest .
  OPTIONAL { ?latest pav:hasCurrentVersion/health:conditionName ?name }
  OPTIONAL { ?latest pav:hasCurrentVersion/health:snomedCode ?snomed }
  OPTIONAL { ?latest pav:hasCurrentVersion/health:icd10Code ?icd10 }
  OPTIONAL { ?entry rec:statusFrom ?statusFrom .
             ?statusFrom pav:hasCurrentVersion/health:status ?status }
  OPTIONAL { ?entry rec:statusFrom/pav:hasCurrentVersion/clinical:abatementDate ?abatement }
  OPTIONAL { ?entry rec:dateFrom/pav:hasCurrentVersion/health:onsetDate ?onset }
}
