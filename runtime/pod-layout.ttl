@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix pim: <http://www.w3.org/ns/pim/space#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix solid: <http://www.w3.org/ns/solid/terms#> .

[] a cascade:Placement ; solid:forClass cascade:Subject ; solid:instanceContainer <subject/> ; cascade:subfolderPrefixLength 2 .

[] a cascade:Placement ; solid:forClass cascade:AllergyOrIntolerance ; solid:instanceContainer <records/allergies/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:ProblemOrDiagnosis ; solid:instanceContainer <records/conditions/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:Vaccination ; solid:instanceContainer <records/immunizations/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:MedicalProcedure ; solid:instanceContainer <records/procedures/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:PrescribedOrReportedMedication ; solid:instanceContainer <records/medications/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:LaboratoryTestResult ; solid:instanceContainer <records/lab-results/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:GeneticVariantFinding ; solid:instanceContainer <records/variants/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:VariantInterpretation ; solid:instanceContainer <records/variant-interpretations/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:PatientProfile ; solid:instanceContainer <records/patient-profile/> ; cascade:subfolderPrefixLength 2 .

[] a cascade:Placement ; cascade:filedWith prov:specializationOf ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; cascade:filedWith cascade:revisionOf ; cascade:subfolderPrefixLength 2 .

[] a cascade:Placement ; solid:forClass prov:Activity ; solid:instanceContainer <provenance/activities/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass prov:Activity ; cascade:forSubjectsOf prov:used ; solid:instanceContainer <provenance/imports/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass prov:Entity ; solid:instanceContainer <provenance/documents/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; cascade:storesBytes true ; solid:instanceContainer <attachments/sha-256/> .

[] a cascade:Placement ; solid:forClass cascade:Judgment ; solid:instanceContainer <judgments/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:ClaimAssertion ; solid:instanceContainer <judgments/assertions/> ; cascade:subfolderPrefixLength 2 .
[] a cascade:Placement ; solid:forClass cascade:ReferenceSeries ; solid:instanceContainer <references/> ; cascade:subfolderPrefixLength 2 .

[] a cascade:Placement ; solid:forClass cascade:View ; solid:instanceContainer <clinical/> ; dct:title "Rebuildable views" .
[] a cascade:Placement ; solid:forClass cascade:AllergyOrIntolerance ; solid:instance <clinical/allergies.ttl> ;
   cascade:writtenByQueryPath "views/allergies.rq" ; dct:title "Allergies" .
[] a cascade:Placement ; solid:forClass cascade:ProblemOrDiagnosis ; solid:instance <clinical/conditions.ttl> ;
   cascade:writtenByQueryPath "views/conditions.rq" ; dct:title "Conditions" .
[] a cascade:Placement ; solid:forClass cascade:Vaccination ; solid:instance <clinical/immunizations.ttl> ;
   cascade:writtenByQueryPath "views/immunizations.rq" ; dct:title "Immunizations" .
[] a cascade:Placement ; solid:forClass cascade:MedicalProcedure ; solid:instance <clinical/procedures.ttl> ;
   cascade:writtenByQueryPath "views/procedures.rq" ; dct:title "Procedures" .
[] a cascade:Placement ; solid:forClass cascade:PrescribedOrReportedMedication ; solid:instance <clinical/medications.ttl> ;
   cascade:writtenByQueryPath "views/medications.rq" ; dct:title "Medications" .
[] a cascade:Placement ; solid:forClass cascade:LaboratoryTestResult ; solid:instance <clinical/lab-results.ttl> ;
   cascade:writtenByQueryPath "views/lab-results.rq" ; dct:title "Lab results" .
[] a cascade:Placement ; solid:forClass cascade:GeneticVariantFinding ; solid:instance <clinical/variants.ttl> ;
   cascade:writtenByQueryPath "views/variants.rq" ; dct:title "Variants" .
[] a cascade:Placement ; solid:forClass cascade:VariantInterpretation ; solid:instance <clinical/variant-interpretations.ttl> ;
   cascade:writtenByQueryPath "views/variant-interpretations.rq" ; dct:title "Variant interpretations" .
[] a cascade:Placement ; solid:forClass cascade:PatientProfile ; solid:instance <clinical/patient-profile.ttl> ;
   cascade:writtenByQueryPath "views/patient-profile.rq" ; cascade:writtenAlways true ; dct:title "Patient profile" .
[] a cascade:Placement ; solid:instance <clinical/labels.ttl> ; cascade:writtenByQueryPath "labels.rq" .

[] a cascade:Placement ; solid:forClass foaf:PersonalProfileDocument ; solid:instance <profile/card.ttl> .
[] a cascade:Placement ; solid:forClass pim:ConfigurationFile ; solid:instance <settings/preferences> .
[] a cascade:Placement ; solid:forClass solid:TypeIndex ; solid:instance <settings/privateTypeIndex.ttl> .
[] a cascade:Placement ; solid:forClass cascade:PodManifest ; solid:instance <manifest.ttl> .
