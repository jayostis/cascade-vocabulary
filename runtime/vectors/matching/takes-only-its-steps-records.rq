PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?judgment ?justification ?member WHERE {
  GRAPH <urn:cascade:steps> { <urn:cascade:step:match-entry> prov:generated ?file }
  GRAPH ?file { ?judgment jdg:verdict jdg:Same ; jdg:justification ?justification ; prov:hadMember ?member }
  
}
