@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:   <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt:   <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix rec:  <https://ns.cascadeprotocol.org/records/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "runtime rule vectors" ;
  mf:entries (
    <#record-keeps-the-bridges-name>
    <#document-name>
    <#import-is-a-new-uuid>
    <#import-uses-each-kept-document>
    <#first-arrival>
    <#revision-holds-its-arrival>
    <#files-named-from-what-they-hold>
    <#same-bytes-again-writes-nothing>
    <#missing-from-a-later-export>
    <#known-source-version-writes-no-revision>
    <#not-kept-without-revision-or-findings>
    <#import-that-keeps-nothing-writes-nothing>
    <#current-version-again-writes-no-revision>
    <#kept-for-its-findings>
    <#new-content-writes-a-revision-after-the-last>
    <#a-later-revision-keeps-the-earlier>
    <#no-source-version-told-apart-by-content>
    <#change-undone-reuses-its-version>
    <#creation-files-the-subject>
    <#entry-record-name>
    <#two-drafts-of-one-entry-are-two-records>
    <#entry-version-name>
    <#entry-files-each-draft>
    <#entry-session-is-a-new-uuid>
    <#refused-stray-statement>
    <#refused-type-filed-nowhere>
    <#refused-import-disagreement>
    <#refused-entry-of-two-activities>
    <#judgment-name>
    <#takes-only-its-steps-records>
    <#a-record-nobody-is-named-for-is-never-taken>
    <#a-retracted-about-stops-taking>
    <#taken-in-order-and-joining-the-compared>
    <#one-judgment-per-record-per-rule>
    <#a-judgment-cites-what-it-used>
    <#reads-no-persons-judgment>
    <#a-rerun-writes-nothing>
    <#a-retraction-deletes-nothing>
    <#same-code>
    <#same-code-ignores-a-procedures-date>
    <#same-cvx-code-needs-one-date>
    <#vaccine-group-needs-two-codes-and-one-date>
    <#mapped-code-under-the-current-table-only>
    <#shipped-version-until-the-pod-names-one>
    <#reference-description-written-once>
    <#recheck-rederives-a-same-that-still-matches>
    <#recheck-skips-a-retracted-same>
    <#recheck-skips-a-superseded-same>
    <#recheck-skips-a-record-whose-about-was-retracted>
    <#recheck-writes-nothing-when-fewer-than-two-match>
  ) .

<#record-keeps-the-bridges-name> a rec:ReplayTest ;
  mf:name "record-keeps-the-bridges-name" ;
  rdfs:comment "Each record the import wrote has the name the Bridge gave it." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "first-export" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/record-keeps-the-bridges-name.rq> ] ;
  mf:result <arrivals/record-keeps-the-bridges-name.srj> .

<#document-name> a rec:ReplayTest ;
  mf:name "document-name" ;
  rdfs:comment "Each kept document is named by the SHA-256 of its bytes." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "first-export" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/document-name.rq> ] ;
  mf:result <arrivals/document-name.srj> .

<#import-is-a-new-uuid> a rec:ReplayTest ;
  mf:name "import-is-a-new-uuid" ;
  rdfs:comment "The import the step wrote is named by a version 4 UUID, which no input of the story gives." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "first-export" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/import-is-a-new-uuid.rq> ] ;
  mf:result <arrivals/import-is-a-new-uuid.srj> .

<#import-uses-each-kept-document> a rec:ReplayTest ;
  mf:name "import-uses-each-kept-document" ;
  rdfs:comment "An import that kept documents writes its description once: the label, the start and the association the Bridge gave, and prov:used for each kept document." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "first-export" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/import-uses-each-kept-document.rq> ] ;
  mf:result <arrivals/import-uses-each-kept-document.srj> .

<#first-arrival> a rec:ReplayTest ;
  mf:name "first-arrival" ;
  rdfs:comment "A record's first arrival writes the record, its version, and a revision that follows none." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "first-export" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/first-arrival.rq> ] ;
  mf:result <arrivals/first-arrival.srj> .

<#revision-holds-its-arrival> a rec:ReplayTest ;
  mf:name "revision-holds-its-arrival" ;
  rdfs:comment "A revision holds its own five statements and every statement on its arrival but bridge:arrivedAs and prov:wasGeneratedBy; the import that generated it is shown as the step that made it." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "first-export" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/revision-holds-its-arrival.rq> ] ;
  mf:result <arrivals/revision-holds-its-arrival.srj> .

<#files-named-from-what-they-hold> a rec:ReplayTest ;
  mf:name "files-named-from-what-they-hold" ;
  rdfs:comment "Each file a step writes is named from the name of what it holds: a UUID, or a hash in lowercase hex; an RDF file adds .ttl and a stored document adds nothing." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "first-export" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/files-named-from-what-they-hold.rq> ] ;
  mf:result <arrivals/files-named-from-what-they-hold.srj> .

<#same-bytes-again-writes-nothing> a rec:ReplayTest ;
  mf:name "same-bytes-again-writes-nothing" ;
  rdfs:comment "A document whose bytes the pod already keeps is not converted, and its import writes nothing; the story saves no Bridge output for it." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "same-bytes" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/same-bytes-again-writes-nothing.rq> ] ;
  mf:result <arrivals/same-bytes-again-writes-nothing.srj> .

<#missing-from-a-later-export> a rec:ReplayTest ;
  mf:name "missing-from-a-later-export" ;
  rdfs:comment "Records missing from a later export keep everything they had, and get nothing." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "same-bytes" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/missing-from-a-later-export.rq> ] ;
  mf:result <arrivals/missing-from-a-later-export.srj> .

<#known-source-version-writes-no-revision> a rec:ReplayTest ;
  mf:name "known-source-version-writes-no-revision" ;
  rdfs:comment "An arrival whose source version a revision of the record already carries writes no revision, though its content differs." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "known-source-version" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/known-source-version-writes-no-revision.rq> ] ;
  mf:result <arrivals/known-source-version-writes-no-revision.srj> .

<#not-kept-without-revision-or-findings> a rec:ReplayTest ;
  mf:name "not-kept-without-revision-or-findings" ;
  rdfs:comment "A document that wrote no revision and on which the Bridge raised no findings is not kept: nothing names it, and the step wrote no file." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "known-source-version" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/not-kept-without-revision-or-findings.rq> ] ;
  mf:result <arrivals/not-kept-without-revision-or-findings.srj> .

<#import-that-keeps-nothing-writes-nothing> a rec:ReplayTest ;
  mf:name "import-that-keeps-nothing-writes-nothing" ;
  rdfs:comment "An import that kept no document writes nothing, not even itself." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "known-source-version" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/import-that-keeps-nothing-writes-nothing.rq> ] ;
  mf:result <arrivals/import-that-keeps-nothing-writes-nothing.srj> .

<#current-version-again-writes-no-revision> a rec:ReplayTest ;
  mf:name "current-version-again-writes-no-revision" ;
  rdfs:comment "An arrival whose version is the one the record is at writes no revision, though its source version is new." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "current-version-again" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/current-version-again-writes-no-revision.rq> ] ;
  mf:result <arrivals/current-version-again-writes-no-revision.srj> .

<#kept-for-its-findings> a rec:ReplayTest ;
  mf:name "kept-for-its-findings" ;
  rdfs:comment "A document that wrote no revision is kept when the Bridge raised findings on it: its bytes and its description, and the import that used it." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "current-version-again" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/kept-for-its-findings.rq> ] ;
  mf:result <arrivals/kept-for-its-findings.srj> .

<#new-content-writes-a-revision-after-the-last> a rec:ReplayTest ;
  mf:name "new-content-writes-a-revision-after-the-last" ;
  rdfs:comment "An arrival of new content under a new source version writes a revision after the record's last." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "new-content" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/new-content-writes-a-revision-after-the-last.rq> ] ;
  mf:result <arrivals/new-content-writes-a-revision-after-the-last.srj> .

<#a-later-revision-keeps-the-earlier> a rec:ReplayTest ;
  mf:name "a-later-revision-keeps-the-earlier" ;
  rdfs:comment "A later revision leaves the earlier revision and version in the files the earlier step wrote." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "new-content" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/a-later-revision-keeps-the-earlier.rq> ] ;
  mf:result <arrivals/a-later-revision-keeps-the-earlier.srj> .

<#no-source-version-told-apart-by-content> a rec:ReplayTest ;
  mf:name "no-source-version-told-apart-by-content" ;
  rdfs:comment "Arrivals with no source version write a revision for new content and none for the content the record is at." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "no-source-version-again" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/no-source-version-told-apart-by-content.rq> ] ;
  mf:result <arrivals/no-source-version-told-apart-by-content.srj> .

<#change-undone-reuses-its-version> a rec:ReplayTest ;
  mf:name "change-undone-reuses-its-version" ;
  rdfs:comment "A change undone at its source writes a revision that points at the earlier version again." ;
  mf:action [ rec:story <arrivals/story.json> ; rec:step "change-undone" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <arrivals/change-undone-reuses-its-version.rq> ] ;
  mf:result <arrivals/change-undone-reuses-its-version.srj> .

<#creation-files-the-subject> a rec:ReplayTest ;
  mf:name "creation-files-the-subject" ;
  rdfs:comment "The pod's creation writes the subject as a rec:Subject." ;
  mf:action [ rec:story <entries/story.json> ; rec:step "create" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <entries/creation-files-the-subject.rq> ] ;
  mf:result <entries/creation-files-the-subject.srj> .

<#entry-record-name> a rec:ReplayTest ;
  mf:name "entry-record-name" ;
  rdfs:comment "An entry's record is named by the record rule from the subject, the entry's start in UTC and the draft's position, and not from its session." ;
  mf:action [ rec:story <entries/story.json> ; rec:step "entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <entries/entry-record-name.rq> ] ;
  mf:result <entries/entry-record-name.srj> .

<#two-drafts-of-one-entry-are-two-records> a rec:ReplayTest ;
  mf:name "two-drafts-of-one-entry-are-two-records" ;
  rdfs:comment "Each draft of one entry becomes a record of its own." ;
  mf:action [ rec:story <entries/story.json> ; rec:step "entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <entries/two-drafts-of-one-entry-are-two-records.rq> ] ;
  mf:result <entries/two-drafts-of-one-entry-are-two-records.srj> .

<#entry-version-name> a rec:ReplayTest ;
  mf:name "entry-version-name" ;
  rdfs:comment "An entry's version is named from its content by the versioning rule, a reference to a draft record replaced by that record's name." ;
  mf:action [ rec:story <entries/story.json> ; rec:step "entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <entries/entry-version-name.rq> ] ;
  mf:result <entries/entry-version-name.srj> .

<#entry-files-each-draft> a rec:ReplayTest ;
  mf:name "entry-files-each-draft" ;
  rdfs:comment "An entry writes its session's description, and for each draft a record, its version and a first revision at the session's start, generated by the session." ;
  mf:action [ rec:story <entries/story.json> ; rec:step "entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <entries/entry-files-each-draft.rq> ] ;
  mf:result <entries/entry-files-each-draft.srj> .

<#entry-session-is-a-new-uuid> a rec:ReplayTest ;
  mf:name "entry-session-is-a-new-uuid" ;
  rdfs:comment "The entry's session, scripted as urn:cascade:this-entry, is named by a version 4 UUID." ;
  mf:action [ rec:story <entries/story.json> ; rec:step "entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <entries/entry-session-is-a-new-uuid.rq> ] ;
  mf:result <entries/entry-session-is-a-new-uuid.srj> .

<#refused-stray-statement> a rec:ReplayTest ;
  mf:name "refused-stray-statement" ;
  rdfs:comment "A Bridge graph holding a statement about no record, version, arrival, document or import is refused, and its step writes nothing." ;
  mf:action [ rec:story <refusals/story.json> ; rec:step "stray-statement" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <refusals/refused-stray-statement.rq> ] ;
  mf:result <refusals/refused-stray-statement.srj> .

<#refused-type-filed-nowhere> a rec:ReplayTest ;
  mf:name "refused-type-filed-nowhere" ;
  rdfs:comment "A record of a type the pod files nowhere is refused, and its step writes nothing." ;
  mf:action [ rec:story <refusals/story.json> ; rec:step "type-filed-nowhere" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <refusals/refused-type-filed-nowhere.rq> ] ;
  mf:result <refusals/refused-type-filed-nowhere.srj> .

<#refused-import-disagreement> a rec:ReplayTest ;
  mf:name "refused-import-disagreement" ;
  rdfs:comment "One import's documents disagreeing on the import's description are refused, and the step writes nothing, neither the revision the agreeing document would write nor the import." ;
  mf:action [ rec:story <refusals/story.json> ; rec:step "import-disagreement" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <refusals/refused-import-disagreement.rq> ] ;
  mf:result <refusals/refused-import-disagreement.srj> .

<#refused-entry-of-two-activities> a rec:ReplayTest ;
  mf:name "refused-entry-of-two-activities" ;
  rdfs:comment "An entry holding two activities is refused, and its step writes nothing." ;
  mf:action [ rec:story <refusals/story.json> ; rec:step "entry-of-two-activities" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <refusals/refused-entry-of-two-activities.rq> ] ;
  mf:result <refusals/refused-entry-of-two-activities.srj> .

<#judgment-name> a rec:ReplayTest ;
  mf:name "judgment-name" ;
  rdfs:comment "A matcher judgment is named by the record rule from the matcher, its justification, its members' names sorted and the sorted names of what it used." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/judgment-name.rq> ] ;
  mf:result <matching/judgment-name.srj> .

<#takes-only-its-steps-records> a rec:ReplayTest ;
  mf:name "takes-only-its-steps-records" ;
  rdfs:comment "A matcher run takes only the records whose first revision came from the step it names: each judgment holds one of the entry's records, and the import's two codeine records are never judged together." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/takes-only-its-steps-records.rq> ] ;
  mf:result <matching/takes-only-its-steps-records.srj> .

<#a-record-nobody-is-named-for-is-never-taken> a rec:ReplayTest ;
  mf:name "a-record-nobody-is-named-for-is-never-taken" ;
  rdfs:comment "A record whose patient is no profile the subject's About names, or which names no patient, is never taken nor compared." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-third-entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/a-record-nobody-is-named-for-is-never-taken.rq> ] ;
  mf:result <matching/a-record-nobody-is-named-for-is-never-taken.srj> .

<#a-retracted-about-stops-taking> a rec:ReplayTest ;
  mf:name "a-retracted-about-stops-taking" ;
  rdfs:comment "While an About names a profile, the matcher takes its records; once the About is retracted it takes none, and compares none." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-third-entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/a-retracted-about-stops-taking.rq> ] ;
  mf:result <matching/a-retracted-about-stops-taking.srj> .

<#taken-in-order-and-joining-the-compared> a rec:ReplayTest ;
  mf:name "taken-in-order-and-joining-the-compared" ;
  rdfs:comment "Records are taken in order of arrival, then by name; each is compared with the subject's other records and then joins them, so three records of one code are two judgments." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/taken-in-order-and-joining-the-compared.rq> ] ;
  mf:result <matching/taken-in-order-and-joining-the-compared.srj> .

<#one-judgment-per-record-per-rule> a rec:ReplayTest ;
  mf:name "one-judgment-per-record-per-rule" ;
  rdfs:comment "A record matching under two rules gets a judgment for each, holding the record and everything it matched under that rule." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/one-judgment-per-record-per-rule.rq> ] ;
  mf:result <matching/one-judgment-per-record-per-rule.srj> .

<#a-judgment-cites-what-it-used> a rec:ReplayTest ;
  mf:name "a-judgment-cites-what-it-used" ;
  rdfs:comment "A matcher judgment is a Same with its rule's justification, using the rule list's version, the table's version and each member's current version, attributed to the matcher at the run's time." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/a-judgment-cites-what-it-used.rq> ] ;
  mf:result <matching/a-judgment-cites-what-it-used.srj> .

<#reads-no-persons-judgment> a rec:ReplayTest ;
  mf:name "reads-no-persons-judgment" ;
  rdfs:comment "The matcher reads no person's Same or Different: it joins the pair a person called Different, and does not join the pair a person called the Same." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/reads-no-persons-judgment.rq> ] ;
  mf:result <matching/reads-no-persons-judgment.srj> .

<#a-rerun-writes-nothing> a rec:ReplayTest ;
  mf:name "a-rerun-writes-nothing" ;
  rdfs:comment "Running the matcher again on the same step writes nothing, since the pod holds each judgment of that name." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-entry-again" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/a-rerun-writes-nothing.rq> ] ;
  mf:result <matching/a-rerun-writes-nothing.srj> .

<#a-retraction-deletes-nothing> a rec:ReplayTest ;
  mf:name "a-retraction-deletes-nothing" ;
  rdfs:comment "A retraction leaves the judgment it retracts in the file its step wrote." ;
  mf:action [ rec:story <matching/story.json> ; rec:step "match-third-entry" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matching/a-retraction-deletes-nothing.rq> ] ;
  mf:result <matching/a-retraction-deletes-nothing.srj> .

<#same-code> a rec:ReplayTest ;
  mf:name "same-code" ;
  rdfs:comment "Two allergies with one code are the Same by code; one with another code joins neither." ;
  mf:action [ rec:story <comparisons/story.json> ; rec:step "match-pairs" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <comparisons/same-code.rq> ] ;
  mf:result <comparisons/same-code.srj> .

<#same-code-ignores-a-procedures-date> a rec:ReplayTest ;
  mf:name "same-code-ignores-a-procedures-date" ;
  rdfs:comment "Two procedures of one code are the Same by code whatever their dates." ;
  mf:action [ rec:story <comparisons/story.json> ; rec:step "match-pairs" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <comparisons/same-code-ignores-a-procedures-date.rq> ] ;
  mf:result <comparisons/same-code-ignores-a-procedures-date.srj> .

<#same-cvx-code-needs-one-date> a rec:ReplayTest ;
  mf:name "same-cvx-code-needs-one-date" ;
  rdfs:comment "Two immunizations of one CVX code on one date are the Same by code and date; one on another date joins neither." ;
  mf:action [ rec:story <comparisons/story.json> ; rec:step "match-pairs" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <comparisons/same-cvx-code-needs-one-date.rq> ] ;
  mf:result <comparisons/same-cvx-code-needs-one-date.srj> .

<#vaccine-group-needs-two-codes-and-one-date> a rec:ReplayTest ;
  mf:name "vaccine-group-needs-two-codes-and-one-date" ;
  rdfs:comment "Two immunizations of different CVX codes in one vaccine group on one date are the Same by mapped code and date; a third on another date joins none, and a fourth of the first's code on its date is the Same as it by code and date." ;
  mf:action [ rec:story <comparisons/story.json> ; rec:step "match-pairs" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <comparisons/vaccine-group-needs-two-codes-and-one-date.rq> ] ;
  mf:result <comparisons/vaccine-group-needs-two-codes-and-one-date.srj> .

<#mapped-code-under-the-current-table-only> a rec:ReplayTest ;
  mf:name "mapped-code-under-the-current-table-only" ;
  rdfs:comment "Codes are mapped only by the current version of the ingredient map: a pair the old version maps is not mapped once the new one arrives, and a pair only the new one maps is mapped only then." ;
  mf:action [ rec:story <comparisons/story.json> ; rec:step "match-later" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <comparisons/mapped-code-under-the-current-table-only.rq> ] ;
  mf:result <comparisons/mapped-code-under-the-current-table-only.srj> .

<#shipped-version-until-the-pod-names-one> a rec:ReplayTest ;
  mf:name "shipped-version-until-the-pod-names-one" ;
  rdfs:comment "A table's current version is the one its series ships with until the pod names one, though the series lists a later version." ;
  mf:action [ rec:story <comparisons/story.json> ; rec:step "match-later" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <comparisons/shipped-version-until-the-pod-names-one.rq> ] ;
  mf:result <comparisons/shipped-version-until-the-pod-names-one.srj> .

<#reference-description-written-once> a rec:ReplayTest ;
  mf:name "reference-description-written-once" ;
  rdfs:comment "A reference series or version is described only by the first step that finds the pod lacking it." ;
  mf:action [ rec:story <comparisons/story.json> ; rec:step "match-later" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <comparisons/reference-description-written-once.rq> ] ;
  mf:result <comparisons/reference-description-written-once.srj> .

<#recheck-rederives-a-same-that-still-matches> a rec:ReplayTest ;
  mf:name "recheck-rederives-a-same-that-still-matches" ;
  rdfs:comment "A recheck reruns the rule of a Same that used a since-revised table version, under the current version, and writes a new judgment when its members still match." ;
  mf:action [ rec:story <rechecks/story.json> ; rec:step "recheck" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <rechecks/recheck-rederives-a-same-that-still-matches.rq> ] ;
  mf:result <rechecks/recheck-rederives-a-same-that-still-matches.srj> .

<#recheck-skips-a-retracted-same> a rec:ReplayTest ;
  mf:name "recheck-skips-a-retracted-same" ;
  rdfs:comment "A recheck skips a Same a person retracted." ;
  mf:action [ rec:story <rechecks/story.json> ; rec:step "recheck" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <rechecks/recheck-skips-a-retracted-same.rq> ] ;
  mf:result <rechecks/recheck-skips-a-retracted-same.srj> .

<#recheck-skips-a-superseded-same> a rec:ReplayTest ;
  mf:name "recheck-skips-a-superseded-same" ;
  rdfs:comment "A recheck skips a Same a person superseded." ;
  mf:action [ rec:story <rechecks/story.json> ; rec:step "recheck" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <rechecks/recheck-skips-a-superseded-same.rq> ] ;
  mf:result <rechecks/recheck-skips-a-superseded-same.srj> .

<#recheck-skips-a-record-whose-about-was-retracted> a rec:ReplayTest ;
  mf:name "recheck-skips-a-record-whose-about-was-retracted" ;
  rdfs:comment "A recheck runs only on members still the subject's: once the About naming their profile is retracted, fewer than two remain and nothing is written." ;
  mf:action [ rec:story <rechecks/story.json> ; rec:step "recheck" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <rechecks/recheck-skips-a-record-whose-about-was-retracted.rq> ] ;
  mf:result <rechecks/recheck-skips-a-record-whose-about-was-retracted.srj> .

<#recheck-writes-nothing-when-fewer-than-two-match> a rec:ReplayTest ;
  mf:name "recheck-writes-nothing-when-fewer-than-two-match" ;
  rdfs:comment "A recheck writes nothing when fewer than two members still match under the current table." ;
  mf:action [ rec:story <rechecks/story.json> ; rec:step "recheck" ;
              rec:lens <../../queries/v1-draft/lenses/everyday.rq> ; qt:query <rechecks/recheck-writes-nothing-when-fewer-than-two-match.rq> ] ;
  mf:result <rechecks/recheck-writes-nothing-when-fewer-than-two-match.srj> .
