PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?record ?version ?previous WHERE {
  GRAPH <urn:cascade:steps> { <urn:cascade:step:first-export> prov:generated ?revisionFile }
  GRAPH <urn:cascade:steps> { <urn:cascade:step:first-export> prov:generated ?recordFile }
  GRAPH <urn:cascade:steps> { <urn:cascade:step:first-export> prov:generated ?versionFile }
  GRAPH ?revisionFile { ?revision a rec:Revision ; rec:revisionOf ?record ; rec:version ?version }
  GRAPH ?recordFile { ?record a health:AllergyRecord }
  GRAPH ?versionFile { ?version prov:specializationOf ?record }
  OPTIONAL { ?revision prov:wasRevisionOf ?previous }
}
