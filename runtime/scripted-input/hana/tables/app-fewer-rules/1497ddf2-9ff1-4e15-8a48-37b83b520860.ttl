@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .

[] a cascade:RuleListRow ;
    cascade:matcherRule cascade:SameCodeRule ;
    cascade:justifiedAs cascade:SameCode ;
    cascade:appliesToClass cascade:AllergyOrIntolerance , cascade:ProblemOrDiagnosis , cascade:MedicalProcedure ;
    cascade:queryPath "matcher/same-code-key-joined-first.rq" ;
    cascade:queryHash <ni:///sha-256;PtacLM96Yory4_mNGaK_q4nKG5-fcbVXCC7VG9GvJ8A> .

[] a cascade:RuleListRow ;
    cascade:matcherRule cascade:SameCodeAndDateRule ;
    cascade:justifiedAs cascade:SameCodeAndDate ;
    cascade:appliesToClass cascade:Vaccination ;
    cascade:queryPath "matcher/same-code-and-day-or-exact-time-key-joined-first.rq" ;
    cascade:queryHash <ni:///sha-256;0E5zHKTOkifZGyJtEwkEBA0pg68CqP0NUnwOKj5pihM> .

[] a cascade:RuleListRow ;
    cascade:matcherRule cascade:SameMappedCodeAndDateRule ;
    cascade:justifiedAs cascade:SameMappedCodeAndDate ;
    cascade:appliesToClass cascade:Vaccination ;
    cascade:queryPath "matcher/same-vaccine-group-and-day-or-exact-time-key-joined-first.rq" ;
    cascade:queryHash <ni:///sha-256;lgd3O6yiXdxGNbIs0Hbd9rcGoUldtRoe8tc5uNk0_oQ> ;
    cascade:tableKind cascade:VaccineGroups .

[] a cascade:RuleListRow ;
    cascade:matcherRule cascade:SameConvertedCodeRule ;
    cascade:justifiedAs cascade:SameConvertedCode ;
    cascade:appliesToClass cascade:ProblemOrDiagnosis ;
    cascade:queryPath "matcher/same-one-to-one-conversion-key-joined-first.rq" ;
    cascade:queryHash <ni:///sha-256;TqDyY-KcfgYP99boWyQd5ZJhy6jMYJaNJc--SLRsuBo> ;
    cascade:tableKind cascade:CodeConversions .
