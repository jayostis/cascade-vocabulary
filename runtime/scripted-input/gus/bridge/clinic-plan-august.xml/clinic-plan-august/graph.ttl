<ni:///sha-256;lncFQ0JulfgXSp2jPRtD538v_Y7VT3oDlvtzm2aLzYE> cascade:noteOrDocumentTypeName "Plan of care note" ;
	cascade:workflowStatus "current" ;
	cascade:noteOrDocumentTitle "Plan of treatment, August 12" ;
	cascade:narrativeText "Fatigue for two months and pale skin on examination. Check a vitamin B12 level, a folate level and a complete blood count today; keep a food diary, and return in four weeks to go over the results with Elena Marsh, MD.\nAugust 12, 2026 (follow-up, Elena Marsh, MD): vitamin B12 low at 180 pg/mL. Start cyanocobalamin 1000 mcg by mouth daily and recheck the level in three months.\nReturn in 3 months." ;
	cascade:noteOrDocumentDate "2026-08-12T09:00:00-05:00"^^xsd:dateTime ;
	cascade:noteOrDocumentType <http://loinc.org/rdf/18776-5> .
