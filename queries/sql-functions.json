{
  "about": "The six functions a .sql may call where SQLite has no answer of its own, each registered under its name, and the vectors every implementation reproduces: for each input, the output Oxigraph's SPARQL gives, null where it gives an unbound value. Strings are lexical forms; sparql_compare's inputs are terms in N-Triples form.",
  "functions": {
    "sparql_replace": {
      "sparql": "REPLACE(?text, ?pattern, ?replacement) or REPLACE(?text, ?pattern, ?replacement, ?flags), over strings",
      "vectors": [
        {"input": ["a/b", "[^/]*$", "X"], "output": "a/X"},
        {"input": ["abc", "", "-"], "output": "-a-b-c-"},
        {"input": ["ab\n", "b$", "X"], "output": "ab\n"},
        {"input": ["ab\nc", "b$", "X", "m"], "output": "aX\nc"},
        {"input": ["a\nb", "a.b", "X"], "output": "a\nb"},
        {"input": ["a\nb", "a.b", "X", "s"], "output": "X"},
        {"input": ["a\rb/c", "^.*/", ""], "output": "c"},
        {"input": ["aBc", "b", "X", "i"], "output": "aXc"},
        {"input": ["a.b", ".", "X", "q"], "output": "aXb"},
        {"input": ["a.b", ".", "$0", "q"], "output": "a.b"},
        {"input": ["abc", "(b)", "[$1]"], "output": "a[b]c"},
        {"input": ["abc", "(b)", "[${1}]"], "output": "a[b]c"},
        {"input": ["abc", "(b)", "[$2]"], "output": "a[]c"},
        {"input": ["abc", "(b)", "[$1x]"], "output": "a[]c"},
        {"input": ["abc", "b", "$$"], "output": "a$c"},
        {"input": ["abc", "b", "a$"], "output": "aa$c"},
        {"input": ["abc", "b", "\\$"], "output": "a\\$c"},
        {"input": ["a b", " b", "X", "x"], "output": "a X"},
        {"input": ["https://pod.example/clinical/labs.ttl", "^.*/", ""], "output": "labs.ttl"},
        {"input": ["urn:x:a#b", "^.*[:/#]", ""], "output": "b"},
        {"input": ["a, b, ", ", $", ""], "output": "a, b"},
        {"input": ["x\u001fy\u001f", "\u001f$", ""], "output": "x\u001fy"},
        {"input": ["mg/dL", "(^|[./(])(Y|Z|E|P|T|G|M|k|h|da|d|c|m|u|n|p|f|a|z|y)?l($|[./)0-9+-])", "$1$2L$3"], "output": "mg/dL"},
        {"input": ["  a b  ", "^ +| +$", ""], "output": "a b"},
        {"input": ["Hello, World", "[^a-z0-9]+", "-"], "output": "-ello-orld"},
        {"input": ["host:8080", ":[0-9]*$", ""], "output": "host"},
        {"input": ["abc", "(", "X"], "output": null},
        {"input": ["abc", "b", "X", "k"], "output": null},
        {"input": ["aaa", "a*", "X"], "output": "X"},
        {"input": ["baaac", "a*", "X"], "output": "XbXcX"},
        {"input": ["Éclair", "é", "e", "i"], "output": "eclair"}
      ]
    },
    "sparql_sha256": {
      "sparql": "SHA256(?text)",
      "vectors": [
        {"input": [""], "output": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
        {"input": ["abc"], "output": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"},
        {"input": ["Éclair"], "output": "c1b9327b72ce7375665e9d02988feedeb43251d35c4cf99ed0cc1999bac2ae4b"},
        {"input": ["a\u001fb"], "output": "f04cdced9736a69da6103f08a4daaf8c485dd481217d218a1b4993c8c3968e13"},
        {"input": ["https://pod.example/clinical/immunizations.ttl"], "output": "ee8f5bf910344ec37e4a0cc56e8880b772795a89973882cdd03e4df58fda8582"}
      ]
    },
    "sparql_encode_for_uri": {
      "sparql": "ENCODE_FOR_URI(?text)",
      "vectors": [
        {"input": ["a b/é!*~"], "output": "a%20b%2F%C3%A9%21%2A~"},
        {"input": ["Los Angeles"], "output": "Los%20Angeles"},
        {"input": ["-._~"], "output": "-._~"},
        {"input": ["'()"], "output": "%27%28%29"},
        {"input": ["%"], "output": "%25"},
        {"input": [""], "output": ""},
        {"input": ["😀"], "output": "%F0%9F%98%80"},
        {"input": ["a+b=c&d?e#f"], "output": "a%2Bb%3Dc%26d%3Fe%23f"}
      ]
    },
    "sparql_lcase": {
      "sparql": "LCASE(?text)",
      "vectors": [
        {"input": ["ABC"], "output": "abc"},
        {"input": ["Éclair"], "output": "éclair"},
        {"input": ["ΑΣ ΣΑ"], "output": "ας σα"},
        {"input": ["ΟΔΟΣ."], "output": "οδος."},
        {"input": ["İ"], "output": "i̇"},
        {"input": ["ẞ"], "output": "ß"},
        {"input": ["ǅ"], "output": "ǆ"},
        {"input": ["mixed Case 123"], "output": "mixed case 123"},
        {"input": [""], "output": ""},
        {"input": ["ΣΑΣ"], "output": "σας"},
        {"input": ["Σ"], "output": "σ"}
      ]
    },
    "sparql_decimal": {
      "sparql": "?left + ?right, ?left - ?right, ?left * ?right or ?left / ?right, the operator first, or FLOOR(?left) as \"floor\" and the left alone, over xsd:decimal values",
      "vectors": [
        {"input": ["+", "0.1", "0.2"], "output": "0.3"},
        {"input": ["-", "1", "1.5"], "output": "-0.5"},
        {"input": ["*", "2", "30.4375"], "output": "60.875"},
        {"input": ["*", "7.5", "2"], "output": "15"},
        {"input": ["/", "1", "3"], "output": "0.333333333333333333"},
        {"input": ["/", "2", "3"], "output": "0.666666666666666666"},
        {"input": ["/", "-2", "3"], "output": "-0.666666666666666666"},
        {"input": ["/", "2", "24"], "output": "0.083333333333333333"},
        {"input": ["/", "1", "0"], "output": null},
        {"input": ["/", "36", "1440"], "output": "0.025"},
        {"input": ["*", "0.000000000001", "0.0000001"], "output": null},
        {"input": ["*", "-0.000000000001", "0.0000001"], "output": null},
        {"input": ["*", "1000000000000000000000", "1000000000"], "output": null},
        {"input": ["floor", "2.5"], "output": "2"},
        {"input": ["floor", "-2.5"], "output": "-3"},
        {"input": ["floor", "3"], "output": "3"},
        {"input": ["floor", "-0.5"], "output": "-1"},
        {"input": ["+", "7.50", "0"], "output": "7.5"},
        {"input": ["-", "0.5", "0.5"], "output": "0"},
        {"input": ["*", "1.5", "1.5"], "output": "2.25"},
        {"input": ["+", "abc", "1"], "output": null},
        {"input": ["*", "90", "365.25"], "output": "32872.5"},
        {"input": ["*", "0.1234567891", "0.1234567891"], "output": null},
        {"input": ["*", "0.123456789", "0.123456789"], "output": "0.015241578750190521"},
        {"input": ["*", "0.5", "0.000000000000000001"], "output": null},
        {"input": ["*", "3", "0.333333333333333333"], "output": "0.999999999999999999"},
        {"input": ["/", "1", "0.000000000000000003"], "output": "333333333333333333.333333333333333333"},
        {"input": ["*", "100000000000000000000", "1"], "output": "100000000000000000000"},
        {"input": ["*", "100000000000000000000", "2"], "output": null},
        {"input": ["+", "-0.0", "0"], "output": "0"},
        {"input": ["/", "100", "86400"], "output": "0.001157407407407407"}
      ]
    },
