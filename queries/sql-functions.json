        {"input": ["Éclair", "é", "e", "i"], "output": "eclair"},
        {"input": ["😀", ".", "X"], "output": "X"},
        {"input": ["😀a", "", "-"], "output": "-😀-a-"},
        {"input": ["abab", "(?:ab)+", "X"], "output": "X"},
        {"input": ["a{b}c", "\\{[^{}]*\\}", ""], "output": "ac"},
        {"input": ["aaa", "a*?", "X"], "refused": "a lazy quantifier"},
        {"input": ["aaa", "a*+", "X"], "refused": "a possessive quantifier"},
        {"input": ["abc", "(?=b)", "X"], "refused": "a look-ahead"},
        {"input": ["abc", "(?<n>b)", "[$n]"], "refused": "a named group"},
