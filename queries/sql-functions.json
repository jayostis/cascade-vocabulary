        {"input": ["a\rb/c", "^.*/", ""], "output": "c"},
        {"input": ["aBc", "b", "X", "i"], "output": "aXc"},
        {"input": ["a.b", ".", "X", "q"], "output": "aXb"},
        {"input": ["a.b", ".", "$0", "q"], "output": "a.b"},
        {"input": ["abc", "(b)", "[$1]"], "output": "a[b]c"},
        {"input": ["abc", "(b)", "[${1}]"], "output": "a[b]c"},
        {"input": ["abc", "(b)", "[$2]"], "output": "a[]c"},
        {"input": ["abc", "(b)", "[$1x]"], "output": "a[]c"},
        {"input": ["abc", "b", "$$"], "output": "a$c"},
        {"input": ["abc", "b", "a$"], "output": "aa$c"},
        {"input": ["abc", "b", "\\$"], "output": "a\\$c"},
        {"input": ["a b", " b", "X", "x"], "output": "a X"},
