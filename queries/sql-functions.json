        {"input": ["x\u001fy\u001f", "\u001f$", ""], "output": "x\u001fy"},
        {"input": ["mg/dL", "(^|[./(])(Y|Z|E|P|T|G|M|k|h|da|d|c|m|u|n|p|f|a|z|y)?l($|[./)0-9+-])", "$1$2L$3"], "output": "mg/dL"},
        {"input": ["  a b  ", "^ +| +$", ""], "output": "a b"},
