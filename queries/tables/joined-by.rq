# The reference table versions that joined each entry's records. It reads the entries and judgments of the pod, as the pod
# questions do, and the descriptions of the versions the judgments cite. ?entry is an entry of the views and ?used a version
# that a machine's Same counted, under the lens read at, cited (prov:used) while joining one of the entry's records. A cited
# version is a table when its series has a cascade:tableKind: the rule list, which has none, and the revisions of the records
# a Same used never appear. A Same that no longer counts, and one a person's judgment overrides, names nothing. An entry
# joined by Sames that used several tables has a row for each, and one joined without a table has none.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT DISTINCT ?entry ?used
WHERE {
  ?judgment cascade:countsUnderLens true ; cascade:verdict cascade:Same ; prov:wasAttributedTo/a prov:SoftwareAgent ;
            prov:hadMember ?member ; prov:used ?used .
  ?used prov:specializationOf/cascade:tableKind ?kind .
  ?member cascade:inEntry ?entry .
}
ORDER BY ?entry ?used
