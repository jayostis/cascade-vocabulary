# The current version of each note, document or report with a narrative text gives its text as trimmed lines: each run
# of spaces, tabs and carriage returns in a line one space, each line trimmed, and blank lines dropped. The matcher's
# note rules compare these, so the text is worked out once per version and not again in every comparison, bound or not.
# No other kind's text is: the matcher never reads it, and a lab result's would be worked out for every version.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT { ?version cascade:narrativeTextAsTrimmedLines ?lines }
WHERE {
  VALUES ?kind { cascade:DiagnosticReport cascade:ClinicalNoteOrDocument }
  ?record a ?kind ; pav:hasCurrentVersion ?version .
  ?version cascade:narrativeText ?written .
  BIND (REPLACE(REPLACE(REPLACE(STR(?written), "[ \t\r]+", " "), " ?\n[ \n]*", "\n"), "^[ \n]+|[ \n]+$", "") AS ?lines)
}
