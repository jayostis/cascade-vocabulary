# A matcher's claim has lapsed when it does not count, nothing retracts it, no judgment not itself retracted supersedes
# it, and a newer version stopped it counting: a reference version it used has a newer current one, or no current
# version of a rule list pins a query hash it was asserted with. An open adopted newer tables or rules and did not file
# or assert it again, so the pair it joined may now be two entries.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?j cascade:lapsed true }
WHERE {
  { ?j cascade:verdict cascade:Same ; prov:wasAttributedTo cascade:CascadeMatcher ; prov:used ?input .
    ?input prov:specializationOf ?series .
    ?series a cascade:ReferenceSeries ; pav:hasCurrentVersion ?now .
    FILTER (?now != ?input)
    FILTER NOT EXISTS { ?j cascade:countsUnderLens true }
    FILTER NOT EXISTS {
      ?superseding npx:supersedes ?j
      OPTIONAL { ?undoing npx:retracts ?superseding }
      FILTER (!BOUND(?undoing))
    }
    FILTER NOT EXISTS { ?retracting npx:retracts ?j } }
  UNION
  { ?j cascade:verdict cascade:Same ; prov:wasAttributedTo cascade:CascadeMatcher .
    FILTER NOT EXISTS { ?j cascade:countsUnderLens true }
    FILTER NOT EXISTS {
      ?superseding npx:supersedes ?j
      OPTIONAL { ?undoing npx:retracts ?superseding }
      FILTER (!BOUND(?undoing))
    }
    FILTER NOT EXISTS { ?retracting npx:retracts ?j }
    FILTER NOT EXISTS {
      ?assertion cascade:assertedClaim ?j ; cascade:assertedWithQueryHash ?hash .
      ?ruleList pav:hasCurrentVersion ?rules .
      ?rules cascade:queryHash ?hash .
    } }
}
