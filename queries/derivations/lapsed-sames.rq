# A matcher's claim has lapsed when it does not count, nothing retracts it, no judgment not itself retracted replaces
# it, and a newer version stopped it counting: a reference version it used has a newer current one, or no current
# version of a rule list has a row for its rule with the query hash of that rule's row in a version it is asserted
# under. An open adopted newer tables or rules and did not file or assert it again, so the pair it joined may now be
# two entries.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?j cascade:lapsed true }
WHERE {
  { ?j cascade:verdict cascade:Same ; prov:wasAttributedTo cascade:CascadeMatcher ; prov:used ?input .
    ?input prov:specializationOf ?series .
    ?series a cascade:ReferenceSeries ; pav:hasCurrentVersion ?now .
    FILTER (?now != ?input)
    FILTER NOT EXISTS { ?j cascade:countsUnderLens true }
    FILTER NOT EXISTS {
      ?replacing dct:replaces ?j
      OPTIONAL { ?undoing prov:invalidated ?replacing }
      FILTER (!BOUND(?undoing))
    }
    FILTER NOT EXISTS { ?retraction prov:invalidated ?j } }
  UNION
  { ?j cascade:verdict cascade:Same ; prov:wasAttributedTo cascade:CascadeMatcher .
    FILTER NOT EXISTS { ?j cascade:countsUnderLens true }
    FILTER NOT EXISTS {
      ?replacing dct:replaces ?j
      OPTIONAL { ?undoing prov:invalidated ?replacing }
      FILTER (!BOUND(?undoing))
    }
    FILTER NOT EXISTS { ?retraction prov:invalidated ?j }
    MINUS { SELECT DISTINCT ?j
          WHERE {
            { SELECT DISTINCT ?rule ?hash
              WHERE { ?ruleList pav:hasCurrentVersion ?current .
                      ?currentRow cascade:rowOfRuleListVersion ?current ; cascade:matcherRule ?rule ; cascade:queryHash ?hash } }
            ?assertedRow cascade:matcherRule ?rule ; cascade:queryHash ?hash ; cascade:rowOfRuleListVersion ?asserted .
            ?assertion cascade:assertedUnderRuleListVersion ?asserted ; cascade:assertedClaim ?j .
            ?j cascade:matcherRule ?rule .
          } } }
}
