# A reference table's current version is the one no newer version revises.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?series pav:hasCurrentVersion ?v }
WHERE {
  ?series a cascade:ReferenceSeries .
  ?v prov:specializationOf ?series .
  FILTER NOT EXISTS { ?newer prov:wasRevisionOf ?v }
}
