# Every record whose current revision an import brought is left out of every view when a counting Erroneous judgment
# names that import, because of that judgment.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?record cascade:leftOutFor ?leftOut . ?leftOut cascade:leftOutReason cascade:ImportJudgedErroneous ; cascade:leftOutBecauseOf ?e }
WHERE {
  ?e cascade:countsUnderLens true ; cascade:verdict cascade:Erroneous ; prov:hadMember ?act .
  ?r prov:wasGeneratedBy ?act .
  ?record cascade:currentRevision ?r .
  BIND (IRI(CONCAT("urn:cascade:left-out:",
                   SHA256(CONCAT(STR(?record), " ", STR(cascade:ImportJudgedErroneous), " ", STR(?e))))) AS ?leftOut)
}
