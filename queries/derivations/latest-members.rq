# An entry's latest member is the member whose current revision arrived last. The entry shows its name and code.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?entry cascade:latestMember ?latest }
WHERE {
  { SELECT ?entry (IRI(MIN(STR(?r))) AS ?latest)
    WHERE {
      { SELECT ?entry (MAX(?t2) AS ?t)
        WHERE { ?r2 cascade:inEntry ?entry ; cascade:currentRevision/prov:generatedAtTime ?t2 . }
        GROUP BY ?entry }
      ?r cascade:inEntry ?entry ; cascade:currentRevision/prov:generatedAtTime ?t .
    }
    GROUP BY ?entry }
}
