# An entry takes its date from the member whose current revision arrived last, among those that state a date.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?entry cascade:dateFrom ?from }
WHERE {
  { SELECT ?entry (IRI(MIN(STR(?r))) AS ?from)
    WHERE {
      { SELECT ?entry (MAX(?t2) AS ?t)
        WHERE {
          ?r2 cascade:inEntry ?entry ;
              cascade:currentRevision/prov:generatedAtTime ?t2 ; pav:hasCurrentVersion/cascade:displayDate [] . }
        GROUP BY ?entry }
      ?r cascade:inEntry ?entry ;
         cascade:currentRevision/prov:generatedAtTime ?t ; pav:hasCurrentVersion/cascade:displayDate [] .
    }
    GROUP BY ?entry }
}
