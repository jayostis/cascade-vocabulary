# A record named by a counting Erroneous judgment is left out of every view, because of that judgment; so is a record
# every revision of which an Erroneous that stands names, since it has no current state, because of each of those judgments.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?record cascade:leftOutFor ?leftOut . ?leftOut cascade:leftOutReason cascade:JudgedErroneous ; cascade:leftOutBecauseOf ?e }
WHERE {
  { ?e cascade:countsUnderLens true ; cascade:verdict cascade:Erroneous ; prov:hadMember ?record .
    ?record pav:hasCurrentVersion ?v .
    BIND (IRI(CONCAT("urn:cascade:left-out:",
                     SHA256(CONCAT(STR(?record), " ", STR(cascade:JudgedErroneous), " ", STR(?e))))) AS ?leftOut) }
  UNION
  { ?revision cascade:revisionJudgedErroneousBy ?e ; cascade:revisionOf ?record .
    FILTER NOT EXISTS { ?record cascade:currentRevision [] }
    BIND (IRI(CONCAT("urn:cascade:left-out:",
                     SHA256(CONCAT(STR(?record), " ", STR(cascade:JudgedErroneous), " ", STR(?e))))) AS ?leftOut) }
}
