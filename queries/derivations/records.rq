# The first table is the one place that says which types are records and, for each kind, the word for it and whether
# its status comes only from documents; the tables after it give, by kind, the properties that hold a version's name
# and date. Every record becomes a cascade:Record, and every version of one gets cascade:displayName and
# cascade:displayDate, so later steps read any record alike. A medication's date is its start of use, else the day its
# prescription was written, and a dispense's the time it was handed over, else the time it was prepared.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT {
  ?record a cascade:Record ; cascade:recordKind ?kind ; cascade:statusOnlyFromDocuments ?statusOnlyFromDocuments .
  ?version cascade:displayName ?name ; cascade:displayDate ?date .
}
WHERE {
  {
    VALUES (?type ?kind ?statusOnlyFromDocuments) {
      (cascade:AllergyOrIntolerance           "Allergy"                true)
      (cascade:ProblemOrDiagnosis             "Condition"              false)
      (cascade:Vaccination                    "Immunization"           false)
      (cascade:MedicalProcedure               "Procedure"              false)
      (cascade:PrescribedOrReportedMedication "Medication"             false)
      (cascade:LaboratoryTestResult           "Lab result"             false)
      (cascade:GeneticVariantFinding          "Variant"                false)
      (cascade:VariantInterpretation          "Variant interpretation" false)
      (cascade:DiagnosticReport               "Report"                 false)
      (cascade:ClinicalNoteOrDocument         "Note or document"       false)
      (cascade:MedicationDispense             "Medication dispense"    false)
    }
    ?record a ?type .
  } UNION {
    VALUES (?type ?nameProperty) {
      (cascade:AllergyOrIntolerance           cascade:allergenName)
      (cascade:ProblemOrDiagnosis             cascade:conditionName)
      (cascade:Vaccination                    cascade:vaccineName)
      (cascade:MedicalProcedure               cascade:procedureName)
      (cascade:PrescribedOrReportedMedication cascade:drugName)
      (cascade:LaboratoryTestResult           cascade:testName)
      (cascade:GeneticVariantFinding          cascade:hgvsCodingDnaExpression)
      (cascade:DiagnosticReport               cascade:reportName)
      (cascade:ClinicalNoteOrDocument         cascade:noteOrDocumentTypeName)
      (cascade:MedicationDispense             cascade:drugName)
    }
    ?record a ?type .
    ?version prov:specializationOf ?record ; ?nameProperty ?name .
  } UNION {
    VALUES (?type ?dateProperty) {
      (cascade:ProblemOrDiagnosis             cascade:onsetDate)
      (cascade:Vaccination                    cascade:vaccinationOccurrenceTime)
      (cascade:MedicalProcedure               cascade:procedureDate)
      (cascade:PrescribedOrReportedMedication cascade:medicationUseStartDate)
      (cascade:LaboratoryTestResult           cascade:resultClinicallyRelevantTime)
      (cascade:VariantInterpretation          cascade:variantInterpretationDate)
      (cascade:DiagnosticReport               cascade:reportEffectiveTime)
      (cascade:ClinicalNoteOrDocument         cascade:noteOrDocumentDate)
      (cascade:MedicationDispense             cascade:dispenseHandedOverTime)
    }
    ?record a ?type .
    ?version prov:specializationOf ?record ; ?dateProperty ?date .
  } UNION {
    VALUES (?type ?dateProperty ?fallbackDateProperty) {
      (cascade:PrescribedOrReportedMedication cascade:medicationUseStartDate cascade:prescriptionWrittenDate)
      (cascade:MedicationDispense             cascade:dispenseHandedOverTime cascade:dispensePreparedTime)
    }
    ?record a ?type .
    ?version prov:specializationOf ?record ; ?fallbackDateProperty ?date .
    FILTER NOT EXISTS { ?version ?dateProperty ?firstDate }
  }
}
