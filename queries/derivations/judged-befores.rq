# A counting Before places the member it names earlier before its other member: the ladder removes the earlier of two
# revisions of one record, and the lead passes over the earlier of two members' current revisions.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?earlier cascade:judgedBefore ?later }
WHERE {
  ?before cascade:countsUnderLens true ; cascade:verdict cascade:Before ; cascade:earlierMember ?earlier ;
          prov:hadMember ?later .
  FILTER (?later != ?earlier)
}
