# A record whose current version its source marks entered in error or refuted is left out of every view. The table is
# the one place that lists those statuses, each with the reason it gives.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT { ?record cascade:leftOutFor ?leftOut . ?leftOut cascade:leftOutReason ?reason }
WHERE {
  VALUES (?status ?reason) {
    ("entered-in-error" cascade:EnteredInErrorAtSource)
    ("refuted"          cascade:RefutedAtSource)
  }
  ?record pav:hasCurrentVersion/cascade:verificationStatus ?status .
  BIND (IRI(CONCAT("urn:cascade:left-out:", SHA256(CONCAT(STR(?record), " ", STR(?reason))))) AS ?leftOut)
}
