# A record whose current version its source marks entered in error or refuted is left out of every view: by its
# verification status, or, for an immunization, a lab result, a procedure, a variant, a variant interpretation, a report,
# a note or document or a medication dispense, which state entered in error as their status, by its workflow status, and
# a note or document also by the status of its content.
# The table is the one place that lists those statuses, each with the reason it gives.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT { ?record cascade:leftOutFor ?leftOut . ?leftOut cascade:leftOutReason ?reason }
WHERE {
  VALUES (?property ?status ?kind ?reason) {
    (cascade:verificationStatus "entered-in-error" UNDEF          cascade:EnteredInErrorAtSource)
    (cascade:verificationStatus "refuted"          UNDEF          cascade:RefutedAtSource)
    (cascade:workflowStatus     "entered-in-error" "Immunization" cascade:EnteredInErrorAtSource)
    (cascade:workflowStatus     "entered-in-error" "Lab result"   cascade:EnteredInErrorAtSource)
    (cascade:workflowStatus     "entered-in-error" "Procedure"    cascade:EnteredInErrorAtSource)
    (cascade:workflowStatus     "entered-in-error" "Variant"      cascade:EnteredInErrorAtSource)
    (cascade:workflowStatus     "entered-in-error" "Variant interpretation" cascade:EnteredInErrorAtSource)
    (cascade:workflowStatus     "entered-in-error" "Report"       cascade:EnteredInErrorAtSource)
    (cascade:workflowStatus     "entered-in-error" "Note or document" cascade:EnteredInErrorAtSource)
    (cascade:noteOrDocumentContentStatus "entered-in-error" "Note or document" cascade:EnteredInErrorAtSource)
    (cascade:workflowStatus     "entered-in-error" "Medication dispense" cascade:EnteredInErrorAtSource)
  }
  ?record cascade:recordKind ?recordKind ; pav:hasCurrentVersion ?version .
  ?version ?property ?status .
  FILTER (!BOUND(?kind) || ?kind = ?recordKind)
  BIND (IRI(CONCAT("urn:cascade:left-out:", SHA256(CONCAT(STR(?record), " ", STR(?reason))))) AS ?leftOut)
}
