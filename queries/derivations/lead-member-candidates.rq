# The lead of an entry is chosen from its members' current revisions as a record's current revision is from its
# revisions. A record the person entered, whose current revision is derived from no document, leads any entry it is in,
# so where an entry holds one, a member derived from a document is out. Of the members left, one is out when a Before
# that stands places its current revision before another such member's, unless that one is placed before it in turn,
# directly or through others. Of what is left, the members at the latest source change time stay, and so does every
# one carrying none: the first instant xsd:dateTime can write stands for none.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

CONSTRUCT { ?entry cascade:leadMemberCandidate ?member }
WHERE {
  { SELECT ?entry (MAX(COALESCE(?changed0, "0001-01-01T00:00:00Z"^^xsd:dateTime)) AS ?latest)
    WHERE {
      ?member0 cascade:inEntry ?entry ; cascade:currentRevision ?r0 .
      MINUS {
        ?shadowed0 cascade:inEntry ?entry ; cascade:currentRevision ?r0 .
        ?r0 prov:wasDerivedFrom [] .
        ?entered0 cascade:inEntry ?entry ; cascade:currentRevision ?enteredRevision0 .
        FILTER NOT EXISTS { ?enteredRevision0 prov:wasDerivedFrom [] }
      }
      MINUS {
        ?r0 cascade:judgedBefore ?later0 .
        ?other0 cascade:inEntry ?entry ; cascade:currentRevision ?later0 .
        FILTER (NOT EXISTS { ?later0 prov:wasDerivedFrom [] } || EXISTS { ?r0 prov:wasDerivedFrom [] })
        FILTER NOT EXISTS { ?later0 cascade:judgedBefore+ ?r0 }
      }
      OPTIONAL { ?r0 pav:lastUpdateOn ?changed0 }
    }
    GROUP BY ?entry }
  ?member cascade:inEntry ?entry ; cascade:currentRevision ?r .
  MINUS {
    ?shadowed cascade:inEntry ?entry ; cascade:currentRevision ?r .
    ?r prov:wasDerivedFrom [] .
    ?entered cascade:inEntry ?entry ; cascade:currentRevision ?enteredRevision .
    FILTER NOT EXISTS { ?enteredRevision prov:wasDerivedFrom [] }
  }
  MINUS {
    ?r cascade:judgedBefore ?later .
    ?other cascade:inEntry ?entry ; cascade:currentRevision ?later .
    FILTER (NOT EXISTS { ?later prov:wasDerivedFrom [] } || EXISTS { ?r prov:wasDerivedFrom [] })
    FILTER NOT EXISTS { ?later cascade:judgedBefore+ ?r }
  }
  OPTIONAL { ?r pav:lastUpdateOn ?changed }
  FILTER (!BOUND(?changed) || ?changed = ?latest)
}
