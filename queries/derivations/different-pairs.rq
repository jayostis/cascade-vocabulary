# Two records named together by a counting Different judgment are currently different, unless no person made the Different
# and a person's counting Same names both: a person outranks every machine, so the pair stays joined.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?a cascade:currentlyDifferent ?b }
WHERE {
  ?d cascade:countsUnderLens true ; cascade:verdict cascade:Different ; prov:hadMember ?a , ?b .
  FILTER (?a != ?b)
  BIND (EXISTS { ?d prov:wasAttributedTo/a prov:Person } AS ?byAPerson)
  MINUS {
    VALUES ?byAPerson { false }
    ?s cascade:countsUnderLens true ; cascade:verdict cascade:Same ; prov:wasAttributedTo/a prov:Person ;
       prov:hadMember ?a , ?b .
  }
}
