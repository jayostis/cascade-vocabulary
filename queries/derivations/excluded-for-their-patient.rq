# A record about no one known to be the subject is left out of every view: its current version names a patient profile
# no counting About ties to the subject, and the reason rests on that profile; or it names no patient, and a record with
# no current version names none.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT { ?record cascade:leftOutFor ?leftOut . ?leftOut cascade:leftOutReason ?reason ; cascade:leftOutBecauseOf ?profile }
WHERE {
  ?record a cascade:Record .
  FILTER NOT EXISTS { ?record cascade:subject [] }
  OPTIONAL { ?record pav:hasCurrentVersion/cascade:patient ?profile }
  BIND (IF(BOUND(?profile), cascade:PatientNotClaimed, cascade:NoPatient) AS ?reason)
  BIND (IRI(CONCAT("urn:cascade:left-out:",
                   SHA256(CONCAT(STR(?record), " ", STR(?reason), COALESCE(CONCAT(" ", STR(?profile)), ""))))) AS ?leftOut)
}
