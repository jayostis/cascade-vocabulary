PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

SELECT ?entry
WHERE {
  VALUES ?type { health:AllergyRecord health:ConditionRecord health:ImmunizationRecord clinical:Procedure }
  ?j rec:counts true ; jdg:verdict jdg:Same ; jdg:justification ?why ;
     prov:wasAttributedTo/a prov:SoftwareAgent ; prov:hadMember ?record .
  ?record a ?type ; rec:inEntry ?entry .
}
GROUP BY ?entry
HAVING (COUNT(DISTINCT ?why) > 1)
