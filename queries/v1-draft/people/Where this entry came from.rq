PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?entryLabel ?recordLabel ?author ?retrieved ?broughtBy ?arrived ?document ?record ?entry
WHERE {
  VALUES ?type { health:AllergyRecord health:ConditionRecord health:ImmunizationRecord clinical:Procedure }
  ?entry a ?type ; cascade:mergedFrom ?record .
  ?revision rec:revisionOf ?record ; prov:generatedAtTime ?arrived ; prov:wasGeneratedBy ?activity .
  FILTER NOT EXISTS { ?later prov:wasRevisionOf ?revision }
  ?activity rdfs:label ?broughtBy .
  OPTIONAL { ?entry rdfs:label ?entryLabel }
  OPTIONAL { ?record rdfs:label ?recordLabel }
  OPTIONAL { ?revision prov:wasDerivedFrom ?document }
  OPTIONAL { ?revision prov:wasDerivedFrom/pav:retrievedOn ?retrieved }
  OPTIONAL { ?revision prov:wasDerivedFrom/prov:qualifiedAttribution ?attribution .
             ?attribution prov:hadRole rec:author ; prov:agent/rdfs:label ?author }
}
ORDER BY ?entryLabel ?arrived ?recordLabel
