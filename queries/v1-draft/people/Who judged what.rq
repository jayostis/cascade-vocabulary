PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

SELECT ?made ?judgmentLabel ?verdict ?author ?role ?memberLabel ?reason ?supersedes ?retracts ?judgment ?member
WHERE {
  ?judgment a jdg:Judgment ; prov:generatedAtTime ?made ; prov:wasAttributedTo ?author .
  OPTIONAL { ?judgment rdfs:label ?judgmentLabel }
  OPTIONAL { ?judgment jdg:verdict ?verdict }
  OPTIONAL { ?judgment prov:qualifiedAttribution/prov:hadRole ?role }
  OPTIONAL { ?judgment prov:hadMember ?member }
  OPTIONAL { ?judgment prov:hadMember ?member . ?member rdfs:label ?memberLabel }
  OPTIONAL { ?judgment <http://purl.org/dc/terms/description> ?reason }
  OPTIONAL { ?judgment npx:supersedes ?supersedes }
  OPTIONAL { ?judgment npx:retracts ?retracts }
}
ORDER BY ?made ?judgmentLabel ?memberLabel
