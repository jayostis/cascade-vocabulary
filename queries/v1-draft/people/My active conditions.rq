PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

SELECT ?condition ?snomed ?onset (COUNT(?record) AS ?records) ?label ?entry
WHERE {
  ?entry a health:ConditionRecord ; health:status "active" ;
         health:conditionName ?condition ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry health:snomedCode ?snomed }
  OPTIONAL { ?entry health:onsetDate ?onset }
  OPTIONAL { ?entry rdfs:label ?label }
}
GROUP BY ?entry ?condition ?snomed ?onset ?label
ORDER BY ?condition
