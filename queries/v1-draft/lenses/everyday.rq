# The lens decides which judgments count, and is the one step of the build that can be swapped. This one counts every judgment
# not retracted, nor superseded by a judgment not itself retracted, unless a machine made it with a reference table that has a
# newer version since. A retracted judgment supersedes nothing.
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

CONSTRUCT { ?j rec:counts true }
WHERE {
  ?j a jdg:Judgment .
  FILTER NOT EXISTS {
    ?superseding npx:supersedes ?j
    OPTIONAL { ?undoing npx:retracts ?superseding }
    FILTER (!BOUND(?undoing))
  }
  FILTER NOT EXISTS { ?retracting npx:retracts ?j }
  FILTER NOT EXISTS {
    ?j prov:wasAttributedTo/a prov:SoftwareAgent ; prov:used ?input .
    ?input prov:specializationOf ?series .
    ?series a rec:ReferenceSeries ; pav:hasCurrentVersion ?now .
    FILTER (?now != ?input)
  }
}
