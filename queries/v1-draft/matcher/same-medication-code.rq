# Two records of one kind match when their current versions share an RxNorm code, whether each came from a
# prescription or from a list of what the person takes. Any dates are ignored. Each ordered pair is a row.
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX pav: <http://purl.org/pav/>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT DISTINCT ?record ?other
WHERE {
  ?record rec:kind ?kind ; pav:hasCurrentVersion ?version .
  ?other rec:kind ?kind ; pav:hasCurrentVersion ?otherVersion .
  ?version clinical:rxNormCode ?code .
  ?otherVersion clinical:rxNormCode ?code .
  FILTER (?record != ?other)
}
