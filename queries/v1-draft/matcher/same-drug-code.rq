# Two records of one kind match when their current versions share an NDC, or the same chosen RxNorm code. A version's
# chosen code is the one its source selected, else its only RxNorm code; one with several RxNorm codes and none
# selected chooses none, and is left to the rule that reads a table. An NDC names a package, so a shared NDC is enough.
# No table is read, so the code may be an ingredient's: two records coded only with one ingredient's code match, as
# they did when this rule compared RxNorm codes alone. Any dates are ignored. Each ordered pair is a row.
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX pav: <http://purl.org/pav/>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT DISTINCT ?record ?other
WHERE {
  ?record rec:kind ?kind ; pav:hasCurrentVersion ?version .
  ?other rec:kind ?kind ; pav:hasCurrentVersion ?otherVersion .
  ?version rec:ndcCode|rec:selectedCode|clinical:rxNormCode ?code .
  ?otherVersion rec:ndcCode|rec:selectedCode|clinical:rxNormCode ?code .
  FILTER (?record != ?other)
  FILTER (EXISTS { ?version rec:ndcCode|rec:selectedCode ?code }
          || (NOT EXISTS { ?version rec:selectedCode ?chosen }
              && NOT EXISTS { ?version clinical:rxNormCode ?another FILTER (?another != ?code) }))
  FILTER (EXISTS { ?otherVersion rec:ndcCode|rec:selectedCode ?code }
          || (NOT EXISTS { ?otherVersion rec:selectedCode ?chosen }
              && NOT EXISTS { ?otherVersion clinical:rxNormCode ?another FILTER (?another != ?code) }))
}
