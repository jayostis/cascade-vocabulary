# Two records of one kind match when their current versions share an RxNorm code that is a product, one a version of a
# product ingredient table maps to an ingredient other than itself; an ingredient maps to itself, so a code shared
# only at ingredient level joins nothing. A pair whose chosen codes already make it a pair of the rule that reads no
# table is left to it. That leaves the records with several RxNorm codes and none selected. Each ordered pair is a
# row, with the version whose rows joined it; a graph that is not a version of a product ingredient table is never
# read for rows.
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT DISTINCT ?record ?other ?origin
WHERE {
  ?origin prov:specializationOf/rec:tableKind rec:ProductIngredients .
  ?record rec:kind ?kind ; pav:hasCurrentVersion ?version .
  ?other rec:kind ?kind ; pav:hasCurrentVersion ?otherVersion .
  ?version clinical:rxNormCode ?code .
  ?otherVersion clinical:rxNormCode ?code .
  GRAPH ?origin { ?row owl:annotatedSource ?code ; owl:annotatedTarget ?ingredient }
  FILTER (?record != ?other && !sameTerm(?code, ?ingredient))
  FILTER (!(EXISTS { ?version rec:selectedCode ?code }
            || (NOT EXISTS { ?version rec:selectedCode ?chosen }
                && NOT EXISTS { ?version clinical:rxNormCode ?another FILTER (?another != ?code) }))
          || !(EXISTS { ?otherVersion rec:selectedCode ?code }
               || (NOT EXISTS { ?otherVersion rec:selectedCode ?chosen }
                   && NOT EXISTS { ?otherVersion clinical:rxNormCode ?another FILTER (?another != ?code) })))
}
