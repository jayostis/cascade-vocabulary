# Two records of one kind match when their current versions share a code under one property: an allergen's code, or
# a SNOMED CT code under either vocabulary's property. Any dates are ignored. Each ordered pair is a row.
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX pav: <http://purl.org/pav/>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT DISTINCT ?record ?other
WHERE {
  VALUES ?property { clinical:snomedCode health:allergenCode health:snomedCode }
  ?record rec:kind ?kind ; pav:hasCurrentVersion ?version .
  ?other rec:kind ?kind ; pav:hasCurrentVersion ?otherVersion .
  ?version ?property ?code .
  ?otherVersion ?property ?code .
  FILTER (?record != ?other)
}
