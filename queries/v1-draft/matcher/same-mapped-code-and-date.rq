# Two records of one kind match when their current versions give two different vaccine codes that one version of a
# vaccine group table puts in one group, and one date, the same term. A record's CVX code is joined to the table by
# its IRI, http://hl7.org/fhir/sid/cvx/ followed by the code as written. Each ordered pair is a row, with the version
# whose rows joined it; a graph that is not a version of a vaccine group table is never read for rows.
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?record ?other ?origin
WHERE {
  ?origin prov:specializationOf/rec:tableKind rec:VaccineGroups .
  ?record rec:kind ?kind ; pav:hasCurrentVersion ?version .
  ?other rec:kind ?kind ; pav:hasCurrentVersion ?otherVersion .
  ?version health:vaccineCode ?code ; rec:date ?date .
  ?otherVersion health:vaccineCode ?otherCode ; rec:date ?date .
  FILTER (?record != ?other && !sameTerm(?code, ?otherCode))
  BIND (IRI(CONCAT("http://hl7.org/fhir/sid/cvx/", STR(?code))) AS ?cvx)
  BIND (IRI(CONCAT("http://hl7.org/fhir/sid/cvx/", STR(?otherCode))) AS ?otherCvx)
  GRAPH ?origin {
    ?row owl:annotatedSource ?cvx ; owl:annotatedProperty skos:broadMatch ; owl:annotatedTarget ?group .
    ?otherRow owl:annotatedSource ?otherCvx ; owl:annotatedProperty skos:broadMatch ; owl:annotatedTarget ?group .
  }
}
