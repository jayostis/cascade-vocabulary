# Two records of one kind match when their current versions give two different vaccine codes that the vaccine group
# table puts in one group, and one date, the same term. A code is read as its string. Each ordered pair is a row.
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX pav: <http://purl.org/pav/>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT DISTINCT ?record ?other
WHERE {
  ?record rec:kind ?kind ; pav:hasCurrentVersion ?version .
  ?other rec:kind ?kind ; pav:hasCurrentVersion ?otherVersion .
  ?version health:vaccineCode ?code ; rec:date ?date .
  ?otherVersion health:vaccineCode ?otherCode ; rec:date ?date .
  ?row rec:cvxCode ?cvx ; rec:vaccineGroup ?group .
  ?otherRow rec:cvxCode ?otherCvx ; rec:vaccineGroup ?group .
  FILTER (?record != ?other && !sameTerm(?code, ?otherCode) && STR(?code) = ?cvx && STR(?otherCode) = ?otherCvx)
}
