# Two records of one kind match when one version of a code conversion table converts an ICD-10-CM code of one's current
# version to a different ICD-10-CM code of the other's, either way round, by a skos:exactMatch row. A record's code
# joins the table as written when an IRI, and as http://hl7.org/fhir/sid/icd-10-cm/ followed by the code when a
# literal. A code with exact rows to several codes was split, so it matches none of its parts. Each ordered pair is a
# row, with the version whose rows joined it; a graph that is not a version of a code conversion table is never read
# for rows.
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?record ?other ?origin
WHERE {
  ?origin prov:specializationOf/rec:tableKind rec:CodeConversions .
  ?record rec:kind ?kind ; pav:hasCurrentVersion ?version .
  ?other rec:kind ?kind ; pav:hasCurrentVersion ?otherVersion .
  ?version health:icd10Code ?written .
  ?otherVersion health:icd10Code ?otherWritten .
  BIND (IF(isIRI(?written), ?written, IRI(CONCAT("http://hl7.org/fhir/sid/icd-10-cm/", STR(?written)))) AS ?code)
  BIND (IF(isIRI(?otherWritten), ?otherWritten, IRI(CONCAT("http://hl7.org/fhir/sid/icd-10-cm/", STR(?otherWritten))))
        AS ?otherCode)
  GRAPH ?origin {
    ?row owl:annotatedSource|owl:annotatedTarget ?code , ?otherCode ;
        owl:annotatedProperty skos:exactMatch ; owl:annotatedSource ?retired .
    FILTER NOT EXISTS {
      ?part owl:annotatedSource ?retired ; owl:annotatedProperty skos:exactMatch .
      FILTER (!sameTerm(?part, ?row))
    }
  }
  FILTER (?record != ?other && !sameTerm(?code, ?otherCode))
}
