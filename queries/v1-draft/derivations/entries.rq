PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

CONSTRUCT { ?record rec:inEntry ?entry }
WHERE {
  { SELECT ?record (IRI(CONCAT("urn:cascade:entry:", SHA256(MIN(STR(?m))))) AS ?entry)
    WHERE {
      VALUES ?type { health:AllergyRecord health:ConditionRecord health:ImmunizationRecord clinical:Procedure }
      ?record a ?type ; rec:subject [] ; jdg:currentlySame* ?m .
      ?m a ?type ; rec:subject [] .
      FILTER NOT EXISTS { ?record rec:excluded true }
      FILTER NOT EXISTS { ?m rec:excluded true }
    }
    GROUP BY ?record }
}
