# The table is the one place that says which types are records, and which property holds each kind's name, status and
# date. Every record becomes a rec:Record with the word for its kind, and every version of one gets rec:name, rec:status
# and rec:date, so later steps read any record alike. Each OPTIONAL names the version again, so a record with none is
# still a rec:Record. A property is matched with a FILTER, not as the pattern's predicate: there an UNDEF cell, as an
# allergy's date is, would match every statement, and rdflib would drop a version that lacks the property.
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

CONSTRUCT {
  ?record a rec:Record ; rec:kind ?kind .
  ?version rec:name ?name ; rec:status ?status ; rec:date ?date .
}
WHERE {
  VALUES (?type ?kind ?nameProperty ?statusProperty ?dateProperty) {
    (health:AllergyRecord      "Allergy"      health:allergen        clinical:status UNDEF)
    (health:ConditionRecord    "Condition"    health:conditionName   health:status   health:onsetDate)
    (health:ImmunizationRecord "Immunization" health:vaccineName     health:status   health:administrationDate)
    (clinical:Procedure        "Procedure"    clinical:procedureName clinical:status clinical:procedureDate)
  }
  ?record a ?type .
  OPTIONAL { ?version prov:specializationOf ?record }
  OPTIONAL { ?version prov:specializationOf ?record ; ?hasName ?name FILTER (?hasName = ?nameProperty) }
  OPTIONAL { ?version prov:specializationOf ?record ; ?hasStatus ?status FILTER (?hasStatus = ?statusProperty) }
  OPTIONAL { ?version prov:specializationOf ?record ; ?hasDate ?date FILTER (?hasDate = ?dateProperty) }
}
