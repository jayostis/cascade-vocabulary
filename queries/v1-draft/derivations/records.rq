# The table is the one place that says which types are records, and how each kind holds its name, status and date. Every
# record becomes a rec:Record with the word for its kind, and every version of one gets rec:name, rec:status and rec:date,
# so every later step reads any record the same way. Each property is matched through a FILTER: a cell left UNDEF, as an
# allergy's date is, then matches nothing, where in the pattern itself it would match every statement; and rdflib keeps a
# version that lacks one only in this form.
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

CONSTRUCT {
  ?record a rec:Record ; rec:kind ?kind .
  ?version rec:name ?name ; rec:status ?status ; rec:date ?date .
}
WHERE {
  VALUES (?type ?kind ?nameProperty ?statusProperty ?dateProperty) {
    (health:AllergyRecord      "Allergy"      health:allergen        clinical:status UNDEF)
    (health:ConditionRecord    "Condition"    health:conditionName   health:status   health:onsetDate)
    (health:ImmunizationRecord "Immunization" health:vaccineName     health:status   health:administrationDate)
    (clinical:Procedure        "Procedure"    clinical:procedureName clinical:status clinical:procedureDate)
  }
  ?record a ?type .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?version ?hasName ?name FILTER (?hasName = ?nameProperty) }
  OPTIONAL { ?version ?hasStatus ?status FILTER (?hasStatus = ?statusProperty) }
  OPTIONAL { ?version ?hasDate ?date FILTER (?hasDate = ?dateProperty) }
}
