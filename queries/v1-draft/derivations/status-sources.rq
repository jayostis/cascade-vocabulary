# An entry takes its status from the member whose current revision arrived last, among those that state one and came
# from a document: what the person entered never sets a status.
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

CONSTRUCT { ?entry rec:statusFrom ?from }
WHERE {
  { SELECT ?entry (IRI(MIN(STR(?r))) AS ?from)
    WHERE {
      { SELECT ?entry (MAX(?t2) AS ?t)
        WHERE {
          ?r2 a rec:Record ; rec:inEntry ?entry ;
              rec:currentRevision ?rev2 ; pav:hasCurrentVersion/rec:status [] .
          ?rev2 prov:generatedAtTime ?t2 ; prov:wasDerivedFrom [] . }
        GROUP BY ?entry }
      ?r a rec:Record ; rec:inEntry ?entry ;
         rec:currentRevision ?rev ; pav:hasCurrentVersion/rec:status [] .
      ?rev prov:generatedAtTime ?t ; prov:wasDerivedFrom [] .
    }
    GROUP BY ?entry }
}
