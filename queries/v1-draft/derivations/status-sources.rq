PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

CONSTRUCT { ?entry rec:statusFrom ?from }
WHERE {
  { SELECT ?entry (IRI(MIN(STR(?r))) AS ?from)
    WHERE {
      { SELECT ?entry (MAX(?t2) AS ?t)
        WHERE {
          VALUES (?type2 ?status2) { (health:ConditionRecord health:status) (health:ImmunizationRecord health:status) (clinical:Procedure clinical:status) }
          ?r2 a ?type2 ; rec:inEntry ?entry ;
              rec:currentRevision/prov:generatedAtTime ?t2 ; pav:hasCurrentVersion ?v2 .
          ?v2 ?status2 [] . }
        GROUP BY ?entry }
      VALUES (?type ?status) { (health:ConditionRecord health:status) (health:ImmunizationRecord health:status) (clinical:Procedure clinical:status) }
      ?r a ?type ; rec:inEntry ?entry ;
         rec:currentRevision/prov:generatedAtTime ?t ; pav:hasCurrentVersion ?v .
      ?v ?status [] .
    }
    GROUP BY ?entry }
}
