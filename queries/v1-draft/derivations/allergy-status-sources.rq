# An allergy entry takes its status from the member whose current revision arrived last, among those that state a status
# and came from a document.
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

CONSTRUCT { ?entry rec:statusFrom ?from }
WHERE {
  { SELECT ?entry (IRI(MIN(STR(?r))) AS ?from)
    WHERE {
      { SELECT ?entry (MAX(?t2) AS ?t)
        WHERE {
          ?r2 a health:AllergyRecord ; rec:inEntry ?entry ;
              rec:currentRevision ?rev2 ; pav:hasCurrentVersion/clinical:status [] .
          ?rev2 prov:generatedAtTime ?t2 ; prov:wasDerivedFrom [] . }
        GROUP BY ?entry }
      ?r a health:AllergyRecord ; rec:inEntry ?entry ;
         rec:currentRevision ?rev ; pav:hasCurrentVersion/clinical:status [] .
      ?rev prov:generatedAtTime ?t ; prov:wasDerivedFrom [] .
    }
    GROUP BY ?entry }
}
