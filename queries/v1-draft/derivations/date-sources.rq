# An entry takes its date from the member whose current revision arrived last, among those that state a date.
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

CONSTRUCT { ?entry rec:dateFrom ?from }
WHERE {
  { SELECT ?entry (IRI(MIN(STR(?r))) AS ?from)
    WHERE {
      { SELECT ?entry (MAX(?t2) AS ?t)
        WHERE {
          ?r2 rec:inEntry ?entry ;
              rec:currentRevision/prov:generatedAtTime ?t2 ; pav:hasCurrentVersion/rec:date [] . }
        GROUP BY ?entry }
      ?r rec:inEntry ?entry ;
         rec:currentRevision/prov:generatedAtTime ?t ; pav:hasCurrentVersion/rec:date [] .
    }
    GROUP BY ?entry }
}
