# Each entry takes every member's gene symbol, HGVS expressions and ClinVar IDs, since codes are identity and nothing is
# chosen among them, and the status of the member chosen for status.
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX genomics: <https://ns.cascadeprotocol.org/genomics/v1#>
PREFIX pav: <http://purl.org/pav/>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

CONSTRUCT {
  ?entry a genomics:Variant ;
    genomics:geneSymbol ?gene ;
    genomics:hgvsCDot ?hgvs ;
    genomics:clinvarVariationId ?variation ;
    clinical:status ?status ;
    rec:latestMember ?latest ;
    rec:statusFrom ?statusFrom ;
    cascade:mergedFrom ?record .
}
WHERE {
  ?record a genomics:Variant ; rec:inEntry ?entry .
  ?entry rec:latestMember ?latest .
  OPTIONAL { ?record pav:hasCurrentVersion/genomics:geneSymbol ?gene }
  OPTIONAL { ?record pav:hasCurrentVersion/genomics:hgvsCDot ?hgvs }
  OPTIONAL { ?record pav:hasCurrentVersion/genomics:clinvarVariationId ?variation }
  OPTIONAL { ?entry rec:statusFrom ?statusFrom .
             ?statusFrom pav:hasCurrentVersion/clinical:status ?status }
}
