PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

CONSTRUCT {
  ?entry a health:AllergyRecord ;
    health:allergen ?allergen ;
    health:allergenCode ?code ;
    clinical:status ?status ;
    clinical:criticality ?criticality ;
    rec:latestMember ?latest ;
    rec:statusFrom ?statusFrom ;
    cascade:mergedFrom ?record .
}
WHERE {
  ?record a health:AllergyRecord ; rec:inEntry ?entry .
  ?entry rec:latestMember ?latest .
  OPTIONAL { ?latest pav:hasCurrentVersion/health:allergen ?allergen }
  OPTIONAL { ?latest pav:hasCurrentVersion/health:allergenCode ?code }
  OPTIONAL { ?entry rec:statusFrom ?statusFrom .
             ?statusFrom pav:hasCurrentVersion/clinical:status ?status }
  OPTIONAL { ?entry rec:topCriticality ?top .
             BIND (IF(?top = 2, "high", IF(?top = 1, "low", "unable-to-assess")) AS ?criticality) }
}
