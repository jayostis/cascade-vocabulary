PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX pav: <http://purl.org/pav/>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>

CONSTRUCT {
  ?entry a cascade:PatientProfile ;
    cascade:mergedFrom ?profile .
}
WHERE {
  ?j rec:counts true ; jdg:verdict jdg:About ; prov:hadMember ?profile ; jdg:subject ?s .
  FILTER NOT EXISTS { ?profile rec:excluded true }
  BIND (IRI(CONCAT("urn:cascade:entry:", SHA256(STR(?s)))) AS ?entry)
}
