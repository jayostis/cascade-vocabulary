# What a view states about each of its entries, read from the view's own file. An entry is what an app shows: one allergy, one condition, one vaccination.
# Merged From names every record the entry joins. Latest Member and Status From name the member whose values were chosen; the derivation of the same name chose it.
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?entry ?entryLabel ?view ?field ?value ?valueLabel
WHERE {
  GRAPH ?view { ?entry cascade:mergedFrom [] ; ?field ?value }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
  OPTIONAL { ?value rdfs:label ?valueLabel }
}
ORDER BY ?entryLabel ?entry ?field ?value
