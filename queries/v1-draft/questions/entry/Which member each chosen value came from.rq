# An entry takes its values from its members. The latest member gives its name and code; status and date come from the member
# that most recently said something about them. Each row is one of those choices and the member it fell on.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?entry ?entryLabel ?role ?record ?recordLabel
WHERE {
  VALUES ?role { rec:latestMember rec:statusFrom rec:dateFrom }
  ?entry ?role ?record .
  OPTIONAL { ?entry rdfs:label ?entryLabel }
  OPTIONAL { ?record rdfs:label ?recordLabel }
}
ORDER BY ?entryLabel ?entry ?role ?record
