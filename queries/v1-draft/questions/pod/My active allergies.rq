# The allergies an app would show, read from the view alone: each active entry, with its code, its criticality,
# and how many records it joins.
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?allergen ?code ?criticality (COUNT(?record) AS ?records) ?entry ?entryLabel
WHERE {
  ?entry a health:AllergyRecord ; clinical:status "active" ;
         health:allergen ?allergen ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry health:allergenCode ?code }
  OPTIONAL { ?entry clinical:criticality ?criticality }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
}
GROUP BY ?entry ?allergen ?code ?criticality ?entryLabel
ORDER BY ?allergen ?entry
