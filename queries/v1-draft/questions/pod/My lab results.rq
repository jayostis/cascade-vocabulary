# Read from the view alone, as an app would, newest first, with how many records each entry joins.
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?performed ?test ?code ?value ?unit ?status (COUNT(?record) AS ?records) ?entry ?entryLabel
WHERE {
  ?entry a health:LabResultRecord ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry health:performedDate ?performed }
  OPTIONAL { ?entry health:testName ?test }
  OPTIONAL { ?entry health:testCode ?code }
  OPTIONAL { ?entry health:resultValue ?value }
  OPTIONAL { ?entry health:resultUnit ?unit }
  OPTIONAL { ?entry clinical:status ?status }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
}
GROUP BY ?entry ?performed ?test ?code ?value ?unit ?status ?entryLabel
ORDER BY DESC(?performed) ?test ?entry
