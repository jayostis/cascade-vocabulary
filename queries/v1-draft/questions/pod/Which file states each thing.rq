# Every file is loaded twice: into the default graph, which the other questions read, and into a graph named by its address, which GRAPH ?file reads. So for any thing you can ask which files say something about it.
# A file the build wrote and can write again, a view or the labels, is rebuilt, and comes after the file the thing arrived in.
PREFIX pim: <http://www.w3.org/ns/pim/space#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT DISTINCT ?thing ?file ?rebuilt
WHERE {
  GRAPH ?file { ?thing ?property ?value }
  ?owner pim:storage ?root .
  FILTER (isIRI(?thing) && STRSTARTS(STR(?file), STR(?root)))
  BIND (EXISTS { ?file a rec:View } AS ?rebuilt)
}
ORDER BY ?thing ?rebuilt ?file
