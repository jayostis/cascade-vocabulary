# Read from the view alone, as an app would, newest first, with how many records each entry joins. The code is
# SNOMED CT's IRI: the one the entry states, or http://snomed.info/id/ followed by the code as written; none when what
# is written cannot end an IRI.
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?performed ?procedure ?snomed ?status (COUNT(?record) AS ?records) ?entry ?entryLabel
WHERE {
  ?entry a clinical:Procedure ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry clinical:procedureDate ?performed }
  OPTIONAL { ?entry clinical:procedureName ?procedure }
  OPTIONAL {
    ?entry clinical:snomedCode ?written .
    FILTER (isIRI(?written) || REGEX(STR(?written), '^[^\\s<>"{}|^`\\\\]+$'))
    BIND (IF(isIRI(?written), ?written, IRI(CONCAT("http://snomed.info/id/", STR(?written)))) AS ?snomed)
  }
  OPTIONAL { ?entry clinical:status ?status }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
}
GROUP BY ?entry ?performed ?procedure ?snomed ?status ?entryLabel
ORDER BY DESC(?performed) ?procedure ?entry
