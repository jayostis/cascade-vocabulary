# The one person every record is finally about. Each hospital knows them by a patient profile of its own,
# and About judgments tie those profiles to this subject.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?subject ?subjectLabel
WHERE {
  ?subject a rec:Subject .
  OPTIONAL { ?subject rdfs:label ?subjectLabel }
}
ORDER BY ?subject
