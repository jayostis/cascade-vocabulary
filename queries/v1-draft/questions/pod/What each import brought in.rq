# An import is one run of the Bridge over one download, or one session of the person entering things. Rows come in the
# order the imports started: every revision it added, the record it revised, and the version it carries.
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?started ?import ?importLabel ?record ?recordLabel ?revision ?revisionLabel ?version ?versionLabel
WHERE {
  ?import a prov:Activity ; prov:startedAtTime ?started .
  ?revision prov:wasGeneratedBy ?import ; rec:revisionOf ?record ; rec:version ?version .
  OPTIONAL { ?import rdfs:label ?importLabel }
  OPTIONAL { ?record rdfs:label ?recordLabel }
  OPTIONAL { ?revision rdfs:label ?revisionLabel }
  OPTIONAL { ?version rdfs:label ?versionLabel }
}
ORDER BY ?started ?import ?recordLabel ?revision
