# The conditions an app would show, read from the view alone: each active entry, with its code, its onset,
# and how many records it joins.
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?condition ?snomed ?onset (COUNT(?record) AS ?records) ?entry ?entryLabel
WHERE {
  ?entry a health:ConditionRecord ; health:status "active" ;
         health:conditionName ?condition ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry health:snomedCode ?snomed }
  OPTIONAL { ?entry health:onsetDate ?onset }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
}
GROUP BY ?entry ?condition ?snomed ?onset ?entryLabel
ORDER BY ?condition ?entry
