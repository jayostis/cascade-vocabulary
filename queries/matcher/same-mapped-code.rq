# Two records of one kind match when one version of a substance ingredient map pairs an allergen code of one's current
# version with an allergen code of the other's, either way round. The map pairs a SNOMED CT code with an RxNorm code,
# so two codes of one system never match here. Each ordered pair is a row, with the version whose rows joined it; a
# graph that is not a version of such a map is never read for rows.
PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT DISTINCT ?record ?other ?origin
WHERE {
  ?origin prov:specializationOf/rec:tableKind rec:SubstanceIngredients .
  ?record rec:kind ?kind ; pav:hasCurrentVersion ?version .
  ?other rec:kind ?kind ; pav:hasCurrentVersion ?otherVersion .
  ?version health:allergenCode ?code .
  ?otherVersion health:allergenCode ?otherCode .
  FILTER (?record != ?other)
  GRAPH ?origin {
    ?code ^owl:annotatedSource/owl:annotatedTarget|^owl:annotatedTarget/owl:annotatedSource ?otherCode .
  }
}
