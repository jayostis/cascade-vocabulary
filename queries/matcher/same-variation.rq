# Two records of one kind match when their current versions share a ClinVar VariationID. A VariationID names a variation,
# not a transcript, so two reports on different transcript versions of one variant match here. No table is read, and
# HGVS expressions are not compared: the rule that reads a variant classifications table joins those that a row finds.
# Each ordered pair is a row.
PREFIX genomics: <https://ns.cascadeprotocol.org/genomics/v1#>
PREFIX pav: <http://purl.org/pav/>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT DISTINCT ?record ?other
WHERE {
  ?record rec:kind ?kind ; pav:hasCurrentVersion ?version .
  ?other rec:kind ?kind ; pav:hasCurrentVersion ?otherVersion .
  ?version genomics:clinvarVariationId ?id .
  ?otherVersion genomics:clinvarVariationId ?id .
  FILTER (?record != ?other)
}
