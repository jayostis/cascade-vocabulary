# Each entry takes the name and codes of its lead, the clinical status, verification status and abatement date of the
# member chosen for status, and the onset of the member chosen for the date. Each member's current values are a node of
# the view of their own, named after the entry and the member, which says the member they came from. A time its source
# wrote short of the second keeps the node saying so (cascade:PaddedDateTime), named after the entry or the member's
# values and -padded-, so the view never shows a padded time as exact.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT {
  ?entry a cascade:ProblemOrDiagnosis ;
    cascade:conditionName ?name ;
    cascade:conditionCode ?code ;
    cascade:clinicalStatus ?status ;
    cascade:verificationStatus ?verification ;
    cascade:abatementDate ?abatement ;
    cascade:onsetDate ?onset ;
    cascade:leadMember ?lead ;
    cascade:statusFrom ?statusFrom ;
    cascade:entryMember ?record .
  ?entry cascade:memberCurrentValues ?memberValues .
  ?memberValues cascade:valuesOfMember ?member ;
    cascade:conditionName ?memberConditionName ;
    cascade:conditionCode ?memberConditionCode ;
    cascade:clinicalStatus ?memberClinicalStatus ;
    cascade:verificationStatus ?memberVerificationStatus ;
    cascade:abatementDate ?memberAbatementDate ;
    cascade:onsetDate ?memberOnsetDate .
  ?entry cascade:paddedDateTime ?onsetPadded .
  ?onsetPadded cascade:paddedDateTimeProperty cascade:onsetDate ; cascade:timeAsWritten ?onsetWritten .
  ?entry cascade:paddedDateTime ?abatementPadded .
  ?abatementPadded cascade:paddedDateTimeProperty cascade:abatementDate ; cascade:timeAsWritten ?abatementWritten .
  ?memberValues cascade:paddedDateTime ?memberPadded .
  ?memberPadded cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:timeAsWritten ?memberWritten .
}
WHERE {
  { ?record a cascade:ProblemOrDiagnosis ; cascade:inEntry ?entry .
    ?entry cascade:leadMember ?lead .
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:conditionName ?name }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:conditionCode ?code }
    OPTIONAL { ?entry cascade:statusFrom ?statusFrom .
               ?statusFrom pav:hasCurrentVersion/cascade:clinicalStatus ?status }
    OPTIONAL { ?entry cascade:statusFrom/pav:hasCurrentVersion/cascade:verificationStatus ?verification }
    OPTIONAL { ?entry cascade:statusFrom/pav:hasCurrentVersion/cascade:abatementDate ?abatement }
    OPTIONAL { ?entry cascade:dateFrom/pav:hasCurrentVersion/cascade:onsetDate ?onset }
    OPTIONAL { ?entry cascade:dateFrom/pav:hasCurrentVersion/cascade:paddedDateTime ?onsetPaddedAt .
               ?onsetPaddedAt cascade:paddedDateTimeProperty cascade:onsetDate ; cascade:timeAsWritten ?onsetWritten }
    BIND (IF(BOUND(?onsetWritten), IRI(CONCAT(STR(?entry), "-padded-onsetDate")), 1/0) AS ?onsetPadded)
    OPTIONAL { ?entry cascade:statusFrom/pav:hasCurrentVersion/cascade:paddedDateTime ?abatementPaddedAt .
               ?abatementPaddedAt cascade:paddedDateTimeProperty cascade:abatementDate ; cascade:timeAsWritten ?abatementWritten }
    BIND (IF(BOUND(?abatementWritten), IRI(CONCAT(STR(?entry), "-padded-abatementDate")), 1/0) AS ?abatementPadded) }
  UNION
  { ?member a cascade:ProblemOrDiagnosis ; cascade:inEntry ?entry ; pav:hasCurrentVersion ?memberVersion .
    BIND (IRI(CONCAT(STR(?entry), "-", SHA256(STR(?member)))) AS ?memberValues)
    OPTIONAL { ?memberVersion cascade:conditionName ?memberConditionName }
    OPTIONAL { ?memberVersion cascade:conditionCode ?memberConditionCode }
    OPTIONAL { ?memberVersion cascade:clinicalStatus ?memberClinicalStatus }
    OPTIONAL { ?memberVersion cascade:verificationStatus ?memberVerificationStatus }
    OPTIONAL { ?memberVersion cascade:abatementDate ?memberAbatementDate }
    OPTIONAL { ?memberVersion cascade:onsetDate ?memberOnsetDate }
    OPTIONAL { ?memberVersion cascade:paddedDateTime ?memberPaddedAt .
               ?memberPaddedAt cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:timeAsWritten ?memberWritten }
    BIND (IF(BOUND(?memberWritten), IRI(CONCAT(STR(?memberValues), "-padded-", STRAFTER(STR(?memberPaddedProperty), "#"))), 1/0)
          AS ?memberPadded) }
}
