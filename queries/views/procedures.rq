# Each entry takes the name, code and text of its lead, the status of the member chosen for status, and the date of the
# member chosen for the date. Each member's current values are a node of the view of their own, named after the entry
# and the member, which says the member they came from, with the text that member's source wrote for it: an entry whose
# lead states none shows none, and the member that does shows it there.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT {
  ?entry a cascade:MedicalProcedure ;
    cascade:procedureName ?name ;
    cascade:snomedCode ?code ;
    cascade:narrativeText ?text ;
    cascade:workflowStatus ?status ;
    cascade:procedureDate ?date ;
    cascade:leadMember ?lead ;
    cascade:statusFrom ?statusFrom ;
    cascade:mergedFrom ?record .
  ?entry cascade:memberCurrentValues ?memberValues .
  ?memberValues cascade:valuesOfMember ?member ;
    cascade:procedureName ?memberProcedureName ;
    cascade:snomedCode ?memberSnomedCode ;
    cascade:narrativeText ?memberNarrativeText ;
    cascade:workflowStatus ?memberWorkflowStatus ;
    cascade:procedureDate ?memberProcedureDate .
}
WHERE {
  { ?record a cascade:MedicalProcedure ; cascade:inEntry ?entry .
    ?entry cascade:leadMember ?lead .
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:procedureName ?name }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:snomedCode ?code }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:narrativeText ?text }
    OPTIONAL { ?entry cascade:statusFrom ?statusFrom .
               ?statusFrom pav:hasCurrentVersion/cascade:workflowStatus ?status }
    OPTIONAL { ?entry cascade:dateFrom/pav:hasCurrentVersion/cascade:procedureDate ?date } }
  UNION
  { ?member a cascade:MedicalProcedure ; cascade:inEntry ?entry ; pav:hasCurrentVersion ?memberVersion .
    BIND (IRI(CONCAT(STR(?entry), "-", SHA256(STR(?member)))) AS ?memberValues)
    OPTIONAL { ?memberVersion cascade:procedureName ?memberProcedureName }
    OPTIONAL { ?memberVersion cascade:snomedCode ?memberSnomedCode }
    OPTIONAL { ?memberVersion cascade:narrativeText ?memberNarrativeText }
    OPTIONAL { ?memberVersion cascade:workflowStatus ?memberWorkflowStatus }
    OPTIONAL { ?memberVersion cascade:procedureDate ?memberProcedureDate } }
}
