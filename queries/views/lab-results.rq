# Each entry takes the test, code, value, unit and time of its latest member, so a value is never shown at another
# member's time, and the status of the member chosen for status.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT {
  ?entry a cascade:LaboratoryTestResult ;
    cascade:testName ?name ;
    cascade:testCode ?code ;
    cascade:resultValue ?value ;
    cascade:resultUnit ?unit ;
    cascade:workflowStatus ?status ;
    cascade:resultClinicallyRelevantTime ?date ;
    cascade:latestMember ?latest ;
    cascade:statusFrom ?statusFrom ;
    cascade:mergedFrom ?record .
}
WHERE {
  ?record a cascade:LaboratoryTestResult ; cascade:inEntry ?entry .
  ?entry cascade:latestMember ?latest .
  OPTIONAL { ?latest pav:hasCurrentVersion/cascade:testName ?name }
  OPTIONAL { ?latest pav:hasCurrentVersion/cascade:testCode ?code }
  OPTIONAL { ?latest pav:hasCurrentVersion/cascade:resultValue ?value }
  OPTIONAL { ?latest pav:hasCurrentVersion/cascade:resultUnit ?unit }
  OPTIONAL { ?entry cascade:statusFrom ?statusFrom .
             ?statusFrom pav:hasCurrentVersion/cascade:workflowStatus ?status }
  OPTIONAL { ?latest pav:hasCurrentVersion/cascade:resultClinicallyRelevantTime ?date }
}
