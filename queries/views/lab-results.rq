# Each entry takes the test, code, value, unit and time of its lead, so a value is never shown at another member's time,
# and the status of the member chosen for status. A value is shown as its source wrote it: a quantity with its
# comparator before its number, a ratio as its numerator, a colon and its denominator, a range as its two bounds with a
# hyphen between, or the one it has after >= or <=, and any other value as its text. The unit is the quantity's unit
# text, else its UCUM unit, else the result's unit as text. Each member's current values are a node of the view of their
# own, named after the entry and the member, which says the member they came from. A time its source wrote short of the
# second keeps the node saying so (cascade:PaddedDateTime), named after the entry or the member's values and -padded-,
# so the view never shows a padded time as exact.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT {
  ?entry a cascade:LaboratoryTestResult ;
    cascade:testName ?name ;
    cascade:testCode ?code ;
    cascade:resultValue ?value ;
    cascade:resultUnit ?unit ;
    cascade:workflowStatus ?status ;
    cascade:resultClinicallyRelevantTime ?date ;
    cascade:leadMember ?lead ;
    cascade:statusFrom ?statusFrom ;
    cascade:mergedFrom ?record .
  ?entry cascade:memberCurrentValues ?memberValues .
  ?memberValues cascade:valuesOfMember ?member ;
    cascade:testName ?memberTestName ;
    cascade:testCode ?memberTestCode ;
    cascade:resultValue ?memberResultValue ;
    cascade:resultUnit ?memberResultUnit ;
    cascade:workflowStatus ?memberWorkflowStatus ;
    cascade:resultClinicallyRelevantTime ?memberResultClinicallyRelevantTime .
  ?entry cascade:paddedDateTime ?datePadded .
  ?datePadded cascade:paddedDateTimeProperty cascade:resultClinicallyRelevantTime ; cascade:writtenDate ?dateWritten .
  ?memberValues cascade:paddedDateTime ?memberPadded .
  ?memberPadded cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:writtenDate ?memberWritten .
}
WHERE {
  { ?record a cascade:LaboratoryTestResult ; cascade:inEntry ?entry .
    ?entry cascade:leadMember ?lead .
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:testName ?name }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:testCode ?code }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:resultValue ?text }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:resultUnit ?textUnit }
    OPTIONAL {
      ?lead pav:hasCurrentVersion/cascade:resultQuantity ?quantity .
      ?quantity cascade:writtenValue ?written .
      OPTIONAL { ?quantity cascade:quantityComparator ?comparator }
      OPTIONAL { ?quantity cascade:unitText ?unitText }
      OPTIONAL { ?quantity cascade:ucumUnit ?ucumUnit }
    }
    OPTIONAL {
      ?lead pav:hasCurrentVersion ?ratioVersion .
      ?ratioVersion cascade:resultRatioNumerator/cascade:writtenValue ?numerator ;
                    cascade:resultRatioDenominator/cascade:writtenValue ?denominator .
    }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:resultRangeLow/cascade:writtenValue ?low }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:resultRangeHigh/cascade:writtenValue ?high }
    BIND (COALESCE(CONCAT(COALESCE(?comparator, ""), ?written),
                   CONCAT(?numerator, ":", ?denominator),
                   IF(BOUND(?low) && BOUND(?high), CONCAT(?low, "-", ?high),
                      IF(BOUND(?low), CONCAT(">=", ?low), CONCAT("<=", ?high))),
                   ?text) AS ?value)
    BIND (COALESCE(?unitText, ?ucumUnit, ?textUnit) AS ?unit)
    OPTIONAL { ?entry cascade:statusFrom ?statusFrom .
               ?statusFrom pav:hasCurrentVersion/cascade:workflowStatus ?status }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:resultClinicallyRelevantTime ?date }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:paddedDateTime ?datePaddedAt .
               ?datePaddedAt cascade:paddedDateTimeProperty cascade:resultClinicallyRelevantTime ; cascade:writtenDate ?dateWritten }
    BIND (IF(BOUND(?dateWritten), IRI(CONCAT(STR(?entry), "-padded-resultClinicallyRelevantTime")), 1/0) AS ?datePadded) }
  UNION
  { ?member a cascade:LaboratoryTestResult ; cascade:inEntry ?entry ; pav:hasCurrentVersion ?memberVersion .
    BIND (IRI(CONCAT(STR(?entry), "-", SHA256(STR(?member)))) AS ?memberValues)
    OPTIONAL { ?memberVersion cascade:testName ?memberTestName }
    OPTIONAL { ?memberVersion cascade:testCode ?memberTestCode }
    OPTIONAL { ?memberVersion cascade:resultValue ?memberResultValue }
    OPTIONAL { ?memberVersion cascade:resultUnit ?memberResultUnit }
    OPTIONAL { ?memberVersion cascade:workflowStatus ?memberWorkflowStatus }
    OPTIONAL { ?memberVersion cascade:resultClinicallyRelevantTime ?memberResultClinicallyRelevantTime }
    OPTIONAL { ?memberVersion cascade:paddedDateTime ?memberPaddedAt .
               ?memberPaddedAt cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:writtenDate ?memberWritten }
    BIND (IF(BOUND(?memberWritten), IRI(CONCAT(STR(?memberValues), "-padded-", STRAFTER(STR(?memberPaddedProperty), "#"))), 1/0)
          AS ?memberPadded) }
}
