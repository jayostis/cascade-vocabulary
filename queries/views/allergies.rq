# Each entry takes the allergen and code of its lead, the status of the member chosen for status, and the highest
# criticality any member states.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT {
  ?entry a cascade:AllergyOrIntolerance ;
    cascade:allergen ?allergen ;
    cascade:allergenCode ?code ;
    cascade:clinicalStatus ?status ;
    cascade:allergyCriticality ?criticality ;
    cascade:leadMember ?lead ;
    cascade:statusFrom ?statusFrom ;
    cascade:mergedFrom ?record .
}
WHERE {
  ?record a cascade:AllergyOrIntolerance ; cascade:inEntry ?entry .
  ?entry cascade:leadMember ?lead .
  OPTIONAL { ?lead pav:hasCurrentVersion/cascade:allergen ?allergen }
  OPTIONAL { ?lead pav:hasCurrentVersion/cascade:allergenCode ?code }
  OPTIONAL { ?entry cascade:statusFrom ?statusFrom .
             ?statusFrom pav:hasCurrentVersion/cascade:clinicalStatus ?status }
  OPTIONAL { ?entry cascade:topCriticality ?criticality }
}
