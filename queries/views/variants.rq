# Each entry takes every member's gene symbol, HGVS expressions and ClinVar IDs, since codes are identity and nothing is
# chosen among them, and the status of the member chosen for status.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT {
  ?entry a cascade:GeneticVariantFinding ;
    cascade:geneSymbol ?gene ;
    cascade:hgvsCodingDnaExpression ?hgvs ;
    cascade:clinvarVariationId ?variation ;
    cascade:workflowStatus ?status ;
    cascade:latestMember ?latest ;
    cascade:statusFrom ?statusFrom ;
    cascade:mergedFrom ?record .
}
WHERE {
  ?record a cascade:GeneticVariantFinding ; cascade:inEntry ?entry .
  ?entry cascade:latestMember ?latest .
  OPTIONAL { ?record pav:hasCurrentVersion/cascade:geneSymbol ?gene }
  OPTIONAL { ?record pav:hasCurrentVersion/cascade:hgvsCodingDnaExpression ?hgvs }
  OPTIONAL { ?record pav:hasCurrentVersion/cascade:clinvarVariationId ?variation }
  OPTIONAL { ?entry cascade:statusFrom ?statusFrom .
             ?statusFrom pav:hasCurrentVersion/cascade:workflowStatus ?status }
}
