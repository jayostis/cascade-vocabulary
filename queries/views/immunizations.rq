# Each entry takes the vaccine and code of its lead, the status of the member chosen for status, and the date of the
# member chosen for the date. Each member's current values are a node of the view of their own, named after the entry
# and the member, which says the member they came from. A time its source wrote short of the second keeps the node
# saying so (cascade:PaddedDateTime), named after the entry or the member's values and -padded-, so the view never shows
# a padded time as exact.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX pav: <http://purl.org/pav/>

CONSTRUCT {
  ?entry a cascade:Vaccination ;
    cascade:vaccineName ?name ;
    cascade:vaccineCode ?code ;
    cascade:workflowStatus ?status ;
    cascade:vaccinationOccurrenceTime ?date ;
    cascade:leadMember ?lead ;
    cascade:statusFrom ?statusFrom ;
    cascade:mergedFrom ?record .
  ?entry cascade:memberCurrentValues ?memberValues .
  ?memberValues cascade:valuesOfMember ?member ;
    cascade:vaccineName ?memberVaccineName ;
    cascade:vaccineCode ?memberVaccineCode ;
    cascade:workflowStatus ?memberWorkflowStatus ;
    cascade:vaccinationOccurrenceTime ?memberVaccinationOccurrenceTime .
  ?entry cascade:paddedDateTime ?datePadded .
  ?datePadded cascade:paddedDateTimeProperty cascade:vaccinationOccurrenceTime ; cascade:writtenDate ?dateWritten .
  ?memberValues cascade:paddedDateTime ?memberPadded .
  ?memberPadded cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:writtenDate ?memberWritten .
}
WHERE {
  { ?record a cascade:Vaccination ; cascade:inEntry ?entry .
    ?entry cascade:leadMember ?lead .
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:vaccineName ?name }
    OPTIONAL { ?lead pav:hasCurrentVersion/cascade:vaccineCode ?code }
    OPTIONAL { ?entry cascade:statusFrom ?statusFrom .
               ?statusFrom pav:hasCurrentVersion/cascade:workflowStatus ?status }
    OPTIONAL { ?entry cascade:dateFrom/pav:hasCurrentVersion/cascade:vaccinationOccurrenceTime ?date }
    OPTIONAL { ?entry cascade:dateFrom/pav:hasCurrentVersion/cascade:paddedDateTime ?datePaddedAt .
               ?datePaddedAt cascade:paddedDateTimeProperty cascade:vaccinationOccurrenceTime ; cascade:writtenDate ?dateWritten }
    BIND (IF(BOUND(?dateWritten), IRI(CONCAT(STR(?entry), "-padded-vaccinationOccurrenceTime")), 1/0) AS ?datePadded) }
  UNION
  { ?member a cascade:Vaccination ; cascade:inEntry ?entry ; pav:hasCurrentVersion ?memberVersion .
    BIND (IRI(CONCAT(STR(?entry), "-", SHA256(STR(?member)))) AS ?memberValues)
    OPTIONAL { ?memberVersion cascade:vaccineName ?memberVaccineName }
    OPTIONAL { ?memberVersion cascade:vaccineCode ?memberVaccineCode }
    OPTIONAL { ?memberVersion cascade:workflowStatus ?memberWorkflowStatus }
    OPTIONAL { ?memberVersion cascade:vaccinationOccurrenceTime ?memberVaccinationOccurrenceTime }
    OPTIONAL { ?memberVersion cascade:paddedDateTime ?memberPaddedAt .
               ?memberPaddedAt cascade:paddedDateTimeProperty ?memberPaddedProperty ; cascade:writtenDate ?memberWritten }
    BIND (IF(BOUND(?memberWritten), IRI(CONCAT(STR(?memberValues), "-padded-", STRAFTER(STR(?memberPaddedProperty), "#"))), 1/0)
          AS ?memberPadded) }
}
