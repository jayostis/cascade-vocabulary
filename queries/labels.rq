# A name for every record, version, revision, document, judgment, reference version, entry and patient profile, made from
# what each says: its kind, its name, where it came from and when. Names only help people read; nothing depends on them.
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

CONSTRUCT { ?thing rdfs:label ?label }
WHERE {
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing rec:kind ?kind ; pav:hasCurrentVersion ?v ; rec:currentRevision ?r .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?v rec:name ?name }
      OPTIONAL { ?r prov:wasDerivedFrom ?doc }
      OPTIONAL { ?r prov:wasDerivedFrom/pav:retrievedFrom ?from }
      OPTIONAL { ?r prov:wasDerivedFrom/prov:qualifiedAttribution ?a .
                 ?a prov:hadRole rec:author ; prov:agent/rdfs:label ?author }
      BIND (CONCAT(?kind, " · ", COALESCE(?name, "no name"), " · ",
                   COALESCE(CONCAT(?author, " · ", REPLACE(STR(?from), "^.*/", "")),
                            IF(BOUND(?doc), "unknown source", "own entry"))) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing prov:specializationOf/rec:kind ?kind .
      ?revision rec:version ?thing ; prov:generatedAtTime ?t .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing rec:name ?name }
      OPTIONAL { ?thing rec:status ?status }
      OPTIONAL { ?thing clinical:verificationStatus ?verification }
      OPTIONAL { ?thing clinical:criticality ?c }
      OPTIONAL { ?thing rec:date ?date }
      OPTIONAL { ?revision prov:wasDerivedFrom ?doc }
      OPTIONAL { ?revision prov:wasDerivedFrom/pav:retrievedFrom ?from }
      BIND (CONCAT(?kind, " version · ", COALESCE(?name, "no name"), " · ",
                   COALESCE(?status, ?verification, CONCAT("criticality ", ?c), STR(?date), "nothing stated"), " · ",
                   COALESCE(REPLACE(STR(?from), "^.*/", ""), IF(BOUND(?doc), "unknown source", "own entry")),
                   " · first received ", SUBSTR(STR(?t), 1, 10)) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a rec:Revision ; rec:version ?v ; prov:generatedAtTime ?t .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?v rec:name ?name }
      OPTIONAL { ?thing prov:wasDerivedFrom ?doc }
      OPTIONAL { ?thing prov:wasDerivedFrom/pav:retrievedFrom ?from }
      BIND (CONCAT("Revision · ", COALESCE(?name, "no name"), " · ",
                   COALESCE(REPLACE(STR(?from), "^.*/", ""), IF(BOUND(?doc), "unknown source", "own entry")),
                   " · received ", SUBSTR(STR(?t), 1, 10)) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?revision a rec:Revision ; prov:wasDerivedFrom ?thing .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing prov:qualifiedAttribution ?a .
                 ?a prov:hadRole rec:author ; prov:agent/rdfs:label ?author }
      OPTIONAL { ?thing pav:retrievedFrom ?from }
      OPTIONAL { ?thing pav:retrievedOn ?on }
      BIND (CONCAT("Document · ", COALESCE(?author, "unknown source"),
                   COALESCE(CONCAT(" · ", REPLACE(STR(?from), "^.*/([^/]+/[^/]+)$", "$1")), ""),
                   COALESCE(CONCAT(" · retrieved ", SUBSTR(STR(?on), 1, 10)), "")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a jdg:Judgment ; prov:generatedAtTime ?t ; prov:wasAttributedTo ?who .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing jdg:verdict ?verdict }
      OPTIONAL { ?who rdfs:label ?machine }
      OPTIONAL { ?thing prov:qualifiedAttribution/prov:hadRole ?role }
      OPTIONAL { ?thing prov:hadMember/^prov:specializationOf/rec:name ?about }
      OPTIONAL { ?thing npx:retracts/jdg:verdict ?retracted }
      OPTIONAL { ?thing npx:retracts/prov:hadMember/^prov:specializationOf/rec:name ?retractedAbout }
      BIND (CONCAT(COALESCE(REPLACE(STR(?verdict), "^.*#", ""), "Retraction"), " · ",
                   COALESCE(?machine, IF(?role = jdg:patient, "the patient", "a person")), " · ",
                   SUBSTR(STR(?t), 1, 10), " · ",
                   IF(BOUND(?verdict), COALESCE(?about, "a patient profile"),
                      CONCAT("of ", COALESCE(REPLACE(STR(?retracted), "^.*#", ""), "a judgment"), " · ",
                             COALESCE(?retractedAbout, "a patient profile")))) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing prov:specializationOf ?series ; pav:version ?version .
      ?series a rec:ReferenceSeries ; rdfs:label ?name .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      BIND (CONCAT(?name, " · ", ?version) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing rec:latestMember ?latest .
      ?latest rec:kind ?kind .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?latest pav:hasCurrentVersion/rec:name ?name }
      OPTIONAL { ?thing rec:dateFrom/pav:hasCurrentVersion/rec:date ?date }
      BIND (CONCAT(?kind, " entry", COALESCE(CONCAT(" · ", ?name), ""), COALESCE(CONCAT(" · ", STR(?date)), "")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a cascade:PatientProfile ; cascade:mergedFrom [] .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      BIND ("Patient entry" AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?version rec:patient ?thing .
      ?revision rec:version ?version ; prov:generatedAtTime ?t .
      FILTER NOT EXISTS { ?thing a rec:Subject }
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?revision prov:wasDerivedFrom/prov:qualifiedAttribution ?a .
                 ?a prov:hadRole rec:author ; prov:agent/rdfs:label ?author }
      BIND (CONCAT("Patient profile · ", COALESCE(?author, "unknown source"),
                   " · first received ", SUBSTR(STR(?t), 1, 10)) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a rec:Subject .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      BIND ("The person this pod is about" AS ?l)
    }
    GROUP BY ?thing }
}
