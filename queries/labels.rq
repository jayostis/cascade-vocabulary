# A name for every record, version, revision, document, judgment, retraction, reference version, entry and patient
# profile, made from what each says: its kind, its name, where it came from and when; a machine's claim, which gives no
# time, by the start of its name instead. Names only help people read; nothing depends on them.
# An entry is labelled as the view holding it names it: a view is built before this file, and its graph holds each entry
# resolved against the view's address (N13), so the placeholder only the derived state holds is never labelled.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT { ?thing rdfs:label ?label }
WHERE {
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing cascade:recordKind ?kind ; pav:hasCurrentVersion ?v ; cascade:currentRevision ?r .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?v cascade:displayName ?name }
      OPTIONAL { ?r prov:wasDerivedFrom ?doc }
      OPTIONAL { ?r prov:wasDerivedFrom/pav:retrievedFrom ?from }
      OPTIONAL { ?r prov:wasDerivedFrom/prov:qualifiedAttribution ?a .
                 ?a prov:hadRole ?authorRole ; prov:agent/(rdfs:label|pav:hasCurrentVersion/foaf:name) ?author
                 FILTER (?authorRole IN (cascade:AuthorRole, cascade:CustodianRole)) }
      BIND (CONCAT(?kind, " · ", COALESCE(?name, "no name"), " · ",
                   COALESCE(CONCAT(?author, " · ", REPLACE(STR(?from), "^.*/", "")),
                            IF(BOUND(?doc), "unknown source", "own entry"))) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing prov:specializationOf/cascade:recordKind ?kind .
      ?revision cascade:version ?thing ; prov:generatedAtTime ?t .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing cascade:displayName ?name }
      OPTIONAL { ?thing cascade:clinicalStatus|cascade:workflowStatus ?status }
      OPTIONAL { ?thing cascade:verificationStatus ?verification }
      OPTIONAL { ?thing cascade:allergyCriticality ?c }
      OPTIONAL { ?thing cascade:displayDate ?date }
      OPTIONAL { ?revision prov:wasDerivedFrom ?doc }
      OPTIONAL { ?revision prov:wasDerivedFrom/pav:retrievedFrom ?from }
      BIND (CONCAT(?kind, " version · ", COALESCE(?name, "no name"), " · ",
                   COALESCE(?status, ?verification, CONCAT("criticality ", ?c), STR(?date), "nothing stated"), " · ",
                   COALESCE(REPLACE(STR(?from), "^.*/", ""), IF(BOUND(?doc), "unknown source", "own entry")),
                   " · first received ", SUBSTR(STR(?t), 1, 10)) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a cascade:Revision ; cascade:version ?v ; prov:generatedAtTime ?t .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?v cascade:displayName ?name }
      OPTIONAL { ?thing prov:wasDerivedFrom ?doc }
      OPTIONAL { ?thing prov:wasDerivedFrom/pav:retrievedFrom ?from }
      BIND (CONCAT("Revision · ", COALESCE(?name, "no name"), " · ",
                   COALESCE(REPLACE(STR(?from), "^.*/", ""), IF(BOUND(?doc), "unknown source", "own entry")),
                   " · received ", SUBSTR(STR(?t), 1, 10)) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?revision a cascade:Revision ; prov:wasDerivedFrom ?thing .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing prov:qualifiedAttribution ?a .
                 ?a prov:hadRole ?authorRole ; prov:agent/(rdfs:label|pav:hasCurrentVersion/foaf:name) ?author
                 FILTER (?authorRole IN (cascade:AuthorRole, cascade:CustodianRole)) }
      OPTIONAL { ?thing pav:retrievedFrom ?from }
      OPTIONAL { ?thing pav:retrievedOn ?on }
      BIND (CONCAT("Document · ", COALESCE(?author, "unknown source"),
                   COALESCE(CONCAT(" · ", REPLACE(STR(?from), "^.*/([^/]+/[^/]+)$", "$1")), ""),
                   COALESCE(CONCAT(" · retrieved ", SUBSTR(STR(?on), 1, 10)), "")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a cascade:Judgment ; prov:wasAttributedTo ?who .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing prov:generatedAtTime ?t }
      OPTIONAL { ?thing cascade:verdict ?verdict }
      OPTIONAL { ?who rdfs:label ?machine }
      OPTIONAL { ?thing prov:qualifiedAttribution/prov:hadRole ?role }
      OPTIONAL { ?thing prov:hadMember/^prov:specializationOf/cascade:displayName ?about }
      BIND (CONCAT(REPLACE(STR(?verdict), "^.*#", ""), " · ",
                   COALESCE(?machine, IF(?role = cascade:PatientRole, "the patient", "a person")), " · ",
                   IF(BOUND(?t), SUBSTR(STR(?t), 1, 10), SUBSTR(REPLACE(STR(?thing), "^.*[:/#]", ""), 1, 8)), " · ",
                   COALESCE(?about, "a patient profile")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a prov:Activity ; prov:invalidated ?retracted .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?thing prov:wasAssociatedWith ?who }
      OPTIONAL { ?thing prov:startedAtTime ?t }
      OPTIONAL { ?who rdfs:label ?named }
      OPTIONAL { ?thing prov:qualifiedAssociation/prov:hadRole ?role }
      OPTIONAL { ?retracted cascade:assertedClaim?/cascade:verdict ?retractedVerdict }
      OPTIONAL { ?retracted cascade:assertedClaim?/prov:hadMember/^prov:specializationOf/cascade:displayName ?retractedAbout }
      BIND (CONCAT("Retraction · ",
                   COALESCE(?named, IF(BOUND(?who), IF(?role = cascade:PatientRole, "the patient", "a person"), "a release")), " · ",
                   IF(BOUND(?t), SUBSTR(STR(?t), 1, 10), SUBSTR(REPLACE(STR(?thing), "^.*[:/#]", ""), 1, 8)), " · of ",
                   COALESCE(REPLACE(STR(?retractedVerdict), "^.*#", ""), "a judgment"), " · ",
                   COALESCE(?retractedAbout, "a patient profile")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing prov:specializationOf ?series ; pav:version ?version .
      ?series a cascade:ReferenceSeries ; rdfs:label ?name .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      BIND (CONCAT(?name, " · ", ?version) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      GRAPH ?view { ?view a cascade:View . ?thing cascade:latestMember ?latest }
      ?latest cascade:recordKind ?kind .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?latest pav:hasCurrentVersion/cascade:displayName ?name }
      OPTIONAL { ?latest cascade:inEntry/cascade:dateFrom/pav:hasCurrentVersion/cascade:displayDate ?date }
      BIND (CONCAT(?kind, " entry", COALESCE(CONCAT(" · ", ?name), ""), COALESCE(CONCAT(" · ", STR(?date)), "")) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      GRAPH ?view { ?view a cascade:View . ?thing a cascade:PatientProfile ; cascade:mergedFrom [] }
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      BIND ("Patient entry" AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?version cascade:patient ?thing .
      ?revision cascade:version ?version ; prov:generatedAtTime ?t .
      FILTER NOT EXISTS { ?thing a cascade:Subject }
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      OPTIONAL { ?revision prov:wasDerivedFrom/prov:qualifiedAttribution ?a .
                 ?a prov:hadRole ?authorRole ; prov:agent/(rdfs:label|pav:hasCurrentVersion/foaf:name) ?author
                 FILTER (?authorRole IN (cascade:AuthorRole, cascade:CustodianRole)) }
      BIND (CONCAT("Patient profile · ", COALESCE(?author, "unknown source"),
                   " · first received ", SUBSTR(STR(?t), 1, 10)) AS ?l)
    }
    GROUP BY ?thing }
  UNION
  { SELECT ?thing (MIN(?l) AS ?label)
    WHERE {
      ?thing a cascade:Subject .
      FILTER NOT EXISTS { ?thing rdfs:label [] }
      BIND ("The person this pod is about" AS ?l)
    }
    GROUP BY ?thing }
}
