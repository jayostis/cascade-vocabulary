# The lens decides which judgments count, and is the one step of the build that can be swapped. This one counts a person's
# judgment not retracted, nor superseded by a judgment not itself retracted. A machine's claim counts on the same terms when
# the Cascade matcher made it, every reference version it used is current, and it is asserted with a query hash that the
# current version of a rule list pins: its rule runs now the query it was asserted with. A retracted judgment supersedes
# nothing.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?j cascade:countsUnderLens true }
WHERE {
  { ?j a cascade:Judgment ; prov:wasAttributedTo/a prov:Person .
    FILTER NOT EXISTS {
      ?superseding npx:supersedes ?j
      OPTIONAL { ?undoing npx:retracts ?superseding }
      FILTER (!BOUND(?undoing))
    }
    FILTER NOT EXISTS { ?retracting npx:retracts ?j } }
  UNION
  { ?j a cascade:Judgment ; prov:wasAttributedTo cascade:CascadeMatcher .
    FILTER NOT EXISTS {
      ?superseding npx:supersedes ?j
      OPTIONAL { ?undoing npx:retracts ?superseding }
      FILTER (!BOUND(?undoing))
    }
    FILTER NOT EXISTS { ?retracting npx:retracts ?j }
    FILTER EXISTS {
      ?assertion cascade:assertedClaim ?j ; cascade:assertedWithQueryHash ?hash .
      ?ruleList pav:hasCurrentVersion ?rules .
      ?rules cascade:queryHash ?hash .
    }
    FILTER NOT EXISTS {
      ?j prov:used ?input .
      ?input prov:specializationOf ?series .
      ?series a cascade:ReferenceSeries ; pav:hasCurrentVersion ?now .
      FILTER (?now != ?input)
    } }
}
