# A stricter lens, for records sent elsewhere: a person's judgment counts unless retracted or superseded, and a machine's
# claim only when the Cascade matcher made it resting on the same code, or code and date, or code and period, made with
# current reference versions, and asserted under a version whose row for its rule has the query hash of the current rule
# list version's row for it. A retracted judgment supersedes nothing.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX npx: <http://purl.org/nanopub/x/>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>

CONSTRUCT { ?j cascade:countsUnderLens true }
WHERE {
  { ?j a cascade:Judgment ; prov:wasAttributedTo/a prov:Person .
    FILTER NOT EXISTS {
      ?superseding npx:supersedes ?j
      OPTIONAL { ?undoing npx:retracts ?superseding }
      FILTER (!BOUND(?undoing))
    }
    FILTER NOT EXISTS { ?retracting npx:retracts ?j } }
  UNION
  { { SELECT DISTINCT ?j
          WHERE {
            { SELECT DISTINCT ?rule ?hash
              WHERE { ?ruleList pav:hasCurrentVersion ?current .
                      ?currentRow cascade:rowOfRuleListVersion ?current ; cascade:matcherRule ?rule ; cascade:queryHash ?hash } }
            ?assertedRow cascade:matcherRule ?rule ; cascade:queryHash ?hash ; cascade:rowOfRuleListVersion ?asserted .
            ?assertion cascade:assertedUnderRuleListVersion ?asserted ; cascade:assertedClaim ?j .
            ?j cascade:matcherRule ?rule .
          } }
    ?j a cascade:Judgment ; prov:wasAttributedTo cascade:CascadeMatcher ; cascade:justification ?why .
    FILTER (?why IN (cascade:SameCode, cascade:SameCodeAndDate, cascade:SameCodeAndPeriod))
    FILTER NOT EXISTS {
      ?superseding npx:supersedes ?j
      OPTIONAL { ?undoing npx:retracts ?superseding }
      FILTER (!BOUND(?undoing))
    }
    FILTER NOT EXISTS { ?retracting npx:retracts ?j }
    FILTER NOT EXISTS {
      ?j prov:used ?input .
      ?input prov:specializationOf ?series .
      ?series a cascade:ReferenceSeries ; pav:hasCurrentVersion ?now .
      FILTER (?now != ?input)
    } }
}
