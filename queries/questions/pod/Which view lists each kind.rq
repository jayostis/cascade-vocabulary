# An app finds a Solid pod's data through its type index: each registration names a type and the file that lists things of that type.
# Here each of those files is a view, and the entries are the things it lists. A view is never edited by hand; the build writes it from the records and the judgments.
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX solid: <http://www.w3.org/ns/solid/terms#>

SELECT ?title ?type ?view (COUNT(DISTINCT ?entry) AS ?entries)
WHERE {
  ?registration a solid:TypeRegistration ; solid:forClass ?type ; solid:instance ?view ; dct:title ?title .
  OPTIONAL { ?entry a ?type ; cascade:mergedFrom [] }
}
GROUP BY ?title ?type ?view
ORDER BY ?title ?view
