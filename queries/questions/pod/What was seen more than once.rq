# Each entry that holds more than one record, once for each place its records came from: how many of its records came
# from that place, and from how many places they came. A record's place is read from its current revision: the hospital
# that wrote the document it was derived from, or, when it has none, the label of the import or session that generated
# it. A place is told apart by its label alone, since a hospital is named by nothing else: a hospital with two labels is
# two places, and a hospital and an import that share a label are one. A record with two hospitals counts at each, so an
# entry's records can add up to more than it holds; a record with no hospital and no labelled import or session is given
# no place, and is not counted in places. Entries seen at more than one place come first.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?entry ?entryLabel ?place (COUNT(DISTINCT ?record) AS ?records) ?places
WHERE {
  { SELECT ?entry (COUNT(DISTINCT ?somewhere) AS ?places)
    WHERE {
      ?member cascade:inEntry ?entry ; cascade:currentRevision ?memberRevision .
      OPTIONAL { ?memberRevision prov:wasGeneratedBy/rdfs:label ?memberImportLabel }
      OPTIONAL { ?memberRevision prov:wasDerivedFrom/prov:qualifiedAttribution ?memberAttribution .
                 ?memberAttribution prov:hadRole cascade:AuthorRole ; prov:agent/rdfs:label ?memberHospital }
      BIND (COALESCE(?memberHospital, ?memberImportLabel) AS ?somewhere)
    }
    GROUP BY ?entry
    HAVING (COUNT(DISTINCT ?member) > 1) }
  ?record cascade:inEntry ?entry ; cascade:currentRevision ?revision .
  OPTIONAL { ?entry rdfs:label ?entryLabel }
  OPTIONAL { ?revision prov:wasGeneratedBy/rdfs:label ?importLabel }
  OPTIONAL { ?revision prov:wasDerivedFrom/prov:qualifiedAttribution ?attribution .
             ?attribution prov:hadRole cascade:AuthorRole ; prov:agent/rdfs:label ?hospital }
  BIND (COALESCE(?hospital, ?importLabel) AS ?place)
}
GROUP BY ?entry ?entryLabel ?place ?places
ORDER BY DESC(?places) ?entryLabel ?entry ?place
