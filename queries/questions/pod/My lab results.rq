# Read from the view alone, as an app would, newest first, with how many records each entry joins. A day and a time are
# not comparable, so entries are ordered by their day first, then by the time as written.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?performed ?test ?code ?value ?unit ?status (COUNT(?record) AS ?records) ?entry ?entryLabel
WHERE {
  ?entry a cascade:LaboratoryTestResult ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry cascade:resultClinicallyRelevantTime ?performed }
  OPTIONAL { ?entry cascade:testName ?test }
  OPTIONAL { ?entry cascade:testCode ?code }
  OPTIONAL { ?entry cascade:resultValue ?value }
  OPTIONAL { ?entry cascade:resultUnit ?unit }
  OPTIONAL { ?entry cascade:workflowStatus ?status }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
}
GROUP BY ?entry ?performed ?test ?code ?value ?unit ?status ?entryLabel
ORDER BY DESC(COALESCE(SUBSTR(STR(?performed), 1, 10), "")) DESC(COALESCE(STR(?performed), "")) ?test ?entry
