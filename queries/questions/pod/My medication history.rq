# Read from the view alone, as an app would: each medication entry whatever its status, with its RxNorm code, its status,
# the lifecycle class of that status (rule L1), when it started, when it ended, and how many records it joins. A source
# that states no stop gives no end date: none is inferred from a medication's last appearance. The code is the one
# `pod/My active medications` gives, and the entries whose lifecycle is rec:MedicationActive are the ones it lists.
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?medication ?code ?status ?lifecycle ?started ?ended (COUNT(?record) AS ?records) ?entry ?entryLabel
WHERE {
  {
    SELECT ?entry (COUNT(DISTINCT ?candidate) AS ?candidates) (SAMPLE(?candidate) AS ?only)
    WHERE {
      ?entry a clinical:Medication .
      OPTIONAL {
        ?entry clinical:rxNormCode ?written .
        BIND (IF(isIRI(?written), ?written, IRI(CONCAT("http://www.nlm.nih.gov/research/umls/rxnorm/", ENCODE_FOR_URI(STR(?written))))) AS ?candidate)
      }
    }
    GROUP BY ?entry
  }
  ?entry a clinical:Medication ; clinical:drugName ?medication ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry rec:selectedCode ?chosen }
  OPTIONAL { ?entry clinical:status ?status }
  OPTIONAL { ?entry rec:lifecycle ?lifecycle }
  OPTIONAL { ?entry clinical:startDate ?started }
  OPTIONAL { ?entry clinical:endDate ?ended }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
  BIND (COALESCE(IF(STRSTARTS(STR(?chosen), "http://www.nlm.nih.gov/research/umls/rxnorm/"), ?chosen, ?nothing),
                 IF(?candidates = 1, ?only, ?nothing)) AS ?code)
}
GROUP BY ?entry ?medication ?code ?status ?lifecycle ?started ?ended ?entryLabel
ORDER BY ?medication ?entry
