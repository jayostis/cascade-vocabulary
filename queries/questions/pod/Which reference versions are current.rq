# The matcher compares codes using reference tables, and each table comes in versions. The newest is the one no other
# revises; a machine judgment made with an older one stops counting.
PREFIX pav: <http://purl.org/pav/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?series ?seriesLabel ?version ?versionLabel
WHERE {
  ?series a rec:ReferenceSeries ; pav:hasCurrentVersion ?version .
  OPTIONAL { ?series rdfs:label ?seriesLabel }
  OPTIONAL { ?version rdfs:label ?versionLabel }
}
ORDER BY ?series ?version
