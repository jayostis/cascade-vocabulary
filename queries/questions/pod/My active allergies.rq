# Read from the view alone, as an app would: each entry whose status is active, or that no document gives a status
# (its status then reads "not stated"), with its code, its criticality, how many
# records it joins, what each record states of the reaction, and each record it joins, with the document it was derived
# from, when that was retrieved, and the hospitals that wrote it and that keep it. A record's reactions are its
# reaction texts, then its reaction codes in parentheses, then its severity, each as the record's current values state
# them, so a record that is not the entry's lead is read as much as the lead. A list holds its values in order, each
# ended by "; " but the last, a record stating none of them is left out, and a list with nothing in it is unbound; a value's own parts are ended by ", ".
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX pav: <http://purl.org/pav/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?allergen ?code ?criticality ?status ?reactionsByRecord (COUNT(?record) AS ?records) ?entry ?entryLabel ?sources
WHERE {
  { SELECT ?entry (REPLACE(GROUP_CONCAT(DISTINCT COALESCE(CONCAT(?memberText, "; "), ""); separator=""), "; $", "") AS ?allReactions)
    WHERE {
      { SELECT ?entry ?memberText
        WHERE {
          { SELECT ?entry ?member (REPLACE(GROUP_CONCAT(DISTINCT COALESCE(CONCAT(?reactionText, ", "), ""); separator=""), ", $", "") AS ?texts)
            WHERE {
              { SELECT ?entry ?member ?reactionText
                WHERE {
                  ?entry a cascade:AllergyOrIntolerance ; cascade:memberCurrentValues ?textValues .
                  FILTER NOT EXISTS { ?entry cascade:clinicalStatus ?other FILTER (?other != "active") }
                  ?textValues cascade:valuesOfMember ?member .
                  OPTIONAL { ?textValues cascade:reactionManifestationText ?reactionText }
                }
                ORDER BY ?entry ?member ?reactionText }
            }
            GROUP BY ?entry ?member }
          { SELECT ?entry ?member (REPLACE(GROUP_CONCAT(DISTINCT COALESCE(CONCAT(STR(?memberCode), ", "), ""); separator=""), ", $", "") AS ?codes)
            WHERE {
              { SELECT ?entry ?member ?memberCode
                WHERE {
                  ?entry a cascade:AllergyOrIntolerance ; cascade:memberCurrentValues ?codeValues .
                  FILTER NOT EXISTS { ?entry cascade:clinicalStatus ?other FILTER (?other != "active") }
                  ?codeValues cascade:valuesOfMember ?member .
                  OPTIONAL { ?codeValues cascade:reactionManifestationCode ?memberCode }
                }
                ORDER BY ?entry ?member ?memberCode }
            }
            GROUP BY ?entry ?member }
          ?entry cascade:memberCurrentValues ?severityValues .
          ?severityValues cascade:valuesOfMember ?member .
          OPTIONAL { ?severityValues cascade:allergySeverity ?memberSeverity }
          BIND (IF(?texts = "" && ?codes = "" && !BOUND(?memberSeverity), 1/0,
                   CONCAT(STR(?member),
                          IF(?texts = "", "", CONCAT(" ", ?texts)),
                          IF(?codes = "", "", CONCAT(" (", ?codes, ")")),
                          COALESCE(CONCAT(", ", ?memberSeverity), ""))) AS ?memberText)
        }
        ORDER BY ?entry ?memberText }
    }
    GROUP BY ?entry }
  { SELECT ?entry (REPLACE(GROUP_CONCAT(DISTINCT CONCAT(?sourceText, "; "); separator=""), "; $", "") AS ?sources)
    WHERE {
      { SELECT ?entry ?sourceText
        WHERE {
          { SELECT ?entry ?sourceRecord ?document ?retrievedOn
                   (REPLACE(GROUP_CONCAT(DISTINCT COALESCE(CONCAT(?hospital, ", "), ""); separator=""), ", $", "") AS ?hospitals)
            WHERE {
              { SELECT ?entry ?sourceRecord ?document ?retrievedOn ?hospital
                WHERE {
                  ?entry a cascade:AllergyOrIntolerance ; cascade:mergedFrom ?sourceRecord .
                  FILTER NOT EXISTS { ?entry cascade:clinicalStatus ?other FILTER (?other != "active") }
                  OPTIONAL { ?sourceRecord cascade:currentRevision/prov:wasDerivedFrom ?document .
                             OPTIONAL { ?document pav:retrievedOn ?retrievedOn }
                             OPTIONAL { ?document prov:qualifiedAttribution ?attribution .
                                        ?attribution prov:hadRole ?hospitalRole ; prov:agent ?agent
                                        FILTER (?hospitalRole IN (cascade:AuthorRole, cascade:CustodianRole))
                                        OPTIONAL { ?agent rdfs:label ?agentLabel }
                                        OPTIONAL { ?agent pav:hasCurrentVersion/foaf:name ?agentName }
                                        BIND (CONCAT(IF(?hospitalRole = cascade:AuthorRole, "written by ", "kept by "),
                                                     COALESCE(?agentLabel, ?agentName)) AS ?hospital) } }
                }
                ORDER BY ?entry ?sourceRecord ?document ?hospital }
            }
            GROUP BY ?entry ?sourceRecord ?document ?retrievedOn }
          BIND (CONCAT(STR(?sourceRecord), COALESCE(CONCAT(" from ", STR(?document)), ""),
                       COALESCE(CONCAT(", retrieved ", STR(?retrievedOn)), ""),
                       IF(?hospitals = "", "", CONCAT(", ", ?hospitals))) AS ?sourceText)
        }
        ORDER BY ?entry ?sourceText }
    }
    GROUP BY ?entry }
  ?entry a cascade:AllergyOrIntolerance ;
         cascade:allergen ?allergen ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry cascade:clinicalStatus ?stated }
  FILTER (!BOUND(?stated) || ?stated = "active")
  OPTIONAL { ?entry cascade:allergenCode ?code }
  OPTIONAL { ?entry cascade:allergyCriticality ?criticality }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
  BIND (COALESCE(?stated, "not stated") AS ?status)
  BIND (IF(?allReactions = "", 1/0, ?allReactions) AS ?reactionsByRecord)
}
GROUP BY ?entry ?allergen ?code ?criticality ?status ?reactionsByRecord ?entryLabel ?sources
ORDER BY ?allergen ?entry
