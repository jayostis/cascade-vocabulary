# Read from the view alone, as an app would, newest first by the date as written, so a year follows its months and
# days, with how many records each entry joins, and SNOMED CT's IRI for each procedure. Times written with a zone are
# ordered by their wall time as written, not as instants: 23:00-05:00 sorts before 01:00Z the next day, though it is
# later.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?performed ?procedure ?snomed ?status (COUNT(?record) AS ?records) ?entry ?entryLabel
WHERE {
  ?entry a cascade:MedicalProcedure ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry cascade:procedureDate ?performed }
  OPTIONAL { ?entry cascade:procedureName ?procedure }
  OPTIONAL { ?entry cascade:snomedCode ?snomed }
  OPTIONAL { ?entry cascade:workflowStatus ?status }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
}
GROUP BY ?entry ?performed ?procedure ?snomed ?status ?entryLabel
ORDER BY DESC(COALESCE(STR(?performed), "")) ?procedure ?entry
