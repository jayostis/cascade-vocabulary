# Read from the view alone, as an app would, newest first by the date as written, so a year follows its months and
# days, with how many records each entry joins, and each CVX code the entry states, a row for each.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?given ?vaccine ?code ?status (COUNT(?record) AS ?records) ?entry ?entryLabel
WHERE {
  ?entry a cascade:Vaccination ; cascade:mergedFrom ?record .
  OPTIONAL { ?entry cascade:vaccinationOccurrenceTime ?given }
  OPTIONAL { ?entry cascade:vaccineName ?vaccine }
  OPTIONAL { ?entry cascade:vaccineCode ?code }
  OPTIONAL { ?entry cascade:workflowStatus ?status }
  OPTIONAL { ?entry rdfs:label ?entryLabel }
}
GROUP BY ?entry ?given ?vaccine ?code ?status ?entryLabel
ORDER BY DESC(COALESCE(STR(?given), "")) ?vaccine ?entry
