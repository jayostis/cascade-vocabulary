# Read from the view alone, as an app would: one row for each variant entry and each code it states, the codes a page
# looks a variant up by. ?variant is the entry's IRI, as the other pod questions give theirs; ?gene, ?hgvs and ?variation
# are the literals as the entry states them, an HGVS expression or a ClinVar VariationID on a row of its own. An entry
# that states no code has one row without either. The page turns a literal into its code system's IRI (rule M4).
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

SELECT DISTINCT ?variant ?gene ?hgvs ?variation
WHERE {
  { ?variant a cascade:GeneticVariantFinding ; cascade:mergedFrom [] ; cascade:hgvsCodingDnaExpression ?hgvs .
    OPTIONAL { ?variant cascade:geneSymbol ?gene } }
  UNION
  { ?variant a cascade:GeneticVariantFinding ; cascade:mergedFrom [] ; cascade:clinvarVariationId ?variation .
    OPTIONAL { ?variant cascade:geneSymbol ?gene } }
  UNION
  { ?variant a cascade:GeneticVariantFinding ; cascade:mergedFrom [] .
    OPTIONAL { ?variant cascade:geneSymbol ?gene }
    FILTER NOT EXISTS { ?variant cascade:hgvsCodingDnaExpression [] }
    FILTER NOT EXISTS { ?variant cascade:clinvarVariationId [] } }
}
ORDER BY ?variant ?hgvs ?variation
