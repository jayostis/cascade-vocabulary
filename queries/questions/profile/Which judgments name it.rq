# An About judgment names a patient profile as its member and says whose it is; until one counts, the records that name
# the profile are in no view. Rows come in the order the judgments were made.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?profile ?profileLabel ?made ?judgment ?judgmentLabel ?verdict ?counts
WHERE {
  ?version cascade:patient ?profile .
  ?judgment a cascade:Judgment ; prov:hadMember ?profile ; prov:generatedAtTime ?made .
  OPTIONAL { ?judgment cascade:verdict ?verdict }
  OPTIONAL { ?judgment cascade:countsUnderLens ?counted }
  BIND (COALESCE(?counted, false) AS ?counts)
  OPTIONAL { ?profile rdfs:label ?profileLabel }
  OPTIONAL { ?judgment rdfs:label ?judgmentLabel }
}
ORDER BY ?profileLabel ?profile ?made ?judgment
