# What each entry shows: every value its view states of it and every value its members' current versions state of the
# fields the view shows, each with From, the member whose current version states it, and Lead, whether that member is
# the entry's lead (cascade:leadMember), whose values come first. An entry is what an app shows: one allergy, one
# condition, one vaccination; no merged record is stored, so the view holds each member's current values as a node of
# its own (cascade:memberCurrentValues) and this reads the view alone. The view takes the entry's name and codes from
# its lead, and its status and dates from the members the derivations chose for them (cascade:statusFrom,
# cascade:dateFrom and, for a medication, cascade:medicationUseStartDateFrom and cascade:prescriptionWrittenDateFrom). A
# value no member states, such as the highest criticality among them, has no From. A padded time is shown as the time, and a reference range as its
# text, its bounds being nodes of the view of their own; the node saying a time was written short of the second is no
# value of its own.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?entry ?entryLabel ?view ?field ?value ?valueLabel ?from ?fromLabel ?lead
WHERE {
  { GRAPH ?view { ?entry cascade:mergedFrom [] ; cascade:leadMember ?leader ; cascade:memberCurrentValues ?values .
                  ?values cascade:valuesOfMember ?from ; ?field ?value .
                  FILTER (?field NOT IN (cascade:valuesOfMember, cascade:paddedDateTime, cascade:referenceRangeLow, cascade:referenceRangeHigh)) }
    BIND (?from = ?leader AS ?lead)
    OPTIONAL { ?from rdfs:label ?fromLabel }
    OPTIONAL { ?entry rdfs:label ?entryLabel }
    OPTIONAL { ?value rdfs:label ?valueLabel } }
  UNION
  { GRAPH ?view { ?entry cascade:mergedFrom [] ; ?field ?value
                  FILTER (?field NOT IN (cascade:memberCurrentValues, cascade:paddedDateTime, cascade:referenceRangeLow, cascade:referenceRangeHigh))
                  FILTER NOT EXISTS { ?entry cascade:memberCurrentValues ?held . ?held ?field ?value } }
    OPTIONAL { ?entry rdfs:label ?entryLabel }
    OPTIONAL { ?value rdfs:label ?valueLabel } }
}
ORDER BY ?entryLabel ?entry ?field DESC(?lead) STR(?value) ?from
