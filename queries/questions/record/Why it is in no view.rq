# A record no entry joins is hidden, never deleted. Each reason the derivations left it out for is a row, with the thing
# that reason rests on, where there is one.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?record ?recordLabel ?why ?because ?becauseLabel
WHERE {
  ?record a rec:Record ; rec:leftOutFor ?leftOut .
  ?leftOut rec:reason ?why .
  OPTIONAL { ?leftOut rec:because ?because }
  OPTIONAL { ?leftOut rec:because ?because . ?because rdfs:label ?becauseLabel }
  OPTIONAL { ?record rdfs:label ?recordLabel }
}
ORDER BY ?why ?recordLabel ?record ?because
