# A judgment names records as its members: that two are the same, that they differ, or that one is wrong. Rows come in the
# order the judgments were made. Counts says whether one counts under the lens the pod was built with; one that does not
# was retracted, superseded by a judgment not itself retracted, or made with a reference table since replaced.
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?record ?recordLabel ?made ?judgment ?judgmentLabel ?verdict ?counts
WHERE {
  ?record a cascade:Record .
  ?judgment a cascade:Judgment ; prov:hadMember ?record ; prov:generatedAtTime ?made .
  OPTIONAL { ?judgment cascade:verdict ?verdict }
  OPTIONAL { ?judgment cascade:countsUnderLens ?counted }
  BIND (COALESCE(?counted, false) AS ?counts)
  OPTIONAL { ?record rdfs:label ?recordLabel }
  OPTIONAL { ?judgment rdfs:label ?judgmentLabel }
}
ORDER BY ?recordLabel ?record ?made ?judgment
