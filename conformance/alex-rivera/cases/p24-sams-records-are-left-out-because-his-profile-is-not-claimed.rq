PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?record ?why ?because WHERE {
  VALUES ?record { <urn:uuid:835a3c13-6a35-857a-995d-19b9ec534027> <urn:uuid:34a774e3-f83d-8275-89e2-3785085558e6> <urn:uuid:730dea68-b88f-895d-9be7-dd2f19d4de6f> }
  ?record rec:leftOutFor ?left .
  ?left rec:reason ?why .
  OPTIONAL { ?left rec:because ?because }
  FILTER NOT EXISTS { GRAPH ?view { ?entry cascade:mergedFrom ?record } }
}
