PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>

SELECT ?record ?why ?because WHERE {
  VALUES ?record { <urn:uuid:99696d97-cd0d-8e9c-af86-e54f66df19d5> }
  ?record rec:leftOutFor ?left .
  ?left rec:reason ?why .
  OPTIONAL { ?left rec:because ?because }
  FILTER NOT EXISTS { GRAPH ?view { ?entry cascade:mergedFrom ?record } }
}
