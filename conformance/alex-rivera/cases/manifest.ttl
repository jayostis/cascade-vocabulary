  rdfs:comment "What E13 wrote: each judgment as the scenario gives it, and the reference descriptions it was the first to use." ;
  mf:action [ rec:story <../story.json> ; rec:step "M8" ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ; qt:query <matcher-e13-writes-j13-to-j18.rq> ] ;
  mf:result <matcher-e13-writes-j13-to-j18.srj> .

<#matcher-runs-that-write-nothing> a rec:ReplayTest ;
  mf:name "matcher-runs-that-write-nothing" ;
