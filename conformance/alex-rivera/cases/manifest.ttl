<#p01-three-penicillin-records-are-allergies> a rec:ReplayTest ;
  mf:name "p01-three-penicillin-records-are-allergies" ;
  rdfs:comment "H1-ALG-PCN, H2O-ALG-PCN and H2F-ALG-PCN, one allergy at two hospitals, are three allergy records." ;
  mf:action [ rec:story <../story.json> ; rec:step "M8" ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ; qt:query <p01-three-penicillin-records-are-allergies.rq> ] ;
  mf:result <p01-three-penicillin-records-are-allergies.srj> .

<#p01-the-machine-joins-h1-penicillin-only-through-a-mapped-code> a rec:ReplayTest ;
  mf:name "p01-the-machine-joins-h1-penicillin-only-through-a-mapped-code" ;
  rdfs:comment "The only matcher judgment naming H1-ALG-PCN is J4, jdg:SameMappedCode." ;
  mf:action [ rec:story <../story.json> ; rec:step "M8" ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ; qt:query <p01-the-machine-joins-h1-penicillin-only-through-a-mapped-code.rq> ] ;
  mf:result <p01-the-machine-joins-h1-penicillin-only-through-a-mapped-code.srj> .

<#p01-penicillins-share-an-entry-through-the-mapped-code> a rec:ReplayTest ;
  mf:name "p01-penicillins-share-an-entry-through-the-mapped-code" ;
  rdfs:comment "Under everyday, J4's mapped code joins H1-ALG-PCN and H2O-ALG-PCN in one entry." ;
  mf:action [ rec:story <../story.json> ; rec:step "E5" ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ; qt:query <penicillin-entries.rq> ] ;
  mf:result <p01-penicillins-share-an-entry-through-the-mapped-code.srj> .

<#p01-penicillins-stay-apart-under-export> a rec:ReplayTest ;
  mf:name "p01-penicillins-stay-apart-under-export" ;
  rdfs:comment "Under export a mapped code does not count, so H1-ALG-PCN and H2O-ALG-PCN are each an entry of their own." ;
  mf:action [ rec:story <../story.json> ; rec:step "E5" ;
              rec:lens <../../../queries/v1-draft/lenses/export.rq> ; qt:query <penicillin-entries.rq> ] ;
  mf:result <p01-penicillins-stay-apart-under-export.srj> .

<#p01-h1-penicillin-alone-once-the-mapped-code-stops-counting> a rec:ReplayTest ;
  mf:name "p01-h1-penicillin-alone-once-the-mapped-code-stops-counting" ;
  rdfs:comment "With the ingredient map revised, J4 no longer counts: H1-ALG-PCN stands alone, and J14's same code joins the two Larkspur records." ;
  mf:action [ rec:story <../story.json> ; rec:step "E13" ;
              rec:lens <../../../queries/v1-draft/lenses/everyday.rq> ; qt:query <penicillin-entries.rq> ] ;
  mf:result <p01-h1-penicillin-alone-once-the-mapped-code-stops-counting.srj> .

<#p01-the-patient-joins-the-three-penicillins> a rec:ReplayTest ;
  mf:name "p01-the-patient-joins-the-three-penicillins" ;
  rdfs:comment "J21, Alex's Same, joins the three penicillin records, even under export." ;
  mf:action [ rec:story <../story.json> ; rec:step "J24" ;
              rec:lens <../../../queries/v1-draft/lenses/export.rq> ; qt:query <penicillin-entries.rq> ] ;
  mf:result <p01-the-patient-joins-the-three-penicillins.srj> .

<#p01-the-patients-same-counts> a rec:ReplayTest ;
