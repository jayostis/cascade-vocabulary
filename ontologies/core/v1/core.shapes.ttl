@prefix cascade: <https://ns.cascadeprotocol.org/core/v1#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cascade:PatientProfileShape a sh:NodeShape ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/core/v1/core.shapes.ttl> ;
    sh:targetClass cascade:PatientProfile ;
    sh:targetSubjectsOf cascade:dateOfBirth , foaf:givenName , foaf:familyName , foaf:name ;

    sh:property [
        sh:path cascade:dateOfBirth ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:severity sh:Violation
    ] ;

    sh:property [
        sh:path foaf:givenName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "foaf:givenName must be a single non-empty string. The cardinality is a deliberate 1: a second given name goes in foaf:name, which carries the whole name as one string."@en ;
        sh:severity sh:Warning
    ] ;

    sh:property [
        sh:path foaf:familyName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "foaf:familyName must be a single non-empty string."@en ;
        sh:severity sh:Warning
    ] ;

    sh:property [
        sh:path foaf:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "foaf:name must be a single non-empty string: the whole name as one string, which is what IPS Patient.name.text carries."@en ;
        sh:severity sh:Warning
    ] ;

    sh:property [
        sh:path cascade:sourceRecordId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Violation
    ] .
