@prefix dct: <http://purl.org/dc/terms/> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix solid: <http://www.w3.org/ns/solid/terms#> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ns.cascadeprotocol.org/records/v1-draft#> a owl:Ontology .

rec:sourceUrl a owl:ObjectProperty ;
    rdfs:label "source URL"@en ;
    rdfs:comment "A record's full address at its source. For a FHIR resource, the input its name is computed from: its URL on its server, or its urn:uuid; for a contained resource, its container's address, #, and its local id. For a C-CDA record, its HL7 identifier, urn:hl7ii:<root>:<extension>, or its root alone as urn:oid:<root> or urn:uuid:<root>, each character an IRI does not allow percent-encoded as UTF-8; several records may share it, and its name is computed from its class too. A record named from its document and its place in it, or with no usable identifier, has none."@en .

rec:patient a owl:ObjectProperty ;
    rdfs:label "patient"@en ;
    rdfs:comment "Who a version is about: the source's patient record, or the subject itself when the pod's person entered it."@en .

rec:Revision a owl:Class ;
    rdfs:label "revision"@en ;
    rdfs:comment "That, at its prov:generatedAtTime, a record came to say a version, after the revision it prov:wasRevisionOf, generated by an import and derived from a document."@en ;
    rdfs:subClassOf prov:Entity .

rec:revisionOf a owl:ObjectProperty ;
    rdfs:label "revision of"@en ;
    rdfs:domain rec:Revision .

rec:version a owl:ObjectProperty ;
    rdfs:label "version"@en ;
    rdfs:domain rec:Revision .

rec:Record a owl:Class ;
    rdfs:label "record"@en ;
    rdfs:comment "Derived: a thing the pod holds revisions and versions of, whatever its kind."@en .

rec:kind a owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:comment "Derived: the word for the record's kind, one for each type of record."@en ;
    rdfs:domain rec:Record ;
    rdfs:range xsd:string .

rec:statusOnlyFromDocuments a owl:DatatypeProperty ;
    rdfs:label "status only from documents"@en ;
    rdfs:comment "Derived: whether the record's kind takes a status only from a member translated from a document, never from one the person entered."@en ;
    rdfs:domain rec:Record ;
    rdfs:range xsd:boolean .

rec:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Derived: the version's name, copied from the property its kind names things with."@en .

rec:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Derived: the version's status, copied from the property its kind states one with."@en .

rec:date a owl:DatatypeProperty ;
    rdfs:label "date"@en ;
    rdfs:comment "Derived: the version's date, copied from the property its kind dates things with, if it has one."@en .

rec:currentRevision a owl:ObjectProperty ;
    rdfs:label "current revision"@en ;
    rdfs:comment "Derived: the revision of a record no other revision follows. Never written to a pod file."@en ;
    rdfs:range rec:Revision .

rec:Subject a owl:Class ;
    rdfs:label "subject"@en ;
    rdfs:comment "The person a pod is about: only a name, never versioned, holding no data."@en .

rec:author a prov:Role ;
    rdfs:label "author"@en ;
    rdfs:comment "The party that wrote a document, as US Core's provenance agent type author."@en .

rec:transmitter a prov:Role ;
    rdfs:label "transmitter"@en ;
    rdfs:comment "The party that fetched and delivered a document, as US Core's provenance agent type transmitter."@en .

rec:ReferenceSeries a owl:Class ;
    rdfs:label "reference series"@en ;
    rdfs:comment "A versioned reference table or rule set a machine applies; each of its versions is a prov:specializationOf it."@en .

pav:version a owl:DatatypeProperty ;
    rdfs:label "Version"@en ;
    rdfs:isDefinedBy <http://purl.org/pav/> ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/pav-ontology/pav/blob/1aff4569e1e14fc1c6c3ee6654c9101e06a4c655/pav.rdf> .

rdfs:label a rdf:Property ;
    rdfs:label "label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Literal ;
    dct:source <https://www.w3.org/TR/2014/REC-rdf-schema-20140225/> .

pav:hasCurrentVersion a owl:ObjectProperty ;
    rdfs:label "Has current version"@en ;
    rdfs:isDefinedBy <http://purl.org/pav/> ;
    rdfs:subPropertyOf pav:hasVersion ;
    dct:source <https://github.com/pav-ontology/pav/blob/1aff4569e1e14fc1c6c3ee6654c9101e06a4c655/pav.rdf> .

rec:View a owl:Class ;
    rdfs:label "view"@en ;
    rdfs:comment "A file the view queries build from the pod's records and judgments: deleting it loses nothing, and rerunning them rebuilds it."@en .

rec:counts a owl:DatatypeProperty ;
    rdfs:label "counts"@en ;
    rdfs:comment "Derived: the judgment counts under the lens the build used."@en ;
    rdfs:domain jdg:Judgment ;
    rdfs:range xsd:boolean .

rec:leftOutFor a owl:ObjectProperty ;
    rdfs:label "left out for"@en ;
    rdfs:comment "Derived: one reason no view shows the record, in this build."@en ;
    rdfs:domain rec:Record .

rec:reason a owl:ObjectProperty ;
    rdfs:label "reason"@en ;
    rdfs:comment "Derived: which of the reasons a record can be left out for this one is."@en .

rec:because a owl:ObjectProperty ;
    rdfs:label "because"@en ;
    rdfs:comment "Derived: the thing a reason for leaving a record out rests on, where it rests on one."@en .

rec:EnteredInErrorAtSource a owl:NamedIndividual ;
    rdfs:label "entered-in-error at its source"@en .

rec:RefutedAtSource a owl:NamedIndividual ;
    rdfs:label "refuted at its source"@en .

rec:JudgedErroneous a owl:NamedIndividual ;
    rdfs:label "judged erroneous"@en .

rec:ImportJudgedErroneous a owl:NamedIndividual ;
    rdfs:label "the import that brought it was judged erroneous"@en .

rec:PatientNotClaimed a owl:NamedIndividual ;
    rdfs:label "its patient profile has no counting About"@en .

rec:NoPatient a owl:NamedIndividual ;
    rdfs:label "it names no patient"@en .

rec:subject a owl:ObjectProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "Derived: whose record it is."@en ;
    rdfs:range rec:Subject .

rec:inEntry a owl:ObjectProperty ;
    rdfs:label "in entry"@en ;
    rdfs:comment "Derived: the view entry the record belongs to in this build."@en .

rec:latestMember a owl:ObjectProperty ;
    rdfs:label "latest member"@en ;
    rdfs:comment "Derived: the entry's most recently received member."@en .

rec:statusFrom a owl:ObjectProperty ;
    rdfs:label "status from"@en ;
    rdfs:comment "Derived: the member whose status the entry shows."@en .

rec:dateFrom a owl:ObjectProperty ;
    rdfs:label "date from"@en ;
    rdfs:comment "Derived: the member whose date the entry shows."@en .

rec:topCriticality a owl:DatatypeProperty ;
    rdfs:label "top criticality"@en ;
    rdfs:comment "Derived: the most severe criticality a member states."@en ;
    rdfs:range xsd:string .

rec:Placement a owl:Class ;
    rdfs:label "placement"@en ;
    rdfs:comment "One entry of a pod's layout: where a runtime files things. It names a file (solid:instance), a folder (solid:instanceContainer), or the property whose value's folder the thing goes in (rec:filedWith). A thing is placed by rec:filedWith first, then by an entry whose rec:forSubjectsOf it states, then by its solid:forClass alone; a file that says it is a rec:View is placed only by the entries at or under the views folder."@en .

rec:fanOut a owl:DatatypeProperty ;
    rdfs:label "fan-out"@en ;
    rdfs:comment "How many leading characters of a file's name make the subfolder of the placement's folder it is filed in."@en ;
    rdfs:domain rec:Placement ;
    rdfs:range xsd:integer .

rec:filedWith a owl:ObjectProperty ;
    rdfs:label "filed with"@en ;
    rdfs:comment "The property whose value is filed in the folder the thing goes in, when the thing states it."@en ;
    rdfs:domain rec:Placement .

rec:forSubjectsOf a owl:ObjectProperty ;
    rdfs:label "for subjects of"@en ;
    rdfs:comment "Narrows the placement's class to the things that state this property."@en ;
    rdfs:domain rec:Placement .

rec:writtenBy a owl:DatatypeProperty ;
    rdfs:label "written by"@en ;
    rdfs:comment "The path under queries/v1-draft/ of the query that writes the placement's file."@en ;
    rdfs:domain rec:Placement ;
    rdfs:range xsd:string .

rec:writtenAlways a owl:DatatypeProperty ;
    rdfs:label "written always"@en ;
    rdfs:comment "Whether the build writes the placement's view at every build, rather than once the pod holds a record of its class."@en ;
    rdfs:domain rec:Placement ;
    rdfs:range xsd:boolean .

rec:storesBytes a owl:DatatypeProperty ;
    rdfs:label "stores bytes"@en ;
    rdfs:comment "Whether the placement's folder holds documents' own bytes, each file named by the SHA-256 of its bytes in lowercase hex, rather than RDF."@en ;
    rdfs:domain rec:Placement ;
    rdfs:range xsd:boolean .

solid:forClass a rdf:Property ;
    rdfs:label "registry class"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/solid/terms#> ;
    dct:source <https://github.com/solid/vocab/blob/b2ec12c354ead0df5c9526479bda69f0bd4e9acd/solid-terms.ttl> .

solid:instance a rdf:Property ;
    rdfs:label "instance"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/solid/terms#> ;
    dct:source <https://github.com/solid/vocab/blob/b2ec12c354ead0df5c9526479bda69f0bd4e9acd/solid-terms.ttl> .

solid:instanceContainer a rdf:Property ;
    rdfs:label "instance container"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/solid/terms#> ;
    dct:source <https://github.com/solid/vocab/blob/b2ec12c354ead0df5c9526479bda69f0bd4e9acd/solid-terms.ttl> .

# Reference tables and the matcher's rule list, as a runtime is given them; none of these is written to a pod

rec:shipsWith a owl:ObjectProperty ;
    rdfs:label "ships with"@en ;
    rdfs:comment "The version of the series a runtime uses until the pod names another as current."@en ;
    rdfs:domain rec:ReferenceSeries ;
    rdfs:range prov:Entity .

rec:MatcherRule a owl:Class ;
    rdfs:label "matcher rule"@en ;
    rdfs:comment "One row of a version of the matcher's rule list: the justification it gives, the kinds of record it applies to, the comparison query it runs and the hash of that query's bytes, and the kind of table the query reads, if any."@en .

rec:justifiedAs a owl:ObjectProperty ;
    rdfs:label "justified as"@en ;
    rdfs:comment "The justification a judgment the rule writes gives."@en ;
    rdfs:domain rec:MatcherRule .

rec:appliesTo a owl:DatatypeProperty ;
    rdfs:label "applies to"@en ;
    rdfs:comment "A kind of record, as rec:kind words it, that the rule compares."@en ;
    rdfs:domain rec:MatcherRule ;
    rdfs:range xsd:string .

rec:query a owl:DatatypeProperty ;
    rdfs:label "query"@en ;
    rdfs:comment "The path under queries/v1-draft/ of the comparison query the rule runs."@en ;
    rdfs:domain rec:MatcherRule ;
    rdfs:range xsd:string .

rec:queryHash a owl:ObjectProperty ;
    rdfs:label "query hash"@en ;
    rdfs:comment "The ni:///sha-256; name of the bytes of the rule's query file; a run whose file does not hash to it is refused."@en ;
    rdfs:domain rec:MatcherRule .

# Table kinds, their rows and the codes rows name

rec:tableKind a owl:ObjectProperty ;
    rdfs:label "table kind"@en ;
    rdfs:comment "Of a series, the one kind of table its versions are; of a rule of the rule list, the kind whose rows its query reads. A runtime gives the query the current version of every series of that kind, each in the graph named by the version's IRI."@en ;
    rdfs:range rec:TableKind .

rec:TableKind a owl:Class ;
    rdfs:label "table kind"@en ;
    rdfs:comment "What a table's rows say, whatever source fills it: the shape every row conforms to and the property a row is found by. A row is a subject of a version's rows with every triple it is the subject of, and holds no blank node."@en .

rec:rowShape a owl:ObjectProperty ;
    rdfs:label "row shape"@en ;
    rdfs:comment "The SHACL shape every subject of a version's rows conforms to."@en ;
    rdfs:domain rec:TableKind .

rec:foundBy a owl:ObjectProperty ;
    rdfs:label "found by"@en ;
    rdfs:comment "A property whose value is a code a row is found by, or rec:RowSubject when the row is about the code itself, as its subject."@en ;
    rdfs:domain rec:TableKind .

rec:VaccineGroups a rec:TableKind ;
    rdfs:label "vaccine groups"@en ;
    rdfs:comment "An SSSOM mapping kind: a vaccine code and a group it is in. A code in several groups has a row for each, and a group's own code maps to itself."@en ;
    rec:rowShape rec:VaccineGroupRowShape ;
    rec:foundBy owl:annotatedSource .

rec:CodeNames a rec:TableKind ;
    rdfs:label "code names"@en ;
    rdfs:comment "A code's names in SKOS, as its publisher gives them."@en ;
    rec:rowShape rec:CodeNameRowShape ;
    rec:foundBy rec:RowSubject .

rec:CodeStatus a rec:TableKind ;
    rdfs:label "code status"@en ;
    rdfs:comment "A retired code, with each replacement its publisher gives. A code that is not retired has no row; a mapping kind keeps a retired code's rows."@en ;
    rec:rowShape rec:CodeStatusRowShape ;
    rec:foundBy rec:RowSubject .

rec:SubstanceIngredients a rec:TableKind ;
    rdfs:label "substance ingredients"@en ;
    rdfs:comment "An SSSOM mapping kind the stories use and no open source fills: a SNOMED CT substance and its RxNorm ingredient. Read either way round."@en ;
    rec:rowShape rec:SubstanceIngredientRowShape ;
    rec:foundBy owl:annotatedSource , owl:annotatedTarget .

rec:ProductIngredients a rec:TableKind ;
    rdfs:label "product ingredients"@en ;
    rdfs:comment "An SSSOM mapping kind: an RxNorm concept and its ingredient, its one ingredient or, with several, the multiple ingredient concept of exactly those. An ingredient maps to itself."@en ;
    rec:rowShape rec:ProductIngredientRowShape ;
    rec:foundBy owl:annotatedSource .

rec:BrandGenerics a rec:TableKind ;
    rdfs:label "brand generics"@en ;
    rdfs:comment "An SSSOM mapping kind: a branded RxNorm concept and its generic."@en ;
    rec:rowShape rec:BrandGenericRowShape ;
    rec:foundBy owl:annotatedSource .

rec:NdcDrugs a rec:TableKind ;
    rdfs:label "NDC drugs"@en ;
    rdfs:comment "An SSSOM mapping kind: an NDC and the RxNorm drug it is."@en ;
    rec:rowShape rec:NdcDrugRowShape ;
    rec:foundBy owl:annotatedSource .

rec:CodeConversions a rec:TableKind ;
    rdfs:label "code conversions"@en ;
    rdfs:comment "An SSSOM mapping kind: a retired code and the one code its publisher converts its data to. A code split into several has no row; code status gives each of its replacements."@en ;
    rec:rowShape rec:CodeConversionRowShape ;
    rec:foundBy owl:annotatedSource , owl:annotatedTarget .

rec:RowSubject a rdf:Property ;
    rdfs:label "the row's subject"@en ;
    rdfs:comment "Not stated by any row: as a kind's rec:foundBy, that each row is found by its own subject, the code it is about."@en .

rec:CodeSystem a owl:Class ;
    rdfs:label "code system"@en ;
    rdfs:comment "A code system whose codes are IRIs of one form: its void:uriSpace followed by the code. A record's code written as a literal joins a table as that IRI, the literal as written."@en .

rec:CVX a rec:CodeSystem ;
    rdfs:label "CVX"@en ;
    rdfs:comment "The code as CDC writes it, leading zero kept and trailing spaces trimmed: 08, 141. A record coded 8 joins nothing."@en ;
    void:uriSpace "http://hl7.org/fhir/sid/cvx/" .

rec:RxNorm a rec:CodeSystem ;
    rdfs:label "RxNorm"@en ;
    rdfs:comment "The RXCUI."@en ;
    void:uriSpace "http://www.nlm.nih.gov/research/umls/rxnorm/" .

rec:NDC a rec:CodeSystem ;
    rdfs:label "NDC"@en ;
    rdfs:comment "The code as RxNorm's RXNSAT gives it."@en ;
    void:uriSpace "http://hl7.org/fhir/sid/ndc/" .

rec:ICD10CM a rec:CodeSystem ;
    rdfs:label "ICD-10-CM"@en ;
    rdfs:comment "The code as FHIR writes it."@en ;
    void:uriSpace "http://hl7.org/fhir/sid/icd-10-cm/" .

rec:SNOMEDCT a rec:CodeSystem ;
    rdfs:label "SNOMED CT"@en ;
    rdfs:comment "The concept ID."@en ;
    void:uriSpace "http://snomed.info/sct/" .

void:uriSpace a owl:DatatypeProperty ;
    rdfs:label "URI space"@en ;
    rdfs:isDefinedBy <http://rdfs.org/ns/void#> ;
    rdfs:domain void:Dataset ;
    rdfs:range rdfs:Literal ;
    dct:source <https://www.w3.org/TR/2011/NOTE-void-20110303/> .

void:Dataset a owl:Class ;
    rdfs:label "dataset"@en ;
    rdfs:isDefinedBy <http://rdfs.org/ns/void#> ;
    dct:source <https://www.w3.org/TR/2011/NOTE-void-20110303/> .

owl:annotatedSource a rdf:Property ;
    rdfs:label "annotated source"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    dct:source <https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/> ,
        <https://www.w3.org/TR/2012/REC-owl2-rdf-based-semantics-20121211/> .

owl:annotatedProperty a rdf:Property ;
    rdfs:label "annotated property"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    dct:source <https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/> ,
        <https://www.w3.org/TR/2012/REC-owl2-rdf-based-semantics-20121211/> .

owl:annotatedTarget a rdf:Property ;
    rdfs:label "annotated target"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    dct:source <https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/> ,
        <https://www.w3.org/TR/2012/REC-owl2-rdf-based-semantics-20121211/> .

owl:deprecated a owl:AnnotationProperty ;
    rdfs:label "deprecated"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    dct:source <https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/> ,
        <https://www.w3.org/TR/2012/REC-owl2-rdf-based-semantics-20121211/> .

sssom:mapping_justification a owl:ObjectProperty ;
    rdfs:label "mapping justification"@en ;
    rdfs:isDefinedBy <https://w3id.org/sssom/schema/> ;
    dct:source <https://github.com/mapping-commons/sssom/blob/667d3c579d92ad2e1a480503625eeef1e6af8e6d/src/sssom_schema/schema/sssom_schema.yaml> .

skos:prefLabel a owl:AnnotationProperty ;
    rdfs:label "preferred label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:notation a owl:DatatypeProperty ;
    rdfs:label "notation"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

dct:isReplacedBy a rdf:Property ;
    rdfs:label "Is Replaced By"@en ;
    rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
    rdfs:subPropertyOf dct:relation ;
    dct:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/2020-01-20/> .

# Test terms, used with W3C's mf: test-manifest vocabulary

rec:lens a owl:ObjectProperty ;
    rdfs:label "lens"@en ;
    rdfs:comment "The query file of the lens a query test builds its pod under."@en .
