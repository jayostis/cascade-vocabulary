@prefix dct: <http://purl.org/dc/terms/> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ns.cascadeprotocol.org/records/v1-draft#> a owl:Ontology .

rec:sourceUrl a owl:ObjectProperty ;
    rdfs:label "source URL"@en ;
    rdfs:comment "A record's full address at its source, the input its name is computed from: a resource's URL on its server, or its urn:uuid; for a contained resource, its container's address, #, and its local id. A record named from its document and its place in it has none."@en .

rec:patient a owl:ObjectProperty ;
    rdfs:label "patient"@en ;
    rdfs:comment "Who a version is about: the source's patient record, or the subject itself when the pod's person entered it."@en .

rec:Revision a owl:Class ;
    rdfs:label "revision"@en ;
    rdfs:comment "That, at its prov:generatedAtTime, a record came to say a version, after the revision it prov:wasRevisionOf, generated by an import and derived from a document."@en ;
    rdfs:subClassOf prov:Entity .

rec:revisionOf a owl:ObjectProperty ;
    rdfs:label "revision of"@en ;
    rdfs:domain rec:Revision .

rec:version a owl:ObjectProperty ;
    rdfs:label "version"@en ;
    rdfs:domain rec:Revision .

rec:Record a owl:Class ;
    rdfs:label "record"@en ;
    rdfs:comment "Derived: a thing the pod holds revisions and versions of, whatever its kind."@en .

rec:kind a owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:comment "Derived: the word for the record's kind, one for each type of record."@en ;
    rdfs:domain rec:Record ;
    rdfs:range xsd:string .

rec:statusOnlyFromDocuments a owl:DatatypeProperty ;
    rdfs:label "status only from documents"@en ;
    rdfs:comment "Derived: whether the record's kind takes a status only from a member translated from a document, never from one the person entered."@en ;
    rdfs:domain rec:Record ;
    rdfs:range xsd:boolean .

rec:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Derived: the version's name, copied from the property its kind names things with."@en .

rec:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Derived: the version's status, copied from the property its kind states one with."@en .

rec:date a owl:DatatypeProperty ;
    rdfs:label "date"@en ;
    rdfs:comment "Derived: the version's date, copied from the property its kind dates things with, if it has one."@en .

rec:currentRevision a owl:ObjectProperty ;
    rdfs:label "current revision"@en ;
    rdfs:comment "Derived: the revision of a record no other revision follows. Never written to a pod file."@en ;
    rdfs:range rec:Revision .

rec:Subject a owl:Class ;
    rdfs:label "subject"@en ;
    rdfs:comment "The person a pod is about: only a name, never versioned, holding no data."@en .

rec:author a prov:Role ;
    rdfs:label "author"@en ;
    rdfs:comment "The party that wrote a document, as US Core's provenance agent type author."@en .

rec:transmitter a prov:Role ;
    rdfs:label "transmitter"@en ;
    rdfs:comment "The party that fetched and delivered a document, as US Core's provenance agent type transmitter."@en .

rec:ReferenceSeries a owl:Class ;
    rdfs:label "reference series"@en ;
    rdfs:comment "A versioned reference table or rule set a machine applies; each of its versions is a prov:specializationOf it."@en .

pav:version a owl:DatatypeProperty ;
    rdfs:label "Version"@en ;
    rdfs:isDefinedBy <http://purl.org/pav/> ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/pav-ontology/pav/blob/1aff4569e1e14fc1c6c3ee6654c9101e06a4c655/pav.rdf> .

rdfs:label a rdf:Property ;
    rdfs:label "label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Literal ;
    dct:source <https://www.w3.org/TR/2014/REC-rdf-schema-20140225/> .

pav:hasCurrentVersion a owl:ObjectProperty ;
    rdfs:label "Has current version"@en ;
    rdfs:isDefinedBy <http://purl.org/pav/> ;
    rdfs:subPropertyOf pav:hasVersion ;
    dct:source <https://github.com/pav-ontology/pav/blob/1aff4569e1e14fc1c6c3ee6654c9101e06a4c655/pav.rdf> .

rec:View a owl:Class ;
    rdfs:label "view"@en ;
    rdfs:comment "A file the view queries build from the pod's records and judgments: deleting it loses nothing, and rerunning them rebuilds it."@en .

rec:counts a owl:DatatypeProperty ;
    rdfs:label "counts"@en ;
    rdfs:comment "Derived: the judgment counts under the lens the build used."@en ;
    rdfs:domain jdg:Judgment ;
    rdfs:range xsd:boolean .

rec:excluded a owl:DatatypeProperty ;
    rdfs:label "excluded"@en ;
    rdfs:comment "Derived: no view shows the record."@en ;
    rdfs:range xsd:boolean .

rec:subject a owl:ObjectProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "Derived: whose record it is."@en ;
    rdfs:range rec:Subject .

rec:inEntry a owl:ObjectProperty ;
    rdfs:label "in entry"@en ;
    rdfs:comment "Derived: the view entry the record belongs to in this build."@en .

rec:latestMember a owl:ObjectProperty ;
    rdfs:label "latest member"@en ;
    rdfs:comment "Derived: the entry's most recently received member."@en .

rec:statusFrom a owl:ObjectProperty ;
    rdfs:label "status from"@en ;
    rdfs:comment "Derived: the member whose status the entry shows."@en .

rec:dateFrom a owl:ObjectProperty ;
    rdfs:label "date from"@en ;
    rdfs:comment "Derived: the member whose date the entry shows."@en .

rec:topCriticality a owl:DatatypeProperty ;
    rdfs:label "top criticality"@en ;
    rdfs:comment "Derived: the most severe criticality a member states."@en ;
    rdfs:range xsd:string .

# Test terms, used with W3C's mf: test-manifest vocabulary

rec:ReplayTest a owl:Class ;
    rdfs:subClassOf mf:ManifestEntry ;
    rdfs:label "replay test"@en ;
    rdfs:comment "Replay rec:story into a pod of its own up to the step rec:step names, and build the pod as it stood then under the lens whose query file rec:lens names: each file a named graph named by the pod's address and its path, the lens's derived state and the files built from it graphs too, the default graph their union, and urn:cascade:steps, outside the default graph, saying with prov:generated which files each step through that one wrote that were new to the pod. Evaluate qt:query over it. Its rows must equal those of the mf:result file as a multiset, IRIs and literals exact, or its boolean must equal that file's."@en .

rec:story a owl:ObjectProperty ;
    rdfs:label "story"@en ;
    rdfs:comment "The story.json a rec:ReplayTest replays."@en .

rec:step a owl:DatatypeProperty ;
    rdfs:label "step"@en ;
    rdfs:comment "The name of the step of the story a rec:ReplayTest replays to."@en ;
    rdfs:range xsd:string .

rec:lens a owl:ObjectProperty ;
    rdfs:label "lens"@en ;
    rdfs:comment "The query file of the lens a rec:ReplayTest builds the pod under."@en .
