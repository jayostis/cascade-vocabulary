@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix genomics: <https://ns.cascadeprotocol.org/genomics/v1#> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix solid: <http://www.w3.org/ns/solid/terms#> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ns.cascadeprotocol.org/records/v1-draft#> a owl:Ontology .

rec:sourceUrl a owl:ObjectProperty ;
    rdfs:label "source URL"@en ;
    rdfs:comment "A record's full address at its source. For a FHIR resource, the input its name is computed from: its URL on its server, or its urn:uuid; for a contained resource, its container's address, #, and its local id. For a C-CDA record, its HL7 identifier, urn:hl7ii:<root>:<extension>, or its root alone as urn:oid:<root> or urn:uuid:<root>, each character an IRI does not allow percent-encoded as UTF-8; several records may share it, and its name is computed from its class too. A record named from its document and its place in it, or with no usable identifier, has none."@en .

rec:patient a owl:ObjectProperty ;
    rdfs:label "patient"@en ;
    rdfs:comment "Who a version is about: the source's patient record, or the subject itself when the pod's person entered it."@en .

rec:ndcCode a owl:ObjectProperty ;
    rdfs:label "NDC code"@en ;
    rdfs:comment "An NDC the source gave, as the rec:NDC IRI: Cascade's 11-digit form, so an adapter normalises FHIR's 10-digit hyphenated form into it."@en ;
    rdfs:domain clinical:Medication .

rec:selectedCode a owl:ObjectProperty ;
    rdfs:label "selected code"@en ;
    rdfs:comment "The one code among the version's codes that the source marked as the one it chose, as FHIR's Coding.userSelected does; absent when the source marked none."@en ;
    rdfs:domain clinical:Medication .

rec:Revision a owl:Class ;
    rdfs:label "revision"@en ;
    rdfs:comment "That, at its prov:generatedAtTime, a record came to say a version, after the revision it prov:wasRevisionOf, generated by an import and derived from a document."@en ;
    rdfs:subClassOf prov:Entity .

rec:revisionOf a owl:ObjectProperty ;
    rdfs:label "revision of"@en ;
    rdfs:domain rec:Revision .

rec:version a owl:ObjectProperty ;
    rdfs:label "version"@en ;
    rdfs:domain rec:Revision .

rec:Record a owl:Class ;
    rdfs:label "record"@en ;
    rdfs:comment "Derived: a thing the pod holds revisions and versions of, whatever its kind."@en .

rec:kind a owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:comment "Derived: the word for the record's kind, one for each type of record."@en ;
    rdfs:domain rec:Record ;
    rdfs:range xsd:string .

rec:statusOnlyFromDocuments a owl:DatatypeProperty ;
    rdfs:label "status only from documents"@en ;
    rdfs:comment "Derived: whether the record's kind takes a status only from a member translated from a document, never from one the person entered."@en ;
    rdfs:domain rec:Record ;
    rdfs:range xsd:boolean .

rec:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Derived: the version's name, copied from the property its kind names things with."@en .

rec:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Derived: the version's status, copied from the property its kind states one with."@en .

rec:date a owl:DatatypeProperty ;
    rdfs:label "date"@en ;
    rdfs:comment "Derived: the version's date, copied from the property its kind dates things with, if it has one."@en .

rec:currentRevision a owl:ObjectProperty ;
    rdfs:label "current revision"@en ;
    rdfs:comment "Derived: the revision of a record no other revision follows. Never written to a pod file."@en ;
    rdfs:range rec:Revision .

rec:Subject a owl:Class ;
    rdfs:label "subject"@en ;
    rdfs:comment "The person a pod is about: only a name, never versioned, holding no data."@en .

rec:author a prov:Role ;
    rdfs:label "author"@en ;
    rdfs:comment "The party that wrote a document, as US Core's provenance agent type author."@en .

rec:transmitter a prov:Role ;
    rdfs:label "transmitter"@en ;
    rdfs:comment "The party that fetched and delivered a document, as US Core's provenance agent type transmitter."@en .

rec:ReferenceSeries a owl:Class ;
    rdfs:label "reference series"@en ;
    rdfs:comment "A versioned reference table or rule set a machine applies; each of its versions is a prov:specializationOf it."@en .

pav:version a owl:DatatypeProperty ;
    rdfs:label "Version"@en ;
    rdfs:isDefinedBy <http://purl.org/pav/> ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/pav-ontology/pav/blob/1aff4569e1e14fc1c6c3ee6654c9101e06a4c655/pav.rdf> .

rdfs:label a rdf:Property ;
    rdfs:label "label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Literal ;
    dct:source <https://www.w3.org/TR/2014/REC-rdf-schema-20140225/> .

pav:hasCurrentVersion a owl:ObjectProperty ;
    rdfs:label "Has current version"@en ;
    rdfs:isDefinedBy <http://purl.org/pav/> ;
    rdfs:subPropertyOf pav:hasVersion ;
    dct:source <https://github.com/pav-ontology/pav/blob/1aff4569e1e14fc1c6c3ee6654c9101e06a4c655/pav.rdf> .

rec:View a owl:Class ;
    rdfs:label "view"@en ;
    rdfs:comment "A file the view queries build from the pod's records and judgments: deleting it loses nothing, and rerunning them rebuilds it."@en .

rec:counts a owl:DatatypeProperty ;
    rdfs:label "counts"@en ;
    rdfs:comment "Derived: the judgment counts under the lens the build used."@en ;
    rdfs:domain jdg:Judgment ;
    rdfs:range xsd:boolean .

rec:lapsed a owl:DatatypeProperty ;
    rdfs:label "lapsed"@en ;
    rdfs:comment "Derived: the judgment is a matcher's Same that does not count because a reference version it used has a newer current one, nothing retracts it, and no judgment not itself retracted supersedes it."@en ;
    rdfs:domain jdg:Judgment ;
    rdfs:range xsd:boolean .

rec:leftOutFor a owl:ObjectProperty ;
    rdfs:label "left out for"@en ;
    rdfs:comment "Derived: one reason no view shows the record, in this build."@en ;
    rdfs:domain rec:Record .

rec:reason a owl:ObjectProperty ;
    rdfs:label "reason"@en ;
    rdfs:comment "Derived: which of the reasons a record can be left out for this one is."@en .

rec:because a owl:ObjectProperty ;
    rdfs:label "because"@en ;
    rdfs:comment "Derived: the thing a reason for leaving a record out rests on, where it rests on one."@en .

rec:EnteredInErrorAtSource a owl:NamedIndividual ;
    rdfs:label "entered-in-error at its source"@en .

rec:RefutedAtSource a owl:NamedIndividual ;
    rdfs:label "refuted at its source"@en .

rec:JudgedErroneous a owl:NamedIndividual ;
    rdfs:label "judged erroneous"@en .

rec:ImportJudgedErroneous a owl:NamedIndividual ;
    rdfs:label "the import that brought it was judged erroneous"@en .

rec:PatientNotClaimed a owl:NamedIndividual ;
    rdfs:label "its patient profile has no counting About"@en .

rec:NoPatient a owl:NamedIndividual ;
    rdfs:label "it names no patient"@en .

rec:subject a owl:ObjectProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "Derived: whose record it is."@en ;
    rdfs:range rec:Subject .

rec:inEntry a owl:ObjectProperty ;
    rdfs:label "in entry"@en ;
    rdfs:comment "Derived: the view entry the record belongs to in this build."@en .

rec:latestMember a owl:ObjectProperty ;
    rdfs:label "latest member"@en ;
    rdfs:comment "Derived: the entry's most recently received member."@en .

rec:statusFrom a owl:ObjectProperty ;
    rdfs:label "status from"@en ;
    rdfs:comment "Derived: the member whose status the entry shows."@en .

rec:dateFrom a owl:ObjectProperty ;
    rdfs:label "date from"@en ;
    rdfs:comment "Derived: the member whose date the entry shows."@en .

rec:topCriticality a owl:DatatypeProperty ;
    rdfs:label "top criticality"@en ;
    rdfs:comment "Derived: the most severe criticality a member states."@en ;
    rdfs:range xsd:string .

rec:Placement a owl:Class ;
    rdfs:label "placement"@en ;
    rdfs:comment "One entry of a pod's layout: where a runtime files things. It names a file (solid:instance), a folder (solid:instanceContainer), or the property whose value's folder the thing goes in (rec:filedWith). A thing is placed by rec:filedWith first, then by an entry whose rec:forSubjectsOf it states, then by its solid:forClass alone; a file that says it is a rec:View is placed only by the entries at or under the views folder."@en .

rec:fanOut a owl:DatatypeProperty ;
    rdfs:label "fan-out"@en ;
    rdfs:comment "How many leading characters of a file's name make the subfolder of the placement's folder it is filed in."@en ;
    rdfs:domain rec:Placement ;
    rdfs:range xsd:integer .

rec:filedWith a owl:ObjectProperty ;
    rdfs:label "filed with"@en ;
    rdfs:comment "The property whose value is filed in the folder the thing goes in, when the thing states it."@en ;
    rdfs:domain rec:Placement .

rec:forSubjectsOf a owl:ObjectProperty ;
    rdfs:label "for subjects of"@en ;
    rdfs:comment "Narrows the placement's class to the things that state this property."@en ;
    rdfs:domain rec:Placement .

rec:writtenBy a owl:DatatypeProperty ;
    rdfs:label "written by"@en ;
    rdfs:comment "The path under queries/v1-draft/ of the query that writes the placement's file."@en ;
    rdfs:domain rec:Placement ;
    rdfs:range xsd:string .

rec:writtenAlways a owl:DatatypeProperty ;
    rdfs:label "written always"@en ;
    rdfs:comment "Whether the build writes the placement's view at every build, rather than once the pod holds a record of its class."@en ;
    rdfs:domain rec:Placement ;
    rdfs:range xsd:boolean .

rec:storesBytes a owl:DatatypeProperty ;
    rdfs:label "stores bytes"@en ;
    rdfs:comment "Whether the placement's folder holds documents' own bytes, each file named by the SHA-256 of its bytes in lowercase hex, rather than RDF."@en ;
    rdfs:domain rec:Placement ;
    rdfs:range xsd:boolean .

solid:forClass a rdf:Property ;
    rdfs:label "registry class"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/solid/terms#> ;
    dct:source <https://github.com/solid/vocab/blob/b2ec12c354ead0df5c9526479bda69f0bd4e9acd/solid-terms.ttl> .

solid:instance a rdf:Property ;
    rdfs:label "instance"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/solid/terms#> ;
    dct:source <https://github.com/solid/vocab/blob/b2ec12c354ead0df5c9526479bda69f0bd4e9acd/solid-terms.ttl> .

solid:instanceContainer a rdf:Property ;
    rdfs:label "instance container"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/solid/terms#> ;
    dct:source <https://github.com/solid/vocab/blob/b2ec12c354ead0df5c9526479bda69f0bd4e9acd/solid-terms.ttl> .

# Reference tables and the matcher's rule list, as a runtime is given them; none of these is written to a pod

rec:shipsWith a owl:ObjectProperty ;
    rdfs:label "ships with"@en ;
    rdfs:comment "The version of the series a runtime uses until the pod names another as current."@en ;
    rdfs:domain rec:ReferenceSeries ;
    rdfs:range prov:Entity .

rec:MatcherRule a owl:Class ;
    rdfs:label "matcher rule"@en ;
    rdfs:comment "One row of a version of the matcher's rule list: the justification it gives, the kinds of record it applies to, the comparison query it runs and the hash of that query's bytes, and the kind of table the query reads, if any."@en .

rec:justifiedAs a owl:ObjectProperty ;
    rdfs:label "justified as"@en ;
    rdfs:comment "The justification a judgment the rule writes gives."@en ;
    rdfs:domain rec:MatcherRule .

rec:appliesTo a owl:DatatypeProperty ;
    rdfs:label "applies to"@en ;
    rdfs:comment "A kind of record, as rec:kind words it, that the rule compares."@en ;
    rdfs:domain rec:MatcherRule ;
    rdfs:range xsd:string .

rec:query a owl:DatatypeProperty ;
    rdfs:label "query"@en ;
    rdfs:comment "The path under queries/v1-draft/ of the comparison query the rule runs."@en ;
    rdfs:domain rec:MatcherRule ;
    rdfs:range xsd:string .

rec:queryHash a owl:ObjectProperty ;
    rdfs:label "query hash"@en ;
    rdfs:comment "The ni:///sha-256; name of the bytes of the rule's query file; a run whose file does not hash to it is refused."@en ;
    rdfs:domain rec:MatcherRule .

# Table kinds, their rows and the codes rows name

rec:tableKind a owl:ObjectProperty ;
    rdfs:label "table kind"@en ;
    rdfs:comment "Of a series, the one kind of table its versions are; of a rule of the rule list, the kind whose rows its query reads. A runtime gives the query the current version of every series of that kind, each in the graph named by the version's IRI."@en ;
    rdfs:range rec:TableKind .

rec:TableKind a owl:Class ;
    rdfs:label "table kind"@en ;
    rdfs:comment "What a table's rows say, whatever source fills it: the shape every row conforms to and the property a row is found by. A row is a subject of a version's rows with every triple it is the subject of, and holds no blank node."@en .

rec:rowShape a owl:ObjectProperty ;
    rdfs:label "row shape"@en ;
    rdfs:comment "The SHACL shape every subject of a version's rows conforms to."@en ;
    rdfs:domain rec:TableKind .

rec:foundBy a owl:ObjectProperty ;
    rdfs:label "found by"@en ;
    rdfs:comment "A property whose value is a code a row is found by, or rec:RowSubject when the row is about the code itself, as its subject."@en ;
    rdfs:domain rec:TableKind .

rec:VaccineGroups a rec:TableKind ;
    rdfs:label "vaccine groups"@en ;
    rdfs:comment "An SSSOM mapping kind: a vaccine code and a group it is in. A code in several groups has a row for each, and a group's own code maps to itself."@en ;
    rec:rowShape rec:VaccineGroupRowShape ;
    rec:foundBy owl:annotatedSource .

rec:CodeNames a rec:TableKind ;
    rdfs:label "code names"@en ;
    rdfs:comment "A code's names in SKOS, as its publisher gives them."@en ;
    rec:rowShape rec:CodeNameRowShape ;
    rec:foundBy rec:RowSubject ;
    rec:readByPages true .

rec:CodeStatus a rec:TableKind ;
    rdfs:label "code status"@en ;
    rdfs:comment "A retired code, with each replacement its publisher gives. A code that is not retired has no row; a mapping kind keeps a retired code's rows."@en ;
    rec:rowShape rec:CodeStatusRowShape ;
    rec:foundBy rec:RowSubject ;
    rec:readByPages true .

rec:SubstanceIngredients a rec:TableKind ;
    rdfs:label "substance ingredients"@en ;
    rdfs:comment "An SSSOM mapping kind the stories use and no open source fills: a SNOMED CT substance and its RxNorm ingredient. Read either way round."@en ;
    rec:rowShape rec:SubstanceIngredientRowShape ;
    rec:foundBy owl:annotatedSource , owl:annotatedTarget .

rec:ProductIngredients a rec:TableKind ;
    rdfs:label "product ingredients"@en ;
    rdfs:comment "An SSSOM mapping kind: an RxNorm concept and its ingredient, its one ingredient or, with several, the multiple ingredient concept of exactly those. An ingredient maps to itself."@en ;
    rec:rowShape rec:ProductIngredientRowShape ;
    rec:foundBy owl:annotatedSource .

rec:BrandGenerics a rec:TableKind ;
    rdfs:label "brand generics"@en ;
    rdfs:comment "An SSSOM mapping kind: a branded RxNorm concept and its generic."@en ;
    rec:rowShape rec:BrandGenericRowShape ;
    rec:foundBy owl:annotatedSource .

rec:DrugProducts a rec:TableKind ;
    rdfs:label "drug products"@en ;
    rdfs:comment "A code that names one drug product, generic or branded, a clinical drug or a pack (RxNorm's SCD, SBD, GPCK and BPCK), with its term type as its publisher gives it. A code with no row is not known to name one product: an ingredient, a strength, a dose form, a brand name or a salt has none."@en ;
    rec:rowShape rec:DrugProductRowShape ;
    rec:foundBy rec:RowSubject .

rec:termType a owl:DatatypeProperty ;
    rdfs:label "term type"@en ;
    rdfs:comment "Of a code, its term type as its publisher writes it; for RxNorm, the TTY of RXNCONSO."@en ;
    rdfs:range xsd:string .

rec:NdcDrugs a rec:TableKind ;
    rdfs:label "NDC drugs"@en ;
    rdfs:comment "An SSSOM mapping kind: an NDC and the RxNorm drug it is."@en ;
    rec:rowShape rec:NdcDrugRowShape ;
    rec:foundBy owl:annotatedSource .

rec:CodeConversions a rec:TableKind ;
    rdfs:label "code conversions"@en ;
    rdfs:comment "An SSSOM mapping kind: a retired code and each code in effect its publisher converts its data to, one dct:isReplacedBy row each, with its cardinality. The cardinality is counted along each conversion on the way, not over the table as SSSOM counts it: n:… when, at any step of the path from the retired code to the code in effect, the publisher gives the step's code anything but the step's own predecessor as a previous code, …:n when any code on the path before the end converts into more than one code, so a pure chain A to B to C is published as A to C as 1:1. A row of the earlier form, skos:exactMatch with no cardinality, is still read."@en ;
    rec:rowShape rec:CodeConversionRowShape ;
    rec:foundBy owl:annotatedSource , owl:annotatedTarget .

rec:VariantClassifications a rec:TableKind ;
    rdfs:label "variant classifications"@en ;
    rdfs:comment "What a source such as ClinVar says of a variant: a row for each variation, found by its variation IRI and by each coding NM_ expression a submitter used, holding the aggregate germline classification and review status as concepts, the day it was last evaluated and how many submitters contribute. A join through these rows is identity and reads no classification. A version states the genes it covers (rec:coversGene), so a page can tell a variant in a gene the series does not cover from a covered one the rows do not hold."@en ;
    rec:rowShape rec:VariantClassificationRowShape ;
    rec:foundBy rec:RowSubject , rec:hgvsExpression ;
    rec:readByPages true .

rec:readByPages a owl:DatatypeProperty ;
    rdfs:label "read by pages"@en ;
    rdfs:comment "True when an app keeps a series of the kind, and packs it, though no rule of its rule list reads the kind: its pages read the rows. A kind that is neither named by a rule list nor marked is skipped."@en ;
    rdfs:domain rec:TableKind ;
    rdfs:range xsd:boolean .

rec:coversGene a owl:DatatypeProperty ;
    rdfs:label "covers gene"@en ;
    rdfs:comment "Of a version of a series of a kind that covers some genes, an HGNC approved symbol of a gene it covers, any number. A version without it covers no named gene, and a changed list of genes is a new version."@en ;
    rdfs:range xsd:string .

rec:hgvsExpression a owl:ObjectProperty ;
    rdfs:label "HGVS expression"@en ;
    rdfs:comment "Of a variant classification row, a coding NM_ expression a submitter used for its variation, as the rec:HGVS IRI."@en .

rec:clinvarClassification a owl:ObjectProperty ;
    rdfs:label "ClinVar classification"@en ;
    rdfs:comment "Of a variant classification row, a concept of rec:ClinVarClassifications its aggregate germline classification parses to."@en ;
    rdfs:range skos:Concept .

rec:clinvarReviewStatus a owl:ObjectProperty ;
    rdfs:label "ClinVar review status"@en ;
    rdfs:comment "Of a variant classification row, the concept of rec:ClinVarReviewStatuses its review status is."@en ;
    rdfs:range skos:Concept .

rec:lastEvaluated a owl:DatatypeProperty ;
    rdfs:label "last evaluated"@en ;
    rdfs:comment "Of a variant classification row, the day its newest submitter evaluated the variation. It is not the day the aggregate changed."@en ;
    rdfs:range xsd:date .

rec:contributingSubmitters a owl:DatatypeProperty ;
    rdfs:label "contributing submitters"@en ;
    rdfs:comment "Of a variant classification row, how many submissions contribute to its aggregate classification, from a release that lists them (SCVsForAggregateGermlineClassification)."@en ;
    rdfs:range xsd:integer .

rec:submitters a owl:DatatypeProperty ;
    rdfs:label "submitters"@en ;
    rdfs:comment "Of a variant classification row, how many submitters it has, as an older release counts them (NumberSubmitters), which includes any whose submission does not contribute. A row holds this or rec:contributingSubmitters, so it says which count it has."@en ;
    rdfs:range xsd:integer .

rec:RowSubject a rdf:Property ;
    rdfs:label "the row's subject"@en ;
    rdfs:comment "Not stated by any row: as a kind's rec:foundBy, that each row is found by its own subject, the code it is about."@en .

rec:CodeSystem a owl:Class ;
    rdfs:label "code system"@en ;
    rdfs:comment "A code system whose codes are IRIs of one form: its void:uriSpace, the IRI stem, followed by the code percent-encoded as SPARQL's ENCODE_FOR_URI does. The stem is HL7 Terminology's where THO registers one, and is never the FHIR Coding.system URI, which skos:exactMatch names (https://hl7.org/fhir/R5/rdf.html#iri-stem). A record's code written as a literal joins a table as that IRI: the stem followed by the literal percent-encoded as ENCODE_FOR_URI does, so a literal of unreserved characters only is its own tail and NM_000249.4:c.2042C>T is http://varnomen.hgvs.org/NM_000249.4%3Ac.2042C%3ET."@en .

rec:pageTemplate a owl:DatatypeProperty ;
    rdfs:label "page template"@en ;
    rdfs:comment "The address of each code's own page at the code system's publisher, as an RFC 6570 level 1 template whose only expression is {code}. {code} is the code as its IRI writes it after the void:uriSpace, already percent-encoded as ENCODE_FOR_URI does, which is what RFC 6570 simple expansion does. A code system without one publishes no page per code."@en ;
    rdfs:domain rec:CodeSystem ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Property:P1630> ;
    dct:source <https://www.rfc-editor.org/rfc/rfc6570> .

rec:CVX a rec:CodeSystem ;
    rdfs:label "CVX"@en ;
    rdfs:comment "The code as CDC writes it, leading zero kept and trailing spaces trimmed: 08, 141. A record coded 8 joins nothing."@en ;
    void:uriSpace "http://hl7.org/fhir/sid/cvx/" ;
    skos:exactMatch <http://hl7.org/fhir/sid/cvx> .

rec:RxNorm a rec:CodeSystem ;
    rdfs:label "RxNorm"@en ;
    rdfs:comment "The RXCUI."@en ;
    void:uriSpace "http://www.nlm.nih.gov/research/umls/rxnorm/" ;
    skos:exactMatch <http://www.nlm.nih.gov/research/umls/rxnorm> .

rec:NDC a rec:CodeSystem ;
    rdfs:label "NDC"@en ;
    rdfs:comment "The 11-digit HIPAA form, 5-4-2 with no hyphens, as RxNorm's RXNSAT gives it: Cascade's own space. FHIR's NDC code is the 10-digit hyphenated label code, so an NDC is normalised into this space."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/ndc11/" ;
    skos:exactMatch <http://hl7.org/fhir/sid/ndc> ;
    dct:source <https://hl7.org/fhir/R4/ndc.html> .

rec:ICD10CM a rec:CodeSystem ;
    rdfs:label "ICD-10-CM"@en ;
    rdfs:comment "The code as FHIR writes it."@en ;
    void:uriSpace "http://hl7.org/fhir/sid/icd-10-cm/" ;
    skos:exactMatch <http://hl7.org/fhir/sid/icd-10-cm> .

rec:SNOMEDCT a rec:CodeSystem ;
    rdfs:label "SNOMED CT"@en ;
    rdfs:comment "The concept ID. snomed.info/sct is the code system's own URI and, with a module, names its editions; it never names a concept."@en ;
    void:uriSpace "http://snomed.info/id/" ;
    skos:exactMatch <http://snomed.info/sct> ;
    dct:source <https://terminology.hl7.org/SNOMEDCT.html> .

rec:LOINC a rec:CodeSystem ;
    rdfs:label "LOINC"@en ;
    rdfs:comment "The LOINC code as LOINC writes it, with its check digit: 2823-3."@en ;
    void:uriSpace "http://loinc.org/rdf/" ;
    skos:exactMatch <http://loinc.org> ;
    dct:source <https://github.com/HL7/UTG/blob/18bfa0662fbf6c9f6f51922e46c534b00d987848/input/sourceOfTruth/external/v3/namingSystems/v3-loinc.xml> .

rec:UNII a rec:CodeSystem ;
    rdfs:label "UNII"@en ;
    rdfs:comment "The UNII as FDA's GSRS gives it."@en ;
    void:uriSpace "http://fdasis.nlm.nih.gov/" ;
    skos:exactMatch <http://fdasis.nlm.nih.gov> ;
    dct:source <https://hl7.org/fhir/R4/terminologies-systems.html> .

rec:CPT a rec:CodeSystem ;
    rdfs:label "CPT"@en ;
    rdfs:comment "The CPT code."@en ;
    void:uriSpace "http://www.ama-assn.org/go/cpt/" ;
    skos:exactMatch <http://www.ama-assn.org/go/cpt> ;
    dct:source <https://hl7.org/fhir/R4/terminologies-systems.html> .

rec:ICD9CM a rec:CodeSystem ;
    rdfs:label "ICD-9-CM"@en ;
    rdfs:comment "The code as FHIR writes it."@en ;
    void:uriSpace "http://hl7.org/fhir/sid/icd-9-cm/" ;
    skos:exactMatch <http://hl7.org/fhir/sid/icd-9-cm> ;
    dct:source <https://hl7.org/fhir/R4/terminologies-systems.html> .

rec:HGVS a rec:CodeSystem ;
    rdfs:label "HGVS"@en ;
    rdfs:comment "A coding expression in its normal form: the reference sequence with its version, a colon and c., then the change, as NM_000249.4:c.2042C>T, with no gene in parentheses and no protein change. The code holds characters an IRI cannot, so it is percent-encoded: the colon is %3A and > is %3E. Only an NM_ expression is a key of a table."@en ;
    void:uriSpace "http://varnomen.hgvs.org/" ;
    skos:exactMatch <http://varnomen.hgvs.org> ;
    dct:source <https://github.com/HL7/UTG/blob/18bfa0662fbf6c9f6f51922e46c534b00d987848/input/sourceOfTruth/external/v3/namingSystems/v3-hgvs.xml> .

rec:ClinVar a rec:CodeSystem ;
    rdfs:label "ClinVar"@en ;
    rdfs:comment "A ClinVar variation, by its VariationID: the digits, no leading zero, as 90011. The accession VCV000090011 is that number zero-padded and an SCV or RCV accession is not a variation."@en ;
    void:uriSpace "http://www.ncbi.nlm.nih.gov/clinvar/" ;
    rec:pageTemplate "https://www.ncbi.nlm.nih.gov/clinvar/variation/{code}/" ;
    skos:exactMatch <http://www.ncbi.nlm.nih.gov/clinvar> ;
    dct:source <https://github.com/HL7/UTG/blob/18bfa0662fbf6c9f6f51922e46c534b00d987848/input/sourceOfTruth/external/hta/namingSystems/clinVarV.xml> .

rec:ClinVarClassifications a skos:ConceptScheme ;
    rdfs:label "ClinVar classifications"@en ;
    rdfs:comment "The values of ClinVar's aggregate germline classification, as it spells them. ClinVar joins ACMG terms with a slash and other terms with a semicolon, so a value is parsed into concepts, never matched whole. A renamed label is an alternative label of the concept it names."@en ;
    skos:hasTopConcept genomics:Pathogenic , genomics:LikelyPathogenic , genomics:VUS , genomics:LikelyBenign , genomics:Benign ,
        rec:ClinVarConflicting , rec:ClinVarConflictingData , rec:ClinVarEstablishedRiskAllele , rec:ClinVarLikelyRiskAllele ,
        rec:ClinVarUncertainRiskAllele , rec:ClinVarDrugResponse , rec:ClinVarRiskFactor , rec:ClinVarAssociation ,
        rec:ClinVarProtective , rec:ClinVarConfersSensitivity , rec:ClinVarAffects , rec:ClinVarOther , rec:ClinVarNotProvided ,
        rec:ClinVarCombinationOnly , rec:ClinVarNoClassificationsFromUnflaggedRecords , rec:ClinVarNoClassificationForTheSingleVariant .

rec:ClinVarReviewStatuses a skos:ConceptScheme ;
    rdfs:label "ClinVar review statuses"@en ;
    rdfs:comment "The values of ClinVar's review status, as it spells them. A value holds commas and is matched whole, never split."@en ;
    skos:hasTopConcept rec:ClinVarPracticeGuideline , rec:ClinVarExpertPanel , rec:ClinVarMultipleSubmittersNoConflicts ,
        rec:ClinVarConflictingClassifications , rec:ClinVarSingleSubmitter , rec:ClinVarNoAssertionCriteria ,
        rec:ClinVarNoClassificationProvided , rec:ClinVarNoClassificationForTheSingleVariant ,
        rec:ClinVarNoClassificationsFromUnflaggedRecords .

genomics:Pathogenic a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Pathogenic" ;
    skos:exactMatch <http://loinc.org/rdf/LA6668-3> .

genomics:LikelyPathogenic a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Likely pathogenic" ;
    skos:exactMatch <http://loinc.org/rdf/LA26332-9> .

genomics:VUS a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Uncertain significance" ;
    skos:exactMatch <http://loinc.org/rdf/LA26333-7> .

genomics:LikelyBenign a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Likely benign" ;
    skos:exactMatch <http://loinc.org/rdf/LA26334-5> .

genomics:Benign a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Benign" ;
    skos:exactMatch <http://loinc.org/rdf/LA6675-8> .

rec:ClinVarConflicting a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Conflicting classifications of pathogenicity" ;
    skos:altLabel "Conflicting interpretations of pathogenicity" .

rec:ClinVarConflictingData a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "conflicting data from submitters" .

rec:ClinVarPathogenicLowPenetrance a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Pathogenic, low penetrance" ;
    skos:broader genomics:Pathogenic .

rec:ClinVarLikelyPathogenicLowPenetrance a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Likely pathogenic, low penetrance" ;
    skos:broader genomics:LikelyPathogenic .

rec:ClinVarVusHigh a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "VUS-high" ;
    skos:broader genomics:VUS .

rec:ClinVarVusMid a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "VUS-mid" ;
    skos:broader genomics:VUS .

rec:ClinVarVusLow a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "VUS-low" ;
    skos:broader genomics:VUS .

rec:ClinVarEstablishedRiskAllele a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Established risk allele" .

rec:ClinVarLikelyRiskAllele a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Likely risk allele" .

rec:ClinVarUncertainRiskAllele a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Uncertain risk allele" .

rec:ClinVarDrugResponse a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "drug response" .

rec:ClinVarRiskFactor a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "risk factor" .

rec:ClinVarAssociation a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "association" .

rec:ClinVarProtective a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "protective" .

rec:ClinVarConfersSensitivity a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "confers sensitivity" .

rec:ClinVarAffects a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "Affects" .

rec:ClinVarOther a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "other" .

rec:ClinVarNotProvided a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "not provided" .

rec:ClinVarCombinationOnly a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications ;
    skos:prefLabel "classified only as part of a combination" ;
    skos:notation "-" ;
    rdfs:comment "ClinVar writes a hyphen for a variation classified only in combination with another variant; the hyphen is the concept's notation and the whole value."@en .

rec:ClinVarNoClassificationsFromUnflaggedRecords a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications , rec:ClinVarReviewStatuses ;
    skos:prefLabel "no classifications from unflagged records" .

rec:ClinVarNoClassificationForTheSingleVariant a skos:Concept ;
    skos:inScheme rec:ClinVarClassifications , rec:ClinVarReviewStatuses ;
    skos:prefLabel "no classification for the single variant" ;
    skos:altLabel "no interpretation for the single variant" .

rec:ClinVarPracticeGuideline a skos:Concept ;
    skos:inScheme rec:ClinVarReviewStatuses ;
    skos:prefLabel "practice guideline" .

rec:ClinVarExpertPanel a skos:Concept ;
    skos:inScheme rec:ClinVarReviewStatuses ;
    skos:prefLabel "reviewed by expert panel" .

rec:ClinVarMultipleSubmittersNoConflicts a skos:Concept ;
    skos:inScheme rec:ClinVarReviewStatuses ;
    skos:prefLabel "criteria provided, multiple submitters, no conflicts" .

rec:ClinVarConflictingClassifications a skos:Concept ;
    skos:inScheme rec:ClinVarReviewStatuses ;
    skos:prefLabel "criteria provided, conflicting classifications" ;
    skos:altLabel "criteria provided, conflicting interpretations" .

rec:ClinVarSingleSubmitter a skos:Concept ;
    skos:inScheme rec:ClinVarReviewStatuses ;
    skos:prefLabel "criteria provided, single submitter" .

rec:ClinVarNoAssertionCriteria a skos:Concept ;
    skos:inScheme rec:ClinVarReviewStatuses ;
    skos:prefLabel "no assertion criteria provided" .

rec:ClinVarNoClassificationProvided a skos:Concept ;
    skos:inScheme rec:ClinVarReviewStatuses ;
    skos:prefLabel "no classification provided" ;
    skos:altLabel "no assertion provided" .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:ConceptScheme a owl:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:inScheme a owl:ObjectProperty ;
    rdfs:label "is in scheme"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:hasTopConcept a owl:ObjectProperty ;
    rdfs:label "has top concept"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:broader a owl:ObjectProperty ;
    rdfs:label "has broader"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

void:uriSpace a owl:DatatypeProperty ;
    rdfs:label "URI space"@en ;
    rdfs:isDefinedBy <http://rdfs.org/ns/void#> ;
    rdfs:domain void:Dataset ;
    rdfs:range rdfs:Literal ;
    dct:source <https://www.w3.org/TR/2011/NOTE-void-20110303/> .

void:Dataset a owl:Class ;
    rdfs:label "dataset"@en ;
    rdfs:isDefinedBy <http://rdfs.org/ns/void#> ;
    dct:source <https://www.w3.org/TR/2011/NOTE-void-20110303/> .

owl:annotatedSource a rdf:Property ;
    rdfs:label "annotated source"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    dct:source <https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/> ,
        <https://www.w3.org/TR/2012/REC-owl2-rdf-based-semantics-20121211/> .

owl:annotatedProperty a rdf:Property ;
    rdfs:label "annotated property"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    dct:source <https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/> ,
        <https://www.w3.org/TR/2012/REC-owl2-rdf-based-semantics-20121211/> .

owl:annotatedTarget a rdf:Property ;
    rdfs:label "annotated target"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    dct:source <https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/> ,
        <https://www.w3.org/TR/2012/REC-owl2-rdf-based-semantics-20121211/> .

owl:deprecated a owl:AnnotationProperty ;
    rdfs:label "deprecated"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2002/07/owl#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    dct:source <https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/> ,
        <https://www.w3.org/TR/2012/REC-owl2-rdf-based-semantics-20121211/> .

sssom:mapping_justification a owl:ObjectProperty ;
    rdfs:label "mapping justification"@en ;
    rdfs:isDefinedBy <https://w3id.org/sssom/schema/> ;
    dct:source <https://github.com/mapping-commons/sssom/blob/667d3c579d92ad2e1a480503625eeef1e6af8e6d/src/sssom_schema/schema/sssom_schema.yaml> .

sssom:mapping_cardinality a owl:DatatypeProperty ;
    rdfs:label "mapping cardinality"@en ;
    rdfs:isDefinedBy <https://w3id.org/sssom/schema/> ;
    dct:source <https://github.com/mapping-commons/sssom/blob/667d3c579d92ad2e1a480503625eeef1e6af8e6d/src/sssom_schema/schema/sssom_schema.yaml> .

skos:prefLabel a owl:AnnotationProperty ;
    rdfs:label "preferred label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:notation a owl:DatatypeProperty ;
    rdfs:label "notation"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:exactMatch a owl:ObjectProperty ;
    rdfs:label "has exact match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

dct:isReplacedBy a rdf:Property ;
    rdfs:label "Is Replaced By"@en ;
    rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
    rdfs:subPropertyOf dct:relation ;
    dct:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/2020-01-20/> .

# Test terms, used with W3C's mf: test-manifest vocabulary

rec:lens a owl:ObjectProperty ;
    rdfs:label "lens"@en ;
    rdfs:comment "The query file of the lens a query test builds its pod under."@en .
