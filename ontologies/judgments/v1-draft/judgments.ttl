@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix jdg: <https://ns.cascadeprotocol.org/judgments/v1-draft#> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec: <https://ns.cascadeprotocol.org/records/v1-draft#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://ns.cascadeprotocol.org/judgments/v1-draft#> a owl:Ontology .

jdg:Judgment a owl:Class ;
    rdfs:label "judgment"@en ;
    rdfs:comment "A conclusion about records, made by someone at a time; its members are prov:hadMember."@en ;
    rdfs:subClassOf prov:Collection .

jdg:verdict a owl:ObjectProperty ;
    rdfs:label "verdict"@en ;
    rdfs:domain jdg:Judgment .

jdg:Same a owl:NamedIndividual ;
    rdfs:label "same"@en ;
    rdfs:comment "The members are one thing: a view draws one entry on every member."@en .

jdg:Different a owl:NamedIndividual ;
    rdfs:label "different"@en ;
    rdfs:comment "The members are kept apart: a counting Different wins over any Same for that pair."@en .

jdg:Erroneous a owl:NamedIndividual ;
    rdfs:label "erroneous"@en ;
    rdfs:comment "The members, records or a whole activity, are left out of every view."@en .

jdg:About a owl:NamedIndividual ;
    rdfs:label "about"@en ;
    rdfs:comment "The member, a source's patient record, is about the jdg:subject: every record naming it is the subject's."@en .

jdg:subject a owl:ObjectProperty ;
    rdfs:label "subject"@en ;
    rdfs:domain jdg:Judgment ;
    rdfs:range rec:Subject .

jdg:basis a owl:ObjectProperty ;
    rdfs:label "basis"@en ;
    rdfs:domain jdg:Judgment .

jdg:justification a owl:ObjectProperty ;
    rdfs:label "justification"@en ;
    rdfs:comment "The rule a machine applied to conclude Same."@en ;
    rdfs:domain jdg:Judgment .

jdg:SameCode a owl:NamedIndividual ;
    rdfs:label "same code"@en ;
    rdfs:comment "Both records carry one code from one code system, as their sources supplied it."@en ;
    skos:broadMatch semapv:LexicalMatching .

jdg:SameCodeAndDate a owl:NamedIndividual ;
    rdfs:label "same code and date"@en ;
    rdfs:comment "Both records carry one code from one code system and one date."@en ;
    skos:broadMatch semapv:LexicalMatching .

jdg:SameCodeAndPeriod a owl:NamedIndividual ;
    rdfs:label "same code and period"@en ;
    rdfs:comment "Both conditions carry one code from one code system, and their periods overlap."@en ;
    skos:broadMatch semapv:LexicalMatching .

jdg:SameMappedCode a owl:NamedIndividual ;
    rdfs:label "same mapped code"@en ;
    rdfs:comment "The records carry two different codes that a reference table pairs, or maps to one concept."@en ;
    skos:broadMatch semapv:BackgroundKnowledgeBasedMatching .

jdg:SameMappedCodeAndDate a owl:NamedIndividual ;
    rdfs:label "same mapped code and date"@en ;
    rdfs:comment "The records carry two codes that a reference table puts in one group, and one date."@en ;
    skos:broadMatch semapv:BackgroundKnowledgeBasedMatching .

jdg:SameMedicationCode a owl:NamedIndividual ;
    rdfs:label "same medication code"@en ;
    rdfs:comment "Both medication records carry one RxNorm code, whether each came from a prescription or from a list of what the person takes."@en ;
    skos:broadMatch semapv:LexicalMatching .

jdg:SameResult a owl:NamedIndividual ;
    rdfs:label "same result"@en ;
    rdfs:comment "Both lab results carry one test code, one time and one value, however each writes its unit."@en ;
    skos:broadMatch semapv:LexicalMatching .

jdg:SameConvertedCode a owl:NamedIndividual ;
    rdfs:label "same converted code"@en ;
    rdfs:comment "One record carries a retired code and the other the one code its publisher converts it to."@en ;
    skos:broadMatch semapv:BackgroundKnowledgeBasedMatching .

jdg:PortalAuthenticated a owl:NamedIndividual ;
    rdfs:label "portal authenticated"@en ;
    rdfs:comment "The patient record came back from a login the person made themselves."@en .

jdg:RelatedPerson a owl:NamedIndividual ;
    rdfs:label "related person"@en ;
    rdfs:comment "A proxy's connection to someone else's chart, whose own RelatedPerson names the proxy."@en .

jdg:Demographics a owl:NamedIndividual ;
    rdfs:label "demographics"@en ;
    rdfs:comment "A matcher judged it from name, birth date, address or phone."@en .

jdg:OwnerStatement a owl:NamedIndividual ;
    rdfs:label "owner statement"@en ;
    rdfs:comment "The operator said so, at import or later."@en .

jdg:patient a prov:Role ;
    rdfs:label "patient"@en ;
    rdfs:comment "The person the pod is about, acting for themselves."@en .

npx:supersedes a rdf:Property , owl:IrreflexiveObjectProperty ;
    rdfs:isDefinedBy <http://purl.org/nanopub/x/> ;
    rdfs:domain np:Nanopublication ;
    rdfs:range np:Nanopublication ;
    dct:source <https://github.com/peta-pico/ontologies/blob/271a83341f419de9ef3de87687b172b6790adaf2/nanopubx.ttl> .

npx:retracts a rdf:Property ;
    rdfs:isDefinedBy <http://purl.org/nanopub/x/> ;
    rdfs:domain foaf:Agent ;
    rdfs:range np:Nanopublication ;
    dct:source <https://github.com/peta-pico/ontologies/blob/271a83341f419de9ef3de87687b172b6790adaf2/nanopubx.ttl> .

jdg:currentlySame a owl:ObjectProperty ;
    rdfs:label "currently same"@en ;
    rdfs:comment "Derived: two records a counting Same joins and no counting Different separates."@en .

jdg:currentlyDifferent a owl:ObjectProperty ;
    rdfs:label "currently different"@en ;
    rdfs:comment "Derived: two records a counting Different separates."@en .
