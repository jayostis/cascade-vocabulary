cascade:allergySeverity a owl:DatatypeProperty ;
    rdfs:label "Allergy Severity"@en ;
    rdfs:domain cascade:AllergyOrIntolerance ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/health/v1/health.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:allergyCategory a owl:DatatypeProperty ;
    rdfs:label "Allergy Category"@en ;
    rdfs:domain cascade:AllergyOrIntolerance ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/health/v1/health.ttl> ;
