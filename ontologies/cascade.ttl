    rdfs:label "Allergy Criticality"@en ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:conditionCategory a owl:DatatypeProperty ;
    rdfs:label "Condition Category"@en ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:abatementDate a owl:DatatypeProperty ;
    rdfs:label "Abatement Date"@en ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:gYear xsd:gYearMonth xsd:date xsd:dateTime ) ] ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:PrescribedOrReportedMedication a owl:Class ;
    rdfs:label "Prescribed or Reported Medication"@en ;
    rdfs:subClassOf prov:Entity ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:drugName a owl:DatatypeProperty ;
    rdfs:label "Drug Name"@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:rxNormCode a owl:ObjectProperty ;
    rdfs:label "RxNorm Code"@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:prescribedOrReported a owl:DatatypeProperty ;
    rdfs:label "Prescribed or Reported"@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:dosage a owl:DatatypeProperty ;
    rdfs:label "Dosage"@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:medicationUseStartDate a owl:DatatypeProperty ;
    rdfs:label "Medication Use Start Date"@en ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:gYear xsd:gYearMonth xsd:date xsd:dateTime ) ] ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:medicationUseEndDate a owl:DatatypeProperty ;
    rdfs:label "Medication Use End Date"@en ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:gYear xsd:gYearMonth xsd:date xsd:dateTime ) ] ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

# Copied from the spec's genomics

cascade:GeneticVariantFinding a owl:Class ;
    rdfs:label "Genetic Variant Finding"@en ;
    rdfs:subClassOf prov:Entity ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:hgvsCodingDnaExpression a owl:DatatypeProperty ;
    rdfs:label "HGVS Coding DNA Expression"@en ;
    rdfs:domain cascade:GeneticVariantFinding ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:clinvarVariationId a owl:DatatypeProperty ;
    rdfs:label "ClinVar Variation ID"@en ;
    rdfs:domain cascade:GeneticVariantFinding ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:geneSymbol a owl:DatatypeProperty ;
    rdfs:label "Gene Symbol (HGNC Approved)"@en ;
    rdfs:domain cascade:GeneticVariantFinding ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:VariantInterpretation a owl:Class ;
    rdfs:label "Variant Interpretation"@en ;
    rdfs:subClassOf prov:Entity ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:variantInterpreted a owl:ObjectProperty ;
    rdfs:label "Variant Interpreted"@en ;
    rdfs:domain cascade:VariantInterpretation ;
    rdfs:range cascade:GeneticVariantFinding ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:acmgClassification a owl:ObjectProperty ;
    rdfs:label "ACMG/AMP Classification"@en ;
    rdfs:domain cascade:VariantInterpretation ;
    rdfs:range skos:Concept ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:interpretedDate a owl:DatatypeProperty ;
    rdfs:label "Interpretation Date"@en ;
    rdfs:domain cascade:VariantInterpretation ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:gYear xsd:gYearMonth xsd:date ) ] ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:objectCondition a owl:ObjectProperty ;
    rdfs:label "Object Condition"@en ;
    rdfs:domain cascade:VariantInterpretation ;
    rdfs:range cascade:ProblemOrDiagnosis ;
    rdfs:seeAlso <https://github.com/ga4gh/va-spec/blob/11c4a3add0e4a9d0eef7e13f8ec9cb17346e9fa0/schema/va-spec/acmg-2015/profile-source.yaml> .

cascade:acmgEvidenceCode a owl:DatatypeProperty ;
    rdfs:label "ACMG Evidence Code"@en ;
    rdfs:domain cascade:VariantInterpretation ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://github.com/ga4gh/va-spec/blob/9d60508c0a7a1ccd79a6312a45b3618ee0121aec/schema/va-spec/acmg-2015-profile-source.yaml> .

# Records

cascade:sourceUrl a owl:ObjectProperty ;
    rdfs:label "source URL"@en ;
    rdfs:comment "A record's full address at its source: for a FHIR resource, its URL on its server; for a contained resource, its container's address, #, and its local id; for a C-CDA record, its HL7 identifier, urn:hl7ii:<root>:<extension>, or its root alone as urn:oid:<root> or urn:uuid:<root>, each character an IRI does not allow percent-encoded as UTF-8. Several records may share one, since a name takes inputs a source address does not. A record named from its document and its place in it, or with no usable identifier, has none."@en .

cascade:patient a owl:ObjectProperty ;
    rdfs:label "patient"@en ;
    rdfs:comment "Who a version is about: the source's patient record, or the subject itself when the pod's person entered it."@en .

cascade:ndcCode a owl:ObjectProperty ;
    rdfs:label "NDC code"@en ;
    rdfs:comment "An NDC the source gave, as the cascade:NDC IRI: Cascade's 11-digit form, so an adapter normalises FHIR's 10-digit hyphenated form into it."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication .

cascade:prescriptionWrittenDate a owl:DatatypeProperty ;
    rdfs:label "prescription written date"@en ;
    rdfs:comment "Of a version of a prescribed medication, when the prescription was written, as FHIR's MedicationRequest.authoredOn: never the start of use."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:gYear xsd:gYearMonth xsd:date xsd:dateTime ) ] ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/medicationrequest-definitions.html#MedicationRequest.authoredOn> .

cascade:medicationRequestIntent a owl:DatatypeProperty ;
    rdfs:label "medication request intent"@en ;
    rdfs:comment "Of a version of a prescribed medication, how far the source's request goes, as FHIR's MedicationRequest.intent: one of proposal, plan, order, original-order, reflex-order, filler-order, instance-order, option. Read only on a prescribed version; absent where the source gave none, as every C-CDA source does."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/medicationrequest-definitions.html#MedicationRequest.intent> , <https://hl7.org/fhir/R4/valueset-medicationrequest-intent.html> .

cascade:userSelectedCode a owl:ObjectProperty ;
    rdfs:label "user selected code"@en ;
    rdfs:comment "The one code among the version's codes that the source marked as the one it chose, as FHIR's Coding.userSelected does; absent when the source marked none."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication .

cascade:Revision a owl:Class ;
    rdfs:label "revision"@en ;
    rdfs:comment "That, at its prov:generatedAtTime, a record came to say a version, after each revision it prov:wasRevisionOf, the record's heads as the writer held them, generated by an import and derived from a document."@en ;
    rdfs:subClassOf prov:Entity .

cascade:answeredAsOf a owl:DatatypeProperty ;
    rdfs:label "answered as of"@en ;
    rdfs:comment "The instant a source answered as of: its records as they stood then. Not when the document was made, nor when it arrived."@en ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc7089#section-2.1.1> .

cascade:answersForRecordClass a owl:ObjectProperty ;
    rdfs:label "answers for record class"@en ;
    rdfs:comment "Of a document, a class of record its source answered a search for, for the document's patient: the document holds every record that search returned, as of its cascade:answeredAsOf, else its pav:retrievedOn. A document that states neither this nor cascade:refusedForRecordClass for a class does not say where it looked for records of it."@en ;
    rdfs:range owl:Class .

cascade:refusedForRecordClass a owl:ObjectProperty ;
    rdfs:label "refused for record class"@en ;
    rdfs:comment "Of a document, a class of record its source refused a search for, for the document's patient: the document may hold only part of what that search would have returned (a refusal after the first page keeps the earlier pages), and says nothing of the rest."@en ;
    rdfs:range owl:Class .

cascade:observedAsOf a owl:DatatypeProperty ;
    rdfs:label "observed as of"@en ;
    rdfs:comment "Of a revision, when its source was observed saying its state: the first there is of its document's cascade:answeredAsOf, the document's pav:retrievedOn, the source's own change time the revision carries as pav:lastUpdateOn, and the start of the act that generated it. For an entry, the session's start."@en ;
    rdfs:domain cascade:Revision ;
    rdfs:range xsd:dateTime .

cascade:revisionOf a owl:ObjectProperty ;
    rdfs:label "revision of"@en ;
    rdfs:domain cascade:Revision .

cascade:version a owl:ObjectProperty ;
    rdfs:label "version"@en ;
    rdfs:domain cascade:Revision .

cascade:Record a owl:Class ;
    rdfs:label "record"@en ;
    rdfs:comment "Derived: a thing the pod holds revisions and versions of, whatever its kind."@en .

cascade:recordKind a owl:DatatypeProperty ;
    rdfs:label "record kind"@en ;
    rdfs:comment "Derived: the word for the record's kind, one for each type of record."@en ;
    rdfs:domain cascade:Record ;
    rdfs:range xsd:string .

cascade:statusOnlyFromDocuments a owl:DatatypeProperty ;
    rdfs:label "status only from documents"@en ;
    rdfs:comment "Derived: whether the record's kind takes a status only from a member translated from a document, never from one the person entered."@en ;
    rdfs:domain cascade:Record ;
    rdfs:range xsd:boolean .

cascade:displayName a owl:DatatypeProperty ;
    rdfs:label "display name"@en ;
    rdfs:comment "Derived: the version's name, copied from the property its kind names things with."@en .

cascade:displayDate a owl:DatatypeProperty ;
    rdfs:label "display date"@en ;
    rdfs:comment "Derived: the version's date, copied from the property its kind dates things with, if it has one."@en .

cascade:currentRevision a owl:ObjectProperty ;
    rdfs:label "current revision"@en ;
    rdfs:comment "Derived: the revision of a record the ladder picks from its cascade:currentRevisionCandidate revisions: of those no other is cascade:laterInAncestryThan, the greatest cascade:observedAsOf, then the least IRI. Never written to a pod file."@en ;
    rdfs:range cascade:Revision .

cascade:laterInAncestryThan a owl:ObjectProperty ;
    rdfs:label "later in ancestry than"@en ;
    rdfs:comment "Derived: of two candidates for one record's current revision, both derived from live pulls of one source, this one's act's snapshot descends from that one's. A live pull is a document with a pav:retrievedOn and no cascade:answeredAsOf; two are of one source when both name one transmitter agent, or neither names one."@en ;
    rdfs:domain cascade:Revision ;
    rdfs:range cascade:Revision .

cascade:currentRevisionCandidate a owl:ObjectProperty ;
    rdfs:label "current revision candidate"@en ;
    rdfs:comment "Derived: a revision of the record still in the running once the ladder's first three steps have removed what they remove: no Erroneous that stands names it (cascade:revisionJudgedErroneousBy); no Before that stands, outside a cycle among the record's revisions, places it before another revision of the record no such Erroneous names; and of what is left, it carries the latest source change time, pav:lastUpdateOn, or carries none."@en ;
    rdfs:range cascade:Revision .

cascade:revisionJudgedErroneousBy a owl:ObjectProperty ;
    rdfs:label "revision judged erroneous by"@en ;
    rdfs:comment "Derived: a person's Erroneous that stands names this revision: no activity invalidates it, and no judgment that stands replaces it."@en ;
    rdfs:domain cascade:Revision ;
    rdfs:range cascade:Judgment .

cascade:judgedBefore a owl:ObjectProperty ;
    rdfs:label "judged before"@en ;
    rdfs:comment "Derived: a person's Before that stands places this revision before that one: no activity invalidates it, and no judgment that stands replaces it."@en ;
    rdfs:domain cascade:Revision ;
    rdfs:range cascade:Revision .

cascade:judgedBeforeRevisionOfSameRecord a owl:ObjectProperty ;
    rdfs:label "judged before revision of same record"@en ;
    rdfs:comment "Derived: cascade:judgedBefore between two revisions of one record."@en ;
    rdfs:subPropertyOf cascade:judgedBefore ;
    rdfs:domain cascade:Revision ;
    rdfs:range cascade:Revision .

cascade:Subject a owl:Class ;
    rdfs:label "subject"@en ;
    rdfs:comment "The person a pod is about: only a name, never versioned, holding no data."@en .

cascade:AuthorRole a prov:Role ;
    rdfs:label "author role"@en ;
    rdfs:comment "The part a party played in writing a document: HL7's provenance participant type author, which defines a code and no concept IRI."@en ;
    rdfs:seeAlso <http://terminology.hl7.org/CodeSystem/provenance-participant-type> .

cascade:CustodianRole a prov:Role ;
    rdfs:label "custodian role"@en ;
    rdfs:comment "The part a party played in keeping a document, accountable for its true copy: HL7's provenance participant type custodian, which defines a code and no concept IRI, and the CDA participation type CST of HL7 v3's ParticipationType, which a C-CDA custodian carries."@en ;
    rdfs:seeAlso <http://terminology.hl7.org/CodeSystem/provenance-participant-type> , <http://terminology.hl7.org/CodeSystem/v3-ParticipationType> .

cascade:TransmitterRole a prov:Role ;
    rdfs:label "transmitter role"@en ;
    rdfs:comment "The part a party played in fetching and delivering a document: US Core's provenance agent type transmitter, which defines a code and no concept IRI."@en ;
    rdfs:seeAlso <http://hl7.org/fhir/us/core/CodeSystem/us-core-provenance-participant-type> .

cascade:ReferenceSeries a owl:Class ;
    rdfs:label "reference series"@en ;
    rdfs:comment "A versioned reference table or rule set a machine applies; each of its versions is a prov:specializationOf it."@en .

pav:version a owl:DatatypeProperty ;
    rdfs:label "Version"@en ;
    rdfs:isDefinedBy <http://purl.org/pav/> ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/pav-ontology/pav/blob/1aff4569e1e14fc1c6c3ee6654c9101e06a4c655/pav.rdf> .

rdfs:label a rdf:Property ;
    rdfs:label "label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema#> ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Literal ;
    dct:source <https://www.w3.org/TR/2014/REC-rdf-schema-20140225/> .

pav:hasCurrentVersion a owl:ObjectProperty ;
    rdfs:label "Has current version"@en ;
    rdfs:isDefinedBy <http://purl.org/pav/> ;
    rdfs:subPropertyOf pav:hasVersion ;
    dct:source <https://github.com/pav-ontology/pav/blob/1aff4569e1e14fc1c6c3ee6654c9101e06a4c655/pav.rdf> .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "wasAttributedTo" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    dct:source <https://www.w3.org/ns/prov-o-20130430> ;
    dct:license <https://www.w3.org/Consortium/Legal/copyright-documents> .

cascade:View a owl:Class ;
    rdfs:label "view"@en ;
    rdfs:comment "A file the view queries build from the pod's records and judgments: deleting it loses nothing, and rerunning them rebuilds it."@en .

cascade:countsUnderLens a owl:DatatypeProperty ;
    rdfs:label "counts under lens"@en ;
    rdfs:comment "Derived: the judgment counts under the lens the build used."@en ;
    rdfs:domain cascade:Judgment ;
    rdfs:range xsd:boolean .

cascade:membersJoinedByCurrentTableVersion a owl:ObjectProperty ;
    rdfs:label "members joined by current table version"@en ;
    rdfs:comment "Derived: the current version of a series the matcher's claim used another version of, whose rows the query the current rule list runs for the claim's rule joins its members by, one of them to each of the others (M7)."@en ;
    rdfs:domain cascade:Judgment ;
    rdfs:range prov:Entity .

cascade:lapsed a owl:DatatypeProperty ;
    rdfs:label "lapsed"@en ;
    rdfs:comment "Derived: the judgment is a matcher's Same that does not count because a reference version it used has a newer current one whose rows do not join its members, nothing retracts it, and no judgment not itself retracted replaces it (dct:replaces)."@en ;
    rdfs:domain cascade:Judgment ;
    rdfs:range xsd:boolean .

cascade:leftOutFor a owl:ObjectProperty ;
    rdfs:label "left out for"@en ;
    rdfs:comment "Derived: one reason no view shows the record, in this build."@en ;
    rdfs:domain cascade:Record .

cascade:leftOutReason a owl:ObjectProperty ;
    rdfs:label "left out reason"@en ;
    rdfs:comment "Derived: which of the reasons a record can be left out for this one is."@en .

cascade:leftOutBecauseOf a owl:ObjectProperty ;
    rdfs:label "left out because of"@en ;
    rdfs:comment "Derived: the thing a reason for leaving a record out rests on, where it rests on one."@en .

cascade:EnteredInErrorAtSource a owl:NamedIndividual ;
    rdfs:label "entered-in-error at its source"@en .

cascade:RefutedAtSource a owl:NamedIndividual ;
    rdfs:label "refuted at its source"@en .

cascade:JudgedErroneous a owl:NamedIndividual ;
    rdfs:label "judged erroneous"@en .

cascade:ImportJudgedErroneous a owl:NamedIndividual ;
    rdfs:label "the import that brought it was judged erroneous"@en .

cascade:PatientNotClaimed a owl:NamedIndividual ;
    rdfs:label "its patient profile has no counting About"@en .

cascade:NoPatient a owl:NamedIndividual ;
    rdfs:label "it names no patient"@en .

cascade:inEntry a owl:ObjectProperty ;
    rdfs:label "in entry"@en ;
    rdfs:comment "Derived: the view entry the record belongs to in this build."@en .

cascade:leadMember a owl:ObjectProperty ;
    rdfs:label "lead member"@en ;
    rdfs:comment "Derived: the member an entry shows first: of its cascade:leadMemberCandidate members, the one whose current revision has the greatest cascade:observedAsOf, then the least IRI."@en .

cascade:leadMemberCandidate a owl:ObjectProperty ;
    rdfs:label "lead member candidate"@en ;
    rdfs:comment "Derived: a member of the entry still in the running for its lead. Of the members, those the person entered if there are any; less each whose current revision a Before that stands, outside a cycle, places before another such member's; and of what is left, those whose current revision carries the latest source change time, pav:lastUpdateOn, or carries none."@en .

cascade:statusFrom a owl:ObjectProperty ;
    rdfs:label "status from"@en ;
    rdfs:comment "Derived: the member whose status the entry shows."@en .

cascade:dateFrom a owl:ObjectProperty ;
    rdfs:label "date from"@en ;
    rdfs:comment "Derived: the member whose date the entry shows."@en .

cascade:medicationUseStartDateFrom a owl:ObjectProperty ;
    rdfs:label "medication use start date from"@en ;
    rdfs:comment "Derived: the member whose start of use a medication entry shows."@en .

cascade:prescriptionWrittenDateFrom a owl:ObjectProperty ;
    rdfs:label "prescription written date from"@en ;
    rdfs:comment "Derived: the member whose prescription's written date a medication entry shows."@en .

cascade:memberCurrentValues a owl:ObjectProperty ;
    rdfs:label "member current values"@en ;
    rdfs:comment "Derived: one member's current values as the entry's view holds them, a node of the view named after the entry and the member (N13): it names the member (cascade:valuesOfMember) and states what that member's current version states of the fields the view shows, so the view holds every member's values and the member each came from."@en .

cascade:valuesOfMember a owl:ObjectProperty ;
    rdfs:label "values of member"@en ;
    rdfs:comment "Derived: the member of an entry whose current version states the values this node of its view holds."@en .

cascade:topCriticality a owl:DatatypeProperty ;
    rdfs:label "top criticality"@en ;
    rdfs:comment "Derived: the most severe criticality a member states."@en ;
    rdfs:range xsd:string .

cascade:Placement a owl:Class ;
    rdfs:label "placement"@en ;
    rdfs:comment "One entry of a pod's layout: where a runtime files things. It names a file (solid:instance), a folder (solid:instanceContainer), or the property whose value's folder the thing goes in (cascade:filedWith). A thing is placed by cascade:filedWith first, then by an entry whose cascade:forSubjectsOf it states, then by its solid:forClass alone; a thing stating the properties of two such entries is placed by the one for prov:invalidated over the one for prov:used, so a retraction that used a release is filed with the retractions; a file that says it is a cascade:View is placed only by the entries at or under the views folder."@en .

cascade:subfolderPrefixLength a owl:DatatypeProperty ;
    rdfs:label "subfolder prefix length"@en ;
    rdfs:comment "How many leading characters of a file's name make the subfolder of the placement's folder it is filed in."@en ;
    rdfs:domain cascade:Placement ;
    rdfs:range xsd:integer .

cascade:filedWith a owl:ObjectProperty ;
    rdfs:label "filed with"@en ;
    rdfs:comment "The property whose value is filed in the folder the thing goes in, when the thing states it."@en ;
    rdfs:domain cascade:Placement .

cascade:forSubjectsOf a owl:ObjectProperty ;
    rdfs:label "for subjects of"@en ;
    rdfs:comment "Narrows the placement's class to the things that state this property."@en ;
    rdfs:domain cascade:Placement .

cascade:writtenByQueryPath a owl:DatatypeProperty ;
    rdfs:label "written by query path"@en ;
    rdfs:comment "The path under queries/ of the query that writes the placement's file."@en ;
    rdfs:domain cascade:Placement ;
    rdfs:range xsd:string .

cascade:writtenAlways a owl:DatatypeProperty ;
    rdfs:label "written always"@en ;
    rdfs:comment "Whether the build writes the placement's view at every build, rather than once the pod holds a record of its class."@en ;
    rdfs:domain cascade:Placement ;
    rdfs:range xsd:boolean .

cascade:holdsRecords a owl:DatatypeProperty ;
    rdfs:label "holds records"@en ;
    rdfs:comment "Whether the placement's folder holds the records of its class, each with its versions and revisions, which an import files and a pod's records are read from."@en ;
    rdfs:domain cascade:Placement ;
    rdfs:range xsd:boolean .

cascade:storesBytes a owl:DatatypeProperty ;
    rdfs:label "stores bytes"@en ;
    rdfs:comment "Whether the placement's folder holds documents' own bytes, each file named by the SHA-256 of its bytes in lowercase hex, rather than RDF."@en ;
    rdfs:domain cascade:Placement ;
    rdfs:range xsd:boolean .

solid:forClass a rdf:Property ;
    rdfs:label "registry class"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/solid/terms#> ;
    dct:source <https://github.com/solid/vocab/blob/b2ec12c354ead0df5c9526479bda69f0bd4e9acd/solid-terms.ttl> .

solid:instance a rdf:Property ;
    rdfs:label "instance"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/solid/terms#> ;
    dct:source <https://github.com/solid/vocab/blob/b2ec12c354ead0df5c9526479bda69f0bd4e9acd/solid-terms.ttl> .

solid:instanceContainer a rdf:Property ;
    rdfs:label "instance container"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/solid/terms#> ;
    dct:source <https://github.com/solid/vocab/blob/b2ec12c354ead0df5c9526479bda69f0bd4e9acd/solid-terms.ttl> .

# A lab result's value, unit and reference range, typed; decisions/quantities.md

cascade:Quantity a owl:Class ;
    rdfs:label "quantity"@en ;
    rdfs:comment "A number a source stated, with its comparator and its unit, as a node of the version that states it, named by the version's IRI, # and its role (value, numerator, denominator, range-low, range-high, reference-low, reference-high) and hashed with it."@en ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/datatypes.html#Quantity> .

cascade:decimalValue a owl:DatatypeProperty ;
    rdfs:label "decimal value"@en ;
    rdfs:comment "The number as an xsd:decimal in XSD's canonical form, for comparing, sorting and bounds: no exponent, no leading zero but the one before a point, no trailing zero after it, no point when it is a whole number, and no sign on zero. A number the source wrote with an exponent is written out in full."@en ;
    rdfs:domain cascade:Quantity ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso <https://www.w3.org/TR/xmlschema11-2/#decimal> .

cascade:writtenValue a owl:DatatypeProperty ;
    rdfs:label "written value"@en ;
    rdfs:comment "The number exactly as the source wrote it, its precision and any exponent kept: 6.80 is not written 6.8."@en ;
    rdfs:domain cascade:Quantity ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/datatypes.html#decimal> .

cascade:quantityComparator a owl:DatatypeProperty ;
    rdfs:label "quantity comparator"@en ;
    rdfs:comment "That the number is a bound and not the value: <, <=, >= or >, read as the actual value is less than, at most, at least or more than the number. A quantity with none is the value itself."@en ;
    rdfs:domain cascade:Quantity ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/valueset-quantity-comparator.html> .

cascade:ucumUnit a owl:DatatypeProperty ;
    rdfs:label "UCUM unit"@en ;
    rdfs:comment "The unit as a code of UCUM's case-sensitive form, exactly as the source wrote it, its case and its {annotations} kept; written only where the source says its unit is one."@en ;
    rdfs:domain cascade:Quantity ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://ucum.org/ucum> .

cascade:unitText a owl:DatatypeProperty ;
    rdfs:label "unit text"@en ;
    rdfs:comment "The unit as the source shows it to a reader, which need not be a UCUM code."@en ;
    rdfs:domain cascade:Quantity ;
    rdfs:range xsd:string .

cascade:resultValueKind a owl:ObjectProperty ;
    rdfs:label "result value kind"@en ;
    rdfs:comment "Which of the kinds in cascade:ResultValueKinds a lab result's value is, and so which properties hold it."@en ;
    rdfs:domain cascade:LaboratoryTestResult ;
    rdfs:range skos:Concept .

cascade:ResultValueKinds a skos:ConceptScheme ;
    rdfs:label "Result value kinds"@en ;
    rdfs:comment "The five kinds of value a lab result has, the set FHIR's Observation.value[x], CDA's data types and openEHR's DV_ types agree on. A value a source left out for a reason is no kind."@en ;
    skos:hasTopConcept cascade:QuantityResultValue , cascade:RatioResultValue , cascade:RangeResultValue , cascade:CodedResultValue ,
        cascade:TextResultValue .

cascade:QuantityResultValue a skos:Concept ;
    skos:inScheme cascade:ResultValueKinds ;
    skos:prefLabel "quantity" ;
    skos:definition "A number, with any comparator and unit, in the cascade:Quantity cascade:resultQuantity names."@en .

cascade:RatioResultValue a skos:Concept ;
    skos:inScheme cascade:ResultValueKinds ;
    skos:prefLabel "ratio" ;
    skos:definition "A numerator and a denominator, each a cascade:Quantity: a titre 1:64 is one, its parts with no unit."@en .

cascade:RangeResultValue a skos:Concept ;
    skos:inScheme cascade:ResultValueKinds ;
    skos:prefLabel "range" ;
    skos:definition "A low bound, a high bound or both, each a cascade:Quantity with no comparator, both bounds inside the range."@en .

cascade:CodedResultValue a skos:Concept ;
    skos:inScheme cascade:ResultValueKinds ;
    skos:prefLabel "coded" ;
    skos:definition "An answer from a code system, as the code's IRI, one cascade:resultCode for each coding the source gave."@en .

cascade:TextResultValue a skos:Concept ;
    skos:inScheme cascade:ResultValueKinds ;
    skos:prefLabel "text" ;
    skos:definition "Words, in cascade:resultValue, which no rule compares: two spellings of one finding are not one value."@en .

cascade:resultQuantity a owl:ObjectProperty ;
    rdfs:label "result quantity"@en ;
    rdfs:comment "Of a lab result whose value is a quantity, that quantity, <version>#value."@en ;
    rdfs:domain cascade:LaboratoryTestResult ;
    rdfs:range cascade:Quantity .

cascade:resultRatioNumerator a owl:ObjectProperty ;
    rdfs:label "result ratio numerator"@en ;
    rdfs:comment "Of a lab result whose value is a ratio, its numerator, <version>#numerator."@en ;
    rdfs:domain cascade:LaboratoryTestResult ;
    rdfs:range cascade:Quantity .

cascade:resultRatioDenominator a owl:ObjectProperty ;
    rdfs:label "result ratio denominator"@en ;
    rdfs:comment "Of a lab result whose value is a ratio, its denominator, <version>#denominator."@en ;
    rdfs:domain cascade:LaboratoryTestResult ;
    rdfs:range cascade:Quantity .

cascade:resultRangeLow a owl:ObjectProperty ;
    rdfs:label "result range low"@en ;
    rdfs:comment "Of a lab result whose value is a range, its low bound, <version>#range-low."@en ;
    rdfs:domain cascade:LaboratoryTestResult ;
    rdfs:range cascade:Quantity .

cascade:resultRangeHigh a owl:ObjectProperty ;
    rdfs:label "result range high"@en ;
    rdfs:comment "Of a lab result whose value is a range, its high bound, <version>#range-high."@en ;
    rdfs:domain cascade:LaboratoryTestResult ;
    rdfs:range cascade:Quantity .

cascade:resultCode a owl:ObjectProperty ;
    rdfs:label "result code"@en ;
    rdfs:comment "Of a lab result whose value is coded, the answer's code IRI, one for each coding the source gave in a code system cascade:CodeSystem names."@en ;
    rdfs:domain cascade:LaboratoryTestResult .

cascade:referenceRangeLow a owl:ObjectProperty ;
    rdfs:label "reference range low"@en ;
    rdfs:comment "The low bound of the one reference range the source marks normal, or of its only one, <version>#reference-low; with no low bound the range is everything up to its high one."@en ;
    rdfs:domain cascade:LaboratoryTestResult ;
    rdfs:range cascade:Quantity ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/observation-definitions.html#Observation.referenceRange.low> .

cascade:referenceRangeHigh a owl:ObjectProperty ;
    rdfs:label "reference range high"@en ;
    rdfs:comment "The high bound of the one reference range the source marks normal, or of its only one, <version>#reference-high; with no high bound the range is everything from its low one."@en ;
    rdfs:domain cascade:LaboratoryTestResult ;
    rdfs:range cascade:Quantity ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/observation-definitions.html#Observation.referenceRange.high> .

cascade:resultInterpretationCode a owl:ObjectProperty ;
    rdfs:label "result interpretation code"@en ;
    rdfs:comment "Of a lab result, a flag its source gave it, such as high, low or abnormal, as a code IRI of cascade:ObservationInterpretation: one for each such coding the source gave, so a result flagged both H and A holds both. It is the source's flag, never one inferred from the value and the reference range."@en ;
    rdfs:domain cascade:LaboratoryTestResult ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/observation-definitions.html#Observation.interpretation> .

# A time written short of the second, and a value absent for a stated reason; decisions/partial-dates-and-absent-reasons.md

cascade:PaddedDateTime a owl:Class ;
    rdfs:label "padded date-time"@en ;
    rdfs:comment "That one of a version's times was written by its source to the hour or the minute, and is held as an xsd:dateTime padded with zeros to the second, with no time zone where the source gave none: a node of the version, named by the version's IRI, #padded- and the local name of the property it is about, and hashed with it. The padded time sorts, compares and falls in a range as any xsd:dateTime does, and is never read as exact to the second: a query that needs its precision reads cascade:writtenDate. A year, a month or a day is no padded time, since its own type holds its precision."@en ;
    rdfs:seeAlso <https://hl7.org/fhir/us/ccda/en/mappingGuidance.html> .

cascade:paddedDateTime a owl:ObjectProperty ;
    rdfs:label "padded date-time"@en ;
    rdfs:comment "Of a version, the node saying that one of its times was written short of the second, one for each such property."@en ;
    rdfs:range cascade:PaddedDateTime .

cascade:paddedDateTimeProperty a owl:ObjectProperty ;
    rdfs:label "padded date-time property"@en ;
    rdfs:comment "The property of the version whose value is the padded time."@en ;
    rdfs:domain cascade:PaddedDateTime ;
    rdfs:range rdf:Property .

cascade:writtenDate a owl:DatatypeProperty ;
    rdfs:label "written date"@en ;
    rdfs:comment "The time exactly as the source wrote it, every character kept: a CDA time to the hour, 2023053114, is written 2023053114, its offset too where it had one. How many digits it has is its precision."@en ;
    rdfs:domain cascade:PaddedDateTime ;
    rdfs:range xsd:string .

cascade:ValueAbsentForReason a owl:Class ;
    rdfs:label "value absent for a reason"@en ;
    rdfs:comment "That a version holds no value for one property because its source said why: a node of the version, named by the version's IRI, #absent- and the property's local name, and hashed with it. A version holds it only where it holds no value for that property. A value a source left out without a reason has none, since a pod read open-world takes a missing triple as nothing said."@en ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/extension-data-absent-reason.html> , <https://terminology.hl7.org/CodeSystem-v3-NullFlavor.html> .

cascade:valueAbsentForReason a owl:ObjectProperty ;
    rdfs:label "value absent for a reason"@en ;
    rdfs:comment "Of a version, the node saying why it holds no value for one property, one for each such property."@en ;
    rdfs:range cascade:ValueAbsentForReason .

cascade:absentValueProperty a owl:ObjectProperty ;
    rdfs:label "absent value property"@en ;
    rdfs:comment "The property the version holds no value for. A lab result's value, of whatever kind, is cascade:resultValueKind's: with no value there is no kind."@en ;
    rdfs:domain cascade:ValueAbsentForReason ;
    rdfs:range rdf:Property .

cascade:absentReasonCode a owl:ObjectProperty ;
    rdfs:label "absent reason code"@en ;
    rdfs:comment "Why the value is absent, as the source said it: the code's IRI in cascade:DataAbsentReason, as FHIR's dataAbsentReason or data-absent-reason extension gives it, or in cascade:NullFlavor, as CDA's nullFlavor gives it, one for each such coding the source gave. It is never mapped from one system into the other when written: a view that needs one list maps at read, and shows the source's own code where HL7's map has none."@en ;
    rdfs:domain cascade:ValueAbsentForReason .

# Reference tables and the matcher's rule list, as a runtime is given them; none of these is written to a pod

cascade:defaultTableVersion a owl:ObjectProperty ;
    rdfs:label "default table version"@en ;
    rdfs:comment "The version of the series a runtime uses until the pod names another as current."@en ;
    rdfs:domain cascade:ReferenceSeries ;
    rdfs:range prov:Entity .

cascade:RuleListRow a owl:Class ;
    rdfs:label "rule list row"@en ;
    rdfs:comment "One row of a version of the matcher's rule list: the matcher rule it runs, the justification it gives or, for a rule that files findings for review instead of judgments, the kind of finding it files, the classes of record it applies to, the comparison query it runs and the hash of that query's bytes, and the kind of table the query reads, if any. A row is a blank node of its version; the rule is the term it names."@en .

cascade:justifiedAs a owl:ObjectProperty ;
    rdfs:label "justified as"@en ;
    rdfs:comment "The justification a judgment the rule writes gives."@en ;
    rdfs:domain cascade:RuleListRow .

cascade:findingKind a owl:ObjectProperty ;
    rdfs:label "finding kind"@en ;
    rdfs:comment "Of a row whose rule files findings for review rather than judgments, the kind of cascade:FindingForReview it files for each pair its query gives, a concept of cascade:FindingForReviewKinds."@en ;
    rdfs:domain cascade:RuleListRow ;
    rdfs:range skos:Concept .

cascade:appliesToClass a owl:ObjectProperty ;
    rdfs:label "applies to class"@en ;
    rdfs:comment "A class of record the rule compares, as SHACL's sh:targetClass names a class."@en ;
    rdfs:domain cascade:RuleListRow ;
    rdfs:range owl:Class .

cascade:matcherRule a owl:ObjectProperty ;
    rdfs:label "matcher rule"@en ;
    rdfs:comment "The matcher rule a row of a rule list runs, or that a machine claim was made by: one of the rule terms R1 to R17 of runtime/matcher.feature. A claim's name takes it."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( cascade:RuleListRow cascade:Judgment ) ] .

cascade:queryPath a owl:DatatypeProperty ;
    rdfs:label "query path"@en ;
    rdfs:comment "The path under queries/ of the comparison query the rule runs."@en ;
    rdfs:domain cascade:RuleListRow ;
    rdfs:range xsd:string .

cascade:queryHash a owl:ObjectProperty ;
    rdfs:label "query hash"@en ;
    rdfs:comment "The ni:///sha-256; name of the bytes of the rule's query file; a run whose file does not hash to it is refused."@en ;
    rdfs:domain cascade:RuleListRow .

cascade:rowOfRuleListVersion a owl:ObjectProperty ;
    rdfs:label "row of rule list version"@en ;
    rdfs:comment "The rule list version a row belongs to, as a pod describes it: a version's description names each row <version>#<the rule term's local name>, with its cascade:matcherRule and cascade:queryHash, so a lens can compare the row for a claim's rule in two versions."@en ;
    rdfs:domain cascade:RuleListRow ;
    rdfs:range prov:Entity .

# Table kinds, their rows and the codes rows name

cascade:tableKind a owl:ObjectProperty ;
    rdfs:label "table kind"@en ;
    rdfs:comment "Of a series, the one kind of table its versions are; of a rule of the rule list, the kind whose rows its query reads. A runtime gives the query the current version of every series of that kind, each in the graph named by the version's IRI."@en ;
    rdfs:range cascade:TableKind .

cascade:TableKind a owl:Class ;
    rdfs:label "table kind"@en ;
    rdfs:comment "What a table's rows say, whatever source fills it: the shape every row conforms to and the property a row is found by. A row is a subject of a version's rows with every triple it is the subject of, and holds no blank node."@en .

cascade:rowShape a owl:ObjectProperty ;
    rdfs:label "row shape"@en ;
    rdfs:comment "The SHACL shape every subject of a version's rows conforms to."@en ;
    rdfs:domain cascade:TableKind .

cascade:foundBy a owl:ObjectProperty ;
    rdfs:label "found by"@en ;
    rdfs:comment "A property whose value is a code a row is found by, or cascade:RowSubject when the row is about the code itself, as its subject."@en ;
    rdfs:domain cascade:TableKind .

cascade:VaccineGroups a cascade:TableKind ;
    rdfs:label "vaccine groups"@en ;
    rdfs:comment "An SSSOM mapping kind: a vaccine code and a group it is a member of (obo:RO_0002350). A code in several groups has a row for each, and a group's own code is a member of itself."@en ;
    cascade:rowShape cascade:VaccineGroupRowShape ;
    cascade:foundBy owl:annotatedSource .

cascade:CodeNames a cascade:TableKind ;
    rdfs:label "code names"@en ;
    rdfs:comment "A code's names in SKOS, as its publisher gives them."@en ;
    cascade:rowShape cascade:CodeNameRowShape ;
    cascade:foundBy cascade:RowSubject ;
    cascade:readByAppPages true .

cascade:RetiredCodes a cascade:TableKind ;
    rdfs:label "retired codes"@en ;
    rdfs:comment "A retired code, with each replacement its publisher gives. A code that is not retired has no row; a mapping kind keeps a retired code's rows."@en ;
    cascade:rowShape cascade:RetiredCodeRowShape ;
    cascade:foundBy cascade:RowSubject ;
    cascade:readByAppPages true .

cascade:SubstanceIngredients a cascade:TableKind ;
    rdfs:label "substance ingredients"@en ;
    rdfs:comment "An SSSOM mapping kind the stories use and no open source fills: a SNOMED CT substance and its RxNorm ingredient. Read either way round."@en ;
    cascade:rowShape cascade:SubstanceIngredientRowShape ;
    cascade:foundBy owl:annotatedSource , owl:annotatedTarget .

cascade:ProductIngredients a cascade:TableKind ;
    rdfs:label "product ingredients"@en ;
    rdfs:comment "An SSSOM mapping kind: an RxNorm concept and its active ingredient (obo:RO_0002248), its one ingredient or, with several, the multiple ingredient concept of exactly those. An ingredient has itself as its ingredient. A concept also has a row to each distinct precise ingredient RxNorm ties to it (cascade:hasPreciseIngredient). A version holding any precise ingredient row holds one for each concept whose RxNorm relations reach a precise ingredient, a brand name, a drug, a component and a dose form or dose form group version of one alike, so a concept such a version gives none holds its ingredient itself."@en ;
    cascade:rowShape cascade:ProductIngredientRowShape ;
    cascade:foundBy owl:annotatedSource .

cascade:hasPreciseIngredient a owl:ObjectProperty ;
    rdfs:label "has precise ingredient"@en ;
    rdfs:comment "Of an RxNorm concept, a precise ingredient (PIN) RxNorm ties to it: a component's or a brand name's has_precise_ingredient, a dose form's has_boss, or a drug's, a brand's or a dose form group's by way of those. The ingredient the PIN is a form of stays the concept's active ingredient (obo:RO_0002248)."@en ;
    dct:source <https://lhncbc.nlm.nih.gov/RxNav/APIs/api-RxNorm.getRelaTypes.html> .

cascade:BrandGenerics a cascade:TableKind ;
    rdfs:label "brand generics"@en ;
    rdfs:comment "An SSSOM mapping kind: a branded RxNorm concept and its generic."@en ;
    cascade:rowShape cascade:BrandGenericRowShape ;
    cascade:foundBy owl:annotatedSource .

cascade:DrugProducts a cascade:TableKind ;
    rdfs:label "drug products"@en ;
    rdfs:comment "A code that names one drug product, generic or branded, a clinical drug or a pack (RxNorm's SCD, SBD, GPCK and BPCK), with its term type as its publisher gives it. A code with no row is not known to name one product: an ingredient, a strength, a dose form, a brand name or a salt has none."@en ;
    cascade:rowShape cascade:DrugProductRowShape ;
    cascade:foundBy cascade:RowSubject .

cascade:termType a owl:DatatypeProperty ;
    rdfs:label "term type"@en ;
    rdfs:comment "Of a code, its term type as its publisher writes it; for RxNorm, the TTY of RXNCONSO."@en ;
    rdfs:range xsd:string .

cascade:CodeConversions a cascade:TableKind ;
    rdfs:label "code conversions"@en ;
    rdfs:comment "An SSSOM mapping kind: a retired code and each code in effect its publisher converts its data to, one dct:isReplacedBy row each, with its cardinality. The cardinality is counted along each conversion on the way, not over the table as SSSOM counts it: n:… when, at any step of the path from the retired code to the code in effect, the publisher gives the step's code anything but the step's own predecessor as a previous code, …:n when any code on the path before the end converts into more than one code, so a pure chain A to B to C is published as A to C as 1:1. A row of the earlier form, skos:exactMatch with no cardinality, is still read."@en ;
    cascade:rowShape cascade:CodeConversionRowShape ;
    cascade:foundBy owl:annotatedSource , owl:annotatedTarget .

cascade:VariantClassifications a cascade:TableKind ;
    rdfs:label "variant classifications"@en ;
    rdfs:comment "What a source such as ClinVar says of a variant: a row for each variation, found by its variation IRI and by each coding NM_ expression a submitter used or its ClinVar name holds, holding the aggregate germline classification and review status as concepts, the day it was last evaluated and how many submitters contribute. A join through these rows is identity and reads no classification. A version states the genes it covers (cascade:coversGene), so a page can tell a variant in a gene the series does not cover from a covered one the rows do not hold."@en ;
    cascade:rowShape cascade:VariantClassificationRowShape ;
    cascade:foundBy cascade:RowSubject , cascade:hgvsExpression ;
    cascade:readByAppPages true .

cascade:PanelMembers a cascade:TableKind ;
    rdfs:label "panel members"@en ;
    rdfs:comment "An SSSOM mapping kind: a LOINC panel and each member it directly has (obo:RO_0002351), both LOINC codes, with the member's place in the panel (cascade:panelSequence) and whether the panel requires it (cascade:observationRequiredInPanel) as LOINC gives them. A nested panel is a member of its parent and has its own members as rows of its own, so nesting is the rows, never a flattened tree. A member listed at two places in one panel is two rows. OMOP's relationship Panel contains is the same relation, and has no IRI. A row is found by its panel and by its member."@en ;
    cascade:rowShape cascade:PanelMemberRowShape ;
    cascade:foundBy owl:annotatedSource , owl:annotatedTarget ;
    cascade:readByAppPages true .

cascade:DrugClasses a cascade:TableKind ;
    rdfs:label "drug classes"@en ;
    rdfs:comment "An SSSOM mapping kind: an RxNorm code and a class it is in, one predicate for each relation: its established pharmacologic class (cascade:establishedPharmacologicClass), its mechanism of action (cascade:mechanismOfActionClass), its physiologic effect (cascade:physiologicEffectClass) or its chemical structure (cascade:chemicalStructureClass). The rows are FDA's (Authority FDASPL) as MED-RT indexes them, on an ingredient, a precise ingredient or a code outside the prescribable set; a class is a MED-RT code, and a chemical structure also a MeSH code."@en ;
    cascade:rowShape cascade:DrugClassRowShape ;
    cascade:foundBy owl:annotatedSource ;
    cascade:readByAppPages true .

cascade:ValueSetExpansions a cascade:TableKind ;
    rdfs:label "value set expansions"@en ;
    rdfs:comment "An SSSOM mapping kind: a value set's expansion as its publisher gives it, one row for each code it contains, the code's IRI a member of (obo:RO_0002350) the value set named by its canonical URL as an IRI, as VSAC names one http://cts.nlm.nih.gov/fhir/ValueSet/<OID>. A version is one expansion of one value set and names that value set (cascade:expandedValueSet), every row's target being it, so a rule cites \"checked this value set at this version, no member\" from the version alone, even when every code the expansion contains was left out. Its pav:version is the expansion's timestamp, or its identifier where the publisher gives no timestamp; the value set definition's own version is cascade:valueSetDefinitionVersion. The code systems' versions each member was listed under (contains.version) are not kept. A code in a system with no code IRI is left out, and the version counts what was left out (cascade:expansionMembersWithoutCodeIriLeftOutCount). A row is found by its code, which is how a pod's codes reach the value sets they are in."@en ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/valueset-definitions.html#ValueSet.expansion.contains> ;
    cascade:rowShape cascade:ValueSetExpansionRowShape ;
    cascade:foundBy owl:annotatedSource .

cascade:expandedValueSet a owl:ObjectProperty ;
    rdfs:label "expanded value set"@en ;
    rdfs:comment "Of a version of a value set expansions series, the value set it expands, by its canonical URL as an IRI exactly as the source's ValueSet.url gives it. Each row of the version has it as its target, so a version with no row still says which value set it checked."@en ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/valueset-definitions.html#ValueSet.url> .

cascade:valueSetDefinitionVersion a owl:DatatypeProperty ;
    rdfs:label "value set definition version"@en ;
    rdfs:comment "Of a version of a value set expansions series, the version of the value set's definition the expansion was computed from, as the source gives ValueSet.version. A version without it is of a value set whose source gives none."@en ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/valueset-definitions.html#ValueSet.version> ;
    rdfs:range xsd:string .

cascade:expansionMembersWithoutCodeIriLeftOutCount a owl:DatatypeProperty ;
    rdfs:label "expansion members without code IRI left out count"@en ;
    rdfs:comment "Of a version of a value set expansions series, how many codes the expansion contains that are in a system with no code IRI, and so have no row, as an eCQM expansion may list HCPCS codes. A version without it left none out."@en ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/valueset-definitions.html#ValueSet.expansion.contains.system> ;
    rdfs:range xsd:integer .

cascade:panelSequence a owl:DatatypeProperty ;
    rdfs:label "panel sequence"@en ;
    rdfs:comment "Of a panel member row, the member's SEQUENCE in the panel, as LOINC gives it in its PanelsAndForms file."@en ;
    rdfs:range xsd:integer .

cascade:observationRequiredInPanel a owl:DatatypeProperty ;
    rdfs:label "observation required in panel"@en ;
    rdfs:comment "Of a panel member row, whether the panel requires the member, as LOINC writes ObservationRequiredInPanel in its PanelsAndForms file (R, O, C, R-a, Rflx, Rflx-a). A row without it is a member LOINC gives no requirement for."@en ;
    rdfs:range xsd:string .

cascade:establishedPharmacologicClass a owl:ObjectProperty ;
    rdfs:label "established pharmacologic class"@en ;
    rdfs:comment "Of a drug, a class FDA lists it in by its established pharmacologic class, MED-RT's has_EPC."@en ;
    dct:source <https://lhncbc.nlm.nih.gov/RxNav/applications/RxClassIntro.html> .

cascade:mechanismOfActionClass a owl:ObjectProperty ;
    rdfs:label "mechanism of action class"@en ;
    rdfs:comment "Of a drug, a class naming how it acts, MED-RT's has_MoA."@en ;
    rdfs:seeAlso obo:NCIT_R124 ;
    dct:source <https://lhncbc.nlm.nih.gov/RxNav/applications/RxClassIntro.html> .

cascade:physiologicEffectClass a owl:ObjectProperty ;
    rdfs:label "physiologic effect class"@en ;
    rdfs:comment "Of a drug, a class naming what it does in the body, MED-RT's has_PE."@en ;
    rdfs:seeAlso obo:NCIT_R125 ;
    dct:source <https://lhncbc.nlm.nih.gov/RxNav/applications/RxClassIntro.html> .

cascade:chemicalStructureClass a owl:ObjectProperty ;
    rdfs:label "chemical structure class"@en ;
    rdfs:comment "Of a drug, a class naming its chemical structure, MED-RT's has_SC: a MED-RT code or a MeSH code."@en ;
    dct:source <https://lhncbc.nlm.nih.gov/RxNav/applications/RxClassIntro.html> .

cascade:readByAppPages a owl:DatatypeProperty ;
    rdfs:label "read by app pages"@en ;
    rdfs:comment "True when an app keeps a series of the kind, and packs it, though no rule of its rule list reads the kind: its pages read the rows. A kind that is neither named by a rule list nor marked is skipped."@en ;
    rdfs:domain cascade:TableKind ;
    rdfs:range xsd:boolean .

cascade:coversGene a owl:DatatypeProperty ;
    rdfs:label "covers gene"@en ;
    rdfs:comment "Of a version of a series of a kind that covers some genes, an HGNC approved symbol of a gene it covers, any number. A version without it covers no named gene, and a changed list of genes is a new version."@en ;
    rdfs:range xsd:string .

cascade:hgvsExpression a owl:ObjectProperty ;
    rdfs:label "HGVS expression"@en ;
    rdfs:comment "Of a variant classification row, a coding NM_ expression a submitter used for its variation, or the one its ClinVar name holds, as the cascade:HGVS IRI."@en .

cascade:clinvarClassification a owl:ObjectProperty ;
    rdfs:label "ClinVar classification"@en ;
    rdfs:comment "Of a variant classification row, a concept of cascade:ClinVarClassifications its aggregate germline classification parses to."@en ;
    rdfs:range skos:Concept .

cascade:clinvarReviewStatus a owl:ObjectProperty ;
    rdfs:label "ClinVar review status"@en ;
    rdfs:comment "Of a variant classification row, the concept of cascade:ClinVarReviewStatuses its review status is."@en ;
    rdfs:range skos:Concept .

cascade:lastEvaluated a owl:DatatypeProperty ;
    rdfs:label "last evaluated"@en ;
    rdfs:comment "Of a variant classification row, the day its newest submitter evaluated the variation. It is not the day the aggregate changed."@en ;
    rdfs:range xsd:date .

cascade:contributingSubmitterCount a owl:DatatypeProperty ;
    rdfs:label "contributing submitter count"@en ;
    rdfs:comment "Of a variant classification row, how many submissions contribute to its aggregate classification, from a release that lists them (SCVsForAggregateGermlineClassification)."@en ;
    rdfs:range xsd:integer .

cascade:submitterCount a owl:DatatypeProperty ;
    rdfs:label "submitter count"@en ;
    rdfs:comment "Of a variant classification row, how many submitters it has, as an older release counts them (NumberSubmitters), which includes any whose submission does not contribute. A row holds this or cascade:contributingSubmitterCount, so it says which count it has."@en ;
    rdfs:range xsd:integer .

cascade:RowSubject a rdf:Property ;
    rdfs:label "the row's subject"@en ;
    rdfs:comment "Not stated by any row: as a kind's cascade:foundBy, that each row is found by its own subject, the code it is about."@en .

cascade:CodeSystem a owl:Class ;
    rdfs:label "code system"@en ;
    rdfs:comment "A code system whose codes are IRIs of one form: its void:uriSpace, the IRI stem, followed by the code percent-encoded as SPARQL's ENCODE_FOR_URI does, every character but A-Z a-z 0-9 - _ . ~ as % and two upper-case hexadecimal digits of its UTF-8. Unlike R2RML's IRI-safe form (section 7.3), which leaves ucschar unencoded, it encodes every non-ASCII character; no code of a system here holds one, so the two agree on every code today. The stem is the owner's or a community registry's where one passes decisions/code-iris.md, and Cascade's own under https://ns.cascadeprotocol.org/codes/ otherwise; it is never the FHIR Coding.system URI, which cascade:codingSystemUri holds (https://hl7.org/fhir/R5/rdf.html#iri-stem). A stem the owner or HL7 Terminology registers later is recorded on the system beside its void:uriSpace and read as each code's skos:exactMatch; a code's IRI is never renamed. A record's code written as a literal joins a table as that IRI: the stem followed by the literal percent-encoded as ENCODE_FOR_URI does, so a literal of unreserved characters only is its own tail and NM_000249.4:c.2042C>T is https://ns.cascadeprotocol.org/codes/hgvs/NM_000249.4%3Ac.2042C%3ET."@en .

cascade:codingSystemUri a owl:DatatypeProperty ;
    rdfs:label "coding system URI"@en ;
    rdfs:comment "The code system's URI as FHIR's Coding.system names it, HL7 Terminology's preferred one. A reader writing FHIR takes Coding.system from it and Coding.code from a code IRI's tail after the void:uriSpace, percent-decoded."@en ;
    rdfs:domain cascade:CodeSystem ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/datatypes-definitions.html#Coding.system> .

cascade:codePageUrlTemplate a owl:DatatypeProperty ;
    rdfs:label "code page URL template"@en ;
    rdfs:comment "The address of each code's own page at the code system's publisher, as an RFC 6570 level 1 template whose only expression is {code}. {code} is the code as written, and expanding it by RFC 6570 simple expansion percent-encodes it as ENCODE_FOR_URI does, so it yields the same tail the code's IRI has after the void:uriSpace. A code system without one publishes no page per code."@en ;
    rdfs:domain cascade:CodeSystem ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.wikidata.org/wiki/Property:P1630> ;
    dct:source <https://www.rfc-editor.org/rfc/rfc6570> .

cascade:CVX a cascade:CodeSystem ;
    rdfs:label "CVX"@en ;
    rdfs:comment "The code as CDC writes it, leading zero kept and trailing spaces trimmed: 08, 141. A record coded 8 joins nothing."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/cvx/" ;
    cascade:codingSystemUri "http://hl7.org/fhir/sid/cvx"^^xsd:anyURI .

cascade:RxNorm a cascade:CodeSystem ;
    rdfs:label "RxNorm"@en ;
    rdfs:comment "The RXCUI."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/rxnorm/" ;
    cascade:codingSystemUri "http://www.nlm.nih.gov/research/umls/rxnorm"^^xsd:anyURI .

cascade:NDC a cascade:CodeSystem ;
    rdfs:label "NDC"@en ;
    rdfs:comment "The 11-digit HIPAA form, 5-4-2 with no hyphens, as RxNorm's RXNSAT gives it: Cascade's own space. FHIR's NDC code is the 10-digit hyphenated label code, so an NDC is normalised into this space."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/ndc11/" ;
    cascade:codingSystemUri "http://hl7.org/fhir/sid/ndc"^^xsd:anyURI ;
    dct:source <https://hl7.org/fhir/R4/ndc.html> .

cascade:ICD10CM a cascade:CodeSystem ;
    rdfs:label "ICD-10-CM"@en ;
    rdfs:comment "The code as FHIR writes it."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/icd10cm/" ;
    cascade:codingSystemUri "http://hl7.org/fhir/sid/icd-10-cm"^^xsd:anyURI .

cascade:SNOMEDCT a cascade:CodeSystem ;
    rdfs:label "SNOMED CT"@en ;
    rdfs:comment "The concept ID. snomed.info/sct is the code system's own URI and, with a module, names its editions; it never names a concept."@en ;
    void:uriSpace "http://snomed.info/id/" ;
    cascade:codingSystemUri "http://snomed.info/sct"^^xsd:anyURI ;
    dct:source <https://terminology.hl7.org/SNOMEDCT.html> .

cascade:LOINC a cascade:CodeSystem ;
    rdfs:label "LOINC"@en ;
    rdfs:comment "The LOINC code as LOINC writes it, with its check digit: 2823-3."@en ;
    void:uriSpace "http://loinc.org/rdf/" ;
    cascade:codingSystemUri "http://loinc.org"^^xsd:anyURI ;
    dct:source <https://github.com/HL7/UTG/blob/18bfa0662fbf6c9f6f51922e46c534b00d987848/input/sourceOfTruth/external/v3/namingSystems/v3-loinc.xml> .

cascade:MEDRT a cascade:CodeSystem ;
    rdfs:label "MED-RT"@en ;
    rdfs:comment "The NUI as MED-RT writes it: N0000175562. Cascade's own space: neither VA, HL7 Terminology nor NCI EVS publishes an IRI per code."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/medrt/" ;
    cascade:codingSystemUri "http://va.gov/terminology/medrt"^^xsd:anyURI ;
    dct:source <https://terminology.hl7.org/MEDRT.html> .

cascade:MeSH a cascade:CodeSystem ;
    rdfs:label "MeSH"@en ;
    rdfs:comment "A MeSH unique ID as NLM writes it: a concept M0006414, as MED-RT gives them, or a descriptor D004095."@en ;
    void:uriSpace "http://id.nlm.nih.gov/mesh/" ;
    cascade:codePageUrlTemplate "https://id.nlm.nih.gov/mesh/{code}.html" ;
    cascade:codingSystemUri "https://www.nlm.nih.gov/mesh"^^xsd:anyURI ;
    dct:source <https://terminology.hl7.org/CodeSystem-MSH.html> .

cascade:UNII a cascade:CodeSystem ;
    rdfs:label "UNII"@en ;
    rdfs:comment "The UNII as FDA's GSRS gives it."@en ;
    void:uriSpace "https://identifiers.org/unii:" ;
    cascade:codingSystemUri "http://fdasis.nlm.nih.gov"^^xsd:anyURI ;
    dct:source <https://hl7.org/fhir/R4/terminologies-systems.html> .

cascade:CPT a cascade:CodeSystem ;
    rdfs:label "CPT"@en ;
    rdfs:comment "The CPT code."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/cpt/" ;
    cascade:codingSystemUri "http://www.ama-assn.org/go/cpt"^^xsd:anyURI ;
    dct:source <https://hl7.org/fhir/R4/terminologies-systems.html> .

cascade:ICD9CM a cascade:CodeSystem ;
    rdfs:label "ICD-9-CM"@en ;
    rdfs:comment "The code as FHIR writes it."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/icd9cm/" ;
    cascade:codingSystemUri "http://hl7.org/fhir/sid/icd-9-cm"^^xsd:anyURI ;
    dct:source <https://hl7.org/fhir/R4/terminologies-systems.html> .

cascade:HGVS a cascade:CodeSystem ;
    rdfs:label "HGVS"@en ;
    rdfs:comment "A coding expression in its normal form: the reference sequence with its version, a colon and c., then the change, as NM_000249.4:c.2042C>T, with no gene in parentheses and no protein change. The code holds characters an IRI cannot, so it is percent-encoded: the colon is %3A and > is %3E. Only an NM_ expression is a key of a table."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/hgvs/" ;
    cascade:codingSystemUri "http://varnomen.hgvs.org"^^xsd:anyURI ;
    dct:source <https://github.com/HL7/UTG/blob/18bfa0662fbf6c9f6f51922e46c534b00d987848/input/sourceOfTruth/external/v3/namingSystems/v3-hgvs.xml> .

cascade:ClinVar a cascade:CodeSystem ;
    rdfs:label "ClinVar"@en ;
    rdfs:comment "A ClinVar variation, by its VariationID: the digits, no leading zero, as 90011. The accession VCV000090011 is that number zero-padded and an SCV or RCV accession is not a variation."@en ;
    void:uriSpace "https://identifiers.org/clinvar:" ;
    cascade:codePageUrlTemplate "https://www.ncbi.nlm.nih.gov/clinvar/variation/{code}/" ;
    cascade:codingSystemUri "http://www.ncbi.nlm.nih.gov/clinvar"^^xsd:anyURI ;
    dct:source <https://github.com/HL7/UTG/blob/18bfa0662fbf6c9f6f51922e46c534b00d987848/input/sourceOfTruth/external/hta/namingSystems/clinVarV.xml> .

cascade:DataAbsentReason a cascade:CodeSystem ;
    rdfs:label "FHIR data absent reason"@en ;
    rdfs:comment "The code as FHIR writes it: unknown, asked-unknown, masked. Cascade's own space: HL7 Terminology, which publishes the system, registers no IRI stem for it, and Bioregistry names HL7's code systems, not their codes."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/data-absent-reason/" ;
    cascade:codingSystemUri "http://terminology.hl7.org/CodeSystem/data-absent-reason"^^xsd:anyURI ;
    dct:source <https://terminology.hl7.org/CodeSystem-data-absent-reason.html> .

cascade:NullFlavor a cascade:CodeSystem ;
    rdfs:label "HL7 v3 NullFlavor"@en ;
    rdfs:comment "The code as CDA writes it in nullFlavor, upper case: NI, UNK, ASKU. Cascade's own space, as cascade:DataAbsentReason's is."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/nullflavor/" ;
    cascade:codingSystemUri "http://terminology.hl7.org/CodeSystem/v3-NullFlavor"^^xsd:anyURI ;
    dct:source <https://terminology.hl7.org/CodeSystem-v3-NullFlavor.html> .

cascade:ObservationInterpretation a cascade:CodeSystem ;
    rdfs:label "HL7 v3 ObservationInterpretation"@en ;
    rdfs:comment "The code as FHIR's Observation.interpretation and C-CDA's interpretationCode write it, case kept: H, A, LL, >. A code holding < or > is percent-encoded, so > is %3E. C-CDA names the system by the OID 2.16.840.1.113883.5.83. Cascade's own space, as cascade:DataAbsentReason's is."@en ;
    void:uriSpace "https://ns.cascadeprotocol.org/codes/observationinterpretation/" ;
    cascade:codingSystemUri "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation"^^xsd:anyURI ;
    dct:source <https://terminology.hl7.org/CodeSystem-v3-ObservationInterpretation.html> .

cascade:ClinVarClassifications a skos:ConceptScheme ;
    rdfs:label "ClinVar classifications"@en ;
    rdfs:comment "The values of ClinVar's aggregate germline classification, as it spells them. ClinVar joins ACMG terms with a slash and other terms with a semicolon, so a value is parsed into concepts, never matched whole. A renamed label is an alternative label of the concept it names."@en ;
    skos:hasTopConcept cascade:Pathogenic , cascade:LikelyPathogenic , cascade:UncertainSignificance , cascade:LikelyBenign , cascade:Benign ,
        cascade:ClinVarConflicting , cascade:ClinVarConflictingData , cascade:ClinVarEstablishedRiskAllele , cascade:ClinVarLikelyRiskAllele ,
        cascade:ClinVarUncertainRiskAllele , cascade:ClinVarDrugResponse , cascade:ClinVarRiskFactor , cascade:ClinVarAssociation ,
        cascade:ClinVarProtective , cascade:ClinVarConfersSensitivity , cascade:ClinVarAffects , cascade:ClinVarOther , cascade:ClinVarNotProvided ,
        cascade:ClinVarCombinationOnly , cascade:ClinVarNoClassificationsFromUnflaggedRecords , cascade:ClinVarNoClassificationForTheSingleVariant .

cascade:ClinVarReviewStatuses a skos:ConceptScheme ;
    rdfs:label "ClinVar review statuses"@en ;
    rdfs:comment "The values of ClinVar's review status, as it spells them. A value holds commas and is matched whole, never split."@en ;
    skos:hasTopConcept cascade:ClinVarPracticeGuideline , cascade:ClinVarExpertPanel , cascade:ClinVarMultipleSubmittersNoConflicts ,
        cascade:ClinVarConflictingClassifications , cascade:ClinVarSingleSubmitter , cascade:ClinVarNoAssertionCriteria ,
        cascade:ClinVarNoClassificationProvided , cascade:ClinVarNoClassificationForTheSingleVariant ,
        cascade:ClinVarNoClassificationsFromUnflaggedRecords .

cascade:Pathogenic a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Pathogenic" ;
    skos:exactMatch <http://loinc.org/rdf/LA6668-3> .

cascade:LikelyPathogenic a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Likely pathogenic" ;
    skos:exactMatch <http://loinc.org/rdf/LA26332-9> .

cascade:UncertainSignificance a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Uncertain significance" ;
    skos:exactMatch <http://loinc.org/rdf/LA26333-7> .

cascade:LikelyBenign a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Likely benign" ;
    skos:exactMatch <http://loinc.org/rdf/LA26334-5> .

cascade:Benign a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Benign" ;
    skos:exactMatch <http://loinc.org/rdf/LA6675-8> .

cascade:ClinVarConflicting a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Conflicting classifications of pathogenicity" ;
    skos:altLabel "Conflicting interpretations of pathogenicity" .

cascade:ClinVarConflictingData a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "conflicting data from submitters" .

cascade:ClinVarPathogenicLowPenetrance a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Pathogenic, low penetrance" ;
    skos:broader cascade:Pathogenic .

cascade:ClinVarLikelyPathogenicLowPenetrance a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Likely pathogenic, low penetrance" ;
    skos:broader cascade:LikelyPathogenic .

cascade:ClinVarVusHigh a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "VUS-high" ;
    skos:broader cascade:UncertainSignificance .

cascade:ClinVarVusMid a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "VUS-mid" ;
    skos:broader cascade:UncertainSignificance .

cascade:ClinVarVusLow a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "VUS-low" ;
    skos:broader cascade:UncertainSignificance .

cascade:ClinVarEstablishedRiskAllele a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Established risk allele" .

cascade:ClinVarLikelyRiskAllele a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Likely risk allele" .

cascade:ClinVarUncertainRiskAllele a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Uncertain risk allele" .

cascade:ClinVarDrugResponse a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "drug response" .

cascade:ClinVarRiskFactor a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "risk factor" .

cascade:ClinVarAssociation a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "association" .

cascade:ClinVarProtective a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "protective" .

cascade:ClinVarConfersSensitivity a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "confers sensitivity" .

cascade:ClinVarAffects a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "Affects" .

cascade:ClinVarOther a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "other" .

cascade:ClinVarNotProvided a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "not provided" .

cascade:ClinVarCombinationOnly a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications ;
    skos:prefLabel "classified only as part of a combination" ;
    skos:notation "-" ;
    rdfs:comment "ClinVar writes a hyphen for a variation classified only in combination with another variant; the hyphen is the concept's notation and the whole value."@en .

cascade:ClinVarNoClassificationsFromUnflaggedRecords a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications , cascade:ClinVarReviewStatuses ;
    skos:prefLabel "no classifications from unflagged records" .

cascade:ClinVarNoClassificationForTheSingleVariant a skos:Concept ;
    skos:inScheme cascade:ClinVarClassifications , cascade:ClinVarReviewStatuses ;
    skos:prefLabel "no classification for the single variant" ;
    skos:altLabel "no interpretation for the single variant" .

cascade:ClinVarPracticeGuideline a skos:Concept ;
    skos:inScheme cascade:ClinVarReviewStatuses ;
    skos:prefLabel "practice guideline" .

cascade:ClinVarExpertPanel a skos:Concept ;
    skos:inScheme cascade:ClinVarReviewStatuses ;
    skos:prefLabel "reviewed by expert panel" .

cascade:ClinVarMultipleSubmittersNoConflicts a skos:Concept ;
    skos:inScheme cascade:ClinVarReviewStatuses ;
    skos:prefLabel "criteria provided, multiple submitters, no conflicts" .

cascade:ClinVarConflictingClassifications a skos:Concept ;
    skos:inScheme cascade:ClinVarReviewStatuses ;
    skos:prefLabel "criteria provided, conflicting classifications" ;
    skos:altLabel "criteria provided, conflicting interpretations" .

cascade:ClinVarSingleSubmitter a skos:Concept ;
    skos:inScheme cascade:ClinVarReviewStatuses ;
    skos:prefLabel "criteria provided, single submitter" .

cascade:ClinVarNoAssertionCriteria a skos:Concept ;
    skos:inScheme cascade:ClinVarReviewStatuses ;
    skos:prefLabel "no assertion criteria provided" .

cascade:ClinVarNoClassificationProvided a skos:Concept ;
    skos:inScheme cascade:ClinVarReviewStatuses ;
    skos:prefLabel "no classification provided" ;
    skos:altLabel "no assertion provided" .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:ConceptScheme a owl:Class ;
