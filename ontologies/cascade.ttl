oa:hasBody a rdf:Property ;
    rdfs:label "hasBody"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/oa#> ;
    rdfs:domain oa:Annotation ;
    dct:source <https://www.w3.org/TR/2017/REC-annotation-vocab-20170223/> .

oa:hasTarget a rdf:Property ;
    rdfs:label "hasTarget"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/oa#> ;
    rdfs:domain oa:Annotation ;
    dct:source <https://www.w3.org/TR/2017/REC-annotation-vocab-20170223/> .

oa:motivatedBy a rdf:Property ;
    rdfs:label "motivatedBy"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/oa#> ;
    rdfs:domain oa:Annotation ;
    rdfs:range oa:Motivation ;
    dct:source <https://www.w3.org/TR/2017/REC-annotation-vocab-20170223/> .

oa:classifying a oa:Motivation ;
