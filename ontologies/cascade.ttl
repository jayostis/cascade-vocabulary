@prefix cascade: <https://ns.cascadeprotocol.org/cascade#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix solid: <http://www.w3.org/ns/solid/terms#> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ns.cascadeprotocol.org/cascade#> a owl:Ontology ;
    rdfs:label "Cascade vocabulary"@en ;
    dct:license <https://spdx.org/licenses/Apache-2.0> , <https://spdx.org/licenses/CC-BY-4.0> ;
    dct:source <https://github.com/the-cascade-protocol/spec/tree/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies> .

# Copied from the spec's core

cascade:PatientProfile a owl:Class ;
    rdfs:label "Patient Profile"@en ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/core/v1/core.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:dateOfBirth a owl:DatatypeProperty ;
    rdfs:label "Date of Birth"@en ;
    rdfs:domain cascade:PatientProfile ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:gYear xsd:gYearMonth xsd:date xsd:dateTime ) ] ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/core/v1/core.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:sourceRecordId a owl:DatatypeProperty ;
    rdfs:label "Source Record ID"@en ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/core/v1/core.ttl> , <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/health/v1/health.ttl> , <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:mergedFrom a owl:ObjectProperty ;
    rdfs:label "Merged From"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/core/v1/core.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:PodManifest a owl:Class ;
    rdfs:label "Pod Manifest"@en ;
    rdfs:subClassOf dcat:Dataset , prov:Entity ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/core/v1/core.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

foaf:givenName a owl:DatatypeProperty ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
    dct:source <http://xmlns.com/foaf/spec/20140114.rdf> .

foaf:familyName a owl:DatatypeProperty ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
    dct:source <http://xmlns.com/foaf/spec/20140114.rdf> .

foaf:name a owl:DatatypeProperty ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
    dct:source <http://xmlns.com/foaf/spec/20140114.rdf> .

# The person; decisions/the-person.md

cascade:administrativeGender a owl:DatatypeProperty ;
    rdfs:label "administrative gender"@en ;
    rdfs:comment "Of a version of a patient profile, the gender the person is considered to have for administration and record keeping, as FHIR's Patient.gender holds it, or a C-CDA administrativeGenderCode as C-CDA on FHIR's concept map maps it into FHIR's codes. It is not the person's sex, which no term holds yet."@en ;
    rdfs:domain cascade:PatientProfile ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/patient-definitions.html#Patient.gender> .

cascade:deceased a owl:DatatypeProperty ;
    rdfs:label "deceased"@en ;
    rdfs:comment "Of a version of a patient profile, whether its source says the person has died: true where either element of FHIR's Patient.deceased[x], or C-CDA's sdtc:deceasedInd or sdtc:deceasedTime, says so; false where the source says they have not. Absent, the source says nothing either way."@en ;
    rdfs:domain cascade:PatientProfile ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/patient-definitions.html#Patient.deceased_x_> .

cascade:dateOfDeath a owl:DatatypeProperty ;
    rdfs:label "date of death"@en ;
    rdfs:comment "Of a version of a patient profile, when the person died, as FHIR's Patient.deceasedDateTime or C-CDA's sdtc:deceasedTime gives it."@en ;
    rdfs:domain cascade:PatientProfile ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:gYear xsd:gYearMonth xsd:date xsd:dateTime ) ] ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/patient-definitions.html#Patient.deceased_x_> .

