cascade:onsetDate a owl:DatatypeProperty ;
    rdfs:label "Onset Date"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( cascade:ProblemOrDiagnosis cascade:AllergyOrIntolerance ) ] ;
    rdfs:range [ a rdfs:Datatype ; owl:unionOf ( xsd:date xsd:dateTime ) ] ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/health/v1/health.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:notes a owl:DatatypeProperty ;
    rdfs:label "Notes"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( cascade:LaboratoryTestResult cascade:ProblemOrDiagnosis cascade:AllergyOrIntolerance cascade:Vaccination ) ] ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/health/v1/health.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:conditionName a owl:DatatypeProperty ;
    rdfs:label "Condition Name"@en ;
    rdfs:domain cascade:ProblemOrDiagnosis ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/health/v1/health.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:clinicalStatus a owl:DatatypeProperty ;
    rdfs:label "Clinical Status"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( cascade:AllergyOrIntolerance cascade:ProblemOrDiagnosis ) ] ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/health/v1/health.ttl> , <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

cascade:workflowStatus a owl:DatatypeProperty ;
    rdfs:label "Workflow Status"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( cascade:Vaccination cascade:MedicalProcedure cascade:LaboratoryTestResult
        cascade:PrescribedOrReportedMedication cascade:GeneticVariantFinding cascade:VariantInterpretation ) ] ;
    rdfs:range xsd:string ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/health/v1/health.ttl> , <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.ttl> ;
