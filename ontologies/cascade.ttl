    rdfs:isDefinedBy <https://w3id.org/sssom/schema/> ;
    dct:source <https://github.com/mapping-commons/sssom/blob/667d3c579d92ad2e1a480503625eeef1e6af8e6d/src/sssom_schema/schema/sssom_schema.yaml> .

sssom:mapping_cardinality a owl:DatatypeProperty ;
    rdfs:label "mapping cardinality"@en ;
    rdfs:isDefinedBy <https://w3id.org/sssom/schema/> ;
    dct:source <https://github.com/mapping-commons/sssom/blob/667d3c579d92ad2e1a480503625eeef1e6af8e6d/src/sssom_schema/schema/sssom_schema.yaml> .

obo:RO_0002248 a owl:ObjectProperty ;
    rdfs:label "has active ingredient"@en ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/ro.owl> ;
    rdfs:seeAlso <http://snomed.info/id/127489000> , <https://www.wikidata.org/wiki/Property:P3781> ;
    dct:source <http://purl.obolibrary.org/obo/ro/releases/2026-09-04/ro.owl> .

obo:RO_0002350 a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/ro.owl> ;
    dct:source <http://purl.obolibrary.org/obo/ro/releases/2026-09-04/ro.owl> .

obo:RO_0002351 a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/ro.owl> ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/observation-definitions.html#Observation.hasMember> ;
    dct:source <http://purl.obolibrary.org/obo/ro/releases/2026-09-04/ro.owl> .

skos:prefLabel a owl:AnnotationProperty ;
    rdfs:label "preferred label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:notation a owl:DatatypeProperty ;
    rdfs:label "notation"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

skos:exactMatch a owl:ObjectProperty ;
    rdfs:label "has exact match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    dct:source <https://www.w3.org/TR/2009/REC-skos-reference-20090818/> .

dct:isReplacedBy a rdf:Property ;
    rdfs:label "Is Replaced By"@en ;
    rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
    rdfs:subPropertyOf dct:relation ;
    dct:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/2020-01-20/> .

dct:identifier a owl:DatatypeProperty ;
    rdfs:label "Identifier"@en ;
    rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/identifier> ;
    dct:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/2020-01-20/> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

# Medication lifecycle

cascade:lifecycle a owl:ObjectProperty ;
    rdfs:label "lifecycle"@en ;
    rdfs:comment "Of a medication entry in its view, the concept of cascade:MedicationLifecycle that its status classifies to, so an app reads whether the medication is still taken without the status; cascade:MedicationUnknown where it states none."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range skos:Concept .

cascade:statusLifecycle a owl:ObjectProperty ;
    rdfs:label "status lifecycle"@en ;
    rdfs:comment "Derived: the lifecycle class of the status the entry shows, the cascade:currentVersionStatusLifecycle of the member it takes its status from. The medications view says it as cascade:lifecycle, a name of its own because a query reading both the derived state and the view would otherwise find each triple twice."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range skos:Concept .

cascade:statusLifecycleStep a owl:DatatypeProperty ;
    rdfs:label "status lifecycle step"@en ;
    rdfs:comment "Derived: which step of the matching order in runtime rule L1 classified the entry: 2 for an absent or blank status, 3 for a FHIR status code, 4 for a synonym, 5 for a fragment, 6 for none of them, which leaves the class unknown and unmatched."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range xsd:integer .

cascade:currentVersionStatusLifecycle a owl:ObjectProperty ;
    rdfs:label "current version status lifecycle"@en ;
    rdfs:comment "Derived: of a medication record in an entry, the lifecycle class of its own current version's status, by runtime rule L1. A rule reads a copy's own class, never its entry's, which is the class of the one member the entry takes its status from."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range skos:Concept .

cascade:currentVersionStatusLifecycleStep a owl:DatatypeProperty ;
    rdfs:label "current version status lifecycle step"@en ;
    rdfs:comment "Derived: which step of the matching order in runtime rule L1 classified the record's current version's status, numbered as cascade:statusLifecycleStep."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range xsd:integer .

cascade:medicationExposureStart a owl:DatatypeProperty ;
    rdfs:label "medication exposure start"@en ;
    rdfs:comment "Derived: of a medication record in an entry, the first day its current version shows the medication taken, as the eCQM library CumulativeMedicationDuration starts a period: its start of use (MedicationStatement.effective[x]), else the day its prescription was written (MedicationRequest.authoredOn), as the derivation reads what the copy states: a rule filters cascade:medicationRequestIntent (a proposal or a plan is not an order) and status, as the library's callers do. A start given only to the year or month is its last day, so exposure is never overstated. A record whose start is not known, or whose end falls before its start, has no exposure."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range xsd:date ;
    rdfs:seeAlso <https://github.com/cqframework/ecqm-content-qicore-2024/blob/07c68e5e76d96d167627469f0face771c702023f/input/cql/CumulativeMedicationDuration.cql> ,
        <https://hl7.org/fhir/R4/medicationstatement-definitions.html#MedicationStatement.effective_x_> ,
        <https://hl7.org/fhir/R4/medicationrequest-definitions.html#MedicationRequest.authoredOn> .

cascade:medicationExposureEnd a owl:DatatypeProperty ;
    rdfs:label "medication exposure end"@en ;
    rdfs:comment "Derived: of a medication record with a cascade:medicationExposureStart, the last day its current version shows the medication taken: its end of use (MedicationStatement.effective[x]). An end given only to the year or month is its first day, so exposure is never overstated."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range xsd:date ;
    rdfs:seeAlso <https://github.com/cqframework/ecqm-content-qicore-2024/blob/07c68e5e76d96d167627469f0face771c702023f/input/cql/CumulativeMedicationDuration.cql> ,
        <https://hl7.org/fhir/R4/medicationstatement-definitions.html#MedicationStatement.effective_x_> .

cascade:medicationExposureOngoing a owl:DatatypeProperty ;
    rdfs:label "medication exposure ongoing"@en ;
    rdfs:comment "Derived: true of a medication record with a cascade:medicationExposureStart and no end whose own cascade:currentVersionStatusLifecycle is active, so its exposure is known through its current revision's cascade:observedAsOf, the last instant a source said the copy was active; a rule closes it at the earlier of that and the day it asks. Never written false: absent means not known. A record with no end that is not active has neither an end nor this, and its exposure is not known to have lasted past its start."@en ;
    rdfs:domain cascade:PrescribedOrReportedMedication ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso <https://github.com/cqframework/ecqm-content-qicore-2024/blob/07c68e5e76d96d167627469f0face771c702023f/input/cql/CumulativeMedicationDuration.cql> .

cascade:MedicationLifecycle a skos:ConceptScheme ;
    rdfs:label "Medication lifecycle"@en ;
    rdfs:comment "Whether a medication is still being taken, however its source states a status. The classes are cascade-knowledge's medication-status-lifecycle, the codes of FHIR R4's MedicationRequest.status and MedicationStatement.status each in one, so an absent status is unknown rather than ended. The form follows a FHIR ConceptMap, a table of source codes to target codes published with a specification; the rows are in derivations/medication-lifecycles.rq, because they change only with this vocabulary."@en ;
    dct:source <https://hl7.org/fhir/R4/valueset-medicationrequest-status.html> , <https://hl7.org/fhir/R4/valueset-medication-statement-status.html> ,
        <https://hl7.org/fhir/us/ccda/ConceptMap-CF-MedicationStatus.html> ;
    skos:hasTopConcept cascade:MedicationActive , cascade:MedicationStopped , cascade:MedicationPaused , cascade:MedicationUnknown ,
        cascade:MedicationEnteredInError .

cascade:MedicationActive a skos:Concept ;
    skos:inScheme cascade:MedicationLifecycle ;
    skos:prefLabel "active" ;
    skos:definition "The source states the medication is being taken now."@en .

cascade:MedicationStopped a skos:Concept ;
    skos:inScheme cascade:MedicationLifecycle ;
    skos:prefLabel "stopped" ;
    skos:definition "The source states the medication is not being taken: it ended, was withdrawn before use, or was never taken."@en .

cascade:MedicationPaused a skos:Concept ;
    skos:inScheme cascade:MedicationLifecycle ;
    skos:prefLabel "paused" ;
    skos:definition "The source states the medication is temporarily halted and expected to continue. Not being taken today, but not ended either."@en .

cascade:MedicationUnknown a skos:Concept ;
    skos:inScheme cascade:MedicationLifecycle ;
    skos:prefLabel "unknown" ;
    skos:definition "The source states neither: the status is absent, unknown, or describes an order or intention that has not started. Not evidence either way."@en .

cascade:MedicationEnteredInError a skos:Concept ;
    skos:inScheme cascade:MedicationLifecycle ;
    skos:prefLabel "entered-in-error" ;
    skos:definition "The record itself is repudiated. Not a statement about the medication at all, so not read as stopped; \"My active medications\" leaves it out."@en .

# Judgments

cascade:Judgment a owl:Class ;
    rdfs:label "judgment"@en ;
    rdfs:comment "A conclusion about records, made by a person at a time or claimed by a machine, which gives no time; its members are prov:hadMember."@en ;
    rdfs:subClassOf prov:Collection .

cascade:verdict a owl:ObjectProperty ;
    rdfs:label "verdict"@en ;
    rdfs:domain cascade:Judgment .

cascade:Same a owl:NamedIndividual ;
    rdfs:label "same"@en ;
    rdfs:comment "The members are one thing: a view draws one entry on every member. A Same whose one member is a cascade:ClaimsNoLongerReached finding joins, for each claim the finding names, that claim's members, as a Same of them would."@en .

cascade:Different a owl:NamedIndividual ;
    rdfs:label "different"@en ;
    rdfs:comment "The members are kept apart: a counting Different wins over any Same for that pair."@en .

cascade:Erroneous a owl:NamedIndividual ;
    rdfs:label "erroneous"@en ;
    rdfs:comment "The members, records or a whole activity, are left out of every view; a revision it names is never its record's current one."@en .

cascade:Before a owl:NamedIndividual ;
    rdfs:label "before"@en ;
    rdfs:comment "A person's judgment that of its two members, revisions of one record or of two records a Same joins, the one it names as cascade:earlierMember is a state before the other: a counting Before outranks every clock. Never two versions, and never made by a machine."@en .

cascade:earlierMember a owl:ObjectProperty ;
    rdfs:label "earlier member"@en ;
    rdfs:comment "Of a Before judgment, the member it places before its other member."@en ;
    rdfs:domain cascade:Judgment ;
    rdfs:range cascade:Revision .

cascade:Acknowledged a owl:NamedIndividual ;
    rdfs:label "acknowledged"@en ;
    rdfs:comment "The member, a cascade:FindingForReview, has been seen and needs nothing done: it leaves the review page, still stands, and changes nothing else."@en .

cascade:ClockDiscounted a owl:NamedIndividual ;
    rdfs:label "clock discounted"@en ;
    rdfs:comment "A person's judgment whose one member is an act: the times its writer's clock gave are known wrong, so every revision the act generated is ranked as carrying no cascade:observedAsOf, and its picks fall to the least IRI and the review page. Nothing is rewritten, and retracting it restores the ranking. It carries no offset: a wrong clock is discounted, not corrected. Not Erroneous over the act: the content is sound, only its clock is not."@en .

cascade:observationTimeDiscountedBy a owl:ObjectProperty ;
    rdfs:label "observation time discounted by"@en ;
    rdfs:comment "Derived: a person's ClockDiscounted that stands names the act that generated this revision: no activity invalidates it, and no judgment that stands replaces it."@en ;
    rdfs:domain cascade:Revision ;
    rdfs:range cascade:Judgment .

cascade:About a owl:NamedIndividual ;
    rdfs:label "about"@en ;
    rdfs:comment "The member, a source's patient record, is about the cascade:subject: every record naming it is the subject's."@en .

cascade:subject a owl:ObjectProperty ;
    rdfs:label "subject"@en ;
    rdfs:comment "The person a judgment is made for, or, derived, the person whose record a record is."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( cascade:Judgment cascade:Record ) ] ;
    rdfs:range cascade:Subject .

cascade:basis a owl:ObjectProperty ;
    rdfs:label "basis"@en ;
    rdfs:domain cascade:Judgment .

cascade:justification a owl:ObjectProperty ;
    rdfs:label "justification"@en ;
    rdfs:comment "The rule a machine applied to conclude Same."@en ;
    rdfs:domain cascade:Judgment .

cascade:SameCode a owl:NamedIndividual ;
    rdfs:label "same code"@en ;
    rdfs:comment "Both records carry one code from one code system, as their sources supplied it."@en ;
    skos:broadMatch semapv:LexicalMatching .

cascade:SameCodeAndDate a owl:NamedIndividual ;
    rdfs:label "same code and date"@en ;
    rdfs:comment "Both records carry one code from one code system and one date."@en ;
    skos:broadMatch semapv:LexicalMatching .

cascade:SameCodeAndPeriod a owl:NamedIndividual ;
    rdfs:label "same code and period"@en ;
    rdfs:comment "Both conditions carry one code from one code system, and their periods overlap."@en ;
    skos:broadMatch semapv:LexicalMatching .

cascade:SameMappedCode a owl:NamedIndividual ;
    rdfs:label "same mapped code"@en ;
    rdfs:comment "The records carry two different codes that a reference table pairs, or maps to one concept."@en ;
    skos:broadMatch semapv:BackgroundKnowledgeBasedMatching .

cascade:SameMappedCodeAndDate a owl:NamedIndividual ;
    rdfs:label "same mapped code and date"@en ;
    rdfs:comment "The records carry two codes that a reference table puts in one group, and one date."@en ;
    skos:broadMatch semapv:BackgroundKnowledgeBasedMatching .

cascade:SameMedicationCode a owl:NamedIndividual ;
    rdfs:label "same medication code"@en ;
    rdfs:comment "Both medication records share an NDC code. In the rule list's versions 2 to 6 they shared an RxNorm code as well (from version 6, the same chosen RxNorm code, the one their source selected or their only one), whether each came from a prescription or from a list of what the person takes."@en ;
    skos:broadMatch semapv:LexicalMatching .

cascade:SameProductCode a owl:NamedIndividual ;
    rdfs:label "same product code"@en ;
    rdfs:comment "Both medication records carry one RxNorm code that a version of a drug products table says names one drug product (SCD, SBD, GPCK or BPCK); they share no NDC."@en ;
    skos:broadMatch semapv:BackgroundKnowledgeBasedMatching .

cascade:SameVariation a owl:NamedIndividual ;
    rdfs:label "same variation"@en ;
    rdfs:comment "Both variant records carry one ClinVar VariationID. Rule M17 and decisions/variant-identity.md say why."@en ;
    skos:broadMatch semapv:LexicalMatching .

cascade:SameVariationThroughTable a owl:NamedIndividual ;
    rdfs:label "same variation through the table"@en ;
    rdfs:comment "Both variant records find one row of a version of a variant classifications table: a version that carries a ClinVar VariationID finds the row of that variation, and one that carries none finds the row holding its HGVS expression. The classification plays no part. Rule M17 and decisions/variant-identity.md say why."@en ;
    skos:broadMatch semapv:BackgroundKnowledgeBasedMatching .

cascade:SameSelfAssertedBaseUrlAndAuthorizationEndpointOnOneHost a owl:NamedIndividual ;
    rdfs:label "same self-asserted base URL and authorization endpoint on one host"@en ;
    rdfs:comment "Both server records have a version, each written by a connect made with one client id, reporting one self-asserted base URL and one authorization endpoint, and the base URLs the client used name one host. Rule M20 and decisions/republishing-sources.md, row \"two servers are one\", say why."@en ;
    skos:broadMatch semapv:LexicalMatching .

cascade:SameBrandGeneric a owl:NamedIndividual ;
    rdfs:label "same brand generic"@en ;
    rdfs:comment "One record's branded RxNorm product and the other's generic, or two brands of one generic, by a version of a brand generics table; the records share no code."@en ;
    skos:broadMatch semapv:BackgroundKnowledgeBasedMatching .

cascade:SameResult a owl:NamedIndividual ;
    rdfs:label "same result"@en ;
    rdfs:comment "Both lab results carry one test code, one instant, and one value of one kind in one unit, the units' UCUM annotations aside. In the rule list's versions 2 to 10 they carried one test code, one time and one value as written, however each wrote its unit."@en ;
    skos:broadMatch semapv:LexicalMatching .

cascade:SameBusinessIdentifierAndTestCodeWithinOneOrganization a owl:NamedIndividual ;
    rdfs:label "same business identifier and test code within one organization"@en ;
    rdfs:comment "Both lab results carry one business identifier of a named system and one test code, and one clinically relevant time, or one of them none, and documents they came from name one organization record, or two currently the same organization, as custodian or author: a certain join, ahead of every other rule for lab results. Rule M22 and decisions/quantities.md, row \"matcher\", say why."@en ;
    skos:broadMatch semapv:LexicalMatching .

cascade:SameResultOnOneDay a owl:NamedIndividual ;
    rdfs:label "same result on one day"@en ;
    rdfs:comment "Both lab results carry one test code, one value of one kind in one unit, and one day, at least one of them a day with no time, so two draws that day cannot be told apart: a likely join, which the review page lists."@en ;
    skos:broadMatch semapv:LexicalMatching .

cascade:SameConvertedCode a owl:NamedIndividual ;
    rdfs:label "same converted code"@en ;
    rdfs:comment "One record carries a retired code and the other the one code its publisher converts it to."@en ;
    skos:broadMatch semapv:BackgroundKnowledgeBasedMatching .

cascade:PortalAuthenticated a owl:NamedIndividual ;
    rdfs:label "portal authenticated"@en ;
    rdfs:comment "The patient record came back from a login the person made themselves."@en .

cascade:RelatedPersonConnection a owl:NamedIndividual ;
    rdfs:label "related person connection"@en ;
    rdfs:comment "A proxy's connection to someone else's chart, whose own RelatedPerson names the proxy."@en .

cascade:SameDemographics a owl:NamedIndividual ;
    rdfs:label "same demographics"@en ;
    rdfs:comment "A matcher judged it from name, birth date, address or phone."@en .

cascade:OwnerStatement a owl:NamedIndividual ;
    rdfs:label "owner statement"@en ;
    rdfs:comment "The operator said so, at import or later."@en .

cascade:PatientRole a prov:Role ;
    rdfs:label "patient role"@en ;
    rdfs:comment "The person the pod is about, acting for themselves."@en .

dct:replaces a rdf:Property ;
    rdfs:label "Replaces"@en ;
    rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
    rdfs:subPropertyOf dct:relation ;
    dct:source <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/2020-01-20/> .

cascade:matcherRuleDeclaredWrong a owl:ObjectProperty ;
    rdfs:label "matcher rule declared wrong"@en ;
    rdfs:comment "Of a rule list version, the release, a matcher rule it declares wrong: once a pod's current rule list version is the release or a version after it, the pod's cascade:RuleListVersionMigration retracts each assertion of that rule's claims under a version the release revises, so a known-bad join is not offered back. An assertion under the release or a later version is not declared wrong: a version that ships the rule fixed, or runs it again, can join the pair again."@en ;
    rdfs:domain prov:Entity .

cascade:RuleListVersionMigration a owl:Class ;
    rdfs:label "rule list version migration"@en ;
    rdfs:comment "An act a runtime performs whenever the pod's current rule list version, or a version it revises, declares a matcher rule wrong and the pod holds an assertion of that rule's claim, under a version the declaring version revises, that no retraction invalidates: at an open, before its matcher run; at a sync's arrival; before a matcher run. It writes a retraction of each such assertion, a prov:Activity that prov:invalidated the assertion and prov:used the declaring version, named by cascade:RetractionNamingRule with no time and no run, so two writers on one release write one file with one content, whatever order they met the versions in. It is written only when it writes a retraction."@en ;
    rdfs:subClassOf prov:Activity .

cascade:currentlySame a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "currently same"@en ;
    rdfs:comment "Derived: two records that a counting Same joins, or that are of one type and id under two servers a counting Same joins (queries/derivations/same-records-under-same-servers.rq), and that no counting Different separates."@en .

cascade:currentlySameOrganization a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "currently same organization"@en ;
    rdfs:comment "Derived: two organization records a counting Same judgment names together and no counting Different separates (queries/derivations/same-organizations.rq); never two that a join of their servers alone makes one record."@en .

cascade:currentlyDifferent a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "currently different"@en ;
    rdfs:comment "Derived: two records a counting Different separates."@en .

# Findings a runtime files for a person to review

cascade:FindingForReview a owl:Class ;
    rdfs:label "finding for review"@en ;
    rdfs:comment "Something a runtime noticed about what the pod holds and filed for a person to answer, a file an act wrote and named by cascade:FindingNamingRule from its own triples, so two writers that notice one thing file one file. Its kind is its oa:hasBody, a concept of cascade:FindingForReviewKinds, its oa:motivatedBy oa:classifying, since it classifies its targets as that kind, and what it is about its oa:hasTarget. Each kind says how its body reads its targets: whether it applies to each target alone, as cascade:ClaimsNoLongerReached does, or to the targets together, as a finding of two records' differing values would. It carries no time and names no act: which act filed it is read from that act's snapshot. A person answers it with a judgment whose one member it is; an acknowledged finding still stands."@en ;
    rdfs:subClassOf oa:Annotation .

cascade:FindingForReviewKinds a skos:ConceptScheme ;
    rdfs:label "finding for review kinds"@en ;
    rdfs:comment "The kinds of thing a cascade:FindingForReview reports, as its oa:hasBody."@en .

cascade:ClaimsNoLongerReached a skos:Concept ;
    skos:inScheme cascade:FindingForReviewKinds ;
    skos:prefLabel "claims no longer reached"@en ;
    skos:definition "The matcher claims a rule list version no longer reaches (cascade:noLongerReachedUnderRuleListVersion), each an oa:hasTarget: every claim nothing withdraws that is asserted, by an assertion no retraction invalidates, under a version whose row for its rule carries the cascade:queryHash of that rule's row in any version on this one's prov:wasRevisionOf line, under none whose row carries the hash of this version's row for it, and that no finding the pod holds names, the rows read as the pod describes them; so which versions the pod's runs went through does not change which claims are named. The body applies to each target alone: each is a claim no longer reached. Filed once per rule list version, by the first run that compares the whole pod under it and leaves at least one such claim, so these claims are listed together on the review page rather than pair by pair. What a claim's tables did is no part of it: a claim kept or lapsed by a table version, and reached by this rule list version, is in no such finding."@en .

cascade:noLongerReachedUnderRuleListVersion a owl:ObjectProperty ;
    rdfs:label "no longer reached under rule list version"@en ;
    rdfs:comment "Of a cascade:ClaimsNoLongerReached finding, the rule list version that reaches none of the claims it names, though the version it revises reached each."@en ;
    rdfs:domain cascade:FindingForReview ;
    rdfs:range prov:Entity .

cascade:SourceReportedOlderStates a skos:Concept ;
    skos:inScheme cascade:FindingForReviewKinds ;
    skos:prefLabel "source reported older states"@en ;
    skos:definition "A source reported, by a live pull, records at states older than it had reported by earlier live pulls: each oa:hasTarget is the revision holding the older state of one record, and each cascade:contradictedEarlierRevision a revision of a target's record, from a live pull of the same source, whose source change time is later than the target's. A live pull is a document retrieved on a date that answers as of no other instant; two are of one source when both name one transmitter, the same agent, or neither names one. The body applies to each target alone: each is a state its source reported after reporting a later one. Filed once by the import that pulled the older states, naming every record that went back and no record a finding the pod holds already names with each of the same contradicted revisions, so a repeat pull of the same states files nothing while that finding stands, acknowledged or not. A copy by another path files nothing."@en .

cascade:contradictedEarlierRevision a owl:ObjectProperty ;
    rdfs:label "contradicted earlier revision"@en ;
    rdfs:comment "Of a cascade:SourceReportedOlderStates finding, a revision from an earlier live pull of the same source holding a later state of the record one of its targets is a revision of: the earlier report the source now contradicts. Its act is the earlier act, its record the record that went back."@en ;
    rdfs:domain cascade:FindingForReview ;
    rdfs:range cascade:Revision .

cascade:ClockBehind a skos:Concept ;
    skos:inScheme cascade:FindingForReviewKinds ;
    skos:prefLabel "clock behind"@en ;
    skos:definition "The writer whose act generated its targets had a clock at least cascade:writerClockBehindByAtLeastDays days behind: each oa:hasTarget is a revision the act generated whose observation time the writer's own clock gave, as an entry session's start, an act's start, or the retrieval time of a live pull that names no transmitter, and that precedes the cascade:observedAsOf of a head it names, or a revision of such a pull whose source change time is after the pull's own time, by at least one whole day. The second check cannot tell a writer's slow clock from a source's fast one: a source whose clock runs ahead stamps after the pull's own time too. The body applies to the targets together: the greatest whole number of days any one of them shows. Filed by an act whose revisions show it, unless an act in the first-parent ancestry of its snapshot filed one that no answer meets, neither a cascade:Acknowledged of it nor a cascade:ClockDiscounted of the act that filed it, so a writer has one unanswered at a time, and a clock that stays wrong is found again once after each answer. A person answers it with a cascade:ClockDiscounted over the act, or acknowledges it."@en .

cascade:writerClockBehindByAtLeastDays a owl:DatatypeProperty ;
    rdfs:label "writer clock behind by at least days"@en ;
    rdfs:comment "Of a cascade:ClockBehind finding, the whole number of days its targets show the writer's clock was at least behind."@en ;
    rdfs:domain cascade:FindingForReview ;
    rdfs:range xsd:integer .

cascade:DifferentResultValuesAtOneInstant a skos:Concept ;
    skos:inScheme cascade:FindingForReviewKinds ;
    skos:prefLabel "different result values at one instant"@en ;
    skos:definition "Two lab results, each an oa:hasTarget, of one test code at one instant whose values differ: values of two kinds, or of one kind other than text, in one unit, their UCUM annotations aside and the litre written either way, that differ: two numbers, a comparator on one and not the other, a part or a bound one holds and the other lacks, or coded answers of one code system sharing no code. The finding's prov:used are the two versions whose values differ. The body applies to its targets together: neither result is wrong alone, but both cannot be the one draw, and a correction should have come as a new version. The matcher never judges such a pair the same (R6); it files this finding by rule R16 instead, which a person answers with an acknowledgement, or by judging the two results the same or different."@en .

cascade:DifferentResultUnitsAtOneInstant a skos:Concept ;
    skos:inScheme cascade:FindingForReviewKinds ;
    skos:prefLabel "different result units at one instant"@en ;
    skos:definition "Two lab results, each an oa:hasTarget, of one test code at one instant whose values are of one kind that has units, where both hold a number in one place, the first or the second, in units that differ once their UCUM annotations are dropped and the litre is written one way. The finding's prov:used are the two versions compared. Two units may measure one draw, mmol/L and mg/dL, and no rule converts one into the other, so the matcher neither joins nor parts them; it files this finding by rule R17, which a person answers with an acknowledgement, or by judging the two results the same or different."@en .

# Naming rules: each name a runtime or an adapter mints follows one, and a changed recipe is a new rule

cascade:RecordFromServerNamingRule a owl:NamedIndividual ;
    rdfs:label "record from a server naming rule"@en ;
    rdfs:comment "A record a client pulled from a FHIR server is named urn:uuid: and a version 8 UUID: the first 128 bits of SHA-256 over 90c60849-c5ef-4ca6-bfb8-8662bd07d2b5, this rule's IRI and the inputs, each with % written %25 and | written %7C, joined by |, with the version bits 1000 and the variant bits 10. Inputs in order: the base URL the client used, normalised by RFC 3986 sections 6.2.2 and 6.2.3 with every trailing / removed, its host an ASCII reg-name or a bracketed IPv6 address or IPvFuture with no zone id, its port empty (no port) or ASCII digits read as an integer with leading zeros dropped, refused above 65535, then dropped if it is the scheme's default (a URL with userinfo, a query, a fragment, a control character or space, no scheme, no host, any other host or any other port names nothing); the resource type; the resource's id."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> , <https://www.rfc-editor.org/rfc/rfc3986#section-6.2.2> ,
        <https://www.rfc-editor.org/rfc/rfc3986#section-6.2.3> .

cascade:RecordFromDocumentNamingRule a owl:NamedIndividual ;
    rdfs:label "record from a document naming rule"@en ;
    rdfs:comment "A record named by its document and its place in it: a record of a document with no known server, one whose id repeats in its document or that has none, one with a urn:uuid fullUrl, every record of a C-CDA document whose custodian has no id that names an organization record, or that states not exactly one patient with an id, the patient's included, and any record no other rule names. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the document's ni:///sha-256; name (cascade:DocumentNamingRule); the rdf:value of the oa:hasSelector of the revision that brought it, the selector of its arrival."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> , <https://www.w3.org/TR/annotation-model/#selectors> .

cascade:RecordFromCcdaNamingRule a owl:NamedIndividual ;
    rdfs:label "record from C-CDA naming rule"@en ;
    rdfs:comment "A C-CDA statement with an id, or the patient with one, named inside its custodian's and its patient's scope. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the custodian's id that names its organization record, as cascade:OrganizationNamingRule picks it, as a root and an extension (the NPI's URI as its OID, a root alone as its urn:oid: or urn:uuid: IRI's tail, a UUID root in lower case); the patient id's root, its extension; the entry id's root, its extension; an absent extension is the empty string. The patient is named with its own id as the patient scope and again as the entry id. Two entries of one document carrying one id with different content are named by cascade:RecordFromDocumentNamingRule instead. Used only in a document whose custodian has an id that names an organization record and that states exactly one patient with an id."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> .

cascade:RecordFromCcdaWithoutIdNamingRule a owl:NamedIndividual ;
    rdfs:label "record from C-CDA without an id naming rule"@en ;
    rdfs:comment "A C-CDA statement with no id, named inside its custodian's and its patient's scope. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the custodian's root and extension, as cascade:RecordFromCcdaNamingRule picks them; the patient id's root, its extension; the IRI of the class the entry's record is; its key fingerprint; its members fingerprint when it has no key fingerprint; the empty string for each it lacks. Used only in a document whose custodian has an id that names an organization record and that states exactly one patient with an id, and never for the patient."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> .

cascade:ContainedRecordNamingRule a owl:NamedIndividual ;
    rdfs:label "contained record naming rule"@en ;
    rdfs:comment "A FHIR contained resource, named inside its container's source version. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the container record's name; the container's meta.versionId, else its meta.lastUpdated as written, else the empty string; the contained resource's id."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> .

cascade:EnteredRecordNamingRule a owl:NamedIndividual ;
    rdfs:label "entered record naming rule"@en ;
    rdfs:comment "A record a person entered. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the entry session's IRI; the draft's position in its session, in decimal."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> .

cascade:VersionNamingRule a owl:NamedIndividual ;
    rdfs:label "version naming rule"@en ;
    rdfs:comment "A version is named ni:///sha-256; and the unpadded base64url SHA-256 of the RDFC-1.0 canonical N-Quads of exactly its triples, its subject written urn:cascade:this-version and its prov:specializationOf its record among them: each line once, in code point order, no blank node, a literal's lexical form as written and a language tag in lower case."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc6920> , <https://www.w3.org/TR/rdf-canon/> .

cascade:RevisionNamingRule a owl:NamedIndividual ;
    rdfs:label "revision naming rule"@en ;
    rdfs:comment "A revision is named as cascade:VersionNamingRule names a version, over its own triples, its subject written urn:cascade:this-revision and a node inside it urn:cascade:this-revision# and the node's own fragment."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc6920> , <https://www.w3.org/TR/rdf-canon/> .

cascade:FindingNamingRule a owl:NamedIndividual ;
    rdfs:label "finding naming rule"@en ;
    rdfs:comment "A cascade:FindingForReview is named as cascade:VersionNamingRule names a version, over its own triples, its subject written urn:cascade:this-finding."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc6920> , <https://www.w3.org/TR/rdf-canon/> .

cascade:TableVersionNamingRule a owl:NamedIndividual ;
    rdfs:label "table version naming rule"@en ;
    rdfs:comment "A version of a reference table is named as cascade:VersionNamingRule names a version, over exactly these triples: urn:cascade:this-version prov:specializationOf its series, urn:cascade:this-version prov:wasRevisionOf the version it revises when there is one, and its rows."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc6920> , <https://www.w3.org/TR/rdf-canon/> .

cascade:DocumentNamingRule a owl:NamedIndividual ;
    rdfs:label "document naming rule"@en ;
    rdfs:comment "A document is named ni:///sha-256; and the unpadded base64url SHA-256 of its bytes."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc6920> .

cascade:TableRowNamingRule a owl:NamedIndividual ;
    rdfs:label "table row naming rule"@en ;
    rdfs:comment "A mapping row, its SSSOM record_id. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the IRIs of its owl:annotatedSource, owl:annotatedProperty and owl:annotatedTarget; for a panel member row, the canonical lexical form of its cascade:panelSequence."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> , <https://mapping-commons.github.io/sssom/record_id/> .

cascade:ViewEntryNamingRule a owl:NamedIndividual ;
    rdfs:label "view entry naming rule"@en ;
    rdfs:comment "An entry of a view is named by a relative reference: the view's path as runtime/pod-layout.ttl places it, #, and the lower-case hexadecimal SHA-256 of the IRI of its least member in code point order. It holds no pod address, and no file writes it absolutised."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc3986#section-4.2> .

cascade:SnapshotNamingRule a owl:NamedIndividual ;
    rdfs:label "snapshot naming rule"@en ;
    rdfs:comment "The snapshot of an act. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the act's IRI; the act's description, every triple of the act's file but those whose subject is the snapshot, named as cascade:VersionNamingRule names a version but with its blank nodes labelled by RDFC-1.0; its cascade:firstParentSnapshot as a list of none or one; its cascade:mergedParentSnapshot values as a list; its cascade:setHash as written. A list is its count, then its distinct items in code point order."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> , <https://www.w3.org/TR/rdf-canon/> .

cascade:ServerNamingRule a owl:NamedIndividual ;
    rdfs:label "server naming rule"@en ;
    rdfs:comment "A server a client pulled from or connected to, as a record. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and the normalised base URL the client used."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> , <https://www.rfc-editor.org/rfc/rfc3986#section-6.2.2> ,
        <https://www.rfc-editor.org/rfc/rfc3986#section-6.2.3> .

cascade:OrganizationNamingRule a owl:NamedIndividual ;
    rdfs:label "organization naming rule"@en ;
    rdfs:comment "An organization, as a record. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, from a server, in order: the normalised base URL, Organization, the resource's id; from a document, in order: the IRI of the datatype and the lexical form of the org:identifier literal its version carries, so the name and the version state the identifier alike: a FHIR Organization.identifier's system and value; a C-CDA id as HL7's CDA-to-FHIR identifier mapping makes it one, a root and extension as the root's registered URI and the extension where the FHIR identifier registry gives the root one (http://hl7.org/fhir/sid/us-npi for the NPI's 2.16.840.1.113883.4.6), else as urn:oid: and the root (urn:uuid: and the root in lower case, for a UUID root) and the extension, a root alone that registers no identifier system as urn:ietf:rfc:3986 and the root's urn:oid: or urn:uuid: IRI; a FHIR system urn:oid: and a registered root is that root's URI too, so one NPI names one organization in either format."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> .

cascade:ClaimNamingRule a owl:NamedIndividual ;
    rdfs:label "claim naming rule"@en ;
    rdfs:comment "A machine judgment's claim. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the maker; the matcher rule term; the justification; the members as a list; what it used as a list. A list is its count, then its distinct items in code point order."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> .

cascade:AssertionNamingRule a owl:NamedIndividual ;
    rdfs:label "assertion naming rule"@en ;
    rdfs:comment "A claim asserted under a version of the rule list. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the rule list version; the claim."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> .

cascade:RetractionNamingRule a owl:NamedIndividual ;
    rdfs:label "retraction naming rule"@en ;
    rdfs:comment "A release's retraction of a claim's assertion. A version 8 UUID as cascade:RecordFromServerNamingRule says, over this rule's IRI and, in order: the release; the assertion; the matcher rule the release declares wrong."@en ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc9562#section-5.8> .

# Snapshots

cascade:Snapshot a owl:Class ;
    rdfs:label "snapshot"@en ;
    rdfs:comment "The set of files a writer holds as one of its acts left it, as a git commit names its tree and its parents: a node in its act's file, prov:wasGeneratedBy the act, named by cascade:SnapshotNamingRule. The set is every file named as N9 names a file in a folder runtime/pod-layout.ttl gives by solid:instanceContainer, but the views' folder and the syncs' folder, the one it gives cascade:SyncFromAnotherWriter: a file the layout gives by solid:instance changes in place, and is outside it, and so is any other file in those folders."@en ;
    rdfs:subClassOf prov:Entity .

cascade:firstParentSnapshot a owl:ObjectProperty ;
    rdfs:label "first parent snapshot"@en ;
    rdfs:comment "Of a snapshot, the writer's own previous one; a writer's first snapshot has none. Its name takes it."@en ;
    rdfs:domain cascade:Snapshot ;
    rdfs:range cascade:Snapshot .

cascade:mergedParentSnapshot a owl:ObjectProperty ;
    rdfs:label "merged parent snapshot"@en ;
    rdfs:comment "Of a snapshot, each head it merges: an arrived snapshot no held snapshot names as a parent, for a sync's; every head the writer holds, for a writer's first. Its name takes them."@en ;
    rdfs:domain cascade:Snapshot ;
    rdfs:range cascade:Snapshot .

cascade:setHash a owl:DatatypeProperty ;
    rdfs:label "set hash"@en ;
    rdfs:comment "Of a snapshot, the order-free hash of the set of files the writer held when its act ended, every file of it but the act's own file, which the snapshot's name binds instead: Bitcoin Core's MuHash3072 over one member per file, the file's path relative to the pod in UTF-8, a 0x00 byte and the SHA-256 of its bytes, written as the 64 lower-case hexadecimal digits of its SHA-256 digest in byte order, where Bitcoin Core writes them reversed. Two writers hold one set when the set hashes of what each holds agree."@en ;
    rdfs:domain cascade:Snapshot ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://github.com/bitcoin/bitcoin/blob/a773e1e33b349dc819b5a0edc1c7a4839dc73b48/src/crypto/muhash.cpp> , <https://cseweb.ucsd.edu/~mihir/papers/inchash.pdf> .

cascade:fileAddedToSet a owl:DatatypeProperty ;
    rdfs:label "file added to set"@en ;
    rdfs:comment "Of a snapshot, the path relative to the pod of each file of the set its act wrote, its act's own file among them unless a sync's, and of no other, so a sync's names none: what the run that wrote a file is known from. A file of the set that no act wrote, as a new pod's, a reference version's or a person's judgment, is named by none."@en ;
    rdfs:domain cascade:Snapshot ;
    rdfs:range xsd:string .

cascade:MatcherRun a owl:Class ;
    rdfs:label "matcher run"@en ;
    rdfs:comment "An act of the matcher over the records an import, an entry session or a sync brought, or over the pod at an open or a recheck; prov:wasInformedBy the act whose records it takes."@en ;
    rdfs:subClassOf prov:Activity .

cascade:SyncFromAnotherWriter a owl:Class ;
    rdfs:label "sync from another writer"@en ;
    rdfs:comment "An act of a writer that holds acts of another writer of the pod: written whenever it holds an act, other than a sync, whose snapshot is no ancestor of its last snapshot, and prov:wasInformedBy each such act; its snapshot merges every head it holds but its first parent. Its file is in the syncs' folder, outside the set."@en ;
    rdfs:subClassOf prov:Activity .

# The matcher and its rules

cascade:CascadeMatcher a prov:SoftwareAgent ;
    rdfs:label "Cascade matcher"@en ;
    rdfs:comment "Any runtime that follows runtime/matcher.feature and the Cascade rule list, as the maker of the judgments it writes; unversioned, since the runtime that ran is on the act."@en .

cascade:ClaimAssertion a owl:Class ;
    rdfs:label "claim assertion"@en ;
    rdfs:comment "A machine claim asserted under a version of the rule list, named by cascade:AssertionNamingRule. A claim is asserted once for each query its rule has run with: a version whose row for the claim's rule carries the cascade:queryHash of that rule's row in a version the claim is already asserted under asserts nothing. It carries no time and names no run."@en ;
    rdfs:subClassOf prov:Entity .

cascade:assertedClaim a owl:ObjectProperty ;
    rdfs:label "asserted claim"@en ;
    rdfs:comment "The machine claim an assertion asserts."@en ;
    rdfs:domain cascade:ClaimAssertion ;
    rdfs:range cascade:Judgment .

cascade:assertedUnderRuleListVersion a owl:ObjectProperty ;
    rdfs:label "asserted under rule list version"@en ;
    rdfs:comment "The version of the rule list an assertion asserts its claim under."@en ;
    rdfs:domain cascade:ClaimAssertion ;
    rdfs:range prov:Entity .

cascade:SameCodeRule a owl:NamedIndividual ;
    rdfs:label "R1, same code"@en ;
    rdfs:comment "Rule R1 of runtime/matcher.feature; its judgments are justified cascade:SameCode."@en .

cascade:SameCodeAndDateRule a owl:NamedIndividual ;
    rdfs:label "R2, same code and date"@en ;
    rdfs:comment "Rule R2 of runtime/matcher.feature; its judgments are justified cascade:SameCodeAndDate."@en .

cascade:SameMappedCodeRule a owl:NamedIndividual ;
    rdfs:label "R3, same mapped code"@en ;
    rdfs:comment "Rule R3 of runtime/matcher.feature; its judgments are justified cascade:SameMappedCode."@en .

cascade:SameMappedCodeAndDateRule a owl:NamedIndividual ;
    rdfs:label "R4, same mapped code and date"@en ;
    rdfs:comment "Rule R4 of runtime/matcher.feature; its judgments are justified cascade:SameMappedCodeAndDate."@en .

cascade:SameMedicationCodeRule a owl:NamedIndividual ;
    rdfs:label "R5, same medication code"@en ;
    rdfs:comment "Rule R5 of runtime/matcher.feature; its judgments are justified cascade:SameMedicationCode."@en .

cascade:SameResultRule a owl:NamedIndividual ;
    rdfs:label "R6, same result"@en ;
    rdfs:comment "Rule R6 of runtime/matcher.feature; its judgments are justified cascade:SameResult."@en .

cascade:SameConvertedCodeRule a owl:NamedIndividual ;
    rdfs:label "R7, same converted code"@en ;
    rdfs:comment "Rule R7 of runtime/matcher.feature; its judgments are justified cascade:SameConvertedCode."@en .

cascade:SameCodeAndPeriodRule a owl:NamedIndividual ;
    rdfs:label "R8, same code and period"@en ;
    rdfs:comment "Rule R8 of runtime/matcher.feature; its judgments are justified cascade:SameCodeAndPeriod."@en .

cascade:SameBrandGenericRule a owl:NamedIndividual ;
    rdfs:label "R10, same brand generic"@en ;
    rdfs:comment "Rule R10 of runtime/matcher.feature; its judgments are justified cascade:SameBrandGeneric."@en .

cascade:SameProductCodeRule a owl:NamedIndividual ;
    rdfs:label "R11, same product code"@en ;
    rdfs:comment "Rule R11 of runtime/matcher.feature; its judgments are justified cascade:SameProductCode."@en .

cascade:SameVariationRule a owl:NamedIndividual ;
    rdfs:label "R12, same variation"@en ;
    rdfs:comment "Rule R12 of runtime/matcher.feature; its judgments are justified cascade:SameVariation."@en .

cascade:SameVariationThroughTableRule a owl:NamedIndividual ;
    rdfs:label "R13, same variation through the table"@en ;
    rdfs:comment "Rule R13 of runtime/matcher.feature; its judgments are justified cascade:SameVariationThroughTable."@en .

cascade:SameSelfAssertedBaseUrlAndAuthorizationEndpointOnOneHostRule a owl:NamedIndividual ;
    rdfs:label "R14, same self-asserted base URL and authorization endpoint on one host"@en ;
    rdfs:comment "Rule R14 of runtime/matcher.feature; its judgments are justified cascade:SameSelfAssertedBaseUrlAndAuthorizationEndpointOnOneHost."@en .

cascade:DifferentResultValuesRule a owl:NamedIndividual ;
    rdfs:label "R16, different result values"@en ;
    rdfs:comment "Rule R16 of runtime/matcher.feature; it files no judgment, but a finding for review of kind cascade:DifferentResultValuesAtOneInstant."@en .

cascade:DifferentResultUnitsRule a owl:NamedIndividual ;
    rdfs:label "R17, different result units"@en ;
    rdfs:comment "Rule R17 of runtime/matcher.feature; it files no judgment, but a finding for review of kind cascade:DifferentResultUnitsAtOneInstant."@en .

cascade:SameResultOnOneDayRule a owl:NamedIndividual ;
    rdfs:label "R15, same result on one day"@en ;
    rdfs:comment "Rule R15 of runtime/matcher.feature; its judgments are justified cascade:SameResultOnOneDay."@en .

cascade:SameBusinessIdentifierAndTestCodeWithinOneOrganizationRule a owl:NamedIndividual ;
    rdfs:label "R18, same business identifier and test code within one organization"@en ;
    rdfs:comment "Rule R18 of runtime/matcher.feature; its judgments are justified cascade:SameBusinessIdentifierAndTestCodeWithinOneOrganization."@en .

# Servers and organizations

cascade:Server a owl:Class ;
    rdfs:label "server"@en ;
    rdfs:subClassOf prov:SoftwareAgent ;
    rdfs:comment "A server a client pulled from or connected to, as a record named by cascade:ServerNamingRule. What the server reported about itself is on its versions; a server known only from a document's address has a record with none."@en ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/capabilitystatement.html> .

cascade:ConnectToServer a owl:Class ;
    rdfs:label "connect to a server"@en ;
    rdfs:comment "An act: an app signing in to a server, which writes a version of the server's record holding what the server reported about itself and the client id the app signed in with, and nothing else."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:seeAlso <https://hl7.org/fhir/smart-app-launch/app-launch.html> .

cascade:selfAssertedBaseUrl a owl:DatatypeProperty ;
    rdfs:label "self-asserted base URL"@en ;
    rdfs:comment "Of a version of a server, the base URL the server said it lives at, as the server wrote it: evidence, never a name input."@en ;
    rdfs:domain cascade:Server ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/capabilitystatement-definitions.html#CapabilityStatement.implementation.url> .

cascade:authorizationEndpoint a owl:DatatypeProperty ;
    rdfs:label "authorization endpoint"@en ;
    rdfs:comment "Of a version of a server, the URL of its OAuth 2.0 authorization endpoint, as the server reported it."@en ;
    rdfs:domain cascade:Server ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc6749#section-3.1> , <https://www.rfc-editor.org/rfc/rfc8414#section-2> ,
        <https://hl7.org/fhir/smart-app-launch/conformance.html> .

cascade:serverSoftwareName a owl:DatatypeProperty ;
    rdfs:label "server software name"@en ;
    rdfs:comment "Of a version of a server, the name of the software it said it runs, as the server wrote it."@en ;
    rdfs:domain cascade:Server ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/capabilitystatement-definitions.html#CapabilityStatement.software.name> .

cascade:serverSoftwareVersion a owl:DatatypeProperty ;
    rdfs:label "server software version"@en ;
    rdfs:comment "Of a version of a server, the release of the software it said it runs, as the server wrote it."@en ;
    rdfs:domain cascade:Server ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/capabilitystatement-definitions.html#CapabilityStatement.software.version> .

cascade:connectClientId a owl:DatatypeProperty ;
    rdfs:label "client id of the connect"@en ;
    rdfs:comment "Of a version of a server, the OAuth 2.0 client identifier the connect that wrote it used with the server, since a pod holds connects from several apps."@en ;
    rdfs:domain cascade:Server ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc6749#section-2.2> .

cascade:Organization a owl:Class ;
    rdfs:label "organization"@en ;
    rdfs:subClassOf prov:Organization ;
    rdfs:comment "An organization as a record named by cascade:OrganizationNamingRule: a provider, a custodian, a payer. Its name, addresses and identifiers are on its versions."@en ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/organization.html> .

cascade:organizationAddress a owl:DatatypeProperty ;
    rdfs:label "organization address"@en ;
    rdfs:comment "Of a version of an organization, one postal address as one string: FHIR Address.text when the source gives one, else the address lines, then city, state, postal code and country, each present part on its own line, separated by line feeds as a vCard label is."@en ;
    rdfs:domain cascade:Organization ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://hl7.org/fhir/R4/organization-definitions.html#Organization.address> .

org:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    rdfs:domain org:Organization ;
    rdfs:subPropertyOf skos:notation ;
    rdfs:isDefinedBy <http://www.w3.org/ns/org> ;
    dct:source <https://www.w3.org/ns/org.ttl> ;
    dct:license <http://www.opendatacommons.org/licenses/pddl/1.0/> .

# What a document's description and the Bridge's findings carry into a pod

cascade:serverBaseUrl a owl:DatatypeProperty ;
    rdfs:label "server base URL"@en ;
    rdfs:comment "The base URL of a server as the client used it, normalised as cascade:RecordFromServerNamingRule says: of a document, the server's the client fetched it from; of a server's record, its own, which cascade:ServerNamingRule names it by."@en ;
    rdfs:range xsd:string .

cascade:sourceFormatVersion a owl:DatatypeProperty ;
    rdfs:label "source format version"@en ;
    rdfs:comment "Of a document, the version of the source format it is written in, as the container it arrived in states it."@en ;
    rdfs:range xsd:string .

cascade:authenticatedPatient a owl:DatatypeProperty ;
    rdfs:label "authenticated patient"@en ;
    rdfs:comment "Of a document, the patient the connection that fetched it authenticated as, written as a reference in the document is written."@en ;
    rdfs:range xsd:string .

cascade:authenticatedAsProxy a owl:DatatypeProperty ;
    rdfs:label "authenticated as proxy"@en ;
    rdfs:comment "Of a document, true where the connection that fetched it acted for the authenticated patient rather than as them."@en ;
    rdfs:range xsd:boolean .

cascade:BridgeFindingKinds a skos:ConceptScheme ;
    rdfs:label "Bridge finding kinds"@en ;
    rdfs:comment "The kinds of gap a Bridge finding kept with its document names as its oa:hasBody."@en .

cascade:SourcePathNotAccounted a skos:Concept ;
    skos:inScheme cascade:BridgeFindingKinds ;
    skos:prefLabel "a path of the record the adapter's source accounting does not carry"@en .

cascade:occurrenceCount a owl:DatatypeProperty ;
    rdfs:label "occurrence count"@en ;
    rdfs:comment "Of a Bridge finding, how many nodes of the record stand at the path it is about."@en ;
    rdfs:range xsd:integer .
