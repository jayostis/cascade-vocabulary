@prefix clinical: <https://ns.cascadeprotocol.org/clinical/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

clinical:ProcedureShape a sh:NodeShape ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.shapes.ttl> ;
    sh:targetClass clinical:Procedure ;
    sh:targetSubjectsOf clinical:procedureName , clinical:procedureDate , clinical:cptCode ;

    sh:property [
        sh:path clinical:procedureName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Procedure name must be a single non-empty string"@en
    ] ;

    sh:property [
        sh:path clinical:procedureDate ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
        sh:maxCount 1 ;
        sh:message "Procedure Date must be an xsd:date or an xsd:dateTime. FHIR's dateTime primitive permits date precision (YYYY, YYYY-MM, YYYY-MM-DD), so a source that stated only a calendar day must not be given an invented time; an untyped or xsd:string literal is not either type."@en
    ] ;

    sh:property [
        sh:path clinical:status ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ("preparation" "in-progress" "not-done" "on-hold" "stopped" "completed" "entered-in-error" "unknown")
    ] ;

    sh:property [
        sh:path clinical:cptCode ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}[0-9FTU]$" ;
        sh:message "CPT code must be five characters: five digits (Category I), or four digits followed by F (Category II), T (Category III) or U (Proprietary Laboratory Analyses)"@en
    ] ;

    sh:property [
        sh:path clinical:sourceRecordId ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] .

clinical:MedicationShape a sh:NodeShape ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/clinical/v1/clinical.shapes.ttl> ;
    sh:targetClass clinical:Medication ;
    sh:targetSubjectsOf clinical:drugName , clinical:rxNormCode , clinical:clinicalIntent , clinical:dosage ,
        clinical:startDate , clinical:endDate ;

    sh:property [
        sh:path [ sh:inversePath prov:specializationOf ] ;
        sh:node [
            sh:property [
                sh:path clinical:clinicalIntent ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Every version of a medication states once whether it came from a prescription or from a list of what the person takes"@en
    ] ;

    sh:property [
        sh:path clinical:clinicalIntent ;
        sh:datatype xsd:string ;
        sh:in ("prescribed" "reportedUse") ;
        sh:message "A medication's clinical intent is \"prescribed\", from a prescription, or \"reportedUse\", from a list of what the person takes"@en
    ] ;

    sh:property [
        sh:path clinical:drugName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "A medication states at most one non-empty drug name"@en
    ] ;

    sh:property [
        sh:path clinical:rxNormCode ;
        sh:maxCount 1 ;
        sh:message "A medication states at most one RxNorm code"@en
    ] ;

    sh:property [
        sh:path clinical:rxNormCode ;
        sh:nodeKind sh:IRI ;
        sh:message "An RxNorm code should be an IRI in RxNorm's own IRI space, for example http://www.nlm.nih.gov/research/umls/rxnorm/314076"@en ;
        sh:severity sh:Warning
    ] ;

    sh:property [
        sh:path clinical:dosage ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path clinical:status ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path clinical:startDate ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
        sh:maxCount 1 ;
        sh:message "Start Date must be an xsd:date or an xsd:dateTime, so a source that stated only a calendar day is not given an invented time"@en
    ] ;

    sh:property [
        sh:path clinical:endDate ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] ) ;
        sh:maxCount 1 ;
        sh:message "End Date must be an xsd:date or an xsd:dateTime, so a source that stated only a calendar day is not given an invented time"@en
    ] ;

    sh:property [
        sh:path clinical:sourceRecordId ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] .
