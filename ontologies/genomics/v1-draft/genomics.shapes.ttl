@prefix dct: <http://purl.org/dc/terms/> .
@prefix genomics: <https://ns.cascadeprotocol.org/genomics/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

genomics:VariantShape a sh:NodeShape ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.shapes.ttl> ;
    sh:targetClass genomics:Variant ;
    sh:targetSubjectsOf genomics:hgvsCDot , genomics:clinvarVariationId , genomics:geneSymbol ;

    sh:property [
        sh:path [ sh:inversePath prov:specializationOf ] ;
        sh:node [
            sh:property [
                sh:path genomics:hgvsCDot ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Every version of a variant states at most one HGVS coding expression: only an entry of the variants view takes every member's"@en
    ] ;

    sh:property [
        sh:path [ sh:inversePath prov:specializationOf ] ;
        sh:node [
            sh:property [
                sh:path genomics:clinvarVariationId ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Every version of a variant states at most one ClinVar VariationID: only an entry of the variants view takes every member's"@en
    ] ;

    sh:property [
        sh:path [ sh:inversePath prov:specializationOf ] ;
        sh:node [
            sh:property [
                sh:path genomics:geneSymbol ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Every version of a variant states at most one gene symbol: only an entry of the variants view takes every member's"@en
    ] ;

    sh:property [
        sh:path genomics:hgvsCDot ;
        sh:datatype xsd:string ;
        sh:pattern "^((NM|NG|XM|NC)_[0-9]+\\.[0-9]+|LRG_[0-9]+(t[0-9]+)?):c\\.\\S+$" ;
        sh:message "An HGVS coding expression is in the normal form: a reference sequence with its version (NM_000249.3, NG_, XM_, NC_ or LRG_), a colon and c., then the change, with no gene in parentheses and no protein change"@en
    ] ;

    sh:property [
        sh:path genomics:clinvarVariationId ;
        sh:datatype xsd:string ;
        sh:pattern "^[1-9][0-9]*$" ;
        sh:message "A ClinVar VariationID is the digits alone with no leading zero (90011, not VCV000090011)"@en
    ] ;

    sh:property [
        sh:path genomics:geneSymbol ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "A gene symbol is a non-empty string"@en
    ] .

genomics:VariantInterpretationShape a sh:NodeShape ;
    dct:source <https://github.com/the-cascade-protocol/spec/blob/d819bc2c045266f9f79ebf9398cbbb82a6156d27/ontologies/genomics/v1-draft/genomics.shapes.ttl> ;
    sh:targetClass genomics:VariantInterpretation ;
    sh:targetSubjectsOf genomics:acmgClassification , genomics:variantInterpreted , genomics:interpretedDate ;

    sh:property [
        sh:path genomics:acmgClassification ;
        sh:nodeKind sh:IRI ;
        sh:in ( genomics:Pathogenic genomics:LikelyPathogenic genomics:VUS genomics:LikelyBenign genomics:Benign ) ;
        sh:maxCount 1 ;
        sh:message "A variant interpretation states at most one ACMG classification, one of genomics:Pathogenic, LikelyPathogenic, VUS, LikelyBenign and Benign; a report whose answer is not one of the five states none"@en
    ] ;

    sh:property [
        sh:path genomics:variantInterpreted ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "A variant interpretation is about at most one variant, named by the variant record's IRI (its urn:uuid: record name, resolved like rec:patient), never a version; the record is one in the same document, since a urn:uuid names a record within one document only"@en
    ] ;

    sh:property [
        sh:path genomics:interpretedDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:message "An interpretation date is one xsd:date, the day the interpretation was issued, with no time"@en
    ] .
